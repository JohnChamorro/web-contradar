---
/**
 * Envoltorio de las páginas de módulo (/producto/…).
 *
 * POR QUÉ EXISTEN ESAS PÁGINAS (31-ago-2026, hallazgo M7). Todo el producto
 * vivía en /funcionalidades/, una sola página de 17.149 px: el menú prometía
 * seis entradas y las seis eran anclas del mismo documento. Decisión de John:
 * una página por módulo, «en diferentes ventanas podríamos extendernos más por
 * cada item».
 *
 * /funcionalidades/ se queda como índice y como puente: los anclajes viejos
 * —#competencia, #busquedas, #paa…— siguen publicados en correos, menús y
 * enlaces externos, y NO se pueden redirigir en el servidor porque el
 * navegador nunca envía el fragmento. El puente es un script en esa página
 * que traduce el hash a la ruta nueva.
 */
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import AccessForm from "../components/AccessForm.astro";
import Flecha from "../components/Flecha.astro";
import Relacionadas from "../components/guias/Relacionadas.astro";
import HeroFoto from "../components/HeroFoto.astro";

/** Foto del hero por módulo (public/fotos/, FLUX local, 15-nov-2026). */
const FOTOS: Record<string, string> = {
  busquedas: "busquedas", "analisis-de-competencia": "competencia", "estadistica-de-la-licitacion": "estadistica",
  calendario: "calendario", "mis-contratos": "contratos", "mis-licitaciones": "pliegos",
  notificaciones: "notificaciones", anticipados: "via",
};

interface Props {
  /** Va al <title> y al H1. Es el nombre del módulo en el menú de la app. */
  titulo: string;
  /** Rótulo mono de encima del H1: el momento en que entra el módulo. */
  momento: string;
  /** Una frase. Lo que hace el módulo, sin adornos.
   *  NO SE PINTA: alimenta la meta description. Se pintaba, y era un error —
   *  cada sección abre con su propio titular, así que la página decía lo mismo
   *  dos veces seguidas, palabra por palabra, en cinco de las seis páginas.
   *  Ese era el «se siente desorganizado» que reportó John el 31-ago. */
  entradilla: string;
  /** Meta description propia; sin ella, la entradilla. */
  description?: string;
  /** <title> por intención de búsqueda; sin él, «titulo — ContRadar». */
  tituloSeo?: string;
  /** Slugs de src/data/guias.ts: el producto enlaza a las guías que lo explican. */
  guias?: string[];
}
const { titulo, momento, entradilla, description, tituloSeo, guias = [] } = Astro.props;
const migas = [
  { nombre: "Funcionalidades", url: "/funcionalidades/" },
  { nombre: titulo, url: Astro.url.pathname },
];
---

<Base title={tituloSeo ?? `${titulo} — ContRadar`} description={description ?? entradilla} migas={migas}>
  <Nav />
  <main>
    {/* Cabecera CORTA a propósito: rótulo del momento y nombre del módulo, y
        ya. La sección que viene debajo trae su propio titular y su entradilla;
        repetirlos aquí hacía que la página se abriera diciendo dos veces lo
        mismo. */}
    {/* 15-nov-2026: la cabecera corta pasa a hero con foto (HeroFoto), con el
        mismo rótulo y el mismo H1. La foto sale de la ruta del módulo. */}
    <HeroFoto foto={FOTOS[Astro.url.pathname.replace(/\/$/, "").split("/").pop() ?? ""] ?? "puente"} rotulo={momento} titulo={titulo} alto="bajo" />
    <div class="h-10 bg-white" aria-hidden="true"></div>

    <slot />

    <section class="bg-white">
      <div class="mx-auto max-w-contenido px-5 py-10 sm:px-8">
        {guias.length > 0 && <div class="mb-10 max-w-4xl"><Relacionadas slugs={guias} titulo="Guías relacionadas" /></div>}
        <a href="/funcionalidades/" class="inline-flex items-center text-sm font-semibold text-azul-600 hover:text-azul-700 hover:underline">
          Ver los siete módulos <Flecha />
        </a>
      </div>
    </section>

    <AccessForm />
  </main>
  <Footer />
</Base>
