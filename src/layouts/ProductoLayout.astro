---
/**
 * Envoltorio de las páginas de módulo (/producto/…).
 *
 * POR QUÉ EXISTEN ESAS PÁGINAS (31-ago-2026, hallazgo M7). Todo el producto
 * vivía en /funcionalidades/, una sola página de 17.149 px: el menú prometía
 * seis entradas y las seis eran anclas del mismo documento. Decisión de John:
 * una página por módulo, «en diferentes ventanas podríamos extendernos más por
 * cada item».
 *
 * /funcionalidades/ se queda como índice y como puente: los anclajes viejos
 * —#competencia, #busquedas, #paa…— siguen publicados en correos, menús y
 * enlaces externos, y NO se pueden redirigir en el servidor porque el
 * navegador nunca envía el fragmento. El puente es un script en esa página
 * que traduce el hash a la ruta nueva.
 */
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import AccessForm from "../components/AccessForm.astro";
import Flecha from "../components/Flecha.astro";

interface Props {
  /** Va al <title> y al H1. Es el nombre del módulo en el menú de la app. */
  titulo: string;
  /** Rótulo mono de encima del H1: el momento en que entra el módulo. */
  momento: string;
  /** Una frase. Lo que hace el módulo, sin adornos. */
  entradilla: string;
  /** Meta description propia; sin ella, la entradilla. */
  description?: string;
}
const { titulo, momento, entradilla, description } = Astro.props;
---

<Base title={`${titulo} — ContRadar`} description={description ?? entradilla}>
  <Nav />
  <main>
    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-5 pb-4 pt-14 text-center sm:px-8 lg:pt-20">
        <p class="dato mb-3.5 inline-flex items-center gap-3 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-azul-500">
          <span class="h-px w-8 bg-azul-500" aria-hidden="true"></span>{momento}
        </p>
        <h1 class="mx-auto max-w-[20ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:max-w-none sm:text-4xl lg:text-5xl">
          {titulo}
        </h1>
        <p class="mx-auto mt-5 max-w-[54ch] text-lg leading-relaxed text-grafito-500">
          {entradilla}
        </p>
      </div>
    </section>

    <slot />

    <section class="bg-white">
      <div class="mx-auto max-w-contenido px-5 py-10 sm:px-8">
        <a href="/funcionalidades/" class="inline-flex items-center text-sm font-semibold text-azul-600 hover:text-azul-700 hover:underline">
          Ver los siete módulos <Flecha />
        </a>
      </div>
    </section>

    <AccessForm />
  </main>
  <Footer />
</Base>
