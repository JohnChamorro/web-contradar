---
// GuideLayout.astro — layout de las guías (/guias/*).
// Responde la búsqueda en el primer párrafo; schema Article + Breadcrumb + FAQ
// opcional. Desde seo/fase-2: migas visibles, fuentes oficiales, caja de
// autor (E-E-A-T), guías relacionadas y llamada al diagnóstico por NIT.
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";
import Migas from "../components/guias/Migas.astro";
import CtaDiagnostico from "../components/guias/CtaDiagnostico.astro";
import CajaAutor from "../components/guias/CajaAutor.astro";
import Fuentes, { type Fuente } from "../components/guias/Fuentes.astro";
import Relacionadas from "../components/guias/Relacionadas.astro";
import { absoluta, esquemaFaq, fundador, ID } from "../lib/esquemas";

interface Props {
  title: string;        // <title> SEO
  description: string;  // meta description
  h1: string;           // titular visible
  slug: string;         // ej. "que-es-el-paa"
  datePublished: string; // "2026-07-07"
  /** Última revisión de FONDO del contenido (no cada retoque de estilo).
   *  Sin ella, se toma la de publicación. */
  dateModified?: string;
  faq?: { q: string; a: string }[];
  /** Normas y guías oficiales citadas. Obligatorio en guías normativas. */
  fuentes?: Fuente[];
  /** Fecha de consulta de las fuentes (AAAA-MM-DD). */
  consultadas?: string;
  /** Slugs de src/data/guias.ts para «Sigue leyendo». */
  relacionadas?: string[];
  /** Título del bloque de fuentes («Fuentes» en comparativas). */
  tituloFuentes?: string;
  /** Texto propio de la llamada al diagnóstico, si la guía lo pide. */
  cta?: { titulo?: string; texto?: string };
}

const {
  title, description, h1, slug, datePublished, dateModified = datePublished,
  faq, fuentes = [], consultadas = dateModified, relacionadas = [], cta = {}, tituloFuentes,
} = Astro.props;
const url = absoluta(`/guias/${slug}/`);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: h1,
  description,
  inLanguage: "es-CO",
  datePublished,
  dateModified,
  mainEntityOfPage: url,
  image: absoluta("/og-image.png"),
  author: fundador,
  publisher: { "@id": ID.organizacion },
  ...(fuentes.length ? { citation: fuentes.map((f) => f.url) } : {}),
};

const migas = [
  { nombre: "Guías", url: "/guias/" },
  { nombre: h1, url: `/guias/${slug}/` },
];

const esquemas = [articleSchema, ...(faq && faq.length ? [esquemaFaq(faq)] : [])];
---

<Base title={title} description={description} migas={migas} esquemas={esquemas}>
  <Nav />
  <main>

    <!-- Encabezado -->
    <section class="relative overflow-hidden bg-tinta-900 text-white">
      <div class="relative mx-auto max-w-3xl px-5 py-14 sm:px-8">
        <Migas migas={[{ nombre: "Guías", url: "/guias/" }, { nombre: h1, url: `/guias/${slug}/` }]} tono="tinta" />
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl text-wrap-balance">{h1}</h1>
        <p class="mt-3 text-lg text-tinta-txt-2">{description}</p>
      </div>
    </section>

    <!-- Contenido -->
    <article class="bg-papel-50">
      <div class="guide-prose mx-auto max-w-3xl px-5 py-12 sm:px-8">
        <slot />
        {/* La FAQ SE VE: el FAQPage del JSON-LD solo vale si el contenido
            marcado está en la página. */}
        {faq && faq.length > 0 && (
          <section aria-labelledby="faq-t">
            <h2 id="faq-t">Preguntas frecuentes</h2>
            {faq.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
          </section>
        )}
        <CtaDiagnostico medio="guia" campana={slug} titulo={cta.titulo} texto={cta.texto} />
        {fuentes.length > 0 && <Fuentes fuentes={fuentes} consultadas={consultadas} titulo={tituloFuentes} />}
        <CajaAutor publicada={datePublished} revisada={dateModified} />
        {relacionadas.length > 0 && <Relacionadas slugs={relacionadas} />}
      </div>
    </article>

    <AccessForm />

  </main>
  <Footer />
</Base>

<style is:global>
  /* En @layer components (2-oct-2026): fuera de capa, estas reglas le ganaban
     a CUALQUIER utilidad de Tailwind 4 y pisaban los componentes metidos en la
     guía (el título del recuadro de diagnóstico salía gris). Dentro de la capa
     siguen dando formato al texto suelto, pero las clases de un componente
     mandan. */
  @layer components {
    .guide-prose h2 {
      margin-top: 2.25rem;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.015em;
      color: var(--grafito-900);
    }
    .guide-prose h3 {
      margin-top: 1.75rem;
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--grafito-900);
    }
    .guide-prose p {
      margin-top: 1rem;
      line-height: 1.75;
      color: var(--grafito-500);
    }
    .guide-prose ul, .guide-prose ol {
      margin-top: 1rem;
      padding-left: 1.4rem;
      color: var(--grafito-500);
      line-height: 1.7;
    }
    .guide-prose ul { list-style: disc; }
    .guide-prose ol { list-style: decimal; }
    .guide-prose li { margin-top: 0.4rem; }
    .guide-prose li::marker { color: var(--azul-300); }
    .guide-prose strong { color: var(--grafito-900); }
    .guide-prose a { color: var(--azul-texto); font-weight: 600; }
    .guide-prose a:hover { text-decoration: underline; }
    .guide-prose .lead {
      margin-top: 0;
      font-size: 1.125rem;
      color: var(--grafito-700);
    }
    .guide-prose .callout {
      margin-top: 1.5rem;
      border-radius: 1rem;
      background: var(--azul-050);
      border: 1px solid rgb(var(--azul-500-rgb) / 0.25);
      padding: 1.1rem 1.3rem;
    }
    .guide-prose .callout p { margin-top: 0; }
    /* Envuelve toda tabla ancha: <div class="tabla-scroll"><table>…</table></div>.
       Sin esto la tabla arrastra el ancho de la página y el body scrollea en
       horizontal en móvil — el contenido ancho scrollea dentro de su caja, no
       mueve la página. */
    .guide-prose .tabla-scroll { margin-top: 1.5rem; overflow-x: auto; }
    .guide-prose .tabla-scroll table { margin-top: 0; min-width: 560px; }
    .guide-prose table {
      margin-top: 1.5rem;
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .guide-prose th {
      text-align: left;
      padding: 0.6rem 0.8rem;
      background: var(--papel-100);
      color: var(--grafito-900);
      font-weight: 700;
      border-bottom: 2px solid var(--papel-200);
    }
    .guide-prose td {
      padding: 0.6rem 0.8rem;
      border-bottom: 1px solid var(--papel-150);
      color: var(--grafito-500);
      vertical-align: top;
    }
  }
</style>
