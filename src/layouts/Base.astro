---
import Flecha from "../components/Flecha.astro";
/* tokens.css NO se importa aquí: lo hace global.css con `layer(base)`. Entrando
   por JS, Vite lo inyecta sin capa y su `.dato` ganaría a las utilidades de
   Tailwind 4. Ver la nota en global.css. */
/* fonts.css declara Manrope Y IBM Plex Mono, las dos autoalojadas en
   /public/fonts. Los @fontsource/ibm-plex-mono/*.css se retiraron en ago-2026:
   venían con font-display: swap, que es justo lo que hacía saltar el texto en
   cada recarga. Solo latin + latin-ext: sitio en español, sin cirílico ni
   griego ni vietnamita. */
import fuentesCss from "../styles/fonts.css?raw";
import { VERSION_CARAS } from "../lib/version-caras";
import "../styles/global.css";
/* Sistema de carga y transiciones — después de tokens y de Tailwind. Todos los
   keyframes del sistema viven ahí; se sincroniza desde contradar-design. */
import "../styles/contradar-loaders.css";
import { SITE_NAME, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /* Solo para páginas que no deben entrar al índice (la 404). El resto del
     sitio va indexable; no lo uses para "ocultar" contenido flojo. */
  noindex?: boolean;
}

const {
  title = `ContRadar — App de licitaciones y alertas de SECOP I y II en Colombia`,
  description = SITE_DESCRIPTION,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
/* El ?v= fuerza a WhatsApp/LinkedIn/X a re-rastrear la imagen: cachean por URL
   y sin esto seguirían mostrando el og anterior semanas. Súbelo al regenerar
   el arte (misma convención que las imágenes de correo en functions/api). */
const ogImage = new URL("/og-image.png?v=3", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <!-- LAS FUENTES, ANTES QUE NADA (30-ago-2026).
         caras.css lleva las ocho caras latinas de Manrope e IBM Plex Mono
         incrustadas en base64 (la genera scripts/generar-caras.mjs). Va como
         <link> y no incrustada en el HTML por una razón medida: incrustarla
         dejaba cada página en ~196 KB comprimidos y se re-descargaba en cada
         navegación, mientras que así se cachea una vez.

         Y va aquí arriba porque una hoja del <head> es render-blocking: el
         navegador no pinta hasta tenerla, y cuando pinta ya tiene la
         tipografía definitiva. Comprobado bloqueando todas las peticiones a
         /fonts/*.woff2: las ocho caras miden EXACTAMENTE lo mismo con archivos
         y sin ellos, o sea que ninguna cambia después del primer fotograma.

         El porqué de todo esto: al recargar se veía medio segundo de otra
         letra. No era el servidor de desarrollo — medido sobre el build, a
         8 Mbps, una sonda pasaba de 458 px (respaldo) a 481 px (Manrope) a los
         200 ms. Ni `font-display: optional` ni seis <link rel=preload> lo
         evitaban: Chrome intercambiaba igual. La única forma de que no haya
         intercambio es que no haya carrera. -->
    <link rel="stylesheet" href={`/fonts/caras.css?v=${VERSION_CARAS}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* La landing corre su PROPIA escala tipográfica fluida, declarada en
        tailwind.config.mjs (theme.extend.fontSize) y no en tokens.css.
        Es deliberado, no un descuido: los --fs-* del sistema dejan de crecer
        entre 992 y 1493 px, y tokens.css está marcado GENERADO (lo pisa
        sync-tokens.sh). La app NO comparte esta escala y no debe hacerlo: ella
        pide densidad, no magnificación. Razonamiento completo en
        docs/auditoria-responsive-2026-08-03.md y al pie de tailwind.config.mjs. */}
    {/* Google exige favicon cuadrado y múltiplo de 48 px: el 48x48 va declarado
        aparte (además de vivir dentro del .ico) para que el rastreador lo tome
        sin depender de que lea las entradas del ICO. Todos cuadrados. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A1628" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="licitaciones, licitaciones Colombia, app de licitaciones, app licitaciones Colombia, licitaciones automáticas, alertas de licitaciones, alertas de licitaciones automáticas, SECOP, SECOP I, SECOP II, monitoreo SECOP, buscador de licitaciones, seguimiento de licitaciones, CRM de licitaciones, contratación pública Colombia, cómo licitar con el Estado, ayuda para licitar, oportunidades de contratación, análisis de competencia en licitaciones, Plan Anual de Adquisiciones, PAA, concursos públicos Colombia" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="author" content="eulertech" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage} />
    {/* 1200×630 (1.91:1), el estándar de WhatsApp/LinkedIn/X. Opaco sobre
        --papel-100: un og con transparencia lo compone cada red a su gusto.
        El arte se genera desde docs/og-image.html — editar ahí, no el PNG. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* El alt DESCRIBE la imagen, así que dice lo que la imagen dice. El arte se
        regeneró con el titular de la portada (docs/og-image.html), que es lo que
        había que alinear: cambiar solo el alt lo habría hecho mentir sobre lo
        que se ve en la tarjeta compartida. */}
    <meta property="og:image:alt" content="ContRadar — El pliego dice qué piden. Los datos dicen quién gana: contra quién compites y a qué precio se adjudica en cada entidad del SECOP I y II" />
    <meta property="og:site_name" content="ContRadar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ContRadar",
      "description": "Plataforma de alertas y gestión de licitaciones de SECOP I y SECOP II en Colombia. Incluye sondeos de mercado (RFI), Plan Anual de Adquisiciones, análisis de competencia y gestión de contratos en equipo.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "inLanguage": "es-CO",
      "url": "https://contradar.com.co",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "COP",
        "lowPrice": "152000",
        "highPrice": "990000",
        "offerCount": "3"
      },
      "featureList": [
        "Monitoreo SECOP I y SECOP II",
        "Alertas de licitaciones por correo",
        "Sondeos de mercado (RFI) antes de la licitación",
        "Plan Anual de Adquisiciones (PAA)",
        "Gestión de licitaciones en equipo por etapas",
        "Asignación de responsables",
        "Análisis de competencia y contratantes desde 2012",
        "Gestión de contratos: hitos, pólizas y liquidación",
        "Capacidad Residual (K) para obra pública",
        "Dashboard de métricas"
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ContRadar",
      "legalName": "eulertech",
      "url": "https://contradar.com.co",
      "logo": "https://contradar.com.co/android-chrome-512x512.png",
      "image": "https://contradar.com.co/og-image.png",
      "email": "soporte@contradar.com.co",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Popayán",
        "addressRegion": "Cauca",
        "addressCountry": "CO"
      },
      "sameAs": ["https://app.contradar.com.co"]
    }
    </script>

    <!-- Manrope e IBM Plex Mono se auto-alojan en /public/fonts (ver
         src/styles/fonts.css): sin llamadas a Google Fonts, la IP del visitante
         no se transmite a Google.

         YA NO SE PRECARGA NINGUNA, y es a propósito (30-ago-2026).

         Manrope 400 y 800 van INCRUSTADAS en base64 unas líneas más arriba
         (lib/caras-criticas.ts), así que no hay petición que adelantar: el
         texto nace en Manrope. Comprobado bloqueando todas las peticiones de
         /fonts/*.woff2 — la sonda mide exactamente lo mismo con archivos y
         sin ellos: 481 px a peso 800 y 455 a peso 400.

         Y las otras tres (500, 600, 700) dejaron de precargarse porque ya no
         corre prisa: con 400 y 800 disponibles, el emparejamiento las resuelve
         DENTRO de Manrope, no en Arial. Si llegan, ajustan el grosor; si no
         llegan, nadie lo nota. Precargarlas solo le robaba ancho de banda al
         HTML, que ahora es lo único que hace falta para pintar bien.

         SÍ se precargan 500, 600, 700 y el Plex de las cifras, y esas cuatro
         pasaron de `optional` a `swap`. Motivo: arriba del pliegue se usan LOS
         CINCO pesos (medido: 400 y 700 son los más frecuentes, y hay 500, 600
         y 800), así que dejarlas sin aplicar no era neutral — el menú se
         quedaba con el grosor equivocado de forma permanente. Con 400 y 800 ya
         incrustadas, lo que estas cuatro cambian al llegar es el GROSOR dentro
         de Manrope, no la tipografía: eso no se ve, y es justo lo que se
         quería quitar. -->
    <!-- LAS @font-face VAN INCRUSTADAS, no en una hoja aparte (30-ago-2026).
         Importarlas como módulo hacía que Astro las mandara a un trozo de CSS
         compartido —`_astro/apps-para-licitaciones-colombia.*.css`, bautizado
         con el nombre de una página que no tiene nada que ver—. Ese archivo
         llega por su propia petición, así que el navegador pintaba el texto
         ANTES de saber que Manrope existía y la cambiaba al llegar.

         Medido sobre el build, con red a 400 kbps y 300 ms de latencia:
           1.800 ms → texto pintado con el RESPALDO
           2.800 ms → cambia a Manrope
         Un segundo entero con la letra equivocada, y en cada recarga.

         Con las reglas en el head no hay petición que esperar: se conocen en
         el primer parseo, los preload de abajo se emparejan al instante y la
         ventana de `font-display: optional` empieza a contar desde el
         principio, que es para lo que sirve. Son 9 KB de reglas —los .woff2
         siguen siendo archivos aparte y cacheables—, así que el head no
         engorda de forma apreciable.

         Ojo con el orden: esto tiene que ir ANTES de los <link rel=preload>. -->
    <style is:inline set:html={fuentesCss}></style>


    <!-- El estilo del splash va EN EL HEAD, no junto a su marcado: el CSS del
         head es render-blocking, así que el velo ya nace fijo y centrado. Con
         el <style> después del <div>, el navegador pintaba el div en flujo
         normal (esquina superior izquierda) y lo recolocaba al centro al
         parsear el estilo — un salto visible en la primera entrada. -->
    <style is:inline>
      #cr-splash {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 100;
        align-items: center;
        justify-content: center;
        background: rgb(var(--papel-050-rgb) / 0.92);
        backdrop-filter: blur(2px);
        transition: opacity var(--t-panel) var(--ease-salida);
      }
      #cr-splash.activo { display: flex; }
      #cr-splash.fuera { opacity: 0; pointer-events: none; }
      .cr-splash-marca { display: block; width: 72px; height: 72px; }
      /* Centro del radar en el viewBox del logo: los grupos giran a su
         alrededor y el punto se queda quieto. Tiempos del sistema. */
      .cr-splash-ext, .cr-splash-int { transform-origin: 54.181px 54.054px; }
      .cr-splash-ext { animation: cr-girar 2600ms linear infinite; }
      .cr-splash-int { animation: cr-girar-inv 3600ms linear infinite; }
      .cr-splash-eco { animation: cr-latir 1400ms ease-in-out infinite; }
      @keyframes cr-girar { to { transform: rotate(360deg); } }
      @keyframes cr-girar-inv { to { transform: rotate(-360deg); } }
      @keyframes cr-latir { 0%, 100% { opacity: .35 } 50% { opacity: 1 } }
      @media (prefers-reduced-motion: reduce) {
        .cr-splash-ext, .cr-splash-int, .cr-splash-eco { animation: none; }
      }
    </style>
  </head>
  <body class="bg-papel-50 font-sans text-slate-800 antialiased">
    <!-- Splash de PRIMERA visita (frecuencia rara → entrada permitida): velo
         translúcido con la marca y el anillo del radar dibujándose. Solo se
         muestra vía JS inline (sin JS jamás aparece ni bloquea) y una vez por
         sesión. reduced-motion: sin giro, solo el fade. -->
    <div id="cr-splash" aria-hidden="true">
      {/* Misma geometría que el loader del sistema y que el arranque de la app
          (contradar/frontend/index.html): los dos arcos del logo girando en
          sentidos opuestos alrededor del punto, que no se mueve, y el eco
          latiendo. El salto contradar.com.co → app.contradar.com.co no debe
          tener cambio de estilo perceptible, y con un arco aquí y otro dibujo
          allá sí lo tenía. */}
      <svg class="cr-splash-marca" viewBox="0 0 107.54822 99.293579" width="72" height="72">
        <g class="cr-splash-ext">
          <g transform="matrix(1.3333333,0,0,-1.3333333,-1861.0553,308.57397)">
            <g fill="none" stroke="var(--grafito-900)" stroke-width="4.805" stroke-linecap="round">
              <g transform="translate(1470.6932,206.7238)"><path d="m 0,0 c 2.157,-4.764 3.357,-10.054 3.357,-15.624 0,-13.277 -6.822,-24.961 -17.152,-31.737" /></g>
              <g transform="translate(1453.64,224.749)"><path d="m 0,0 c -5.24,2.734 -11.198,4.279 -17.518,4.279 -20.947,0 -37.928,-16.981 -37.928,-37.928 0,-13.277 6.822,-24.961 17.152,-31.737" /></g>
            </g>
          </g>
        </g>
        <g class="cr-splash-int">
          <g transform="matrix(1.3333333,0,0,-1.3333333,-1861.0553,308.57397)">
            <g fill="none" stroke="var(--azul-500)" stroke-width="4.805" stroke-linecap="round" opacity=".7">
              <g transform="translate(1424.5775,169.9988)"><path d="m 0,0 c -7.042,4.09 -11.777,11.715 -11.777,20.445 0,13.049 10.578,23.627 23.627,23.627 13.049,0 23.627,-10.578 23.627,-23.627 C 35.477,9.632 28.214,0.516 18.3,-2.291" /></g>
            </g>
          </g>
        </g>
        <circle fill="var(--azul-500)" cx="54.181" cy="54.054" r="13.513" />
        <circle class="cr-splash-eco" fill="var(--azul-500)" cx="93.270" cy="22.399" r="6.721" />
      </svg>
    </div>
    <script is:inline>
      // Antes del primer paint: decidir si el splash existe siquiera.
      (() => {
        const el = document.getElementById("cr-splash");
        if (!el) return;
        try {
          if (sessionStorage.getItem("cr-splash")) { el.remove(); return; }
          sessionStorage.setItem("cr-splash", "1");
        } catch { el.remove(); return; }
        el.classList.add("activo");
        const irse = () => {
          el.classList.add("fuera");
          setTimeout(() => el.remove(), 400);
        };
        // Corto y no bloqueante: se va al cargar o a los 900 ms, lo primero.
        window.addEventListener("load", () => setTimeout(irse, 250), { once: true });
        setTimeout(irse, 900);
      })();
    </script>
    <slot />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("revealed");
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

      // ── VÍDEOS: se piden al acercarse, no al cargar la página ─────────────
      // Con `autoplay` en el marcado, el navegador descarga el vídeo entero
      // aunque esté tres pantallas más abajo. Medido antes de esto:
      // /funcionalidades pesaba 3,15 MB y 2.854 KB eran vídeo. Ahora la ruta
      // viaja en data-src y se pone aquí, 300 px antes de entrar en pantalla.
      //
      // Al salir de la vista se PAUSA: un bucle que nadie mira gasta batería,
      // y buena parte de nuestra gente entra desde el celular.
      //
      // Y se respeta `prefers-reduced-motion`: ahí no arranca solo — se
      // muestran los controles y decide quien mira. Antes se ignoraba.
      const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const cargar = (v: HTMLVideoElement) => {
        if (v.dataset.cargado) return;
        v.dataset.cargado = "1";
        const src = v.dataset.src;
        if (!src) return;
        const fuente = document.createElement("source");
        fuente.src = src;
        fuente.type = "video/mp4";
        v.appendChild(fuente);
        v.load();
      };

      const vigilanteVideo = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              cargar(v);
              // play() rechaza si el navegador lo bloquea; no es un error nuestro.
              // Si el navegador RECHAZA la reproducción —iOS en Modo de Bajo
              // Consumo la bloquea aunque el vídeo esté silenciado, y también
              // la bloquean el ahorro de datos y el ajuste «Reproducción
              // automática: nunca»— hay que dar una salida. Antes el rechazo se
              // tragaba en silencio y el vídeo quedaba congelado en el póster
              // para siempre: sin controles, sin botón, sin ninguna pista de
              // que ahí había algo que ver, y con 0,8-1,2 MB de mp4 ya
              // descargados. Se le da el MISMO trato que a
              // prefers-reduced-motion unas líneas más abajo: se muestran los
              // controles y decide quien mira.
              if (!menosMovimiento) v.play().catch(() => { v.controls = true; });
            } else if (!v.paused) {
              v.pause();
            }
          });
        },
        { rootMargin: "300px 0px" }
      );

      document.querySelectorAll<HTMLVideoElement>("video[data-video-demo]").forEach((v) => {
        if (menosMovimiento) v.controls = true;
        vigilanteVideo.observe(v);
      });

      // ── FONDOS A SANGRE: la foto se pone al acercarse ─────────────────────
      // Un background-image de CSS se descarga SIEMPRE, aunque su sección esté
      // al final de la página. La banda de cierre pesaba 474 KB y se pagaban
      // aunque nadie bajara hasta ella: el 30 % de la portada. La foto vive en
      // la clase `.bleed.cargada` (FullBleedCTA.astro) y se añade aquí.
      // Sin JavaScript la banda se queda en `bg-tinta-900`, que es su fondo
      // base: se lee igual, solo sin foto.
      const vigilanteFondo = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add("cargada");
            vigilanteFondo.unobserve(e.target);
          });
        },
        { rootMargin: "400px 0px" }
      );
      document.querySelectorAll(".bleed").forEach((el) => vigilanteFondo.observe(el));

      // Scroll confiable al formulario (#solicitar): las imágenes lazy cargan
      // después del salto al ancla y empujan el layout, dejando al usuario una
      // sección arriba. Se re-ancla hasta que la posición se estabiliza.
      const scrollToForm = (smooth: boolean) => {
        const el = document.getElementById("solicitar");
        if (!el) return;
        el.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "start" });
        let attempts = 0;
        const settle = window.setInterval(() => {
          attempts++;
          const top = el.getBoundingClientRect().top;
          if (Math.abs(top - 64) > 8) {
            el.scrollIntoView({ behavior: "auto", block: "start" });
          } else if (attempts > 3) {
            window.clearInterval(settle);
          }
          if (attempts >= 12) window.clearInterval(settle);
        }, 250);
      };

      document.addEventListener("click", (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href="#solicitar"]');
        if (!a) return;
        e.preventDefault();
        // /terminos/, /politica-de-datos/ y la 404 NO montan AccessForm, así que
        // no tienen #solicitar. Este manejador capturaba el clic igual, hacía
        // preventDefault y `scrollToForm` salía en su primera línea al no
        // encontrar el destino: el botón «Prueba gratis» del menú —que está dos
        // veces por página, escritorio y móvil— no hacía absolutamente nada.
        // Solo cambiaba la URL. Y la 404 es justo donde alguien perdido intenta
        // recuperarse.
        //
        // No se arregla poniendo href="/#solicitar" en Nav.astro: este manejador
        // filtra por el href exacto, así que esos enlaces dejarían de casar y en
        // las once páginas que SÍ tienen el formulario el CTA pasaría de bajar
        // suave a recargar la página entera.
        if (!document.getElementById("solicitar")) {
          window.location.href = "/#solicitar";
          return;
        }
        history.pushState(null, "", "#solicitar");
        scrollToForm(true);
      });

      if (window.location.hash === "#solicitar") {
        window.addEventListener("load", () => scrollToForm(false));
      }
    </script>
  </body>
</html>
