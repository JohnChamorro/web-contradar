---
import "../styles/tokens.css"; /* antes de Tailwind (global.css) — variables del sistema visual */
import "../styles/fonts.css";
/* IBM Plex Mono autoalojada (cifras .dato) — sin llamadas a Google Fonts.
   Solo latin + latin-ext: app en español, sin cirílico/griego/vietnamita. */
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-ext-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-ext-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-ext-600.css";
import "../styles/global.css";
import { SITE_NAME, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `ContRadar — App de licitaciones y alertas de SECOP I y II en Colombia`,
  description = SITE_DESCRIPTION,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Google exige favicon cuadrado y múltiplo de 48 px: el 48x48 va declarado
        aparte (además de vivir dentro del .ico) para que el rastreador lo tome
        sin depender de que lea las entradas del ICO. Todos cuadrados. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A1628" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="licitaciones, licitaciones Colombia, app de licitaciones, app licitaciones Colombia, licitaciones automáticas, alertas de licitaciones, alertas de licitaciones automáticas, SECOP, SECOP I, SECOP II, monitoreo SECOP, buscador de licitaciones, seguimiento de licitaciones, CRM de licitaciones, contratación pública Colombia, cómo licitar con el Estado, ayuda para licitar, oportunidades de contratación, análisis de competencia en licitaciones, Plan Anual de Adquisiciones, PAA, concursos públicos Colombia" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="eulertech" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage} />
    {/* 1200×630 (1.91:1), el estándar de WhatsApp/LinkedIn/X. Opaco sobre
        --papel-050: un og con transparencia lo compone cada red a su gusto. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ContRadar — monitoreo y seguimiento de licitaciones SECOP I y II" />
    <meta property="og:site_name" content="ContRadar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ContRadar",
      "description": "Plataforma de alertas y seguimiento de licitaciones de SECOP I y SECOP II en Colombia. Incluye CRM de licitaciones, pipeline Kanban y asignación de equipo.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "inLanguage": "es-CO",
      "url": "https://contradar.com.co",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "COP",
        "lowPrice": "152000",
        "highPrice": "990000",
        "offerCount": "3"
      },
      "featureList": [
        "Monitoreo SECOP I y SECOP II",
        "Alertas de licitaciones por correo",
        "CRM de licitaciones con pipeline Kanban",
        "Seguimiento de oportunidades",
        "Asignación de responsables",
        "Análisis de competencia 2023-2025",
        "Buscador PAA (Plan Anual de Adquisiciones)",
        "Dashboard de métricas"
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ContRadar",
      "legalName": "eulertech",
      "url": "https://contradar.com.co",
      "logo": "https://contradar.com.co/android-chrome-512x512.png",
      "image": "https://contradar.com.co/og-image.png",
      "email": "soporte@contradar.com.co",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Popayán",
        "addressRegion": "Cauca",
        "addressCountry": "CO"
      },
      "sameAs": ["https://app.contradar.com.co"]
    }
    </script>

    <!-- Manrope se auto-aloja en /public/fonts (ver src/styles/fonts.css): sin
         llamadas a Google Fonts, la IP del visitante no se transmite a Google. -->
  </head>
  <body class="bg-papel-50 font-sans text-slate-800 antialiased">
    <!-- Splash de PRIMERA visita (frecuencia rara → entrada permitida): velo
         translúcido con la marca y el anillo del radar dibujándose. Solo se
         muestra vía JS inline (sin JS jamás aparece ni bloquea) y una vez por
         sesión. reduced-motion: sin giro, solo el fade. -->
    <div id="cr-splash" aria-hidden="true">
      <div class="cr-splash-marca">
        {/* favicon.svg es cuadrado (lo exige Google) con el dibujo centrado y
            aire arriba/abajo: la caja va 56×56 y el trazo queda a los mismos
            56×52 de antes. */}
        <img src="/favicon.svg" alt="" width="56" height="56" />
        <svg class="cr-splash-anillo" viewBox="0 0 72 72" width="72" height="72">
          <circle cx="36" cy="36" r="33" fill="none" stroke="var(--azul-line)" stroke-width="1.5" />
          <circle class="cr-splash-arco" cx="36" cy="36" r="33" fill="none" stroke="var(--azul-500)"
            stroke-width="2" stroke-linecap="round" stroke-dasharray="52 156" transform="rotate(-90 36 36)" />
        </svg>
      </div>
    </div>
    <script is:inline>
      // Antes del primer paint: decidir si el splash existe siquiera.
      (() => {
        const el = document.getElementById("cr-splash");
        if (!el) return;
        try {
          if (sessionStorage.getItem("cr-splash")) { el.remove(); return; }
          sessionStorage.setItem("cr-splash", "1");
        } catch { el.remove(); return; }
        el.classList.add("activo");
        const irse = () => {
          el.classList.add("fuera");
          setTimeout(() => el.remove(), 400);
        };
        // Corto y no bloqueante: se va al cargar o a los 900 ms, lo primero.
        window.addEventListener("load", () => setTimeout(irse, 250), { once: true });
        setTimeout(irse, 900);
      })();
    </script>
    <style is:inline>
      #cr-splash {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 100;
        align-items: center;
        justify-content: center;
        background: rgb(var(--papel-050-rgb) / 0.92);
        backdrop-filter: blur(2px);
        transition: opacity var(--t-panel) var(--ease-salida);
      }
      #cr-splash.activo { display: flex; }
      #cr-splash.fuera { opacity: 0; pointer-events: none; }
      .cr-splash-marca { position: relative; width: 72px; height: 72px; display: grid; place-items: center; }
      .cr-splash-marca img { position: relative; z-index: 1; }
      .cr-splash-anillo { position: absolute; inset: 0; }
      .cr-splash-arco { animation: cr-girar 1.1s linear infinite; transform-origin: 36px 36px; }
      @keyframes cr-girar { to { transform: rotate(270deg); } }
      @media (prefers-reduced-motion: reduce) {
        .cr-splash-arco { animation: none; }
      }
    </style>
    <slot />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("revealed");
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

      // Scroll confiable al formulario (#solicitar): las imágenes lazy cargan
      // después del salto al ancla y empujan el layout, dejando al usuario una
      // sección arriba. Se re-ancla hasta que la posición se estabiliza.
      const scrollToForm = (smooth: boolean) => {
        const el = document.getElementById("solicitar");
        if (!el) return;
        el.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "start" });
        let attempts = 0;
        const settle = window.setInterval(() => {
          attempts++;
          const top = el.getBoundingClientRect().top;
          if (Math.abs(top - 64) > 8) {
            el.scrollIntoView({ behavior: "auto", block: "start" });
          } else if (attempts > 3) {
            window.clearInterval(settle);
          }
          if (attempts >= 12) window.clearInterval(settle);
        }, 250);
      };

      document.addEventListener("click", (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href="#solicitar"]');
        if (!a) return;
        e.preventDefault();
        history.pushState(null, "", "#solicitar");
        scrollToForm(true);
      });

      if (window.location.hash === "#solicitar") {
        window.addEventListener("load", () => scrollToForm(false));
      }
    </script>
  </body>
</html>
