---
import Flecha from "../components/Flecha.astro";
import Logo from "../components/Logo.astro";
/* tokens.css NO se importa aquí: lo hace global.css con `layer(base)`. Entrando
   por JS, Vite lo inyecta sin capa y su `.dato` ganaría a las utilidades de
   Tailwind 4. Ver la nota en global.css. */
/* fonts.css declara Manrope Y IBM Plex Mono, las dos autoalojadas en
   /public/fonts. Los @fontsource/ibm-plex-mono/*.css se retiraron en ago-2026:
   venían con font-display: swap, que es justo lo que hacía saltar el texto en
   cada recarga. Solo latin + latin-ext: sitio en español, sin cirílico ni
   griego ni vietnamita. */
import fuentesCss from "../styles/fonts.css?raw";
import { VERSION_CARAS } from "../lib/version-caras";
import "../styles/global.css";
/* Sistema de carga y transiciones — después de tokens y de Tailwind. Todos los
   keyframes del sistema viven ahí; se sincroniza desde contradar-design. */
import "../styles/contradar-loaders.css";
import { SITE_DESCRIPTION } from "../consts";
import Asistente from "../components/asistente/Asistente.astro";
import DemoModal from "../components/demo/DemoModal.astro";
import { esquemasComunes, esquemaMigas } from "../lib/esquemas";

interface Props {
  title?: string;
  description?: string;
  /* Solo para páginas que no deben entrar al índice (la 404). El resto del
     sitio va indexable; no lo uses para "ocultar" contenido flojo. */
  noindex?: boolean;
  /* Migas para el BreadcrumbList (sin «Inicio», que se pone solo). La última
     es la página actual. Vacío en la portada. */
  migas?: { nombre: string; url: string }[];
  /* Imagen del LCP: se precarga con prioridad alta. Solo donde la imagen es
     de verdad el elemento más grande del primer pantallazo. */
  precargarImagen?: { href: string; type?: string };
  /* JSON-LD propio de la página (Article, FAQPage…), además del común. */
  esquemas?: Record<string, unknown>[];
  /* Autor de la página para <meta name="author">. Las páginas de contenido
     (guías, pilar, sectores, alternativas, herramientas) pasan a la persona;
     el resto queda a nombre de la empresa. */
  autor?: string;
}

const {
  title = `App de licitaciones en Colombia: SECOP I y II con análisis · ContRadar`,
  description = SITE_DESCRIPTION,
  noindex = false,
  migas = [],
  precargarImagen,
  esquemas = [],
  autor = "eulertech",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
/* El ?v= fuerza a WhatsApp/LinkedIn/X a re-rastrear la imagen: cachean por URL
   y sin esto seguirían mostrando el og anterior semanas. Súbelo al regenerar
   el arte (misma convención que las imágenes de correo en functions/api). */
const ogImage = new URL("/og-image.jpg?v=6", Astro.site);

/* Token de Cloudflare Web Analytics. Vacío en local y en las previsualizaciones
   —no queremos medir nuestras propias pruebas—; se pone en las variables de
   entorno del despliegue. */
const beaconAnalitica = (import.meta.env.PUBLIC_CF_BEACON ?? "").trim();
/* Umami autoalojado para EVENTOS (el beacon de Cloudflare no los tiene).
   Sin las dos variables no se carga nada. */
/* .trim(): un espacio pegado en el panel de Cloudflare llegaba hasta el src. */
const umamiSrc = (import.meta.env.PUBLIC_UMAMI_SRC ?? "").trim();
const umamiId = (import.meta.env.PUBLIC_UMAMI_ID ?? "").trim();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* La landing corre su PROPIA escala tipográfica fluida, declarada en
        tailwind.config.mjs (theme.extend.fontSize) y no en tokens.css.
        Es deliberado, no un descuido: los --fs-* del sistema dejan de crecer
        entre 992 y 1493 px, y tokens.css está marcado GENERADO (lo pisa
        sync-tokens.sh). La app NO comparte esta escala y no debe hacerlo: ella
        pide densidad, no magnificación. Razonamiento completo en
        docs/auditoria-responsive-2026-08-03.md y al pie de tailwind.config.mjs. */}
    {/* Google exige favicon cuadrado y múltiplo de 48 px: el 48x48 va declarado
        aparte (además de vivir dentro del .ico) para que el rastreador lo tome
        sin depender de que lea las entradas del ICO. Todos cuadrados. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A1628" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="author" content={autor} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage} />
    {/* 1200×630 (1.91:1), el estándar de WhatsApp/LinkedIn/X. Opaco sobre
        --papel-100: un og con transparencia lo compone cada red a su gusto.
        Desde el 2-nov-2026 es un pantallazo del hero de la portada sin la cabecera y con el logo discreto arriba a la izquierda (1440×756 a 2x,
        escalado a 1200×630, JPG por la foto: 80 KB). Si el hero cambia, se vuelve a
        tomar. El og-image.png viejo se queda para los enlaces ya compartidos. */}
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* El alt DESCRIBE la imagen, así que dice lo que la imagen dice. */}
    <meta property="og:image:alt" content="ContRadar — Licitar a mano y a ciegas se acabó. Te trae las licitaciones que te sirven, lee el pliego, llena los formatos con tus datos y te muestra quién compite y a qué precio" />
    <meta property="og:site_name" content="ContRadar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Datos estructurados. Organization + WebSite + SoftwareApplication en
        TODAS las páginas (salen de src/data/producto.ts, la fuente única),
        BreadcrumbList en las internas y lo propio de cada página al final.
        Sin AggregateRating: no hay reseñas reales y inventarlas viola las
        políticas de Google. */}
    {[...esquemasComunes(), ...(migas.length ? [esquemaMigas(migas)] : []), ...esquemas].map((e) => (
      <script type="application/ld+json" set:html={JSON.stringify(e)} />
    ))}
    {precargarImagen && (
      <link rel="preload" as="image" href={precargarImagen.href} type={precargarImagen.type} fetchpriority="high" />
    )}

    <!-- Manrope e IBM Plex Mono se auto-alojan en /public/fonts (ver
         src/styles/fonts.css): sin llamadas a Google Fonts, la IP del visitante
         no se transmite a Google.

         YA NO SE PRECARGA NINGUNA, y es a propósito (30-ago-2026).

         Las ocho caras latinas van en base64 dentro de caras.css (la genera
         scripts/generar-caras.mjs), así que no hay .woff2 que adelantar: el
         texto nace en Manrope. Comprobado bloqueando todas las peticiones de
         /fonts/*.woff2 — la sonda mide exactamente lo mismo con archivos y
         sin ellos: 481 px a peso 800 y 455 a peso 400.

         Y las otras tres (500, 600, 700) dejaron de precargarse porque ya no
         corre prisa: con 400 y 800 disponibles, el emparejamiento las resuelve
         DENTRO de Manrope, no en Arial. Si llegan, ajustan el grosor; si no
         llegan, nadie lo nota. Precargarlas solo le robaba ancho de banda al
         HTML, que ahora es lo único que hace falta para pintar bien.

         SÍ se precargan 500, 600, 700 y el Plex de las cifras, y esas cuatro
         pasaron de `optional` a `swap`. Motivo: arriba del pliegue se usan LOS
         CINCO pesos (medido: 400 y 700 son los más frecuentes, y hay 500, 600
         y 800), así que dejarlas sin aplicar no era neutral — el menú se
         quedaba con el grosor equivocado de forma permanente. Con 400 y 800 ya
         incrustadas, lo que estas cuatro cambian al llegar es el GROSOR dentro
         de Manrope, no la tipografía: eso no se ve, y es justo lo que se
         quería quitar. -->
    <!-- caras.css (arriba) trae las ocho caras latinas en base64 y viaja como
         hoja APARTE y cacheable: pesa 229 KB (70 KB brotli) y así se paga una
         sola vez por sesión, no en cada página. El resto de reglas (respaldos
         métricos y latin-ext) sí va incrustado abajo, y NO como módulo (30-ago-2026).
         Importarlas como módulo hacía que Astro las mandara a un trozo de CSS
         compartido —`_astro/apps-para-licitaciones-colombia.*.css`, bautizado
         con el nombre de una página que no tiene nada que ver—. Ese archivo
         llega por su propia petición, así que el navegador pintaba el texto
         ANTES de saber que Manrope existía y la cambiaba al llegar.

         Medido sobre el build, con red a 400 kbps y 300 ms de latencia:
           1.800 ms → texto pintado con el RESPALDO
           2.800 ms → cambia a Manrope
         Un segundo entero con la letra equivocada, y en cada recarga.

         Con las reglas en el head no hay petición que esperar: se conocen en
         el primer parseo, los preload de abajo se emparejan al instante y la
         ventana de `font-display: optional` empieza a contar desde el
         principio, que es para lo que sirve. Son 9 KB de reglas —los .woff2
         siguen siendo archivos aparte y cacheables—, así que el head no
         engorda de forma apreciable.

         Ojo con el orden: esto tiene que ir ANTES de los <link rel=preload>. -->
    <link rel="stylesheet" href={`/fonts/caras.css?v=${VERSION_CARAS}`} />
    <script is:inline>
      // Tema antes de pintar (Web y app 2027): lo que diga el dispositivo o el navegador
      // y, si la persona lo cambió con el botón, eso se recuerda en este navegador.
      (function () {
        var t = null;
        try { t = localStorage.getItem("contradar.tema"); } catch (e) { /* sin almacenamiento */ }
        var oscuro = t ? t === "oscuro" : !!(window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches);
        if (oscuro) document.documentElement.setAttribute("data-theme", "dark");
        // Sin elección propia, sigue al dispositivo también con la página abierta.
        if (!window.matchMedia) return;
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function (e) {
          var propia = null;
          try { propia = localStorage.getItem("contradar.tema"); } catch (err) { /* sin almacenamiento */ }
          if (propia) return;
          if (e.matches) document.documentElement.setAttribute("data-theme", "dark");
          else document.documentElement.removeAttribute("data-theme");
        });
      })();
    </script>
    <script is:inline>
      // EMPUJAR las caras. caras.css es render-blocking, así que las reglas
      // @font-face están ANTES del primer trazado — pero el navegador activa
      // una cara de forma PEREZOSA: solo cuando hay texto maquetado que la
      // pide, o sea DESPUÉS de ese trazado. Medido en producción: aun con los
      // datos en base64 dentro de la hoja, fonts:loading arrancaba 250 ms
      // tarde y el encabezado saltaba 9 px al pasar de las métricas del
      // respaldo a las de Manrope. Con este empujón la decodificación arranca
      // nada más parsearse este script y termina antes del primer trazado.
      // Medido a 3000/1000/400 kbps con caché fría: cero saltos, CLS 0.
      (function () {
        var f = document.fonts;
        if (!f) return;
        ["300", "400", "500", "600", "700", "800"].forEach(function (w) {
          f.load(w + " 1em Manrope");
        });
        f.load('400 1em "IBM Plex Mono"');
        f.load('500 1em "IBM Plex Mono"');
        f.load('600 1em "IBM Plex Mono"');
        // Y ADEMÁS: el encabezado no se muestra hasta que Manrope esté
        // activa. El empujón acorta la carrera pero no la elimina — con
        // caché caliente el primer trazado tarda ~50 ms y la decodificación
        // 30-100 ms, así que a veces gana el trazado y el menú aparece con
        // las métricas del respaldo y se recoloca 9 px al cuadro siguiente.
        // Oculto (visibility, conserva su alto: nada de abajo se mueve)
        // nace ya en su posición final. Tope de 800 ms por si las fuentes
        // no llegaran: mejor un menú en respaldo que un menú invisible.
        document.documentElement.classList.add("cr-fuentes-pendientes");
        var listo = function () {
          document.documentElement.classList.remove("cr-fuentes-pendientes");
        };
        Promise.race([f.ready, new Promise(function (r) { setTimeout(r, 800); })]).then(listo, listo);
      })();
    </script>
    <script is:inline>
      // DE DÓNDE LLEGÓ (6-oct-2026). La app no puede saberlo: el referer que
      // recibe es esta web, y los enlaces solo dicen qué botón se pulsó
      // (utm_campaign=hero). Las visitas orgánicas al diagnóstico se veían, pero
      // no si venían de Google, de LinkedIn o de un enlace compartido. Aquí se
      // apunta al entrar —utm_source de la URL, o el sitio que trajo a la
      // persona, o «directo»— y se añade como `ref` a todo enlace hacia la app
      // (contradar/backend public._origen_web lo guarda en el panel).
      // Vale 30 min desde la última página vista, como una sesión de analítica:
      // así una pestaña nueva abierta desde aquí no se vuelve «directo».
      // TRÁFICO INTERNO (ronda SEO 3): abrir cualquier página con ?cr_interno=1
      // marca ese navegador como del equipo, en web y app, durante un año;
      // ?cr_interno=0 lo desmarca. Umami no cuenta nada mientras exista
      // `umami.disabled` en localStorage (docs/seo/embudo.md).
      (function () {
        try {
          var marca = new URLSearchParams(location.search).get("cr_interno");
          var dom = /(^|\.)contradar\.com\.co$/.test(location.hostname) ? "; Domain=.contradar.com.co" : "";
          if (marca === "1") document.cookie = "cr_interno=1; Max-Age=" + 365 * 86400 + "; Path=/; SameSite=Lax" + dom;
          if (marca === "0") document.cookie = "cr_interno=; Max-Age=0; Path=/; SameSite=Lax" + dom;
          if (/(^|;\s*)cr_interno=1/.test(document.cookie)) localStorage.setItem("umami.disabled", "1");
          else if (marca === "0") localStorage.removeItem("umami.disabled");
        } catch (e) {}
      })();
      (function () {
        var MEDIA_HORA = 30 * 60 * 1000;
        var conocidos = [
          [/(^|\.)gemini\.google\./, "gemini"], [/(^|\.)google\./, "google"],
          [/(^|\.)bing\.com$/, "bing"], [/(^|\.)duckduckgo\.com$/, "duckduckgo"],
          [/(^|\.)yahoo\./, "yahoo"], [/(^|\.)(linkedin\.com|lnkd\.in)$/, "linkedin"],
          [/(^|\.)(facebook\.com|fb\.com|fb\.me)$/, "facebook"], [/(^|\.)instagram\.com$/, "instagram"],
          [/(^|\.)(t\.co|x\.com|twitter\.com)$/, "x"], [/(^|\.)(chatgpt\.com|openai\.com)$/, "chatgpt"],
          [/(^|\.)perplexity\.ai$/, "perplexity"], [/(^|\.)copilot\.microsoft\.com$/, "copilot"],
          [/(^|\.)claude\.ai$/, "claude"], [/(^|\.)(whatsapp\.com|wa\.me)$/, "whatsapp"],
          [/(^|\.)(youtube\.com|youtu\.be)$/, "youtube"],
          [/(^|\.)(mail\.google\.com|outlook\.(live|office)\.com|mail\.yahoo\.com)$/, "correo"]
        ];
        var limpio = function (v) { return String(v || "").toLowerCase().replace(/[^a-z0-9._-]/g, "").slice(0, 60); };
        var origen = "directo";
        try {
          var q = new URLSearchParams(location.search);
          var host = "";
          try { host = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, "") : ""; } catch (e) {}
          var propio = /(^|\.)contradar\.com\.co$/.test(host);
          var nuevo = limpio(q.get("utm_source") || q.get("ref"));
          if (!nuevo && host && !propio) {
            nuevo = host;
            for (var i = 0; i < conocidos.length; i++) if (conocidos[i][0].test(host)) { nuevo = conocidos[i][1]; break; }
            nuevo = limpio(nuevo);
          }
          var guardado = null;
          try { guardado = JSON.parse(localStorage.getItem("cr-origen") || "null"); } catch (e) {}
          var vigente = guardado && guardado.o && Date.now() - guardado.t < MEDIA_HORA;
          origen = nuevo || (vigente ? guardado.o : "directo");
          try { localStorage.setItem("cr-origen", JSON.stringify({ o: origen, t: Date.now() })); } catch (e) {}

          // PRIMER CONTACTO (7-oct-2026): lo de arriba es el último toque y
          // vive 30 min. Para saber de dónde salió cada prueba hace falta el
          // primero, aunque la persona vuelva días después por «directo».
          // Cookie de primera parte en .contradar.com.co —la lee también la
          // app (diagnóstico, /prueba) y su API—, 90 días, y NO se pisa: el
          // primer contacto es uno. Solo el origen, nunca nada de la persona.
          // CLIC EN UN ANUNCIO DE GOOGLE (22-oct-2026): el gclid del ÚLTIMO
          // clic se apunta aparte (g, gt), aunque la cookie ya exista y sin
          // tocar el primer contacto. Sirve solo para devolverle a Google Ads
          // la conversión por importación offline; la web sigue sin etiqueta
          // de Google (política de datos §6, docs/seo/google-ads.md).
          var gclid = /^[A-Za-z0-9_-]{10,200}$/.test(q.get("gclid") || "") ? q.get("gclid") : "";
          var dominioC = /(^|\.)contradar\.com\.co$/.test(location.hostname) ? "; Domain=.contradar.com.co" : "";
          var guardar = function (v) {
            document.cookie = "cr_atrib=" + encodeURIComponent(JSON.stringify(v)) + "; Max-Age=" + 90 * 86400
              + "; Path=/; SameSite=Lax" + dominioC + (location.protocol === "https:" ? "; Secure" : "");
          };
          if (gclid && /(^|;\s*)cr_atrib=/.test(document.cookie)) {
            try {
              var mm = document.cookie.match(/(?:^|;\s*)cr_atrib=([^;]*)/);
              var previo = mm ? JSON.parse(decodeURIComponent(mm[1])) : null;
              if (previo && previo.g !== gclid) { previo.g = gclid; previo.gt = new Date().toISOString(); guardar(previo); }
            } catch (e) {}
          }
          if (!/(^|;\s*)cr_atrib=/.test(document.cookie)) {
            var utm = {};
            ["source", "medium", "campaign", "term", "content"].forEach(function (k) {
              var v = q.get("utm_" + k);
              if (v) utm[k] = String(v).slice(0, 80);
            });
            var primero = {
              f: new Date().toISOString(),
              o: nuevo || "directo",
              r: host && !propio ? String(document.referrer).split(/[?#]/)[0].slice(0, 200) : "",
              e: (location.pathname + (location.search ? location.search : "")).slice(0, 200),
              u: utm,
              ref: limpio(q.get("ref"))
            };
            if (gclid) { primero.g = gclid; primero.gt = new Date().toISOString(); }
            guardar(primero);
          }
        } catch (e) {}
        // Lo que viaja con cada solicitud: el primer contacto, el último
        // (`ref`) y la página desde donde se pide.
        window.crAtribucion = function () {
          var primero = null;
          try {
            var m = document.cookie.match(/(?:^|;\s*)cr_atrib=([^;]*)/);
            if (m) primero = JSON.parse(decodeURIComponent(m[1]));
          } catch (e) {}
          return { primero: primero, ultimo: origen, pagina: location.pathname };
        };
        // Para las URL que se arman en JS (formulario del hero, CTA de guías).
        window.crConOrigen = function (url) {
          try {
            var u = new URL(url, location.href);
            if (u.hostname === "app.contradar.com.co" && !u.searchParams.has("ref")) u.searchParams.set("ref", origen);
            return u.href;
          } catch (e) { return url; }
        };
        // Y para los enlaces: justo antes de seguirlos (clic, clic central o
        // teclado), así cuenta también lo que se pinte después de cargar.
        var marcar = function (ev) {
          var a = ev.target && ev.target.closest ? ev.target.closest("a[href]") : null;
          if (a && a.hostname === "app.contradar.com.co") a.href = window.crConOrigen(a.href);
        };
        ["pointerdown", "click", "auxclick", "keydown"].forEach(function (t) {
          document.addEventListener(t, marcar, true);
        });
      })();
    </script>
    <style is:inline>
      /* Sin JS la clase no existe y el encabezado se ve siempre. */
      html.cr-fuentes-pendientes header { visibility: hidden; }
      /* Canaleta de barra de scroll SIEMPRE reservada: si la barra aparece
         tarde (cuando el contenido desborda), el centrado mx-auto del
         encabezado se corre ~7 px. Con overlay scrollbars no reserva nada. */
      html { scrollbar-gutter: stable; }
    </style>
    <style is:inline set:html={fuentesCss}></style>


    <!-- El estilo del splash va EN EL HEAD, no junto a su marcado: el CSS del
         head es render-blocking, así que el velo ya nace fijo y centrado. Con
         el <style> después del <div>, el navegador pintaba el div en flujo
         normal (esquina superior izquierda) y lo recolocaba al centro al
         parsear el estilo — un salto visible en la primera entrada. -->
    <style is:inline>
      /* Logo 2027 §4.2: carga de la web. El velo nace oculto y solo aparece si
         la página tarda más de 400 ms; la cuña gira en bucle (3 s por vuelta, el
         punto late) mientras la página carga — con una sola vuelta se quedaba
         quieta y parecía colgada (John, 4-nov-2026). Se va en 200 ms en cuanto
         la página carga, a mitad de vuelta si hace falta: nunca la retrasa. */
      #cr-splash {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 100;
        flex-direction: column;
        gap: 18px;
        align-items: center;
        justify-content: center;
        background: rgb(var(--papel-050-rgb) / 0.92);
        backdrop-filter: blur(2px);
        transition: opacity 200ms var(--ease-salida);
      }
      #cr-splash.activo { display: flex; }
      #cr-splash.fuera { opacity: 0; pointer-events: none; }
    </style>
  </head>
  <body class="font-sans text-slate-800 antialiased">
    <div id="cr-splash" aria-hidden="true">
      <Logo variant="mark" size={72} class="cr-splash-logo" />
      <Logo variant="nombre" nombre={22} />
    </div>
    <script is:inline>
      (() => {
        const el = document.getElementById("cr-splash");
        if (!el) return;
        let visto = false;
        const t = setTimeout(() => {
          if (document.readyState === "complete") return;
          visto = true;
          el.querySelector(".cr-splash-logo .cr-mark")?.classList.add("cr-mark--loop");
          el.classList.add("activo");
        }, 400);
        window.addEventListener("load", () => {
          clearTimeout(t);
          if (!visto) { el.remove(); return; }
          el.classList.add("fuera");
          setTimeout(() => el.remove(), 220);
        }, { once: true });
      })();
    </script>
    <slot />
    {/* «Pregúntale a ContRadar», en todas las páginas (5-nov-2026). */}
    <Asistente />
    {/* Agendar demo con Calendly (handoff agendar-demo, 5-nov-2026). */}
    <DemoModal />
    <script>
      import { iniciarAnalitica } from "../lib/analitica";
      iniciarAnalitica();

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("revealed");
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

      // ── VÍDEOS: se piden al acercarse, no al cargar la página ─────────────
      // Con `autoplay` en el marcado, el navegador descarga el vídeo entero
      // aunque esté tres pantallas más abajo. Medido antes de esto:
      // /funcionalidades pesaba 3,15 MB y 2.854 KB eran vídeo. Ahora la ruta
      // viaja en data-src y se pone aquí, 300 px antes de entrar en pantalla.
      //
      // Al salir de la vista se PAUSA: un bucle que nadie mira gasta batería,
      // y buena parte de nuestra gente entra desde el celular.
      //
      // Y se respeta `prefers-reduced-motion`: ahí no arranca solo — se
      // muestran los controles y decide quien mira. Antes se ignoraba.
      const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const cargar = (v: HTMLVideoElement) => {
        if (v.dataset.cargado) return;
        v.dataset.cargado = "1";
        const src = v.dataset.src;
        if (!src) return;
        const fuente = document.createElement("source");
        fuente.src = src;
        fuente.type = "video/mp4";
        v.appendChild(fuente);
        v.load();
      };

      const vigilanteVideo = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              cargar(v);
              // play() rechaza si el navegador lo bloquea; no es un error nuestro.
              // Si el navegador RECHAZA la reproducción —iOS en Modo de Bajo
              // Consumo la bloquea aunque el vídeo esté silenciado, y también
              // la bloquean el ahorro de datos y el ajuste «Reproducción
              // automática: nunca»— hay que dar una salida. Antes el rechazo se
              // tragaba en silencio y el vídeo quedaba congelado en el póster
              // para siempre: sin controles, sin botón, sin ninguna pista de
              // que ahí había algo que ver, y con 0,8-1,2 MB de mp4 ya
              // descargados. Se le da el MISMO trato que a
              // prefers-reduced-motion unas líneas más abajo: se muestran los
              // controles y decide quien mira.
              if (!menosMovimiento) v.play().catch(() => { v.controls = true; });
            } else if (!v.paused) {
              v.pause();
            }
          });
        },
        { rootMargin: "300px 0px" }
      );

      document.querySelectorAll<HTMLVideoElement>("video[data-video-demo]").forEach((v) => {
        if (menosMovimiento) v.controls = true;
        vigilanteVideo.observe(v);
      });

      // ── FONDOS A SANGRE: la foto se pone al acercarse ─────────────────────
      // Un background-image de CSS se descarga SIEMPRE, aunque su sección esté
      // al final de la página. La banda de cierre pesaba 474 KB y se pagaban
      // aunque nadie bajara hasta ella: el 30 % de la portada. La foto vive en
      // la clase `.bleed.cargada` (FullBleedCTA.astro) y se añade aquí.
      // Sin JavaScript la banda se queda en `bg-tinta-900`, que es su fondo
      // base: se lee igual, solo sin foto.
      const vigilanteFondo = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add("cargada");
            vigilanteFondo.unobserve(e.target);
          });
        },
        { rootMargin: "400px 0px" }
      );
      document.querySelectorAll(".bleed").forEach((el) => vigilanteFondo.observe(el));

      // Scroll confiable al formulario (#solicitar): las imágenes lazy cargan
      // después del salto al ancla y empujan el layout, dejando al usuario una
      // sección arriba. Se re-ancla hasta que la posición se estabiliza, y deja
      // de hacerlo en cuanto la persona mueve la página: seguir re-anclando la
      // devolvía al formulario durante 3 s y parecía que el scroll estaba clavado.
      const GESTOS_DE_SCROLL = ["wheel", "touchstart", "keydown", "mousedown"];
      let soltarFormulario = () => {};
      // Al llegar, la tarjeta del formulario se marca con un eco del radar (dos
      // anillos que se abren) para que se vea a dónde la trajimos; en escritorio
      // el cursor queda en el primer campo (John, 5-nov-2026).
      const resaltarFormulario = () => {
        const card = document.querySelector<HTMLElement>("#solicitar .cr-trial__card");
        if (!card) return;
        const io = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          card.classList.remove("resalta");
          void card.offsetWidth;
          card.classList.add("resalta");
          window.setTimeout(() => card.classList.remove("resalta"), 2400);
          if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
            card.querySelector<HTMLInputElement>("input:not([type=hidden]):not([disabled])")?.focus({ preventScroll: true });
          }
        }, { threshold: 0.6 });
        io.observe(card);
        window.setTimeout(() => io.disconnect(), 6000);
      };
      const scrollToForm = (smooth: boolean) => {
        const el = document.getElementById("solicitar");
        if (!el) return;
        soltarFormulario();
        resaltarFormulario();
        el.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "start" });
        let attempts = 0;
        const settle = window.setInterval(() => {
          attempts++;
          const top = el.getBoundingClientRect().top;
          if (Math.abs(top - 64) > 8) {
            el.scrollIntoView({ behavior: "auto", block: "start" });
          } else if (attempts > 3) {
            soltarFormulario();
          }
          if (attempts >= 12) soltarFormulario();
        }, 250);
        const soltar = () => {
          window.clearInterval(settle);
          GESTOS_DE_SCROLL.forEach((g) => window.removeEventListener(g, soltar));
          soltarFormulario = () => {};
        };
        soltarFormulario = soltar;
        GESTOS_DE_SCROLL.forEach((g) => window.addEventListener(g, soltar, { passive: true }));
      };

      document.addEventListener("click", (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href="#solicitar"]');
        if (!a) return;
        e.preventDefault();
        // /terminos/, /politica-de-datos/ y la 404 NO montan AccessForm, así que
        // no tienen #solicitar. Este manejador capturaba el clic igual, hacía
        // preventDefault y `scrollToForm` salía en su primera línea al no
        // encontrar el destino: el botón «Prueba gratis» del menú —que está dos
        // veces por página, escritorio y móvil— no hacía absolutamente nada.
        // Solo cambiaba la URL. Y la 404 es justo donde alguien perdido intenta
        // recuperarse.
        //
        // No se arregla poniendo href="/#solicitar" en Nav.astro: este manejador
        // filtra por el href exacto, así que esos enlaces dejarían de casar y en
        // las once páginas que SÍ tienen el formulario el CTA pasaría de bajar
        // suave a recargar la página entera.
        if (!document.getElementById("solicitar")) {
          window.location.href = "/#solicitar";
          return;
        }
        history.pushState(null, "", "#solicitar");
        scrollToForm(true);
      });

      if (window.location.hash === "#solicitar") {
        window.addEventListener("load", () => scrollToForm(false));
      }
    </script>
    {/* Analítica de Cloudflare — sin cookies y sin banner, a propósito.

       Cloudflare YA sirve este sitio, así que ya procesa la IP de quien entra
       como proveedor nuestro: su analítica no añade ningún destinatario nuevo
       de datos. Por eso no hace falta consentimiento previo ni banner, y por
       eso se descartó Google Analytics, que sí habría mandado la IP del
       visitante a un tercero en Estados Unidos y habría obligado a banner,
       cláusula de transferencia internacional y a romper la promesa escrita en
       política-de-datos.

       No usa cookies, no crea identificador de visitante y no cruza datos
       entre sitios. Si la variable no está puesta, no se carga nada: el sitio
       funciona igual y sin llamadas externas. */}
    {umamiSrc && umamiId && (
      <script defer src={umamiSrc} data-website-id={umamiId} data-domains="contradar.com.co" data-do-not-track="true" />
    )}
    {beaconAnalitica && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${beaconAnalitica}"}`}
      />
    )}
  </body>
