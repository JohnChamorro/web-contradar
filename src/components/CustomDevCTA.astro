---
import Flecha from "./Flecha.astro";
// CustomDevCTA.astro — "¿Lo necesitas y no existe? Lo construimos."
// Usado en /precios y /servicios-a-medida. Claro: tarjeta con línea
// (la única banda oscura de /precios es el ROI).
---

<div class="bg-white">
  <div class="mx-auto max-w-contenido px-5 py-10 sm:px-8">
    <div class="rounded-2xl border border-papel-200 bg-papel-50 px-8 py-10 sm:px-10 sm:py-12">
      <div class="grid items-center gap-8 sm:grid-cols-[1fr_auto]">
        <div>
          <p class="dato text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
            Desarrollo a la medida
          </p>
          <h3 class="mt-4 text-2xl font-extrabold leading-snug tracking-tight text-grafito-900 sm:text-3xl">
            ¿Lo necesitas y no existe?
            <span class="text-azul-600">Lo construimos.</span>
          </h3>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-grafito-500">
            Integración con tu ERP, módulos de análisis personalizados, automatizaciones
            diseñadas exactamente para tu sector — si hay una funcionalidad que dispararía
            los resultados de tu equipo, cuéntanos.
          </p>
          <p class="mt-3 max-w-xl text-base text-grafito-500">
            La desarrollamos sobre ContRadar para que
            <strong class="text-grafito-900">cada peso invertido genere el máximo retorno en contratos ganados.</strong>
          </p>
        </div>
        <div class="sm:shrink-0">
          <a href="#solicitar"
            class="inline-flex min-h-[48px] items-center gap-2 whitespace-nowrap rounded-lg bg-azul-500 px-6 text-sm font-bold text-white transition hover:bg-azul-600">
            Hablar con el equipo <Flecha />
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
