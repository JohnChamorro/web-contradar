---
import Flecha from "./Flecha.astro";
// «Hecho para tu sector» — vuelve al formato original (fotos + texto), pero
// enfocada en LOS SECTORES: cuatro fotos en vez de una sola de obra
// (John, 1-sep-2026). El titular enumera cuatro sectores y ahora se ven los
// cuatro, así que la imagen dice lo mismo que el texto.
//
// La foto única de obra ilustraba solo construcción mientras el titular
// prometía cuatro industrias; era la desconexión que se sentía.
const sectores = [
  { archivo: "sector-construccion", nombre: "Construcción", alt: "Obreros en una estructura de concreto y varilla" },
  { archivo: "sector-ingenieria", nombre: "Ingeniería", alt: "Ingeniero revisando planos técnicos en campo" },
  { archivo: "sector-salud", nombre: "Salud", alt: "Personal de salud en un centro médico" },
  { archivo: "sector-telecomunicaciones", nombre: "Telecomunicaciones", alt: "Torre de telecomunicaciones y equipos de red" },
];
---

<section class="bg-papel-100">
  <div class="mx-auto grid max-w-contenido items-center gap-8 px-5 py-14 sm:px-8 md:grid-cols-[1fr_1.05fr] lg:gap-14 lg:py-[100px]">

    <!-- Los cuatro sectores del titular, vistos -->
    <div class="grid grid-cols-2 gap-3" data-reveal>
      {sectores.map((s) => (
        <figure class="foto-sector sombra-flota relative m-0 overflow-hidden rounded-xl">
          <picture>
            <source srcset={`/fotos/${s.archivo}.webp`} type="image/webp" />
            <img
              src={`/fotos/${s.archivo}.jpg`}
              alt={s.alt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="block aspect-[4/3] w-full object-cover"
            />
          </picture>
          <figcaption class="absolute inset-x-0 bottom-0 px-3 py-2 text-[0.8125rem] font-bold text-white">
            {s.nombre}
          </figcaption>
        </figure>
      ))}
    </div>

    <div>
      <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
        Hecho para tu sector
      </p>
      <h2 class="max-w-[20ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl">
        Construcción, ingeniería, salud, tecnología…
      </h2>
      <p class="mt-4 max-w-[56ch] text-grafito-500">
        ContRadar entiende el vocabulario de tu sector: una búsqueda de «alcantarilla» también
        encuentra saneamiento, acueducto y drenaje, y lo mismo pasa en salud, tecnología o
        dotación.
        <span class="mt-1 block text-xs text-grafito-400">
          En «alcantarilla» son <span class="dato">7.378</span> procesos donde el portal
          solo muestra <span class="dato">2.789</span>. Datos SECOP, julio 2026.
        </span>
      </p>
      <a
        href="/sectores/"
        class="mt-6 inline-flex min-h-[48px] items-center gap-2 whitespace-nowrap rounded-lg bg-azul-500 px-6 font-bold text-white transition hover:bg-azul-600 max-sm:w-full max-sm:justify-center"
      >
        Ver mi sector <span aria-hidden="true"><Flecha /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .sombra-flota {
    box-shadow: var(--sh-flota);
  }
  /* Velo bajo el rótulo: el nombre del sector va sobre foto y tiene que
     leerse sea cual sea la imagen. Degradado, no barra: no tapa el motivo. */
  .foto-sector::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    background: linear-gradient(transparent, rgb(var(--tinta-900-rgb) / 0.78));
    pointer-events: none;
  }
  .foto-sector figcaption {
    z-index: 1;
  }
</style>
