---
/* Mapa de Colombia en relieve (13-nov-2026). Reemplaza la fila de cuatro cifras
   sueltas: en vez de «número grande + etiqueta», una imagen que solo ContRadar
   puede tener, porque sale de sus datos. Cada departamento sube según los
   procesos que sus entidades publicaron en SECOP I y II en doce meses.

   - La imagen es un render de Blender (Cycles) con fondo transparente, una por
     tema. Se regenera con scripts/mapa/ (mapa_relieve.py y luego publicar.py),
     que también escribe data/mapa-secop.json con las cifras y la posición en
     pantalla de la cima de cada departamento.
   - Las cifras se muestran redondeadas a miles: salen de la base de desarrollo
     y el SECOP sigue cargando procesos atrasados.
   - Geometría: Natural Earth (dominio público).
   - Se toca (14-nov-2026): cada departamento tiene un punto que muestra su cifra
     al pasar o al enfocarlo, y las filas de la lista señalan el suyo en el mapa.
     Al entrar en pantalla el país «sube» una vez: seis cuadros del mismo render
     con la altura de 0 a 1 (scripts/mapa/cuadros.py). Sin JS o con movimiento
     reducido se ve el mapa final, quieto. */
import { CIFRAS, DESDE } from "../../data/producto";
import { readdirSync } from "node:fs";

/* Cuántos cuadros de «el país sube» hay publicados (scripts/mapa/cuadros.py).
   Se cuentan al compilar: así el script nunca pide un cuadro que no existe. */
const cuadrosN = Math.min(
  ...["claro", "oscuro"].map((t) => readdirSync("public/mapa").filter((f) => new RegExp(`^sube-${t}-\\d+\\.webp$`).test(f)).length),
);
import mapa from "../../data/mapa-secop.json";

const miles = (n: number) => `${Math.round(n / 1000).toLocaleString("es-CO")} mil`;
const total = Math.round(mapa.total / 1e6);
const lista = mapa.deptos.slice(0, 6);
const max = lista[0].procesos;
/* Etiquetas sobre la imagen: solo las que no se pisan. Las del occidente salen
   hacia la izquierda; Bogotá, hacia la derecha. */
const ETIQUETAS: Record<string, "izq" | "der"> = { "Bogotá D.C.": "der", Antioquia: "izq", "Valle del Cauca": "izq", Nariño: "izq" };
const etiquetas = mapa.deptos.filter((d) => d.nombre in ETIQUETAS && d.x != null);
/* Un punto por departamento. Los que caen encima de uno mayor (Cundinamarca
   sobre Bogotá) se quedan sin punto: su cifra está en la lista. */
const puntos = mapa.deptos.filter((d) => d.x != null).filter((d, i, t) => !t.slice(0, i).some((o) => Math.hypot(o.x! - d.x!, (o.y! - d.y!) * mapa.proporcion) < 0.03));
const conPunto = new Set(puntos.map((d) => d.nombre));
const alt = `Mapa de Colombia en relieve: cada departamento sube según los procesos publicados en SECOP. Los más altos son ${lista.slice(0, 3).map((d) => d.nombre).join(", ")}.`;
---

<section class="mapa" aria-labelledby="mapa-t">
  <div class="mapa-in">
    <div class="mapa-tx">
      <h2 id="mapa-t"><span class="fino">Así se reparte</span><br /><span class="fuerte">la contratación.</span></h2>
      <p>En doce meses las entidades publicaron más de {total} millones de procesos en SECOP I y II. Cada departamento sube según los suyos.</p>
      <ol class="mapa-lista">
        {lista.map((d) => (
          <li data-mapa-fila={conPunto.has(d.nombre) ? d.nombre : undefined}>
            <span class="nom">{d.nombre}</span>
            <span class="num">{miles(d.procesos)}</span>
            <span class="barra" aria-hidden="true"><i style={`width:${Math.round((d.procesos / max) * 100)}%`}></i></span>
          </li>
        ))}
      </ol>
      <p class="mapa-pie">Procesos publicados de {mapa.periodo}. En total leemos {CIFRAS.procesos} de procesos desde {DESDE}, de {CIFRAS.entidades} entidades y {CIFRAS.empresas} de proveedores. <a href="/licitaciones-colombia/">Ver las licitaciones por departamento</a></p>
    </div>
    <div class="mapa-img" style={`aspect-ratio: 1 / ${mapa.proporcion}`} data-mapa data-cuadros={cuadrosN}>
      <img class="solo-claro" src="/mapa/mapa-secop-claro-1600.webp" srcset="/mapa/mapa-secop-claro-960.webp 960w, /mapa/mapa-secop-claro-1600.webp 1600w" sizes="(max-width: 760px) 100vw, 58vw" width="1600" height={Math.round(1600 * mapa.proporcion)} alt={alt} loading="lazy" decoding="async" />
      <img class="solo-oscuro" src="/mapa/mapa-secop-oscuro-1600.webp" srcset="/mapa/mapa-secop-oscuro-960.webp 960w, /mapa/mapa-secop-oscuro-1600.webp 1600w" sizes="(max-width: 760px) 100vw, 58vw" width="1600" height={Math.round(1600 * mapa.proporcion)} alt={alt} loading="lazy" decoding="async" />
      <img class="cuadro" alt="" aria-hidden="true" data-mapa-cuadro hidden />
      <img class="cuadro" alt="" aria-hidden="true" data-mapa-cuadro-sig hidden />
      {puntos.map((d) => (
        <button type="button" class="pt" style={`left:${(d.x! * 100).toFixed(2)}%;top:${(d.y! * 100).toFixed(2)}%`} data-mapa-pt={d.nombre} data-cifra={miles(d.procesos)} data-lado={d.x! > 0.62 ? "izq" : "der"} aria-label={`${d.nombre}: ${miles(d.procesos)} procesos`}></button>
      ))}
      <span class="et viva" data-mapa-viva aria-hidden="true" hidden><b></b><span></span></span>
      {etiquetas.map((d) => (
        <span class:list={["et", "fija", ETIQUETAS[d.nombre]]} data-mapa-fija={d.nombre} style={`left:${(d.x! * 100).toFixed(2)}%;top:${(d.y! * 100).toFixed(2)}%`} aria-hidden="true">
          <b>{d.nombre}</b>{miles(d.procesos)}
        </span>
      ))}
    </div>
  </div>
</section>

<script>
  const caja = document.querySelector<HTMLElement>("[data-mapa]");
  if (caja) {
    const viva = caja.querySelector<HTMLElement>("[data-mapa-viva]")!;
    const pts = [...caja.querySelectorAll<HTMLButtonElement>("[data-mapa-pt]")];
    const fijas = [...caja.querySelectorAll<HTMLElement>("[data-mapa-fija]")];
    /* Señalar un departamento: su punto se enciende y la etiqueta viva va a él.
       Si ya tiene etiqueta fija, se resalta esa y no se duplica. */
    const senalar = (nombre: string | null) => {
      pts.forEach((p) => p.classList.toggle("on", p.dataset.mapaPt === nombre));
      fijas.forEach((f) => f.classList.toggle("on", f.dataset.mapaFija === nombre));
      caja.classList.toggle("senala", !!nombre);
      document.querySelectorAll<HTMLElement>("[data-mapa-fila]").forEach((f) => f.classList.toggle("on", f.dataset.mapaFila === nombre));
      const p = pts.find((x) => x.dataset.mapaPt === nombre);
      if (!p || fijas.some((f) => f.dataset.mapaFija === nombre)) { viva.hidden = true; return; }
      viva.querySelector("b")!.textContent = nombre; viva.querySelector("span")!.textContent = p.dataset.cifra || "";
      viva.style.left = p.style.left; viva.style.top = p.style.top;
      viva.classList.toggle("izq", p.dataset.lado === "izq"); viva.classList.toggle("der", p.dataset.lado !== "izq");
      viva.hidden = false;
    };
    let medido = false;
    const tocar = (n: string) => { senalar(n); if (!medido) { medido = true; window.dispatchEvent(new CustomEvent("cr:evento", { detail: { nombre: "web_mapa_departamento" } })); } };
    pts.forEach((p) => {
      p.addEventListener("pointerenter", () => tocar(p.dataset.mapaPt!)); p.addEventListener("focus", () => tocar(p.dataset.mapaPt!));
      p.addEventListener("pointerleave", () => senalar(null)); p.addEventListener("blur", () => senalar(null));
    });
    document.querySelectorAll<HTMLElement>("[data-mapa-fila]").forEach((f) => {
      f.addEventListener("pointerenter", () => tocar(f.dataset.mapaFila!)); f.addEventListener("pointerleave", () => senalar(null));
    });

    /* El país sube: una vez, al entrar en pantalla, si los cuadros ya cargaron.
       14-nov-2026: 12 cuadros (antes 5 cambiados cada 95 ms, que se veían a
       saltos) y cada uno se FUNDE con el siguiente en cada fotograma del
       navegador: dos capas, la de arriba con la opacidad de lo que falta para
       el próximo cuadro. El último paso funde con el mapa final, así que no
       hay corte al terminar. */
    const cuadro = caja.querySelector<HTMLImageElement>("[data-mapa-cuadro]");
    const sig = caja.querySelector<HTMLImageElement>("[data-mapa-cuadro-sig]");
    const seccion = caja.closest<HTMLElement>(".mapa");
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (cuadro && sig && seccion && !quieto && Number(caja.dataset.cuadros) >= 2 && "IntersectionObserver" in window && caja.getBoundingClientRect().top > innerHeight) {
      const tema = document.documentElement.dataset.theme === "dark" ? "oscuro" : "claro";
      const final = caja.querySelector<HTMLImageElement>(tema === "oscuro" ? "img.solo-oscuro" : "img.solo-claro");
      const N = Number(caja.dataset.cuadros) || 0, DUR = 1600;
      const fuentes: string[] = [];
      let listos = false;
      /* El mapa arranca PLANO, no completo (14-nov-2026). Antes, al asomar la
         sección se veía el mapa final y, al llegar al 45 %, saltaba a plano
         para subir: se leía como un error. Ahora, en cuanto los cuadros están
         listos y el mapa todavía no se ha visto, se deja puesto el cuadro 0. Si
         ya se alcanzó a ver completo, no se anima: mejor quieto que con salto. */
      let visto = false, preparado = false;
      new IntersectionObserver(([e], o) => { if (e.isIntersecting) { visto = true; o.disconnect(); } }).observe(caja);
      const cargar = new IntersectionObserver(([e], o) => {
        if (!e.isIntersecting) return; o.disconnect();
        fuentes.push(...Array.from({ length: N }, (_, i) => new URL(`/mapa/sube-${tema}-${i}.webp`, location.href).href));
        if (final) final.loading = "eager";
        const todas = fuentes.map((src) => { const im = new Image(); im.src = src; return im.decode(); });
        const fin = final ? (final.complete ? final.decode() : new Promise<void>((ok, mal) => { final.onload = () => ok(); final.onerror = mal; })) : Promise.reject();
        Promise.all([...todas, fin]).then(() => {
          fuentes.push(final!.currentSrc || final!.src); listos = true;
          if (visto) return;
          preparado = true;
          seccion.classList.add("sube");
          cuadro.src = fuentes[0]; cuadro.hidden = false;
        }, () => {});
      }, { rootMargin: "900px 0px" });
      cargar.observe(caja);
      new IntersectionObserver(([e], o) => {
        if (!e.isIntersecting) return; o.disconnect();
        if (!listos || !preparado) return; // red lenta o ya visto completo: se queda el mapa final
        sig.src = fuentes[1]; sig.style.opacity = "0"; sig.hidden = false;
        requestAnimationFrame(() => seccion.classList.add("crece")); // las barras crecen a la par
        // Curva simétrica (seno): crece parejo y llega sin cola lenta. La cúbica
        // de salida dejaba el último 20 % arrastrándose casi 1 s.
        const salida = (p: number) => 0.5 - Math.cos(Math.PI * p) / 2;
        let ini = 0;
        const marco = (t: number) => {
          ini ||= t;
          const p = Math.min(1, (t - ini) / DUR);
          const f = salida(p) * N;              // 0 … N (N = el mapa final)
          const i = Math.min(N - 1, Math.floor(f));
          if (cuadro.src !== fuentes[i]) cuadro.src = fuentes[i];
          if (sig.src !== fuentes[i + 1]) sig.src = fuentes[i + 1];
          sig.style.opacity = String(p < 1 ? f - i : 1);
          if (p < 1) { requestAnimationFrame(marco); return; }
          seccion.classList.remove("sube", "crece"); seccion.classList.add("subio");
          setTimeout(() => { cuadro.hidden = true; sig.hidden = true; }, 260);
        };
        requestAnimationFrame(marco);
      }, { threshold: 0.45 }).observe(caja);
    }
  }
</script>

<style>
  .mapa { border-bottom: 1px solid var(--line); background: var(--bg-web); color: var(--ink); }
  .mapa-in { max-width: 1440px; margin: 0 auto; padding: 72px var(--pad-v3, 56px) 56px; box-sizing: border-box; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 40px; align-items: center; }
  .mapa-tx { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  h2 { margin: 0; font-size: var(--fs-web-h2-b); line-height: 1.04; letter-spacing: -.04em; text-wrap: balance; }
  .fino { font-weight: var(--fw-ligero); } .fuerte { font-weight: 800; }
  p { margin: 0; max-width: 46ch; font-size: var(--fs-w-17); line-height: 1.5; color: var(--muted); }
  .mapa-lista { list-style: none; margin: 4px 0 0; padding: 0; max-width: 440px; border-top: 1px solid var(--line); }
  .mapa-lista li { display: grid; grid-template-columns: 1fr auto; gap: 6px 16px; padding: 11px 0; border-bottom: 1px solid var(--line-soft); }
  .mapa-lista .nom { font-size: var(--fs-w-15); font-weight: 700; }
  .mapa-lista .num { font-size: var(--fs-w-15); font-variant-numeric: tabular-nums; color: var(--muted); }
  .mapa-lista .barra { grid-column: 1 / -1; height: 3px; border-radius: 2px; background: var(--surface-2); overflow: hidden; }
  .mapa-lista .barra i { display: block; height: 100%; background: var(--action); border-radius: 2px; }
  .mapa-pie { font-size: var(--fs-w-13); line-height: 1.55; max-width: 52ch; }
  .mapa-pie a { color: var(--link); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .mapa-pie a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .mapa-img { position: relative; width: 100%; min-width: 0; }
  .mapa-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  /* La etiqueta nace en la cima del departamento y sale hacia un lado con una
     línea corta: el punto queda exacto y el texto no tapa el relieve. */
  /* El punto de cada departamento: 28 px de zona táctil, 8 de punto visible. */
  .pt { position: absolute; width: 28px; height: 28px; margin: -14px 0 0 -14px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; z-index: 2; }
  .pt::after { content: ""; position: absolute; left: 10px; top: 10px; width: 8px; height: 8px; border-radius: 50%; background: var(--ink); opacity: 0; transition: opacity var(--t-fast, .12s), transform var(--t-fast, .12s); }
  .mapa-img:hover .pt::after, .pt:focus-visible::after { opacity: .35; }
  .pt.on::after, .pt:hover::after { opacity: 1; transform: scale(1.5); }
  .pt:focus-visible { outline: 2px solid var(--link); outline-offset: -4px; }
  .et.viva { z-index: 3; border-color: var(--ink); } .et.viva[hidden] { display: none; }
  .et.fija { transition: opacity var(--t-fast, .12s), border-color var(--t-fast, .12s); }
  .mapa-img.senala .et.fija:not(.on) { opacity: .35; } .et.fija.on { border-color: var(--ink); }
  .mapa-lista li { transition: background-color var(--t-fast, .12s); cursor: default; }
  .mapa-lista li.on .nom { color: var(--link); }
  /* El país sube: durante la secuencia se ve el cuadro y no el mapa final ni sus etiquetas. */
  .cuadro { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .cuadro[hidden] { display: none; }
  .mapa.sube .mapa-img > img:not(.cuadro), .mapa.sube .et, .mapa.sube .pt { opacity: 0; }
  .mapa.subio .mapa-img > img:not(.cuadro), .mapa.subio .et.fija { animation: mapa-entra .25s ease-out both; }
  .mapa.sube .barra i { transform: scaleX(0); } .mapa .barra i { transform-origin: left; }
  /* Las barras crecen al mismo paso que el país (1,6 s, misma curva). */
  .mapa.sube.crece .barra i { transform: scaleX(1); transition: transform 1.6s ease-in-out; }
  @keyframes mapa-entra { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .pt::after, .et.fija, .mapa-lista li { transition: none; } }
  .et { position: absolute; display: flex; flex-direction: column; gap: 1px; font-size: var(--fs-w-13); line-height: 1.25; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; pointer-events: none; padding: 4px 8px; border-radius: 8px; background: var(--bg-web); border: 1px solid var(--line); }
  .et b { font-weight: 800; color: var(--ink); }
  .et::before { content: ""; position: absolute; top: 0; width: 41px; height: 1px; background: var(--ink); opacity: .55; }
  .et::after { content: ""; position: absolute; top: -2.5px; width: 6px; height: 6px; border-radius: 50%; background: var(--ink); }
  .et.der { transform: translate(44px, -13px); text-align: left; }
  .et.der::before { left: -42px; top: 12px; } .et.der::after { left: -48px; top: 9.5px; }
  .et.izq { transform: translate(calc(-100% - 44px), -13px); text-align: right; align-items: flex-end; }
  .et.izq::before { right: -42px; top: 12px; } .et.izq::after { right: -48px; top: 9.5px; }

  @media (max-width: 1100px) {
    .mapa-in { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-top: 56px; }
    .mapa-img { order: -1; max-width: 720px; margin: 0 auto; }
  }
  @media (max-width: 760px) {
    .mapa-in { padding: 40px 20px 40px; }
    .et.fija { display: none; }
    p { font-size: var(--fs-w-16); }
  }
</style>
