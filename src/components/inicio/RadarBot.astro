---
/* El personaje del asistente (5-nov-2026). Fuente única en contradar-design/
   personaje/: el SVG y su hoja (estados, tokens, duraciones) llegan aquí por
   sync-tokens.sh a components/asistente/personaje/ y NO se editan.
   - El logo del menú NO lleva ojos: el personaje solo aparece como asistente.
   - Se mueve con transform: la cuña gira (CSS), las pupilas siguen el mouse,
     los ojos parpadean y los pies caminan (lib/radarBot.ts pone las variables).
   - Con prefers-reduced-motion queda quieto.
   `tono`: "auto" sigue el tema; "oscuro" es la versión para fondo tinta.
   `mira`: si las pupilas siguen el mouse. `estado`: ver personaje.css. */
import svg from "../asistente/personaje/personaje.svg?raw";
import "../asistente/personaje/personaje.css";

interface Props { tono?: "auto" | "oscuro"; mira?: boolean; class?: string; gira?: "lento" | "rapido" | "no"; estado?: "reposo" | "pensando" | "respondiendo" | "aviso" | "sin-conexion" }
const { tono = "auto", mira = false, class: clase = "", gira = "lento", estado = "reposo" } = Astro.props;
const attrs = `class="rb${clase ? " " + clase : ""}" data-tono="${tono}" data-gira="${gira}" data-estado="${estado}"${mira ? " data-mira" : ""}`;
const marcado = svg.replace(/^<!--[^\n]*-->\n/, "").trim().replace('class="rb"', attrs);
---

<Fragment set:html={marcado} />
