---
/* Portada · «El producto al frente» (14-nov-2026). John eligió en el lienzo de
   diseño la propuesta C, con los precios de «A con más fuerza» y el bloque del
   equipo de B. Reemplaza a Inicio2027.astro, que queda en el repo para volver.

   Orden: hero · la app (ejemplo) · el mapa y las cifras · el pliego en cuatro
   pasos · todo lo que hacemos (mosaico) · precios · equipo · preguntas · cierre.

   - Los textos son los de la portada anterior; no se reescribió ninguno. Lo
     único nuevo es la pantalla de ejemplo de la app, con una empresa inventada.
   - Nada de tarjetas iguales en fila de tres, números decorativos 01/02/03,
     rótulos en mayúscula sobre cada título ni velos sobre fotos: es lo que
     marcan los detectores de «hecho por IA» (Impeccable, Hallmark).
   - Imágenes: renders de Blender (scripts/hero/mezclas.py, escenas «hero» y
     «cierre») y el mapa de scripts/mapa/. */
import { CalendarDays } from "@lucide/astro";
import { diagnosticoUrl } from "../../consts";
import { CIFRAS, DESDE, DESCUENTO_ANUAL, PLANES, PRUEBA, busquedasDe, precioMes } from "../../data/producto";
import { FAQ_2027 } from "../../data/content";
import EntradaHero from "./EntradaHero.astro";
import MapaSecop from "./MapaSecop.astro";

const alertas = [
  ["92", "Mejoramiento de vías terciarias", "Timbío · cierra en 9 días", "$2.340 M", false],
  ["81", "Adecuación de la sede educativa", "Popayán · cierra en 4 días", "$612 M", true],
  ["77", "Construcción de puente vehicular", "Piendamó · cierra en 12 días", "$1.073 M", false],
] as const;
/* La app de ejemplo se recorre: cada módulo del menú abre su pantalla. */
const menuApp = [["inicio", "Inicio", ""], ["busquedas", "Búsquedas", "12"], ["competencia", "Competencia", ""], ["licitaciones", "Mis licitaciones", "3"], ["contratos", "Mis contratos", ""], ["calendario", "Calendario", ""]];
const formatos = [["Carta de presentación", "Lleno", "ok"], ["Compromiso anticorrupción", "Lleno", "ok"], ["Experiencia del proponente", "Lleno", "ok"], ["Capacidad residual (K)", "Lleno", "ok"], ["Indicadores financieros", "Lleno con tu RUP", "ok"], ["Certificado de seguridad social", "Falta la firma", "falta"], ["Oferta económica", "La llenas tú", "tu"]];
const capas = [["Licitaciones", "licitaciones"], ["Contratos", "contratos"], ["Pólizas", "polizas"], ["Internos", "internos"]];
const evMes: Record<number, [string, string]> = { 4: ["Cierre · Vías Timbío", "licitaciones"], 6: ["Reunión de equipo", "internos"], 11: ["Póliza vence", "polizas"], 13: ["Audiencia de riesgos", "licitaciones"], 18: ["Informe mensual", "contratos"], 20: ["Visita de obra", "internos"], 25: ["Cobro · acta 3", "contratos"] };
const cifras = [[CIFRAS.procesos, `procesos leídos desde ${DESDE}`], [CIFRAS.contratos, "contratos"], [CIFRAS.empresas, "proveedores perfilados"], [CIFRAS.entidades, "entidades"]];
/* Cada paso abre con su cifra: es un dato del ejemplo, no un número de orden. */
const pasos = [
  ["86", "páginas", "Leemos", "las 86 páginas.", "Un pliego de obra con documentos tipo trae hasta 25 documentos.", "Pliego, anexos y adendas. No tienes que abrir ningún PDF.", "/inteligencia/", "Cómo leemos el pliego", ""],
  ["5", "requisitos", "Marcamos", "lo que pide.", "Experiencia, K residual, indicadores y garantía, en un solo lugar.", "Cada requisito con su página, para que lo verifiques.", "/inteligencia/", "Qué requisitos marcamos", ""],
  ["RUP", "y tu experiencia en SECOP", "Te decimos si", "cumples o te falta.", "La garantía de seriedad no se puede subsanar después del cierre. Te avisamos antes.", "Lo cruzamos con tu experiencia en SECOP y con tu RUP.", "/herramientas/calculadora-capacidad-residual/", "Calcula tu capacidad residual", "aviso"],
  ["12 de 15", "formatos", "Llenamos", "tus formatos.", "12 de 15 formatos listos con tus datos. Tú revisas y firmas.", "Con los datos de tu empresa, en el formato de la entidad.", "/inteligencia/", "Cómo llenamos los formatos", "tinta"],
] as const;
const rivales = [["Constructora M.", "8 / 3", 100], ["Consorcio Vías D.", "6 / 2", 75], ["Ingeniería Vertex", "5 / 1", 62]] as const;
const ev: Record<number, string> = { 4: "licitaciones", 6: "internos", 11: "polizas", 13: "licitaciones" };
const COP = (n: number) => `$${n.toLocaleString("es-CO")}`;
const PARA = ["Para no perderte ninguna.", "Para ofertar con datos.", "Para equipos grandes y consorcios."];
const planes = PLANES.map((p, i) => ({
  p, para: PARA[i], reco: i === 1,
  inc: [
    `${p.usuarios} ${p.usuarios === 1 ? "usuario" : "usuarios"}`,
    busquedasDe(p).replace(/^./, (c) => c.toUpperCase()),
    `${p.pliegosMes} pliegos resumidos con IA al mes`,
    `${p.propuestasMes} ${p.propuestasMes === 1 ? "propuesta" : "propuestas"} con formatos llenos al mes`,
  ],
}));
const equipo = [
  ["john-chamorro", "John Chamorro", "Fundador", "Magíster en Automatización"],
  ["jairo-marin", "Jairo Marín", "Análisis de datos", "PhD (c) en Ciencias de la Electrónica"],
  ["jaderd-dorado", "Jaderd Dorado", "Especialista en obra pública", "Ingeniero civil"],
  ["alejandra-viveros", "Alejandra Viveros", "Relación con clientes", ""],
];
const envioNit = (origen: string) => `event.preventDefault(); const n=this.nit.value.replace(/\\D/g,'').slice(0,10); const e=this.querySelector('.err'); if(n.length>=6){ e.textContent=''; const u=(window.crConOrigen||String)('${diagnosticoUrl("home", origen)}&nit='+n); window.dispatchEvent(new CustomEvent('cr:evento',{detail:{nombre:'diagnostico_iniciado',datos:{origen:'${origen}'}}})); window.dispatchEvent(new CustomEvent('cr:evento',{detail:{nombre:'web_nit_enviado',datos:{origen:'${origen}'}}})); setTimeout(function(){window.location.href=u;}, window.umami?250:0); } else { e.textContent='Escribe al menos 6 dígitos, sin puntos ni guiones.'; this.nit.focus(); }`;
---

<div class="ip">
  {/* ── 1. Hero ── la imagen aprobada; debajo asoma la app. */}
  <section class="heroz" id="diagnostico" aria-labelledby="hero-t">
    <EntradaHero />
    <div data-hero-revela>
      <div class="hero-foto" aria-hidden="true">
        <img src="/hero/hero-puente-2560.webp" srcset="/hero/hero-puente-1280.webp 1280w, /hero/hero-puente-2560.webp 2560w" sizes="100vw" width="2560" height="1440" alt="" fetchpriority="high" />
      </div>
      <div class="hero-in">
        <div class="hero-tx">
          <h1 id="hero-t"><span class="fino">Licitar a mano y a ciegas</span> <span class="fuerte">se acabó.</span></h1>
          <p>ContRadar te trae las licitaciones que te sirven, lee el pliego, llena los formatos con tus datos y te muestra quién compite y a qué precio.</p>
          <form class="nit" onsubmit={envioNit("hero")}>
            <label>
              <span>NIT de tu empresa</span>
              <input name="nit" inputmode="numeric" required autocomplete="off" spellcheck="false" placeholder="901234567" maxlength="13" aria-label="NIT de tu empresa o cédula" />
            </label>
            <button type="submit" class="pildora">Ver mi diagnóstico<i aria-hidden="true">→</i></button>
            <small class="err" aria-live="polite"></small>
          </form>
          <span class="gratis">Gratis y sin registro</span>
          <div class="demo-hero">
            <span>¿Prefieres verlo con nosotros?</span>
            <a href="/demo/" class="demo-btn" data-cta="demo" data-ubicacion="hero">
              <CalendarDays size={18} stroke-width={1.8} aria-hidden="true" />
              Agenda una demo de 20 min
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── 2. La app, montada sobre el borde del hero. Es un ejemplo y lo dice. ── */}
  <section class="app" aria-labelledby="app-t">
    <div class="marco">
      <h2 class="sr-only" id="app-t">Recorre ContRadar con un ejemplo</h2>
      <div class="app-caja" data-app>
        <div class="app-menu" role="tablist" aria-label="Módulos de ContRadar" aria-orientation="vertical">
          <b class="app-logo" aria-hidden="true">Cont<span>Radar</span></b>
          {menuApp.map(([id, t, n], i) => <button type="button" role="tab" id={`app-tab-${id}`} aria-controls={`app-p-${id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-app-tab={id}>{t}{n && <i class="m" aria-hidden="true">{n}</i>}</button>)}
        </div>
        <div class="app-cuerpo">
          <div class="app-panel" role="tabpanel" id="app-p-inicio" aria-labelledby="app-tab-inicio" tabindex="0">
            <div class="app-cab"><b>Buenos días, Cordillera del Sur</b><span class="app-ia"><i></i>Pregúntale a ContRadar</span></div>
            <div class="w suave"><b class="w-t">Para hoy</b><span class="m hoy">3</span><span class="w-s">licitaciones nuevas que se parecen a lo que vendes</span></div>
            <div class="w dos">
              <b class="w-t">Te llegaron esta mañana</b>
              {alertas.map(([e, t, s, v, pronto]) => (
                <div class="fila"><span class="m enc">{e}</span><span class="tx"><b>{t}</b><span class={pronto ? "pronto" : ""}>{s}</span></span><span class="m val">{v}</span></div>
              ))}
            </div>
            <div class="w tinta dos">
              <b class="w-t">El pliego, resumido</b>
              <span class="w-s">Vías terciarias, Timbío · 79 de 86 páginas</span>
              <span class="pista"><i style="width:92%"></i></span>
              <div class="par"><div><span class="m">0/5</span><span class="w-s">Requisitos</span></div><div><span class="m">0/15</span><span class="w-s">Formatos</span></div></div>
            </div>
            <div class="w"><b class="w-t">Formatos</b><span class="m c34">12 de 15</span><span class="pista"><i style="width:80%"></i></span><span class="w-s aviso">Falta la firma en 1</span></div>
          </div>

          <div class="app-panel" role="tabpanel" id="app-p-busquedas" aria-labelledby="app-tab-busquedas" tabindex="0" hidden>
            <div class="app-cab"><b>Búsquedas</b><a class="mas-l" href="/producto/busquedas/">Ver cómo funcionan las búsquedas<span aria-hidden="true">→</span></a></div>
            <div class="w dos alto">
              <b class="w-t">Te llegaron esta mañana</b>
              {alertas.map(([e, t, s, v, pronto]) => (
                <div class="fila g"><span class="m enc">{e}</span><span class="tx"><b>{t}</b><span class={pronto ? "pronto" : ""}>{s}</span></span><span class="m val">{v}</span></div>
              ))}
            </div>
            <div class="w suave"><b class="w-t">Abres el correo. Ya están ahí.</b><span class="w-s">Cada mañana, solo las licitaciones que se parecen a lo que vendes, ordenadas por encaje.</span><a class="mas-l abajo" href="/producto/notificaciones/">Cómo y cuándo te llegan los avisos<span aria-hidden="true">→</span></a></div>
          </div>

          <div class="app-panel" role="tabpanel" id="app-p-competencia" aria-labelledby="app-tab-competencia" tabindex="0" hidden>
            <div class="app-cab"><b>Competencia</b><a class="mas-l" href="/producto/analisis-de-competencia/">Análisis de competencia<span aria-hidden="true">→</span></a></div>
            <div class="w tinta dos alto">
              <b class="w-t">Quién compite.</b>
              {rivales.map(([n, v, w]) => <span class="riv"><span class="fl"><b>{n}</b><span class="m">{v}</span></span><span class="pista"><i style={`width:${w}%`}></i></span></span>)}
              <span class="w-s abajo">Se presentó / ganó, en esta entidad</span>
            </div>
            <div class="pila">
              <div class="w"><b class="w-t">Cuánto ofertan los que ganan.</b><span class="m c34">95 % – 97 %</span><span class="w-s">del presupuesto, en esta entidad</span></div>
              <div class="w"><b class="w-t">Cuándo te pagan.</b><span class="m c34">47 días</span><span class="w-s">para pagar el 90 % de lo facturado, según sus contratos anteriores</span></div>
            </div>
          </div>

          <div class="app-panel" role="tabpanel" id="app-p-licitaciones" aria-labelledby="app-tab-licitaciones" tabindex="0" hidden>
            <div class="app-cab"><b>Mis licitaciones</b><a class="mas-l" href="/producto/mis-licitaciones/">Ver cómo funciona<span aria-hidden="true">→</span></a></div>
            <div class="w dos alto">
              <span class="w-cab"><b class="w-t">Formatos del pliego · Timbío</b><span class="m">12 de 15</span></span>
              <span class="pista"><i style="width:80%"></i></span>
              {formatos.map(([n, e, k]) => <div class="fila f"><span class="tx"><b>{n}</b></span><span class={`est ${k}`}>{e}</span></div>)}
            </div>
            <div class="pila">
              <div class="w"><b class="w-t">Cada uno sabe qué le toca.</b>
                <div class="fila f"><span class="tx"><b>Visita de obra · Juan</b></span><span class="est">14 nov</span></div>
                <div class="fila f"><span class="tx"><b>Formatos · Ana</b></span><span class="est ok">listo</span></div>
                <div class="fila f"><span class="tx"><b>Póliza · Luis</b></span><span class="est falta">vie</span></div>
              </div>
              <div class="w tinta"><b class="w-t">Si cambia el pliego, te enteras.</b><span class="w-s">Adenda 2</span><span>Cierre: 7 nov → 28 nov</span><span>Experiencia: 3 → 2 contratos</span></div>
            </div>
          </div>

          <div class="app-panel" role="tabpanel" id="app-p-contratos" aria-labelledby="app-tab-contratos" tabindex="0" hidden>
            <div class="app-cab"><b>Mis contratos</b><a class="mas-l" href="/producto/mis-contratos/">Ver cómo funciona<span aria-hidden="true">→</span></a></div>
            <div class="w dos alto">
              <span class="w-cab"><b class="w-t">Ejecución · Timbío</b><span class="m">día 52 de 121</span></span>
              <span class="pista jade"><i style="width:43%"></i></span>
              <div class="fila f"><span class="tx"><b>Póliza vence</b></span><span class="est falta">11 nov</span></div>
              <div class="fila f"><span class="tx"><b>Informe mensual</b></span><span class="est">18 nov</span></div>
              <div class="fila f"><span class="tx"><b>Cobro · acta 3</b></span><span class="est">25 nov</span></div>
            </div>
            <div class="w suave"><b class="w-t">Del acta a la liquidación.</b><span class="w-s">Pólizas, informes, cobros y plazos de ley, con aviso antes de que venzan.</span></div>
          </div>

          <div class="app-panel" role="tabpanel" id="app-p-calendario" aria-labelledby="app-tab-calendario" tabindex="0" hidden>
            <div class="app-cab"><b>Noviembre</b><span class="capas">{capas.map(([t, c]) => <span><i class={c}></i>{t}</span>)}</span></div>
            <div class="w mes">
              <div class="mes-g">
                {Array.from({ length: 28 }, (_, i) => i + 1).map((n) => (
                  <div class={n === 4 ? "hoy" : ""}><span class="m">{n}</span>{evMes[n] && <span class={`e ${evMes[n][1]}`}>{evMes[n][0]}</span>}</div>
                ))}
              </div>
              <a class="mas-l" href="/producto/calendario/">Ver cómo funciona el calendario<span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </div>
      <p class="pie-ej">Pantalla de ejemplo, con una empresa inventada. Toca un módulo para recorrerla.</p>
    </div>
  </section>

  {/* ── 3. El mapa (aprobado, intacto) y las cifras de lo que leemos. ── */}
  <MapaSecop />
  <section class="fuerza" aria-label="Lo que leemos del SECOP">
    <div class="marco cifras">
      {cifras.map(([v, k], i) => <div class={i === 0 ? "w tinta" : "w"}><span class="m c52">{v}</span><span class="w-s">{k}</span></div>)}
    </div>
  </section>

  {/* ── 4. El pliego, en cuatro pasos. ── */}
  <section class="sec" id="asi-funciona" aria-labelledby="asi-t">
    <div class="marco">
      <div class="cab">
        <h2 id="asi-t"><span class="fino">86 páginas,</span><br /><span class="fuerte">leídas en 40 segundos.</span></h2>
        <p>ContRadar abre el pliego y sus anexos, marca lo que pide y te dice si puedes presentarte. Este es un ejemplo con un proceso de vías terciarias.</p>
      </div>
      <ol class="pasos">
        {pasos.map(([num, cap, t1, t2, dolor, d, href, mas, tono]) => (
          <li class={`w ${tono}`}>
            <span class="m c46">{num}</span>
            <span class="w-s">{cap}</span>
            <h3><span class="fino">{t1}</span> <span class="fuerte">{t2}</span></h3>
            <p class="dolor">{dolor}</p>
            <p>{d}</p>
            <a class="mas-l" href={href}>{mas}<span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ol>
      <div class="acc">
        <a href="#solicitar" class="pildora" data-formatos-cta>Llenar mis formatos<i aria-hidden="true">→</i></a>
        <span class="w-s">{PRUEBA.dias} días gratis · sin tarjeta</span>
      </div>
    </div>
  </section>

  {/* ── 5. Inteligencia y todo lo demás: mosaico en tinta, piezas desiguales. ── */}
  <section class="sec noche" id="inteligencia" aria-labelledby="int-t">
    <div class="marco">
      <div class="cab">
        <h2 id="int-t"><span class="fino">Antes de ofertar,</span><br /><span class="fuerte">sabes contra quién vas.</span></h2>
        <p>Radar, el asistente de ContRadar, cruza cada proceso con el historial del SECOP desde {DESDE}. <a href="/inteligencia/">Ver cómo funciona<span aria-hidden="true">→</span></a></p>
      </div>
      <div class="mosaico">
        <a class="mz dos" href="/producto/analisis-de-competencia/">
          <span class="mz-cab"><b class="g">Quién compite.</b><span class="ej">Ejemplo</span></span>
          <span class="mz-s">Las empresas que se presentan en esa entidad, cuántas veces y cuántas ganan.</span>
          {rivales.map(([n, v, w]) => <span class="riv"><span class="fl"><b>{n}</b><span class="m">{v}</span></span><span class="pista"><i style={`width:${w}%`}></i></span></span>)}
        </a>
        <a class="mz claro" href="/producto/estadistica-de-la-licitacion/"><b>Cuánto ofertan los que ganan.</b><span class="mz-s">El rango de las ofertas ganadoras frente al presupuesto.</span><span class="m c46 abajo">95–97 %</span><span class="mz-n">del presupuesto · ejemplo</span></a>
        <a class="mz blanco" href="/producto/estadistica-de-la-licitacion/"><b>Cuándo te pagan.</b><span class="mz-s">Los días que tarda cada entidad en pagar el 90 % de lo facturado.</span><span class="m c46 abajo">47 días</span><span class="mz-n">en promedio · ejemplo</span></a>
        <a class="mz" href="/producto/notificaciones/"><b>Si cambia el pliego, te enteras.</b><span class="mz-s">Te avisamos de cada adenda con el antes y el después. El resumen se actualiza solo.</span>
          <span class="lista abajo"><span><span>Cierre: 7 nov → 28 nov</span><span class="mz-n">Adenda 2</span></span><span><span>Experiencia: 3 → 2 contratos</span><span class="mz-n">Adenda 2</span></span></span></a>
        <a class="mz" href="/producto/mis-licitaciones/"><b>Cada uno sabe qué le toca.</b><span class="mz-s">Asignas licitaciones y tareas, comentas con @menciones y ves quién tiene qué.</span>
          <span class="lista abajo"><span><span>Visita de obra · Juan</span><span class="mz-n">14 nov</span></span><span><span>Formatos · Ana</span><span class="listo">listo</span></span><span><span>Póliza · Luis</span><span class="tiempo">vie</span></span></span></a>
        <a class="mz blanco dos cal" href="/producto/calendario/">
          <span class="cal-tx"><b>Cierres, pólizas y reuniones.</b><span class="mz-s">Lo del SECOP entra solo y tú agregas lo interno.</span><span class="mas-l abajo">Ver cómo funciona<span aria-hidden="true">→</span></span></span>
          <span class="cal-g" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => i + 1).map((n) => <span class={n === 4 ? "hoy" : ""}><i class="m">{n}</i>{ev[n] && <i class={`e ${ev[n]}`}></i>}</span>)}</span>
        </a>
        <a class="mz dos" href="/producto/mis-contratos/"><b>Del acta a la liquidación.</b><span class="mz-s">Pólizas, informes, cobros y plazos de ley, con aviso antes de que venzan.</span>
          <span class="riv abajo"><span class="fl"><span>Ejecución · Timbío</span><span class="m mz-n">día 52 de 121</span></span><span class="pista jade"><i style="width:43%"></i></span></span></a>
        <a class="mz" href="/producto/analisis-de-competencia/"><b>Conoce a tus rivales.</b><span class="mz-s">Qué gana cada empresa, dónde, con quién se asocia y cuánto oferta.</span><span class="mas-l abajo">Ver más<span aria-hidden="true">→</span></span></a>
        <a class="mz" href="/funcionalidades/"><b>Para decidir con datos.</b><span class="mz-s">Mercado, precios de adjudicación, consorcios y tu operación, en Excel o PDF.</span><span class="mas-l abajo">Ver más<span aria-hidden="true">→</span></span></a>
      </div>
    </div>
  </section>

  {/* ── 6. Precios ── tres columnas con línea; solo el recomendado en tinta. */}
  <section class="sec blanca" id="precios" data-pago="anual" aria-labelledby="pre-t">
    <div class="marco">
      <div class="cab">
        <h2 id="pre-t"><span class="fino">{PRUEBA.dias} días gratis.</span><br /><span class="fuerte">Después, eliges.</span></h2>
        <div class="pago" role="group" aria-label="Forma de pago">
          <button type="button" aria-pressed="false" data-pago-btn="mensual">Mensual</button>
          <button type="button" aria-pressed="true" data-pago-btn="anual">Anual · {DESCUENTO_ANUAL} % menos</button>
        </div>
      </div>
      <div class="planes">
        {planes.map(({ p, para, reco, inc }) => (
          <div class={`plan${reco ? " reco" : ""}`}>
            <div class="pn"><b>{p.nombre}</b>{reco && <span class="tag">Recomendado</span>}</div>
            <div class="pp mensual"><span class="m c52">{COP(precioMes(p, "mensual"))}</span><span class="per">al mes</span></div>
