  a.mas-l:hover { text-decoration: underline; text-underline-offset: 3px; }
  .sec { padding: var(--sec-y) 0; }
  .sec.blanca { background: var(--bg-web); }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 64px; margin-bottom: 48px; }
  .cab p, .est-p, .mz-s, details p { text-wrap: pretty; }
  .cab p { margin: 0; max-width: 46ch; font-size: var(--fs-w-18); line-height: 1.5; color: var(--muted); }
  .cab p a { color: var(--link); font-weight: 700; text-decoration: none; white-space: nowrap; }

  /* Widget: una superficie, línea de 1 px, sin sombra y sin caja dentro. */
  .w { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-widget); padding: 24px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .w.suave { background: var(--soft); }
  .w.tinta { background: var(--panel-ink); border-color: var(--panel-ink); color: var(--on-action); }
  .w.aviso { background: var(--warn-bg); }
  .w-t { font-size: var(--fs-w-15); font-weight: 800; }
  .w-s { font-size: var(--fs-w-14); color: var(--muted); }
  .w.tinta .w-s { color: var(--panel-muted); }
  .pista { display: block; height: 6px; border-radius: 3px; background: var(--surface-2); overflow: hidden; }
  .pista i { display: block; height: 100%; border-radius: 3px; background: var(--action); }
  .w.tinta .pista, .noche .pista { background: var(--panel-track); }
  .w.tinta .pista i, .noche .pista i { background: var(--panel-link); }
  .noche .pista.jade i { background: var(--jade-claro); }

  /* ── Hero: bloque tinta en los dos temas (la imagen es de noche). ── */
  /* -77 y no -76: la cabecera mide 76 + 1 px de borde (transparente en la
     portada); con -76 asomaba una línea blanca arriba del hero (14-nov-2026). */
  .heroz { position: relative; overflow: hidden; margin-top: -77px; background: var(--panel-ink); color: var(--on-action);
    --bg-web: var(--panel-ink); --ink: var(--on-action); --muted: var(--panel-muted); --action: var(--panel-link); --link: var(--panel-link);
    --soft: var(--panel-chip); --web-boton: var(--on-action); --web-boton-tx: var(--panel-ink); --alert: var(--ambar-claro);
    --logo-cont: var(--logo-cont-oscuro); --logo-radar: var(--logo-radar-oscuro); }
  /* El hero ocupa la primera pantalla entera y «No es un video» empieza en el
     doblez (John, 14-nov-2026: «muy lleno, le hace falta espacio para respirar»).
     Antes medía 60svh y en 1920×950 la app ya asomaba con su título a 700 px.
     Relleno, separaciones y titular se escalan con el ALTO de la ventana: en
     1366×768 se aprietan sin cortarse y en 1920×1080 respiran. Tope de 1080 px
     para que en un monitor vertical no quede un hueco tinta sin fin. */
  /* «Cordillera» (15-nov-2026). La caja guarda la proporción de la foto (2560×1463):
     así la palabra cae siempre detrás de las cumbres, en cualquier ancho. */
  .hero-caja { position: relative; width: 100%; aspect-ratio: 2560 / 1463; }
  .hero-capa { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-palabra { position: absolute; left: 0; right: 0; top: 21%; text-align: center; font-size: 17.5vw; font-weight: 800; letter-spacing: -.055em; line-height: .8; color: color-mix(in srgb, var(--on-action) 82%, transparent); white-space: nowrap; user-select: none; }
  /* Velo arriba (el menú) y abajo (el texto); encima de las tres capas. */
  .hero-caja::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, color-mix(in srgb, var(--panel-ink) 55%, transparent) 0%, transparent 18%, transparent 52%, color-mix(in srgb, var(--panel-ink) 70%, transparent) 76%, var(--panel-ink) 100%); }
  .hero-in { --hg: 20px; position: absolute; left: 0; right: 0; bottom: 0; max-width: 1440px; margin: 0 auto; padding: 0 var(--pad-v3) clamp(36px, 6vh, 72px); box-sizing: border-box; }
  .hero-tx { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr); gap: 32px 48px; align-items: end; }
  .hero-a, .hero-b { display: flex; flex-direction: column; gap: var(--hg); min-width: 0; }
  h1 { margin: 0; font-size: var(--h1-v3); line-height: 1.02; letter-spacing: -.045em; text-wrap: balance; }
  .heroz h1 { font-size: clamp(2.5rem, 4.1vw, 4rem); }
  .hero-tx p { margin: 0; font-size: var(--fs-w-17); line-height: 1.5; color: var(--on-action-2); max-width: 44ch; }
  .gratis { font-size: var(--fs-w-14); color: var(--muted); margin-top: -10px; }
  .hero-a .gratis { margin-top: -10px; }
  /* La licitación de ejemplo en vidrio esmerilado: lo único que flota sobre la foto. */
  .hero-lic { position: relative; padding: 12px; border-radius: var(--radius-widget); background: color-mix(in srgb, var(--panel-ink) 48%, transparent); border: 1px solid color-mix(in srgb, var(--on-action) 20%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
  .hl-foto img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9.5; object-fit: cover; border-radius: var(--radius-celda); }
  .hl-item { display: flex; flex-direction: column; gap: 2px; padding: 12px 6px 0; }
  .hl-item[hidden] { display: none; }
  .hl-item b { font-size: var(--fs-w-15); font-weight: 700; line-height: 1.3; }
  .hl-s { font-size: var(--fs-w-13); color: var(--muted); }
  .hl-enc { position: absolute; left: 22px; top: 22px; padding: 2px 10px; border-radius: var(--radius-pill); background: var(--on-action); color: var(--panel-ink); font-size: var(--fs-w-14); }
  .hl-paso { display: flex; align-items: center; gap: 12px; padding: 12px 6px 4px; font-size: var(--fs-w-12); color: var(--muted); }
  .hl-barra { flex: 1; height: 3px; border-radius: 3px; background: color-mix(in srgb, var(--on-action) 20%, transparent); overflow: hidden; }
  .hl-barra i { display: block; height: 100%; width: 33.4%; background: var(--on-action); border-radius: 3px; transition: transform .4s; }
  .hl-ej { font-weight: 700; }
  /* La demo es el camino secundario: más aire encima la separa del diagnóstico. */
  .demo-hero { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px; margin-top: clamp(4px, 2.2vh, 24px); font-size: var(--fs-w-15); color: var(--ink); }
  .demo-btn { min-height: 44px; padding: 0 18px; display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid var(--action); border-radius: var(--radius-pill); color: var(--action); font-size: var(--fs-w-15); font-weight: 700; text-decoration: none; white-space: nowrap; transition: background-color var(--t-fast, .12s); }
  .demo-btn:hover { background: var(--soft); }
  .demo-btn :global(svg) { flex-shrink: 0; width: 18px; height: 18px; }
  .demo-btn:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
  .nit { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .nit label { display: flex; flex-direction: column; gap: 4px; width: 220px; border-bottom: 2px solid var(--ink); padding-bottom: 6px; }
  .nit label:focus-within { border-bottom-color: var(--link); box-shadow: 0 2px 0 var(--link); }
  .nit label span { font-size: var(--fs-w-13); font-weight: 700; color: var(--muted); }
  .nit input { border: 0; outline: 0; background: transparent; font-family: var(--font-codigo); font-size: var(--fs-w-22); color: var(--ink); padding: 0; min-width: 0; width: 100%; }
  .nit input::placeholder { color: var(--muted); opacity: .7; }
  .nit .err { flex-basis: 100%; font-size: var(--fs-w-13); color: var(--alert); }
  .nit .err:empty { display: none; }
  .pildora { height: 52px; padding: 0 8px 0 24px; border-radius: var(--radius-pill); border: 0; background: var(--web-boton); color: var(--web-boton-tx); display: inline-flex; align-items: center; justify-content: space-between; gap: 16px; font-family: inherit; font-size: var(--fs-w-17); font-weight: 800; text-decoration: none; white-space: nowrap; cursor: pointer; }
  .pildora i { width: 38px; height: 38px; border-radius: var(--radius-pill); background: var(--capa-licitaciones); color: var(--on-action); display: flex; align-items: center; justify-content: center; font-style: normal; font-size: var(--fs-w-20); }
  .pildora:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }

  /* ── La app de ejemplo ── */
  .app { position: relative; overflow: hidden; padding: clamp(88px, 12vw, 160px) 0 88px; background: var(--panel-ink); }
  .app > .marco { position: relative; z-index: 2; }
  .app-fondo { position: absolute; inset: 0; }
  .app-fondo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .app-fondo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, var(--panel-ink) 0%, color-mix(in srgb, var(--panel-ink) 30%, transparent) 22%, color-mix(in srgb, var(--panel-ink) 20%, transparent) 45%, color-mix(in srgb, var(--panel-ink) 85%, transparent) 75%, var(--panel-ink) 100%); }
  .app-radar { position: absolute; right: 4%; top: 4%; width: min(52vw, 760px); aspect-ratio: 1; z-index: 1; }
  .app-radar i { position: absolute; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--panel-link) 38%, transparent); }
  .app-radar b { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, transparent 0deg, transparent 290deg, color-mix(in srgb, var(--panel-link) 42%, transparent) 360deg); animation: ip-barrido 9s linear infinite; mix-blend-mode: screen; }
  @keyframes ip-barrido { to { transform: rotate(360deg); } }
  .app-mk { min-height: 110px; padding: 0 8px 24px; box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 32px; color: var(--on-action); }
  .app-mk h2 { font-size: var(--fs-web-h2-b); }
  .app-mk p { margin: 0 0 6px; flex: 1 1 320px; max-width: 52ch; font-size: var(--fs-w-17); line-height: 1.5; color: var(--on-action-2); }
  .app-tour { margin: 0 0 4px auto; min-height: 44px; padding: 0 16px; display: inline-flex; align-items: center; gap: 10px; border: 1px solid var(--panel-borde); border-radius: var(--radius-pill); background: var(--panel-ink); color: var(--on-action); font: inherit; font-size: var(--fs-w-14); font-weight: 700; cursor: pointer; white-space: nowrap; }
  .app-tour[hidden] { display: none; }
  .app-tour i { width: 10px; height: 12px; border-left: 3px solid currentColor; border-right: 3px solid currentColor; box-sizing: border-box; }
  .app-tour[aria-pressed="false"] i { width: 0; height: 0; border: 6px solid transparent; border-left: 10px solid currentColor; border-right: 0; }
  .app-tour:focus-visible { outline: 2px solid var(--panel-link); outline-offset: 3px; }
  /* Lo que se puede tocar se ve tocable: el widget del Inicio lleva a su módulo. */
  button.w { font: inherit; color: inherit; text-align: left; cursor: pointer; transition: border-color var(--t-fast, .12s); }
  button.w.tinta { color: var(--on-action); }
  button.w:hover { border-color: var(--link); } button.w.tinta:hover { border-color: var(--panel-link); }
  button.w:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  .abre { margin-top: auto; padding-top: 8px; font-size: var(--fs-w-13); font-weight: 700; color: var(--link); }
  .w.tinta .abre { color: var(--panel-link); }
  /* Durante el recorrido, el módulo activo lleva una línea que se llena en 4 s. */
  .app-menu button { position: relative; overflow: hidden; }
  .app-caja.solo .app-menu button[aria-selected="true"]::after { content: ""; position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--link); transform-origin: left; animation: ip-llenar 4s linear both; }
  @keyframes ip-llenar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .app-caja { background: var(--surface-3); border: 1px solid var(--line); border-radius: var(--radius-shell); padding: 14px; display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 14px; }
  .app-menu { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-shell); padding: 20px 12px; display: flex; flex-direction: column; gap: 4px; font-size: var(--fs-w-15); font-weight: 700; }
  .app-logo { padding: 0 12px 14px; font-size: var(--fs-w-18); font-weight: 800; } .app-logo span { color: var(--logo-radar); }
  .app-menu button { min-height: 44px; padding: 0 12px; border: 0; border-radius: var(--radius-celda); background: transparent; color: var(--ink); font: inherit; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: 8px; cursor: pointer; white-space: nowrap; transition: background-color var(--t-fast, .12s); }
  .app-menu button:hover { background: var(--surface-3); }
  .app-menu button[aria-selected="true"] { background: var(--soft); color: var(--link); }
  .app-menu button:focus-visible, .app-panel:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  .app-menu i { font-style: normal; font-size: var(--fs-w-13); color: var(--muted); }
  .app-cuerpo { min-width: 0; min-height: 500px; }
  .app-panel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; align-content: start; border-radius: var(--radius-celda); }
  .app-panel[hidden] { display: none; }
  .app-cab .mas-l { white-space: nowrap; }
  .w .abajo { margin-top: auto; }
  .w.alto { min-height: 380px; }
  .w-cab { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; } .w-cab .m { font-size: var(--fs-w-18); white-space: nowrap; }
  .pila { display: flex; flex-direction: column; gap: 14px; min-width: 0; } .pila .w { flex: 1; }
  .fila.g { padding: 16px 0 6px; } .fila.g .enc { font-size: var(--fs-w-34); min-width: 52px; } .fila.g .tx b { font-size: var(--fs-w-17); }
  .fila.f { padding-top: 9px; justify-content: space-between; } .fila.f .tx b { font-size: var(--fs-w-15); font-weight: 400; }
  .est { font-size: var(--fs-w-14); font-weight: 700; color: var(--muted); white-space: nowrap; }
  .est.ok { color: var(--jade-texto); } .est.falta { color: var(--ambar-texto); }
  .w .riv { display: flex; flex-direction: column; gap: 8px; padding-top: 8px; }
  .w .riv .fl { display: flex; justify-content: space-between; gap: 16px; font-size: var(--fs-w-17); }
  .w .riv .m { letter-spacing: 0; } .w .riv .pista { height: 8px; }
  .w .pista.jade i { background: var(--capa-contratos); }
  .capas { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: var(--fs-w-13); color: var(--muted); }
  .capas span { display: inline-flex; align-items: center; gap: 6px; } .capas i { width: 10px; height: 10px; border-radius: 3px; }
  .w.mes { grid-column: 1 / -1; gap: 16px; }
  .mes-g { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
  .mes-g > div { min-height: 74px; padding: 6px; box-sizing: border-box; border-radius: var(--radius-celda); background: var(--surface-3); display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .mes-g > div.hoy { background: var(--soft); outline: 2px solid var(--link); outline-offset: -2px; }
  .mes-g .m { font-size: var(--fs-w-12); color: var(--muted); letter-spacing: 0; }
  .mes-g .e { font-size: var(--fs-w-11); font-weight: 700; line-height: 1.25; padding: 3px 5px; border-radius: 6px; overflow: hidden; }
  .licitaciones { background: var(--capa-licitaciones); color: var(--capa-licitaciones-tx); } .contratos { background: var(--capa-contratos); color: var(--capa-contratos-tx); }
  .polizas { background: var(--capa-polizas); color: var(--capa-polizas-tx); } .internos { background: var(--capa-internos); color: var(--on-action); }
  .app-cab { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 6px 8px; }
  .app-cab b { font-size: var(--fs-w-24); font-weight: 800; letter-spacing: -.025em; }
  .app-ia { height: 40px; padding: 0 18px; display: inline-flex; align-items: center; gap: 8px; background: var(--panel-ink); color: var(--on-action); border-radius: var(--radius-pill); font-size: var(--fs-w-14); font-weight: 800; }
  .app-ia i { width: 8px; height: 8px; border-radius: 50%; background: var(--jade-claro); }
  .w.dos { grid-column: span 2; }
  .hoy { font-size: var(--fs-w-hoy); line-height: 1; }
  .fila { display: flex; align-items: center; gap: 14px; padding-top: 10px; border-top: 1px solid var(--line-soft); }
  .fila .enc { font-size: var(--fs-w-22); min-width: 32px; }
  .fila .tx { flex: 1; min-width: 0; display: flex; flex-direction: column; font-size: var(--fs-w-13); color: var(--muted); }
  .fila .tx b { font-size: var(--fs-w-15); color: var(--ink); }
  .fila .pronto, .w-s.aviso { color: var(--ambar-texto); font-weight: 700; }
  .fila .val { font-size: var(--fs-w-14); white-space: nowrap; }
  .par { display: flex; padding-top: 6px; }
  .par > * { flex: 1; display: flex; flex-direction: column; } .par > * + * { padding-left: 20px; border-left: 1px solid var(--panel-line); }
  .par .m { font-size: var(--fs-w-28); }
  .pie-ej { margin: 14px 8px 0; font-size: var(--fs-w-13); color: var(--muted); }

  /* ── Cifras ── */
  .fuerza { padding: 56px 0 0; }
  .cifras { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .cifras .pie-ej { grid-column: 1 / -1; margin: 0; }
  .pie-ej .mas-l { margin-left: 8px; white-space: nowrap; }
  .cifras .w { padding: 28px; gap: 4px; } .cifras .w-s { font-size: var(--fs-w-15); }

  /* ── Las dos secciones que más pesan: la IA del pliego y los formatos ── */
  .estrella { padding: var(--sec-y) 0; background: var(--bg-web); }
  .est-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px 64px; align-items: center; }
  .est-tx { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .est-p { margin: 0; max-width: 46ch; font-size: var(--fs-w-20); line-height: 1.5; color: var(--muted); }
  .est-l { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .est-l li { padding: 20px 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .est-l h3 { margin: 0; font-size: var(--fs-w-28); line-height: 1.1; letter-spacing: -.03em; text-wrap: balance; }
  .est-l p { margin: 0; font-size: var(--fs-w-16); line-height: 1.5; color: var(--muted); }
  .est-l p b { color: var(--ink); }
  .acc { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; }
  .est-img { margin: 0; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .est-img img { display: block; width: 100%; height: auto; border-radius: var(--radius-tile); background: var(--surface-3); }
  figcaption { display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: var(--fs-w-14); color: var(--muted); }
  figcaption span { display: inline-flex; align-items: center; gap: 8px; } figcaption i { width: 18px; height: 8px; border-radius: 2px; }
  figcaption .ej { margin-left: auto; color: var(--muted); }
  /* El pliego: foto con las marcas de la IA encima, en vidrio claro (fijo en los dos
     temas: va sobre la foto, no sobre la página). */
  .pf-caja { position: relative; border-radius: var(--radius-tile); overflow: hidden; }
  .pliego-f .pf-caja img { border-radius: 0; aspect-ratio: 2560 / 1463; object-fit: cover; }
  .pf-marcas { list-style: none; margin: 0; padding: 0; }
  .pf-marcas li { position: absolute; display: flex; align-items: center; gap: 10px; padding: 10px 16px 10px 10px; border-radius: var(--radius-celda); background: color-mix(in srgb, var(--on-action) 84%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); color: var(--panel-ink); box-shadow: var(--sh-flota); font-size: var(--fs-w-13); white-space: nowrap; }
  .pf-marcas b { display: block; font-size: var(--fs-w-15); font-weight: 800; }
  .pf-marcas span { color: var(--panel-borde); }
  .pf-marcas i { width: 28px; height: 28px; flex-shrink: 0; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-weight: 800; font-size: var(--fs-w-14); }
  .pf-marcas .ok i { background: var(--capa-contratos); color: var(--capa-contratos-tx); }
  .pf-marcas .oj i { background: var(--capa-polizas); color: var(--capa-polizas-tx); }
  /* La ruta: la foto a todo el ancho con su proporción; texto arriba a la izquierda
     y las fases en vidrio a la derecha. Bloque oscuro en los dos temas. */
  .ruta { background: var(--panel-ink); color: var(--on-action);
    --ink: var(--on-action); --muted: var(--panel-muted); --link: var(--panel-link); --web-boton: var(--on-action); --web-boton-tx: var(--panel-ink); }
  .ruta-caja { position: relative; aspect-ratio: 2560 / 1463; min-height: 640px; overflow: hidden; }
  .ruta-foto, .ruta-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
