<script>
  document.querySelector("[data-formatos-cta]")?.addEventListener("click", () =>
    window.dispatchEvent(new CustomEvent("cr:evento", { detail: { nombre: "web_formatos_cta" } })));
  /* La app de ejemplo: pestañas. Clic o flechas cambian de módulo; no se mueve
     nada más (el cuerpo reserva su alto para que la página no salte). */
  const app = document.querySelector<HTMLElement>("[data-app]");
  if (app) {
    const tabs = [...app.querySelectorAll<HTMLButtonElement>("[data-app-tab]")];
    const abrir = (t: HTMLButtonElement, foco = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute("aria-selected", String(on)); x.tabIndex = on ? 0 : -1;
        const p = document.getElementById(x.getAttribute("aria-controls") || ""); if (p) p.hidden = !on;
      });
      if (foco) t.focus();
      if (!auto) window.dispatchEvent(new CustomEvent("cr:evento", { detail: { nombre: "web_app_ejemplo_modulo", datos: { modulo: t.dataset.appTab } } }));
    };
    /* Recorrido: mientras nadie lo toca, la app pasa sola de módulo cada 4 s para
       que se vea que está viva. El primer clic o tecla lo detiene para siempre;
       hay botón de pausa, se detiene fuera de pantalla y no existe con
       movimiento reducido. */
    let auto = false, reloj = 0, visto = false, tocado = false;
    const tour = document.querySelector<HTMLButtonElement>("[data-app-tour]");
    const txTour = tour?.querySelector<HTMLElement>("[data-app-tour-tx]");
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const parar = () => { clearInterval(reloj); reloj = 0; app.classList.remove("solo"); };
    const andar = () => {
      if (reloj || quieto || tocado || !visto || tour?.getAttribute("aria-pressed") === "false") return;
      app.classList.add("solo");
      reloj = window.setInterval(() => {
        const k = tabs.findIndex((x) => x.getAttribute("aria-selected") === "true");
        auto = true; abrir(tabs[(k + 1) % tabs.length]); auto = false;
      }, 4000);
    };
    const soltar = () => { if (tocado) return; tocado = true; parar(); if (tour) tour.hidden = true; };
    if (tour && !quieto) {
      tour.hidden = false;
      tour.addEventListener("click", (e) => {
        e.stopPropagation();
        const on = tour.getAttribute("aria-pressed") === "true";
        tour.setAttribute("aria-pressed", String(!on)); if (txTour) txTour.textContent = on ? "Seguir el recorrido" : "Pausar el recorrido";
        on ? parar() : andar();
      });
      new IntersectionObserver(([e]) => { visto = e.isIntersecting; visto ? andar() : parar(); }, { threshold: 0.5 }).observe(app);
    }
    app.addEventListener("pointerdown", soltar); app.addEventListener("keydown", soltar);
    app.querySelectorAll<HTMLButtonElement>("[data-app-ir]").forEach((b) => b.addEventListener("click", () => {
      const t = tabs.find((x) => x.dataset.appTab === b.dataset.appIr); if (t) abrir(t, true);
    }));
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => abrir(t));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : e.key === "ArrowUp" || e.key === "ArrowLeft" ? -1 : 0;
        if (e.key === "Home") { e.preventDefault(); abrir(tabs[0], true); }
        else if (e.key === "End") { e.preventDefault(); abrir(tabs[tabs.length - 1], true); }
        else if (d) { e.preventDefault(); abrir(tabs[(i + d + tabs.length) % tabs.length], true); }
      });
    });
  }
  /* Hero: la licitación de ejemplo pasa sola entre tres cada 5 s (quieta con
     movimiento reducido o fuera de pantalla). */
  const lic = document.querySelector<HTMLElement>("[data-hero-lic]");
  if (lic && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const items = [...lic.querySelectorAll<HTMLElement>("[data-hl]")];
    const n = lic.querySelector<HTMLElement>("[data-hl-n]"), barra = lic.querySelector<HTMLElement>("[data-hl-barra]");
    let k = 0, reloj = 0;
    const paso = () => {
      items[k].hidden = true; k = (k + 1) % items.length; items[k].hidden = false;
      if (n) n.textContent = `${k + 1} de ${items.length}`;
      if (barra) barra.style.transform = `translateX(${k * 100}%)`;
    };
    new IntersectionObserver(([e]) => { clearInterval(reloj); if (e.isIntersecting) reloj = window.setInterval(paso, 5000); }).observe(lic);
  }
  /* «Pruébalo con tu NIT»: sube al campo del diagnóstico y lo deja listo. */
  document.querySelector("[data-asi-cta]")?.addEventListener("click", (ev) => {
    const campo = document.querySelector<HTMLInputElement>("#diagnostico input[name=nit]");
    if (!campo) return;
    ev.preventDefault();
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.getElementById("diagnostico")?.scrollIntoView({ behavior: quieto ? "auto" : "smooth" });
    setTimeout(() => campo.focus({ preventScroll: true }), quieto ? 0 : 600);
  });
  /* Precios: Mensual | Anual, con los precios publicados (data/producto). */
  const precios = document.querySelector<HTMLElement>("#precios");
  precios?.querySelectorAll<HTMLButtonElement>("[data-pago-btn]").forEach((b) => b.addEventListener("click", () => {
    precios.dataset.pago = b.dataset.pagoBtn;
    precios.querySelectorAll<HTMLButtonElement>("[data-pago-btn]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
  }));
</script>

