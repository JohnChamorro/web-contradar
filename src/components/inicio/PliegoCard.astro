---
/* La tarjeta del pliego (Web 2027 v3, handoff/web-2027-v3 §2). Un solo
   componente para el hero y «Así funciona». Es HTML y CSS: el estado inicial
   sale en el HTML (`progress`) y la animación la pinta pintarPliego()
   (lib/pliegoCard.ts) con la misma cuenta.

   - Es un EJEMPLO inventado: el chip «Ejemplo» va siempre. Si se cambia por un
     proceso real, sus requisitos tienen que coincidir con su pliego.
   - Compacta (celular): sola cuando la tarjeta mide menos de 520 px de ancho
     (container query), o forzada con `compact`.
   - Solo se animan transform y opacity. El contenido va aria-hidden y la caja
     lleva un resumen en aria-label. */
import { CASILLAS, FILAS, LINEAS, LLENABLES, PAGINAS, TEXTO_FORMATOS, estadoPliego } from "../../lib/pliegoCard";

interface Props { progress?: number; compact?: boolean; class?: string; id?: string }
const { progress = 1, compact = false, class: clase = "", id } = Astro.props;
const e = estadoPliego(progress);
---

<div class={`pc-caja ${clase}`} id={id} role="img" aria-label={`Ejemplo: ContRadar lee ${PAGINAS} páginas, marca ${FILAS.length} requisitos y llena ${LLENABLES} de ${CASILLAS} formatos`}>
  <div class={`pc${compact ? " compacta" : ""}`} data-pliego data-p={progress} aria-hidden="true">
    <div class="pc-cab">
      <span class="pc-ia">IA</span>
      <span class="pc-ej">Ejemplo</span>
      <span class="pc-tit">Mejoramiento de vías terciarias en Timbío, Cauca</span>
    </div>
    <div class="pc-cuerpo">
      <div class="pc-lectura">
        <div class="pc-pila">
          <span class="pc-capa c2"></span>
          <span class="pc-capa c1"></span>
          <div class="pc-hoja" style={e.giro ? `transform: perspective(600px) rotateY(${e.giro}deg)` : undefined}>
            {LINEAS.map((w, i) => <span class={`pc-linea${e.lineas[i] ? " on" : ""}`} style={`width:${w}`}></span>)}
          </div>
        </div>
        <div class="pc-cont">
          <span class="pc-num"><span class="pc-n">{e.pagina}</span><span class="de">/{PAGINAS}</span></span>
          <span class="pc-leyendo">{e.leyendo ? "leyendo…" : "páginas leídas"}</span>
        </div>
      </div>
      <div class="pc-pide">
        <span class="pc-rot">Lo que pide</span>
        {FILAS.map((f, i) => (
          <div class={`pc-fila${e.filas[i].ver ? " ver" : ""}${e.filas[i].chip ? " chip" : ""}`}>
            <span class="k">{f.k}</span>
            <span class="v">{f.v}</span>
            <span class={`pc-chip ${f.tono}`}>{f.chip}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="pc-fmt">
      <div class="pc-fmt-cab">
        <span class="t">Formatos</span>
        <span class="pc-fe">{TEXTO_FORMATOS[e.formatos]}</span>
        <span class="pc-fnum"><span class="pc-fn">{e.llenas}</span><span class="de"> de {CASILLAS}</span></span>
      </div>
      <div class="pc-barra"><i style={`transform: scaleX(${e.barra})`}></i></div>
      <div class="pc-casillas">
        {Array.from({ length: CASILLAS }, (_, i) => (
          i >= LLENABLES
            ? <span class="pc-casilla tu">Tú</span>
            : <span class={`pc-casilla${i < e.llenas ? " ok" : ""}`}><b>✓</b></span>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .pc-caja { container-type: inline-size; width: 100%; }
  .pc { --pc-rad: 28px; background: var(--panel-ink); color: var(--on-action); border-radius: var(--pc-rad); padding: 28px 30px; display: flex; flex-direction: column; gap: 20px; border: 1px solid var(--panel-ink); box-sizing: border-box; font-family: var(--font-body); }
  :global(:root[data-theme="dark"]) .pc { border-color: var(--panel-line); }
  .pc-cab { display: flex; align-items: flex-start; gap: 8px; flex-wrap: wrap; }
  .pc-ia { font-family: var(--font-codigo); font-size: var(--fs-w-12); font-weight: 600; padding: 4px 10px; border-radius: var(--radius-pill); background: var(--panel-chip); color: var(--azul-claro); }
  .pc-ej { font-size: var(--fs-w-12); font-weight: 800; padding: 3px 10px; border-radius: var(--radius-pill); border: 1px solid var(--panel-borde); color: var(--panel-claro); }
  .pc-tit { flex: 1 1 220px; font-size: var(--fs-w-17); line-height: 1.3; font-weight: 800; }

  .pc-cuerpo { display: flex; gap: 28px; }
  .pc-lectura { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; flex-shrink: 0; }
  .pc-pila { position: relative; width: 178px; height: 226px; flex-shrink: 0; }
  .pc-capa, .pc-hoja { position: absolute; width: 156px; height: 204px; border-radius: 8px; box-sizing: border-box; }
  .pc-capa.c2 { left: 20px; top: 20px; background: var(--panel-track); }
  .pc-capa.c1 { left: 10px; top: 10px; background: var(--panel-borde); }
  .pc-hoja { left: 0; top: 0; background: var(--panel-claro); padding: 16px 14px; display: flex; flex-direction: column; gap: 9px; transform-origin: left center; }
  .pc-linea { position: relative; height: 7px; border-radius: 4px; background: var(--panel-muted); opacity: .75; }
  .pc-linea::after { content: ""; position: absolute; inset: 0; border-radius: inherit; background: var(--azul-claro); opacity: 0; transition: opacity .3s; }
  .pc-linea.on { opacity: 1; } .pc-linea.on::after { opacity: 1; }
  .pc-cont { display: flex; flex-direction: column; gap: 2px; }
  .pc-num { font-family: var(--font-codigo); font-size: var(--fs-w-28); font-weight: 600; letter-spacing: -.02em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pc-num .de, .pc-fnum .de { color: var(--panel-muted); opacity: .7; }
  .pc-leyendo { font-size: var(--fs-w-13); color: var(--panel-muted); white-space: nowrap; }

  .pc-pide { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .pc-rot { font-size: var(--fs-w-13); font-weight: 700; color: var(--panel-muted); padding-bottom: 2px; }
  .pc-fila { position: relative; display: grid; grid-template-columns: minmax(0, 112px) minmax(0, 1fr) auto; align-items: center; column-gap: 12px; min-height: 48px; padding: 7px 12px; box-sizing: border-box; border-radius: 12px; opacity: .14; transform: translateY(8px); transition: opacity .35s, transform .35s; }
  .pc-fila::before { content: ""; position: absolute; inset: 0; border-radius: inherit; background: var(--panel-ink-2); opacity: 0; transition: opacity .3s; }
  .pc-fila.ver { opacity: 1; transform: none; } .pc-fila.ver::before { opacity: 1; }
  .pc-fila > * { position: relative; }
  .pc-fila .k { font-size: var(--fs-w-14); line-height: 1.3; font-weight: 800; }
  /* El valor puede ir en dos renglones: nada se corta. */
  .pc-fila .v { font-size: var(--fs-w-13); line-height: 1.35; color: var(--panel-claro); }
  .pc-chip { justify-self: end; font-size: var(--fs-w-12); font-weight: 800; padding: 4px 10px; border-radius: var(--radius-pill); white-space: nowrap; opacity: 0; transform: scale(.7); transition: opacity .3s, transform .3s; }
  .pc-fila.chip .pc-chip { opacity: 1; transform: none; }
  .pc-chip.ok { background: var(--jade-claro); color: var(--panel-ink); }
  .pc-chip.rup { background: var(--panel-borde); color: var(--on-action); }
  .pc-chip.falta { background: var(--ambar-claro); color: var(--panel-ink); }

  .pc-fmt { display: flex; flex-direction: column; gap: 10px; padding-top: 16px; border-top: 1px solid var(--panel-track); }
  .pc-fmt-cab { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .pc-fmt-cab .t { font-size: var(--fs-w-16); font-weight: 800; }
  .pc-fe { font-size: var(--fs-w-13); color: var(--panel-muted); }
  .pc-fnum { margin-left: auto; font-family: var(--font-codigo); font-size: var(--fs-w-24); font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pc-barra { height: 10px; border-radius: 5px; background: var(--panel-track); overflow: hidden; }
  .pc-barra i { display: block; height: 100%; border-radius: 5px; background: var(--jade-claro); transform-origin: left center; transition: transform .25s linear; }
  .pc-casillas { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .pc-casilla { position: relative; height: 30px; border-radius: 8px; border: 1px solid var(--panel-borde); box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: var(--fs-w-12); font-weight: 800; color: var(--panel-muted); }
  .pc-casilla::before { content: ""; position: absolute; inset: -1px; border-radius: inherit; background: var(--jade-claro); opacity: 0; transition: opacity .25s; }
  .pc-casilla b { position: relative; color: var(--panel-ink); opacity: 0; transition: opacity .25s; }
  .pc-casilla.ok::before, .pc-casilla.ok b { opacity: 1; }
  .pc-casilla.tu { border-style: dashed; border-color: var(--panel-muted); }

  /* Compacta: forzada o cuando la tarjeta mide menos de 520 px. */
  @container (max-width: 519.98px) {
    .pc { --pc-rad: 22px; padding: 20px 18px; gap: 16px; }
    .pc-tit { font-size: var(--fs-w-15); }
    .pc-cuerpo { flex-direction: column; gap: 16px; }
    .pc-lectura { flex-direction: row; align-items: center; }
    .pc-pila { width: 96px; height: 118px; }
    .pc-capa, .pc-hoja { width: 84px; height: 106px; }
    .pc-capa.c2 { left: 12px; top: 12px; } .pc-capa.c1 { left: 6px; top: 6px; }
    .pc-hoja { padding: 10px 9px; gap: 6px; }
    .pc-linea { height: 5px; } .pc-linea:nth-child(n+9) { display: none; }
    .pc-num { font-size: var(--fs-w-24); }
    .pc-fila { grid-template-columns: 104px minmax(0, 1fr) auto; column-gap: 10px; min-height: 44px; padding: 7px 10px; }
    .pc-fila .k { font-size: var(--fs-w-13); }
    .pc-casilla { height: 28px; }
    .pc-fnum { font-size: var(--fs-w-20); }
  }
  .pc.compacta { --pc-rad: 22px; padding: 20px 18px; gap: 16px; }
  .pc.compacta .pc-tit { font-size: var(--fs-w-15); }
  .pc.compacta .pc-cuerpo { flex-direction: column; gap: 16px; }
  .pc.compacta .pc-lectura { flex-direction: row; align-items: center; }
  .pc.compacta .pc-pila { width: 96px; height: 118px; }
  .pc.compacta :is(.pc-capa, .pc-hoja) { width: 84px; height: 106px; }
  .pc.compacta .pc-capa.c2 { left: 12px; top: 12px; } .pc.compacta .pc-capa.c1 { left: 6px; top: 6px; }
  .pc.compacta .pc-hoja { padding: 10px 9px; gap: 6px; }
  .pc.compacta .pc-linea { height: 5px; } .pc.compacta .pc-linea:nth-child(n+9) { display: none; }
  .pc.compacta .pc-fila { grid-template-columns: 104px minmax(0, 1fr) auto; column-gap: 10px; min-height: 44px; padding: 7px 10px; }
  .pc.compacta .pc-fila .k { font-size: var(--fs-w-13); }

  /* Muy angosta (320 px): etiqueta y chip arriba, el valor entero debajo. */
  @container (max-width: 359.98px) {
    .pc-fila { grid-template-columns: minmax(0, 1fr) auto; row-gap: 2px; }
    .pc-fila .v { grid-column: 1 / -1; grid-row: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc *, .pc *::before, .pc *::after { transition-duration: 1ms !important; }
  }
</style>
