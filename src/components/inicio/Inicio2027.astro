      <div class="velo">
        <span class="bt"><span class="fino">Hecho para quienes</span><br /><span class="fuerte">le venden al Estado.</span></span>
        <span class="bs">Constructoras, ingenierías, consultoras y proveedores. De 1 a 100 personas.</span>
      </div>
    </section>

    <section class="sec faq" id="faq" data-reveal>
      <div class="cab">
        <span class="ceja az">PREGUNTAS</span>
        <h2 class="b"><span class="fino">Lo que</span><br /><span class="fuerte">siempre preguntan.</span></h2>
      </div>
      <div class="lista">
        {FAQ_2027.map((f) => <details><summary>{f.q}<span class="mas" aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}
      </div>
    </section>

    {/* ── 7. Equipo ── */}
    <section class="sec" id="nosotros" data-reveal>
      <h2><span class="fino">Detrás de ContRadar,</span> <span class="fuerte">personas.</span></h2>
      <div class="cuatro-eq">
        {equipo.map(([f, n, r, s]) => (
          <div>
            <img src={`/equipo/${f}.webp`} alt={`${n}, ${r.toLowerCase()} de ContRadar`} width="320" height="280" loading="lazy" decoding="async" />
            <b>{n}</b><span class="rol">{r}</span>{s && <span class="mut s14">{s}</span>}
