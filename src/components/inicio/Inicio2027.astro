---
/* Portada · Web 2027 v3 (4-nov-2026, handoff/web-2027-v3). Reemplaza el hero y el
   orden del paquete web-y-app-2027 §7; tokens, tema oscuro, radar, logo y fotos
   siguen igual.

   Orden: hero · Así funciona · Inteligencia · Alertas · Gestión · Precios · lo que
   ya tenía la web (hechos, módulos, calendario, etapas, chat, perfiles, banda y
   preguntas) · Equipo · Cierre. Qué quedó dónde: docs/web-2027-v3.md.

   La tarjeta del pliego es la misma en el hero y en «Así funciona»
   (PliegoCard.astro + lib/pliegoCard.ts). Las cifras de Inteligencia y Alertas
   son de ejemplo y lo dicen. Precios y prueba salen de data/producto. */
import { diagnosticoUrl, whatsappLink } from "../../consts";
import { DESCUENTO_ANUAL, PLANES, PRUEBA, busquedasDe, precioMes } from "../../data/producto";
import { FAQ_2027 } from "../../data/content";
import PliegoCard from "./PliegoCard.astro";
import EscenaAsi from "./EscenaAsi.astro";

/* Cada paso: número, título en dos pesos, la línea de dolor (John, 4-nov-2026) y
   el texto del paquete v3. Cada uno tiene su escena (EscenaAsi) y su acento. */
const pasos = [
  ["01", "Leemos", "las 86 páginas.", "Un pliego de obra con documentos tipo trae hasta 25 documentos.", "Pliego, anexos y adendas. No tienes que abrir ningún PDF."],
  ["02", "Marcamos", "lo que pide.", "Experiencia, K residual, indicadores y garantía, en un solo lugar.", "Cada requisito con su página, para que lo verifiques."],
  ["03", "Te decimos si", "cumples o te falta.", "La garantía de seriedad no se puede subsanar después del cierre. Te avisamos antes.", "Lo cruzamos con tu experiencia en SECOP y con tu RUP."],
  ["04", "Llenamos", "tus formatos.", "12 de 15 formatos listos con tus datos. Tú revisas y firmas.", "Con los datos de tu empresa, en el formato de la entidad."],
] as const;
const rivales = [["Constructora M.", "8 / 3", 100], ["Consorcio Vías D.", "6 / 2", 75], ["Ingeniería Vertex", "5 / 1", 62]] as const;
const alertas = [
  ["92", "Mejoramiento de vías terciarias", "Timbío · cierra en 9 días", "$2.340 M", false],
  ["81", "Adecuación de la sede educativa", "Popayán · cierra en 4 días", "$612 M", true],
  ["77", "Construcción de puente vehicular", "Piendamó · cierra en 12 días", "$1.073 M", false],
] as const;
const gestion = [
  ["gris", "Equipo", "Cada uno sabe qué le toca.", "Asignas licitaciones y tareas, comentas con @menciones y ves quién tiene qué."],
  ["ink", "Adendas", "Si cambia el pliego, te enteras.", "Te avisamos de cada adenda con el antes y el después, y el resumen se actualiza solo."],
  ["gris jade", "Contratos", "Del acta a la liquidación.", "Pólizas, informes, cobros y plazos de ley, con aviso antes de que venzan."],
] as const;
const COP = (n: number) => `$${n.toLocaleString("es-CO")}`;
const PARA = ["Para no perderte ninguna.", "Para ofertar con datos.", "Para equipos grandes y consorcios."];
const planes = PLANES.map((p, i) => ({
  p, para: PARA[i], reco: i === 1,
  inc: [
    `${p.usuarios} ${p.usuarios === 1 ? "usuario" : "usuarios"}`,
    busquedasDe(p).replace(/^./, (c) => c.toUpperCase()),
    `${p.pliegosMes} pliegos resumidos con IA al mes`,
    `${p.propuestasMes} ${p.propuestasMes === 1 ? "propuesta" : "propuestas"} con formatos llenos al mes`,
  ],
}));
const hechos = [["SECOP I y II", "todo el histórico desde 2012"], ["Cada mañana", "licitaciones nuevas en tu correo"], ["IA en español", "lee pliegos y llena formatos"], ["Tu equipo, al día", "cada licitación con su responsable"], [`${PRUEBA.dias} días gratis`, "sin tarjeta"]];
const modulos = [
  ["01", "Búsquedas", "Te llegan solas, con su encaje.", "", "/producto/busquedas/"],
  ["02", "Expediente", "Decidir, preparar y presentar.", "", "/producto/mis-licitaciones/"],
  ["03", "Mis contratos", "Pólizas, informes y cobros.", "", "/producto/mis-contratos/"],
  ["04", "Calendario", "Todas tus fechas y las del equipo.", "Nuevo", "/producto/calendario/"],
  ["05", "Competencia", "Contra quién compites.", "", "/producto/analisis-de-competencia/"],
  ["06", "Mercado", "Cuánto vale tu sector.", "", "/producto/estadistica-de-la-licitacion/"],
  ["07", "Asistente IA", "Pliegos, chat y formatos.", "Nuevo", "/inteligencia/"],
  ["08", "Equipo", "Quién tiene qué, sin perseguir.", "", "/producto/mis-licitaciones/"],
];
const capas = [["Licitaciones", "licitaciones"], ["Contratos", "contratos"], ["Pólizas", "polizas"], ["Internos", "internos"]];
const ev: Record<number, [string, string]> = { 4: ["Cierre · Vías Timbío", "licitaciones"], 6: ["Reunión de equipo", "internos"], 11: ["Póliza vence", "polizas"], 13: ["Audiencia de riesgos", "licitaciones"], 18: ["Informe mensual", "contratos"], 20: ["Visita de obra", "internos"], 25: ["Cobro · acta 3", "contratos"] };
const etapas = [["Buscar", "Te llegan solas, cada mañana."], ["Decidir", "¿Te presentas o no? Con datos."], ["Preparar", "La IA llena los formatos."], ["Presentar", "A tiempo y sin que falte nada."], ["Ejecutar", "Pólizas, informes y cobros."], ["Liquidar", "Cerrar y liberar capacidad."]];
const perfiles = [["sector-construccion", "Constructoras", "Obra civil, vías, edificaciones."], ["sector-ingenieria", "Ingenierías y consultoras", "Interventoría, estudios y diseños."], ["sector-telecomunicaciones", "Proveedores", "Tecnología, dotación, servicios."]];
const equipo = [
  ["john-chamorro", "John Chamorro", "Fundador", "Magíster en Automatización"],
  ["jairo-marin", "Jairo Marín", "Análisis de datos", "PhD (c) en Ciencias de la Electrónica"],
  ["jaderd-dorado", "Jaderd Dorado", "Especialista en obra pública", "Ingeniero civil"],
  ["alejandra-viveros", "Alejandra Viveros", "Relación con clientes", ""],
];
const envioNit = (origen: string) => `event.preventDefault(); const n=this.nit.value.replace(/\\D/g,'').slice(0,10); const e=this.querySelector('.err'); if(n.length>=6){ e.textContent=''; const u=(window.crConOrigen||String)('${diagnosticoUrl("home", origen)}&nit='+n); window.dispatchEvent(new CustomEvent('cr:evento',{detail:{nombre:'diagnostico_iniciado',datos:{origen:'${origen}'}}})); window.dispatchEvent(new CustomEvent('cr:evento',{detail:{nombre:'web_nit_enviado',datos:{origen:'${origen}'}}})); setTimeout(function(){window.location.href=u;}, window.umami?250:0); } else { e.textContent='Escribe al menos 6 dígitos, sin puntos ni guiones.'; this.nit.focus(); }`;
---

<div class="i27">
  {/* ── 1. Hero ── */}
  <section class="heroz" id="diagnostico" aria-labelledby="hero-t">
    <div class="hero-in">
      <div class="hero-tx">
        <span class="ceja">LICITACIONES · SECOP I Y II · CON IA</span>
        <h1 id="hero-t"><span class="fino">Licitar a mano y a ciegas</span> <span class="fuerte">se acabó.</span></h1>
        <p>ContRadar te trae las licitaciones que te sirven, lee el pliego, llena los formatos con tus datos y te muestra quién compite y a qué precio.</p>
        <form class="nit" onsubmit={envioNit("hero")}>
          <label>
            <span>NIT de tu empresa</span>
            <input name="nit" inputmode="numeric" required autocomplete="off" spellcheck="false" placeholder="901234567" maxlength="13" aria-label="NIT de tu empresa o cédula" />
          </label>
          <button type="submit" class="pildora">Ver mi diagnóstico<i aria-hidden="true">→</i></button>
          <small class="err" aria-live="polite"></small>
        </form>
        <span class="gratis">Gratis y sin registro</span>
      </div>
      <div class="hero-card">
        <div class="radar" aria-hidden="true">
          <span class="glow"></span>
          {[520, 700, 880, 1060, 1240].map((s) => <span class="anillo" style={`--s:${s}px`}></span>)}
        </div>
        <div class="hero-escala" data-hero-escala>
          {/* En el HTML va el estado final: sin JS (o con movimiento reducido) se
              ve completa; el script la lleva a 0 antes de animarla. */}
          <PliegoCard progress={1} id="pliego-hero" />
        </div>
      </div>
    </div>
  </section>

  {/* ── 2. Así funciona ── Una escena propia por paso (no la tarjeta del hero). */}
  <section class="asi" id="asi-funciona" aria-labelledby="asi-t" data-asi-sec data-k="3">
    <div class="asi-pista" data-asi>
      <div class="asi-fijo">
        <span class="asi-noche" aria-hidden="true"></span>
        <div class="asi-grid" data-asi-grid>
          <div class="asi-izq">
            <h2 class="ceja" id="asi-t">ASÍ FUNCIONA</h2>
            <div class="asi-pasos">
              <span class="riel" aria-hidden="true"><i data-riel></i></span>
              <ol>
                {pasos.map(([n, t1, t2, dolor, d], i) => (
                  <li class={`p${i + 1}${i === 3 ? " on" : ""}`} data-paso={i}>
                    <span class="n">{n}</span>
                    <h3><span class="fino">{t1}</span> <span class="fuerte">{t2}</span></h3>
                    <p class="dolor">{dolor}</p>
                    <p>{d}</p>
                    {/* Celular y movimiento reducido: la escena de cada paso, debajo. */}
                    <div class="asi-mini" data-mini><EscenaAsi n={(i + 1) as 1 | 2 | 3 | 4} /></div>
                  </li>
                ))}
              </ol>
            </div>
            <a href="#diagnostico" class="pildora asi-cta" data-asi-cta>Pruébalo con tu NIT<i aria-hidden="true">→</i></a>
          </div>
          <div class="asi-der" data-escenario>
            {([1, 2, 3, 4] as const).map((n) => <div class={`asi-esc${n === 4 ? " on" : ""}`} data-esc={n - 1}><EscenaAsi n={n} /></div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="marco">
    {/* ── 3. Inteligencia ── */}
    <section class="sec" id="inteligencia" data-reveal>
      <div class="cab">
        <span class="ceja az">INTELIGENCIA</span>
        <h2><span class="fino">Antes de ofertar,</span><br /><span class="fuerte">sabes contra quién vas.</span></h2>
      </div>
      <div class="tres-t">
        <div class="tile ink t340">
          <span class="ej">Ejemplo</span>
          <span class="tt28">Quién compite.</span>
          <div class="rivales">
            {rivales.map(([n, v, w]) => (
              <div><div class="fl"><b>{n}</b><span class="m">{v}</span></div><span class="pista"><i style={`width:${w}%`}></i></span></div>
            ))}
            <span class="nota">Se presentó / ganó, en esta entidad</span>
          </div>
        </div>
        <div class="tile gris t340">
          <span class="ej">Ejemplo</span>
          <span class="tt28">Cuánto ofertan los que ganan.</span>
          <div class="abajo">
            <span class="m c36">95 % – 97 %</span>
            <span class="rango"><i></i></span>
            <span class="mut s14">del presupuesto, en esta entidad</span>
          </div>
        </div>
        <div class="tile gris t340">
          <span class="ej">Ejemplo</span>
          <span class="tt28">Cuándo te pagan.</span>
          <div class="abajo">
            <span class="dias"><span class="m c44">47</span><span class="mut">días</span></span>
            <span class="mut s14">para pagar el 90 % de lo facturado, según sus contratos anteriores</span>
          </div>
        </div>
      </div>
    </section>

    {/* ── 4. Alertas diarias ── */}
    <section class="sec dos" id="alertas" data-reveal>
      <div class="cab">
        <span class="ceja az">ALERTAS DIARIAS</span>
        <h2><span class="fino">Abres el correo.</span><br /><span class="fuerte">Ya están ahí.</span></h2>
        <p class="txt18">Cada mañana, solo las licitaciones que se parecen a lo que vendes, ordenadas por encaje.</p>
      </div>
      <div class="tile gris alertas">
        <span class="ej">Ejemplo</span>
        {alertas.map(([e, t, s, v, pronto]) => (
          <div class="alerta">
            <span class="encaje m">{e}</span>
            <span class="tx"><b>{t}</b><span class={pronto ? "s pronto" : "s"}>{s}</span></span>
            <span class="m v">{v}</span>
          </div>
        ))}
      </div>
    </section>

    {/* ── 5. Gestión ── */}
    <section class="sec" id="gestion" data-reveal>
      <div class="cab">
        <span class="ceja az">GESTIÓN</span>
        <h2><span class="fino">Ganaste.</span><br /><span class="fuerte">Ahora no se te pasa nada.</span></h2>
      </div>
      <div class="tres-t">
        {gestion.map(([tono, k, t, s]) => (
          <div class={`tile g280 ${tono}`}>
            <span class="chip">{k}</span>
            <span class="tt28 auto">{t}</span>
            <span class="s16">{s}</span>
          </div>
        ))}
      </div>
    </section>

    {/* ── 6. Precios ── */}
    <section class="sec" id="precios" data-reveal>
      <div class="cab">
        <span class="ceja az">PRECIOS</span>
        <h2><span class="fino">{PRUEBA.dias} días gratis.</span><br /><span class="fuerte">Después, eliges.</span></h2>
      </div>
      <div class="tres-t planes">
        {planes.map(({ p, para, reco, inc }) => (
          <div class={`plan${reco ? " reco" : ""}`}>
            <div class="pn"><b>{p.nombre}</b>{reco && <span class="tag">Recomendado</span>}</div>
            <div class="pp"><span class="m c36">{COP(precioMes(p, "mensual"))}</span><span class="per">al mes</span></div>
            <span class="pd">{para}</span>
            <ul>{inc.map((x) => <li><span class="ck" aria-hidden="true">✓</span>{x}</li>)}</ul>
            {p.id === "enterprise"
              ? <a class="pb" href={whatsappLink("Hola, quiero saber más del plan Dominio de ContRadar.")} data-plan={p.id}>Hablar con nosotros</a>
              : <a class="pb" href="#solicitar" data-plan={p.id}>Empezar gratis</a>}
          </div>
        ))}
      </div>
      <p class="mut s14 pie-p">Subes o bajas de plan cuando quieras. En el plan anual pagas {DESCUENTO_ANUAL} % menos. <a href="/precios/">Ver todo lo que incluye cada plan →</a></p>
    </section>

    {/* ── Lo que ya tenía la portada (handoff §1: entre Precios y Equipo) ── */}
    <div class="hechos" id="hechos" data-reveal>
      {hechos.map(([v, k]) => <div><b>{v}</b><span>{k}</span></div>)}
    </div>

    <section class="sec" id="modulos" data-reveal>
      <div class="cab">
        <span class="ceja az">MÓDULOS</span>
        <h2><span class="fino">Todo tu trabajo.</span><br /><span class="fuerte">Un solo lugar.</span></h2>
      </div>
      <div class="ocho">
        {modulos.map(([n, t, s, tag, href], i) => (
          <a href={href} class={`tile modulo ${i === 6 ? "ink" : i === 3 ? "suave" : "gris"}`}>
            <span class="top"><span class="m">{n}</span>{tag && <span class="nuevo">{tag}</span>}</span>
            <b>{t}</b><span class="s">{s}</span>
