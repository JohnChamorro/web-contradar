      <span class="anillos" aria-hidden="true">{[240, 420, 600, 780].map((s) => <i style={`--s:${s}px`}></i>)}</span>
      <h2 id="cierre-t"><span class="fino">¿Qué dice el SECOP</span><br /><span class="fuerte">de tu empresa?</span></h2>
      <form class="nit claro" onsubmit={envioNit("cierre")}>
        <label><span>NIT de tu empresa</span><input name="nit" inputmode="numeric" required autocomplete="off" spellcheck="false" placeholder="901234567" maxlength="13" aria-label="NIT de tu empresa o cédula" /></label>
        <button type="submit" class="pildora blanca">Ver mi diagnóstico<i aria-hidden="true">→</i></button>
        <small class="err" aria-live="polite"></small>
      </form>
      <span class="gratis">Gratis y sin registro</span>
    </section>
  </div>
</div>

<script>
  import { pintarPliego } from "../../lib/pliegoCard";

  const reducido = matchMedia("(prefers-reduced-motion: reduce)");
  const medir = (nombre: string, datos?: Record<string, unknown>) =>
    window.dispatchEvent(new CustomEvent("cr:evento", { detail: { nombre, datos } }));

  /* Hero: la tarjeta llega al estado final en 2,5 s y se queda ahí (John,
     4-nov-2026: «nada de estados intermedios en reposo»). Arranca cuando el hero
     se ve. Con movimiento reducido, quieta en el estado final (el del HTML). */
  const hero = document.querySelector<HTMLElement>("#pliego-hero .pc");
  if (hero && !reducido.matches) {
    const DURA = 2500;
    pintarPliego(hero, 0);
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const paso = (t: number) => {
        const p = Math.min(1, (t - t0) / DURA);
        pintarPliego(hero, p);
        if (p < 1) requestAnimationFrame(paso);
        else medir("web_hero_anim_completa");
      };
      requestAnimationFrame(paso);
    }, { threshold: 0.25 });
    io.observe(hero);
  }

  /* Hero: si el alto útil no alcanza, la tarjeta se encoge para caber. */
  const escala = document.querySelector<HTMLElement>("[data-hero-escala]");
  const ajustarHero = () => {
    if (!escala) return;
    escala.style.transform = "";
    if (innerWidth < 760) return;
    const util = innerHeight - 76 - 48;
    const alto = escala.offsetHeight;
    const k = alto > util ? Math.max(0.6, util / alto) : 1;
    if (k < 1) escala.style.transform = `scale(${k.toFixed(3)})`;
  };

  /* Escena: --t mueve sus piezas y los contadores se escriben aquí. */
  const ponerT = (esc: HTMLElement | null, t: number) => {
    if (!esc) return;
    esc.style.setProperty("--t", t.toFixed(3));
    esc.querySelectorAll<HTMLElement>("[data-cuenta]").forEach((c) => {
      const s0 = parseFloat(c.style.getPropertyValue("--s") || "0"), d = parseFloat(c.style.getPropertyValue("--d") || "1");
      c.textContent = String(Math.round(Number(c.dataset.cuenta) * Math.min(1, Math.max(0, (t - s0) / d))));
    });
  };

  /* «Así funciona»: 300vh con el bloque fijo. El scroll se reparte en 4 tramos;
     el 60 % de cada uno anima su escena y el 40 % se queda quieto. */
  const pista = document.querySelector<HTMLElement>("[data-asi]");
  const sec = document.querySelector<HTMLElement>("[data-asi-sec]");
  const escenas = [...document.querySelectorAll<HTMLElement>("[data-esc]")];
  const grid = document.querySelector<HTMLElement>("[data-asi-grid]");
  const riel = document.querySelector<HTMLElement>("[data-riel]");
  const cta = document.querySelector<HTMLElement>("[data-asi-cta]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-paso]")];
  const vistos = new Set<number>();
  try { JSON.parse(sessionStorage.getItem("cr-asi-pasos") || "[]").forEach((n: number) => vistos.add(n)); } catch { /* sin almacenamiento */ }
  let pendiente = false;
  const fijo = () => innerWidth >= 760 && !reducido.matches;
  const pintarAsi = () => {
    pendiente = false;
    if (!pista || !fijo()) return;
    const r = pista.getBoundingClientRect();
    const q = Math.min(1, Math.max(0, -r.top / ((r.height - innerHeight) || 1)));
    const k = Math.min(3, Math.floor(q * 4));
    const local = Math.min(1, (q * 4 - k) / 0.6);
    escenas.forEach((e, i) => {
      e.classList.toggle("on", i === k);
      ponerT(e.querySelector<HTMLElement>(".esc"), i < k ? 1 : i > k ? 0 : local);
    });
    if (sec) sec.dataset.k = String(k);
    if (riel) riel.style.transform = `scaleY(${((k + local) / 4).toFixed(3)})`;
    if (cta) cta.classList.toggle("ver", k === 3 && local >= 1);
    items.forEach((li, i) => { li.classList.toggle("on", i === k); li.classList.toggle("antes", i < k); });
    if (q > 0 && !vistos.has(k + 1)) {
      vistos.add(k + 1);
      medir("web_asi_funciona_paso", { paso: k + 1 });
      try { sessionStorage.setItem("cr-asi-pasos", JSON.stringify([...vistos])); } catch { /* sin almacenamiento */ }
    }
  };

  /* Celular (sin fijar): cada escena se anima una vez, en 2,5 s, al entrar en
     vista. Con movimiento reducido se quedan en el estado final del HTML. */
  if (!reducido.matches) {
    const minis = [...document.querySelectorAll<HTMLElement>("[data-mini] .esc")];
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting || fijo()) return;
      io.unobserve(e.target);
      const esc = e.target as HTMLElement, t0 = performance.now();
      const paso = (t: number) => { const p = Math.min(1, (t - t0) / 2500); ponerT(esc, p); if (p < 1) requestAnimationFrame(paso); };
      ponerT(esc, 0);
      requestAnimationFrame(paso);
    }), { threshold: 0.35 });
    if (innerWidth < 760) minis.forEach((m) => { ponerT(m, 0); io.observe(m); });
  }

  const ajustarAsi = () => {
    if (!grid) return;
    const k = Math.min(1, (innerHeight - 76 - 48) / 680);
    grid.style.transform = fijo() && k < 1 ? `scale(${k.toFixed(3)})` : "";
  };
  const alScroll = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(pintarAsi); } };
  const alCambio = () => { ajustarHero(); ajustarAsi(); alScroll(); };
  /* «Pruébalo con tu NIT»: sube al campo del diagnóstico y lo deja listo. */
  cta?.addEventListener("click", (ev) => {
    const campo = document.querySelector<HTMLInputElement>("#diagnostico input[name=nit]");
    if (!campo) return;
    ev.preventDefault();
    document.getElementById("diagnostico")?.scrollIntoView({ behavior: reducido.matches ? "auto" : "smooth" });
    setTimeout(() => campo.focus({ preventScroll: true }), reducido.matches ? 0 : 600);
  });
  addEventListener("scroll", alScroll, { passive: true });
  addEventListener("resize", alCambio);
  reducido.addEventListener?.("change", alCambio);
  alCambio();
</script>

