---
import Flecha from "./Flecha.astro";
// Hero: campo diagonal teñido a la derecha (azul-050, sobrio) con la foto de
// uso y TRES tarjetas de inteligencia flotando alrededor, con la anatomía
// exacta del panel de la app (BloquesInteligencia.tsx): rótulo de 11px en
// mayúscula con icono azul, cifra en `.dato` y la franja «Basado en N…».
// Jerarquía: manda «dónde ofertaron las ganadoras», que es la que decide si te
// presentas; «de dónde sale la plata» y «competidores probables» acompañan.
// Acción principal: NIT → diagnóstico en la app.
import { APP_URL } from "../consts";
import { Swords, Sigma, SquareKanban, Crosshair, Banknote, Users } from "@lucide/astro";

/* Dos líneas exactas cada uno, con el corte puesto a mano: el <br /> solo se
   respeta si la columna da el ancho, por eso la lista es de 38rem y no lg. */
const puntos = [
  { icon: Sigma,          t: "Análisis estadístico<br />de todo el SECOP" },
  { icon: Swords,         t: "Análisis de<br />competencia" },
  { icon: SquareKanban,   t: "Gestión de equipo,<br />hasta la liquidación" },
];
---

<section id="diagnostico" class="hero relative overflow-hidden bg-white">
  <!-- Forma orgánica en tinta (8f, 24-sep-2026): entra por el borde superior
       y el derecho. Geometría aprobada a 1920 × 920 px, path sin tocar.

       `preserveAspectRatio="none"` y no el `xMaxYMin slice` del encargo: slice
       escala por el lado que más crece, y cuando el hero es más alto que
       ancho × 920/1920 la forma crecía también hacia la izquierda y se comía
       el texto (medido: párrafo 79 px dentro a 1280×800, 34 px a 1440×900,
       todo el bloque a 1280×1024). Con `none` la escala horizontal es siempre
       ancho/1920 —la forma nunca pasa del 49 % del ancho— y la vertical sigue
       al hero, así que la foto queda sobre tinta y la curva cierra antes del
       borde inferior a cualquier alto. A proporciones de portátil la
       deformación es ≤ 1,15× y no se nota; en un monitor 5:4 llega a 1,55×.

       Solo desde 1280 px, que es donde el hero pasa a dos columnas: por
       debajo el texto ocupa todo el ancho y la forma le caería encima (ver el
       estilo del final). -->
  <div class="hero-bg" aria-hidden="true">
    <svg viewBox="0 0 1920 920" preserveAspectRatio="none" focusable="false">
      <path fill="var(--tinta-900, #0A1628)"
        d="M1080 0 L1920 0 L1920 780
           C1800 880, 1560 900, 1380 820
           C1180 730, 1000 780, 950 560
           C900 340, 1020 200, 1080 0 Z"/>
    </svg>
  </div>

  <!-- En escritorio la primera pantalla ocupa el alto de la ventana (menos la
       cabecera): nada de la siguiente sección asoma antes del scroll. -->
  <!-- Marco del sitio (max-w-contenido): 1400 px de tope y 92vw por debajo. -->
  <div class="relative mx-auto grid w-full max-w-contenido items-center gap-8 px-5 py-12 sm:px-8 xl:min-h-[calc(100svh-4.5rem)] xl:grid-cols-[minmax(0,1.11fr)_minmax(0,0.89fr)] xl:gap-12 xl:py-14">

    <!-- Copy + acción -->
    <div data-reveal>
      <!-- Ritmo vertical: 16 / 20 / 32 / 40 px entre bloques, en la escala de 4 px
           del sistema. Antes eran 12/16/24/28 —cuatro saltos casi iguales—, y por
           eso el hero se leía como un solo bloque apretado. El salto crece cuando
           cambia el tipo de bloque, no por gusto.
           En móvil los dos últimos saltos se quedan cortos (24 y 32): ahí el aire
           compite con el botón, que tiene que verse sin bajar. -->
      <p class="dato mb-4 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
        Estadística de licitaciones · SECOP I y II
      </p>
      <!-- El hero es de dos columnas desde xl (1280), no desde lg (1024): a 1024
           la columna de texto queda en 458 px y ahí el titular caía en cuatro
           líneas y cada uno de los cuatro puntos en tres o cuatro. Medido. -->
      <!-- Las dos frases NO miden lo mismo: la primera es el planteamiento y la
           segunda es la respuesta, así que la segunda manda. El tope de la
           segunda lo pone el ancho de su columna, no el gusto: a 1280 px son
           49,9 px y por encima de eso se parte en dos renglones. -->
      <h1 class="font-extrabold leading-[1.12] tracking-tight text-grafito-900">
        <span class="block text-[1.7rem] text-grafito-900 sm:text-[2.1rem] xl:text-hero-1">
          El pliego dice qué piden.
        </span>
        <em class="not-italic block text-[2.1rem] text-azul-600 sm:text-[2.6rem] xl:text-hero">
          Los datos dicen<span class="sm:block"> quién gana.</span>
        </em>
      </h1>

      <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-grafito-500">
        No es intuición: es <strong class="font-bold text-grafito-900">todo el histórico
        del SECOP</strong>, medido. Sabes contra quién compites y a qué precio adjudica cada
        entidad — antes de ofertar.
      </p>

      <!-- Tres claves en línea: iconos de 1px, sin color -->
      <ul class="mt-6 grid max-w-[30rem] grid-cols-2 gap-x-5 gap-y-5 sm:mt-8 sm:grid-cols-3">
        {puntos.map((p) => (
          <li class="min-w-0">
            <p.icon size={22} stroke-width={1.5} class="text-grafito-700" aria-hidden="true" />
            <span class="mt-2.5 block text-[0.8125rem] leading-snug text-grafito-500" set:html={p.t} />
          </li>
        ))}
      </ul>

      <form
        class="mt-8 flex max-w-lg flex-col gap-2.5 sm:mt-10 sm:flex-row"
        onsubmit={`event.preventDefault(); const n=this.nit.value.replace(/\\D/g,'').slice(0,10); const e=this.querySelector('#hero-nit-error'); if(n.length>=8){ e.textContent=''; window.location.href='${APP_URL}/diagnostico?nit='+n+'&utm_campaign=landing'; } else { e.textContent='Escribe al menos 8 dígitos, sin puntos ni guiones.'; this.nit.focus(); }`}
      >
        <div class="w-full">
        {/* Cédula además del NIT: buena parte de la contratación pública la
            ganan personas naturales, sobre todo en prestación de servicios, y
            el diagnóstico ya las resuelve. El rango 8-10 dígitos es el mismo
            que aplican la app (NIT_RE) y el backend (_NIT_RE): antes la
            landing exigía 9 exactos y dejaba fuera a las cédulas. */}
        <label for="hero-nit" class="mb-1 block text-sm font-medium text-grafito-700">NIT de tu empresa o cédula</label>
        <input
          id="hero-nit"
          name="nit"
          inputmode="numeric"
          required
          autocomplete="off"
          spellcheck="false"
          placeholder="900123456"
          {/* Sin `minlength`: con él, el navegador corta el envío y muestra SU
              burbuja —en su idioma y fuera de nuestro plano— antes de que
              corra el onsubmit, así que el mensaje inline nunca aparecía. El
              largo lo valida el onsubmit y se dice debajo del campo. */}
          maxlength="13"
          aria-describedby="hero-nit-error"
          class="dato min-h-[54px] w-full rounded-lg border border-papel-300 bg-white px-4 text-base text-grafito-900 placeholder:text-grafito-400 focus:border-azul-500 focus:outline-none focus:ring-[3px] focus:ring-azul-100"
        />
        <p id="hero-nit-error" class="mt-1.5 text-[0.8125rem] leading-snug text-sello-600" aria-live="polite"></p>
        </div>
        <button
          type="submit"
          class="min-h-[54px] shrink-0 self-end whitespace-nowrap rounded-lg bg-azul-500 px-6 text-base font-bold text-white transition hover:bg-azul-600 sm:w-auto"
        >
          Ver mi diagnóstico
        </button>
      </form>
      <p class="mt-3 text-[0.8125rem] text-grafito-400">
        Gratis y sin registro · Datos abiertos del SECOP
      </p>
    </div>

    <!-- Foto + tres tarjetas de dato real. Las tarjetas encogen en xl: al subir el
       titular +6 px la columna de texto se llevó ancho y la foto bajó a ~470 px;
       con los tamaños de antes las tres tarjetas la tapaban entera. -->
    <div class="columna-foto relative xl:pb-8 xl:pl-10" data-reveal data-delay="150">
      <div class="foto foto-hero aspect-[4/3.2]">
        {/* hero-trabajo: manos al teclado con EL TABLERO REAL de la app
            compuesto en la pantalla por perspectiva (John, 1-sep: «alguien
            trabajando en un PC y en la pantalla un pantallazo de nuestra app,
            entorno corporativo»). El montaje se hace fuera del repo —foto de
            Unsplash + dashboard-inicio.webp deformado al plano de la pantalla,
            con mezcla de bordes y ajuste de luz— y aquí llega ya horneado. */}
        <picture>
          <source srcset="/fotos/hero-trabajo.webp" type="image/webp" />
          <img
            src="/fotos/hero-trabajo.jpg"
            alt="Analista de licitaciones trabajando con el tablero de ContRadar en pantalla"
            width="1497"
            height="1198"
            fetchpriority="high"
          />
        </picture>
      </div>

      <!-- Tres tarjetas de inteligencia, con la anatomía REAL del panel de la
           app (BloquesInteligencia.tsx): rótulo en 11px mayúscula con icono
           azul, cifra en `.dato`, y la franja «Basado en N…» que declara sobre
           cuántos casos está medida. Jerarquía: la de precio manda —es la que
           decide si te presentas— y las otras dos la acompañan más pequeñas. -->

      <!-- DOMINANTE · dónde ofertar para ganar. Va abajo a la izquierda: es la que
           decide si te presentas, y ahí cae justo al final del recorrido de lectura. -->
      <div class="tarjeta-int absolute -bottom-6 left-0 w-[19rem] max-w-[88%] rounded-xl border border-papel-200 bg-white p-4 xl:-bottom-8 xl:-left-16 xl:w-[19rem]">
        <header class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-grafito-500">
          <Crosshair size={13} stroke-width={2} class="shrink-0 text-azul-600" aria-hidden="true" />
          Dónde ofertaron las ganadoras
        </header>
        {/* El rango solo se parte tras el guion: «$1.451 / M» dejaba la
            unidad huérfana en teléfono. */}
        <p class="dato mt-2 text-[1.5rem] font-semibold leading-tight tracking-tight text-grafito-900">
          <span class="whitespace-nowrap">$1.402 M –</span> <span class="whitespace-nowrap">$1.451 M</span>
        </p>
        <p class="mt-1 text-[13px] leading-snug text-grafito-700">
          Mediana <span class="dato">−3,1 %</span> frente al presupuesto ·
          ~<span class="dato">7</span> oferentes
        </p>
        <p class="mt-2 rounded-md bg-papel-100 px-2 py-1 text-[11px] font-medium leading-snug text-grafito-600">
          Basado en <span class="dato">1.240</span> procesos de esta entidad · ejemplo ilustrativo
        </p>
      </div>

      <!-- ACOMPAÑA · de dónde sale la plata. Desde 768 px y no desde 640: entre
           los dos se montaba sobre «competidores» (4.182 px² a 640). En xl
           baja a max(30 %, 8,5rem): con 30 % a secas se metía 13 px bajo
           «competidores» entre 1280 y 1366 px. -->
      <div class="tarjeta-int absolute right-6 top-[26%] hidden w-[14rem] rounded-xl border border-papel-200 bg-white p-3.5 md:block xl:-right-2 xl:top-[max(30%,8.5rem)] xl:w-[13rem]">
        <header class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-grafito-500">
          <Banknote size={13} stroke-width={2} class="shrink-0 text-azul-600" aria-hidden="true" />
          De dónde sale la plata
        </header>
        <ul class="mt-2 space-y-1">
          <li class="flex items-baseline justify-between gap-2 text-[13px]">
            <span class="truncate text-grafito-800">Regalías — SGR</span>
            <span class="dato shrink-0 whitespace-nowrap text-grafito-900">41,3 %</span>
          </li>
          <li class="flex items-baseline justify-between gap-2 text-[13px]">
            <span class="truncate text-grafito-800">Participaciones</span>
            <span class="dato shrink-0 whitespace-nowrap text-grafito-900">28,7 %</span>
          </li>
          <li class="flex items-baseline justify-between gap-2 text-[13px]">
            <span class="truncate text-grafito-800">Recursos propios</span>
            <span class="dato shrink-0 whitespace-nowrap text-grafito-900">19,4 %</span>
          </li>
        </ul>
      </div>

      <!-- ACOMPAÑA · contra quién va -->
      <div class="tarjeta-int absolute -top-5 right-0 w-[15rem] max-w-[80%] rounded-xl border border-papel-200 bg-white p-3.5 xl:-top-7 xl:-right-12 xl:w-[15rem]">
        <header class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-grafito-500">
          <Users size={13} stroke-width={2} class="shrink-0 text-azul-600" aria-hidden="true" />
          Competidores probables
        </header>
        <ul class="mt-2 space-y-1">
          <li class="flex items-baseline justify-between gap-2 text-[13px]">
            <span class="truncate text-grafito-800">CONSTRUCTORA MERIDIANO</span>
            <span class="dato shrink-0 whitespace-nowrap text-grafito-500">8/3 · 38 %</span>
          </li>
          <li class="flex items-baseline justify-between gap-2 text-[13px]">
            <span class="truncate text-grafito-800">CONSORCIO VÍAS DEL NORTE</span>
            <span class="dato shrink-0 whitespace-nowrap text-grafito-500">6/2 · 33 %</span>
          </li>
          <li class="flex items-baseline justify-between gap-2 text-[13px]">
            <span class="truncate text-grafito-800">INGENIERÍA VERTEX</span>
            <span class="dato shrink-0 whitespace-nowrap text-grafito-500">5/1 · 20 %</span>
          </li>
        </ul>
        <p class="dato mt-2 border-t border-papel-150 pt-1.5 text-[10px] text-grafito-400">Ejemplo ilustrativo</p>
      </div>
    </div>

  </div>
</section>

<script>
  /* Llegar a #diagnostico desde el menú dejaba al visitante en la primera
     pantalla sin saber qué tenía que hacer. Ahora el campo del NIT se enfoca y
     se marca durante dos segundos: el destino se señala, no se adivina.
     Respeta `prefers-reduced-motion` — sin el latido, solo el anillo. */
  (() => {
    const señalar = () => {
      const campo = document.getElementById("hero-nit");
      if (!(campo instanceof HTMLInputElement)) return;
      campo.classList.remove("nit-señalado");
      void campo.offsetWidth; /* reinicia la animación si ya estaba puesta */
      campo.focus({ preventScroll: true });
      campo.classList.add("nit-señalado");
      window.setTimeout(() => campo.classList.remove("nit-señalado"), 2200);
    };
    window.addEventListener("hashchange", señalar);

    /* Un segundo clic en un enlace a #diagnostico con la URL ya en ese ancla
       no cambia el hash, así que `hashchange` no salta y el campo se quedaba
       mudo. Se escucha también el clic en cualquier enlace que apunte ahí.
       (El «Diagnóstico gratis» de la barra ya no viene aquí desde el 24-sep:
       lleva a la página del diagnóstico en la app. Esto queda para enlaces y
       marcadores viejos que aún apunten al ancla.) */
    document.addEventListener("click", (e) => {
      const destino = (e.target instanceof Element) && e.target.closest('a[href$="#diagnostico"]');
      if (destino) window.setTimeout(señalar, 120);
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", señalar);
    } else {
      señalar();
    }
  })();
</script>

<style>
  /* Señal del campo de NIT: anillo azul y dos latidos cortos. */
  .nit-señalado {
    border-color: var(--azul-500);
    animation: latido-nit 1.1s var(--ease-salida, ease-out) 2;
  }
  @keyframes latido-nit {
    0%   { box-shadow: 0 0 0 0 rgb(var(--azul-500-rgb) / 0.45); }
    70%  { box-shadow: 0 0 0 10px rgb(var(--azul-500-rgb) / 0); }
    100% { box-shadow: 0 0 0 0 rgb(var(--azul-500-rgb) / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nit-señalado {
      animation: none;
      box-shadow: 0 0 0 3px rgb(var(--azul-500-rgb) / 0.25);
    }
  }

  /* Tarjetas del hero: línea, no sombra (8f, 24-sep-2026). Sobre la forma
     oscura una sombra difusa se ensucia; la separación la da el borde
     papel-200, igual en las tres. La foto tampoco lleva sombra. */
  .tarjeta-int { box-shadow: none; }

  /* ── Tarjetas flotantes: escalan de TAMAÑO, no sólo de posición ──────────
     Antes iban con padding y tipografía en px fijos, así que al crecer la foto
     con el marco se veían proporcionalmente más pequeñas. Ahora cada tarjeta
     fija un font-size fluido y TODO lo de dentro se expresa en `em` respecto a
     él: una sola cifra gobierna la tarjeta entera.

     16 px a 1024 (idénticas a como estaban) → 20 px a 2560.
     Mismos coeficientes que el resto de la escala: B = (20−16)/15.36. */
  .tarjeta-flota {
    font-size: clamp(1rem, 0.8333rem + 0.2604vw, 1.25rem);
    gap: 0.75em;
    padding: 0.75em 1em;
    border-radius: 0.75em;
  }
  .tarjeta-flota .icono-flota {
    width: 1.25em;
    height: 1.25em;
  }
  /* 15 px a 1024 — era text-[0.9375rem] */
  .tarjeta-flota b {
    font-size: 0.9375em;
  }
  /* 12 px a 1024 — era text-xs */
  .tarjeta-flota .sub {
    font-size: 0.75em;
    line-height: 1.3334;
  }

  .tarjeta-flota--cifra {
    padding: 1em 1.25em;
  }
  /* 10 px a 1024 — era text-[0.625rem] */
  .tarjeta-flota--cifra .rotulo {
    font-size: 0.625em;
  }
  /* 28 px a 1024 — era text-[1.75rem] */
  .tarjeta-flota--cifra .cifra {
    margin-top: 0.25em;
    font-size: 1.75em;
  }
  .tarjeta-flota--cifra .pie {
    margin-top: 0.375em;
  }

  /* ── Forma orgánica (8f) ───────────────────────────────────────────────
     EXCEPCIÓN ESCRITA a «una sola banda tinta por página»: la portada ya tiene
     la de FullBleedCTA y John decidió el 24-sep-2026 que la forma del hero
     conviva con ella. Es solo del hero; el resto de la página no cambia. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: none;
  }
  .hero-bg svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero > *:not(.hero-bg) {
    position: relative;
    z-index: 1;
  }
  /* La foto del hero: 12 px, sin borde ni sombra. La regla global `.foto`
     (16 px) no se toca. */
  .foto-hero {
    border-radius: 12px;
  }

  /* Desde 1280 px el hero es de dos columnas y la forma cabe a la derecha.
     Por debajo es de una columna —texto arriba a todo el ancho, foto debajo—
     y la forma quedaría bajo el titular: en su lugar, un bloque tinta de
     16 px de radio y 24 px de aire alrededor de la foto. */
  @media (min-width: 1280px) {
    .hero-bg {
      display: block;
    }
  }
  @media (max-width: 1279px) {
    .columna-foto {
      background: var(--tinta-900);
      border-radius: 16px;
      padding: 24px;
    }
  }
  /* En teléfono las tarjetas no flotan: a 390 px las dos tapaban el 87 % de
     la foto y se montaban una sobre otra (medido antes de la forma, 24-sep;
     regla 11: ninguna tarjeta encima de contenido con datos). Bajo 640 px van
     en fila debajo de la foto, dentro del mismo bloque tinta, en el orden del
     código: primero «dónde ofertaron», que es la que decide. */
  @media (max-width: 639px) {
    /* min-width: 0 en los dos niveles: sin él, el nombre largo de una fila
       («CONSTRUCTORA MERIDIANO») fija el ancho mínimo de la columna y a
       320 px se salía 41 px de la pantalla en vez de recortarse con «…». */
    .columna-foto {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-width: 0;
    }
    .columna-foto .tarjeta-int {
      position: static;
      width: auto;
      max-width: none;
      min-width: 0;
    }
  }
</style>
