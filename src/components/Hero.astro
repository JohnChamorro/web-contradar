---
// Hero — patrón del mockup de verificación (contradar-design/mockups/
// verificacion-landing.html): una sola idea, GANAR. Eyebrow, H1 con el único
// degradado de la página, chips de sector, acción real (NIT → diagnóstico)
// y el radar firma en linework de 1px (los ecos son licitaciones; la
// distancia al centro, qué tanto encajan contigo).
import { APP_URL } from "../consts";

const sectores = ["Obra civil", "Interventoría", "Suministros", "Consultoría"];
---

<section id="diagnostico" class="relative bg-white">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-12 sm:px-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.8fr)] lg:gap-14 lg:py-20">

    <!-- Copy + acción -->
    <div data-reveal>
      <p class="dato mb-3.5 inline-block border-t border-papel-300 pt-2 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
        Licitaciones públicas · SECOP I y II · Colombia
      </p>
      <h1 class="max-w-[18ch] text-4xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-5xl lg:text-[3.6rem]">
        Deja de buscar licitaciones.
        <span class="grad">Empieza a ganarlas.</span>
      </h1>

      <p class="mt-5 max-w-[50ch] text-base leading-relaxed text-grafito-500 lg:text-lg">
        Tu radar revisa el SECOP todos los días y te entrega solo lo que encaja con tu empresa —
        con <strong class="font-bold text-grafito-900">puntaje</strong>,
        <strong class="font-bold text-grafito-900">contra quién compites</strong> y
        <strong class="font-bold text-grafito-900">a qué precio se gana</strong> en esa entidad.
      </p>

      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Sectores">
        {sectores.map((s) => (
          <li class="rounded-full border border-papel-200 bg-papel-50 px-3.5 py-1.5 text-[0.8125rem] font-semibold text-grafito-700">{s}</li>
        ))}
      </ul>

      <form
        class="mt-7 flex max-w-lg flex-col gap-2.5 sm:flex-row"
        onsubmit={`event.preventDefault(); const n=this.nit.value.replace(/\\D/g,'').slice(0,9); if(n.length===9) window.location.href='${APP_URL}/diagnostico?nit='+n+'&utm_campaign=landing';`}
      >
        <div class="w-full">
        <label for="hero-nit" class="mb-1 block text-sm font-medium text-grafito-700">NIT de tu empresa</label>
        <input
          id="hero-nit"
          name="nit"
          inputmode="numeric"
          required
          autocomplete="off"
          spellcheck="false"
          placeholder="900123456"
          class="dato min-h-[54px] w-full rounded-lg border border-papel-300 bg-white px-4 text-base text-grafito-900 placeholder:text-grafito-400 focus:border-azul-500 focus:outline-none focus:ring-[3px] focus:ring-azul-100"
        />
        </div>
        <button
          type="submit"
          class="min-h-[54px] shrink-0 self-end whitespace-nowrap rounded-lg bg-azul-500 px-6 text-base font-bold text-white transition hover:bg-azul-600 sm:w-auto"
        >
          Ver qué se te escapó
        </button>
      </form>
      <p class="mt-2.5 text-[0.8125rem] text-grafito-400">
        Gratis y sin registro · Datos abiertos del SECOP
      </p>
    </div>

    <!-- Radar firma: linework 1px, ecos = licitaciones, centro = tu empresa -->
    <div class="justify-self-center lg:justify-self-end" data-reveal data-delay="150">
      <svg
        class="radar h-auto w-[240px] sm:w-[280px] lg:w-full lg:max-w-[320px]"
        viewBox="0 0 240 240"
        role="img"
        aria-label="Radar de licitaciones: cada eco es un proceso abierto; la distancia al centro indica qué tanto encaja con tu empresa"
      >
        <circle cx="120" cy="120" r="112" class="anilloext" />
        <circle cx="120" cy="120" r="78" />
        <circle cx="120" cy="120" r="44" />
        <line x1="120" y1="8" x2="120" y2="232" />
        <line x1="8" y1="120" x2="232" y2="120" />
        <line x1="41" y1="41" x2="199" y2="199" />
        <line x1="199" y1="41" x2="41" y2="199" />
        <circle cx="120" cy="120" r="7" class="centro" />
        <circle cx="146" cy="96" r="5" class="eco" />
        <circle cx="88" cy="150" r="4" class="eco" />
        <circle cx="172" cy="164" r="3.5" class="eco" />
        <circle cx="70" cy="76" r="3" class="eco" />
      </svg>
      <p class="dato mt-3 text-center text-[0.6875rem] uppercase tracking-[0.14em] text-grafito-400 lg:text-right">
        Cada eco, un proceso que encaja
      </p>
    </div>

  </div>
</section>

<style>
  /* Único degradado de la página: la frase que remata el H1. */
  .grad {
    background: linear-gradient(90deg, var(--azul-500), var(--azul-700));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .radar line,
  .radar circle:not(.eco) {
    stroke: var(--grafito-300);
    fill: none;
    stroke-width: 1;
  }
  .radar .anilloext { stroke: var(--papel-300); }
  .radar .eco { fill: var(--azul-500); stroke: none; }
  /* Más específico que `circle:not(.eco)`: el centro es tinta llena (tu empresa). */
  .radar circle.centro { fill: var(--tinta-900); stroke: none; }
</style>
