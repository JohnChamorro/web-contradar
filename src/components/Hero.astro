---
// Hero: campo diagonal teñido a la derecha (azul-050, sobrio) con la foto de
// uso y dos tarjetas flotantes que llevan datos reales del producto — el
// competidor que te gana y el mercado abierto hoy para tu perfil. Acción
// principal: NIT → diagnóstico en la app.
import { APP_URL } from "../consts";
import { Swords, Radar, ClipboardCheck } from "@lucide/astro";

const puntos = [
  { icon: Radar,          t: "SECOP I y II,<br />revisados cada día" },
  { icon: Swords,         t: "Contra quién compites<br />y a qué precio se gana" },
  { icon: ClipboardCheck, t: "De la alerta<br />a la liquidación" },
];
---

<section id="diagnostico" class="relative overflow-hidden bg-white">
  <!-- Campo diagonal: recorte limpio, sin degradado. Solo escritorio. -->
  <div class="campo" aria-hidden="true"></div>

  <!-- En escritorio la primera pantalla ocupa el alto de la ventana (menos la
       cabecera): nada de la siguiente sección asoma antes del scroll. -->
  <!-- Marco del sitio (max-w-contenido): 1400 px de tope y 92vw por debajo. -->
  <div class="relative mx-auto grid w-full max-w-contenido items-center gap-10 px-5 py-12 sm:px-8 lg:min-h-[calc(100svh-4.5rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:gap-14 lg:py-16">

    <!-- Copy + acción -->
    <div data-reveal>
      <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
        Inteligencia de licitaciones · SECOP I y II
      </p>
      <!-- lg:text-hero = clamp(3.5rem … 4.5rem): 56 px a 1024 (igual que antes,
           cuando era text-[3.5rem] congelado) y 72 px a 2560. -->
      <h1 class="max-w-[15ch] text-4xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-5xl lg:text-hero">
        Deja de buscar licitaciones.
        <!-- El espacio duro entre "a" y "ganarlas." evita que la última línea
             quede en una sola palabra cuando la frase no cabe de una (1024-1279).
             Es inerte de 1280 en adelante, donde entra entera en un renglón.
             De paso respeta la norma tipográfica de no dejar una preposición de
             una letra colgando al final de línea. -->
        <em class="not-italic text-azul-600 sm:block">Empieza a&nbsp;ganarlas.</em>
      </h1>

      <p class="mt-5 max-w-[46ch] text-base leading-relaxed text-grafito-500 lg:text-lg">
        ContRadar te dice <strong class="font-bold text-grafito-900">contra quién compites</strong>,
        <strong class="font-bold text-grafito-900">a qué precio se gana</strong> en esa entidad,
        y coordina a tu equipo hasta la liquidación.
      </p>

      <!-- Tres claves en línea: iconos de 1px, sin color -->
      <ul class="mt-7 flex max-w-lg flex-wrap gap-x-8 gap-y-5">
        {puntos.map((p) => (
          <li class="max-w-[15ch]">
            <p.icon size={22} stroke-width={1.5} class="text-grafito-700" aria-hidden="true" />
            <span class="mt-2 block text-[0.8125rem] leading-snug text-grafito-500" set:html={p.t} />
          </li>
        ))}
      </ul>

      <form
        class="mt-8 flex max-w-lg flex-col gap-2.5 sm:flex-row"
        onsubmit={`event.preventDefault(); const n=this.nit.value.replace(/\\D/g,'').slice(0,9); if(n.length===9) window.location.href='${APP_URL}/diagnostico?nit='+n+'&utm_campaign=landing';`}
      >
        <div class="w-full">
        <label for="hero-nit" class="mb-1 block text-sm font-medium text-grafito-700">NIT de tu empresa</label>
        <input
          id="hero-nit"
          name="nit"
          inputmode="numeric"
          required
          autocomplete="off"
          spellcheck="false"
          placeholder="900123456"
          class="dato min-h-[54px] w-full rounded-lg border border-papel-300 bg-white px-4 text-base text-grafito-900 placeholder:text-grafito-400 focus:border-azul-500 focus:outline-none focus:ring-[3px] focus:ring-azul-100"
        />
        </div>
        <button
          type="submit"
          class="min-h-[54px] shrink-0 self-end whitespace-nowrap rounded-lg bg-azul-500 px-6 text-base font-bold text-white transition hover:bg-azul-600 sm:w-auto"
        >
          Ver mi diagnóstico
        </button>
      </form>
      <p class="mt-2.5 text-[0.8125rem] text-grafito-400">
        Gratis y sin registro · Datos abiertos del SECOP
      </p>
    </div>

    <!-- Foto + dos tarjetas de dato real -->
    <div class="relative lg:pb-8 lg:pl-10" data-reveal data-delay="150">
      <div class="foto sombra-flota aspect-[4/3.2]">
        <picture>
          <source srcset="/fotos/uso.webp" type="image/webp" />
          <img
            src="/fotos/uso.jpg"
            alt="Analista de licitaciones trabajando con ContRadar en pantalla"
            width="1600"
            height="1140"
            fetchpriority="high"
          />
        </picture>
      </div>

      <!-- Arriba a la derecha: el golpe competitivo (sello = se te escapó).
           Con la cifra del día abajo a la izquierda arma una diagonal: las
           dos tarjetas no compiten por la misma esquina. -->
      <div class="tarjeta-flota sombra-flota absolute -top-4 right-0 flex max-w-[92%] items-center border border-papel-200 bg-white lg:-right-6">
        <Swords size={20} stroke-width={1.5} class="icono-flota shrink-0 text-grafito-700" aria-hidden="true" />
        <div>
          <b class="block font-extrabold tracking-tight text-grafito-900">
            Un competidor te ganó <span class="dato text-sello-500">12</span> procesos
          </b>
          <span class="sub text-grafito-400">en los últimos <span class="dato">24</span> meses, en tus mismas entidades</span>
        </div>
      </div>

      <!-- Abajo: la cifra dominante del día (el dato ES el contenido) -->
      <div class="tarjeta-flota tarjeta-flota--cifra sombra-flota absolute -bottom-2 left-2 border border-papel-200 bg-white lg:bottom-2 lg:left-2">
        <p class="dato rotulo uppercase tracking-[0.14em] text-grafito-400">Abierto hoy para tu perfil</p>
        <p class="dato cifra font-semibold leading-none tracking-tight text-grafito-900">$4.520 M</p>
        <p class="pie sub text-grafito-400">
          en <span class="dato">7</span> procesos que encajan · el mejor puntúa
          <span class="dato font-semibold text-jade-700">94</span>
        </p>
      </div>
    </div>

  </div>
</section>

<style>
  .sombra-flota {
    box-shadow: var(--sh-flota);
  }

  /* ── Tarjetas flotantes: escalan de TAMAÑO, no sólo de posición ──────────
     Antes iban con padding y tipografía en px fijos, así que al crecer la foto
     con el marco se veían proporcionalmente más pequeñas. Ahora cada tarjeta
     fija un font-size fluido y TODO lo de dentro se expresa en `em` respecto a
     él: una sola cifra gobierna la tarjeta entera.

     16 px a 1024 (idénticas a como estaban) → 20 px a 2560.
     Mismos coeficientes que el resto de la escala: B = (20−16)/15.36. */
  .tarjeta-flota {
    font-size: clamp(1rem, 0.8333rem + 0.2604vw, 1.25rem);
    gap: 0.75em;
    padding: 0.75em 1em;
    border-radius: 0.75em;
  }
  .tarjeta-flota .icono-flota {
    width: 1.25em;
    height: 1.25em;
  }
  /* 15 px a 1024 — era text-[0.9375rem] */
  .tarjeta-flota b {
    font-size: 0.9375em;
  }
  /* 12 px a 1024 — era text-xs */
  .tarjeta-flota .sub {
    font-size: 0.75em;
    line-height: 1.3334;
  }

  .tarjeta-flota--cifra {
    padding: 1em 1.25em;
  }
  /* 10 px a 1024 — era text-[0.625rem] */
  .tarjeta-flota--cifra .rotulo {
    font-size: 0.625em;
  }
  /* 28 px a 1024 — era text-[1.75rem] */
  .tarjeta-flota--cifra .cifra {
    margin-top: 0.25em;
    font-size: 1.75em;
  }
  .tarjeta-flota--cifra .pie {
    margin-top: 0.375em;
  }

  /* Campo diagonal teñido: un solo tono plano, recorte recto. Aparece solo
     donde hay espacio para él (a partir de lg); en móvil el hero es papel. */
  .campo {
    display: none;
  }
  @media (min-width: 1024px) {
    .campo {
      display: block;
      position: absolute;
      inset: 0 0 0 46%;
      background: var(--azul-050);
      clip-path: polygon(16% 0, 100% 0, 100% 100%, 0 100%);
    }
  }
</style>
