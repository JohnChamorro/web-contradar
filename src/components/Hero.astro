---
// Hero fase 4 (landing-v4): claro, una idea — GANAR, no encontrar.
// Acción principal: NIT → diagnóstico en la app (demo con datos propios).
// Derecha: foto real de uso + tarjeta flotante del score.
import { APP_URL } from "../consts";
import { Swords } from "@lucide/astro";
---

<section id="diagnostico" class="relative bg-white">
  <div class="mx-auto grid max-w-6xl items-center gap-8 px-5 py-12 sm:px-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-14 lg:py-20">

    <!-- Copy + acción -->
    <div data-reveal>
      <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
        Inteligencia de licitaciones · SECOP I y II
      </p>
      <h1 class="max-w-[16ch] text-4xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-5xl lg:text-[3.6rem]">
        Deja de buscar licitaciones.
        <em class="not-italic text-azul-600">Empieza a ganarlas.</em>
      </h1>

      <p class="mt-5 max-w-[52ch] text-base leading-relaxed text-grafito-500 lg:text-lg">
        ContRadar te dice <strong class="font-bold text-grafito-900">contra quién compites</strong>,
        <strong class="font-bold text-grafito-900">a qué precio se gana</strong> en esa entidad,
        y coordina a tu equipo <strong class="font-bold text-grafito-900">de la alerta a la liquidación</strong>.
      </p>

      <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-papel-200 bg-papel-50 px-3.5 py-1.5 text-sm font-bold text-grafito-900">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-jade-500" aria-hidden="true"></span>
        Las alertas genéricas terminan donde ContRadar empieza
      </p>

      <form
        class="mt-7 flex max-w-lg flex-col gap-2.5 sm:flex-row"
        onsubmit={`event.preventDefault(); const n=this.nit.value.replace(/\\D/g,'').slice(0,9); if(n.length===9) window.location.href='${APP_URL}/diagnostico?nit='+n+'&utm_campaign=landing';`}
      >
        <div class="w-full">
        <label for="hero-nit" class="mb-1 block text-sm font-medium text-grafito-700">NIT de tu empresa</label>
        <input
          id="hero-nit"
          name="nit"
          inputmode="numeric"
          required
          autocomplete="off"
          spellcheck="false"
          placeholder="900123456"
          class="dato min-h-[54px] w-full rounded-lg border border-papel-300 bg-white px-4 text-base text-grafito-900 placeholder:text-grafito-400 focus:border-azul-500 focus:outline-none focus:ring-[3px] focus:ring-azul-100"
        />
        </div>
        <button
          type="submit"
          class="min-h-[54px] shrink-0 self-end whitespace-nowrap rounded-lg bg-azul-500 px-6 text-base font-bold text-white transition hover:bg-azul-600 sm:w-auto"
        >
          Ver mi diagnóstico
        </button>
      </form>
      <p class="mt-2.5 text-[0.8125rem] text-grafito-400">
        Gratis y sin registro · Datos abiertos del SECOP
      </p>
    </div>

    <!-- Foto + tarjeta flotante -->
    <div class="relative" data-reveal data-delay="150">
      <div class="foto sombra-flota aspect-[4/3.4]">
        <picture>
          <source srcset="/fotos/uso.webp" type="image/webp" />
          <img
            src="/fotos/uso.jpg"
            alt="Analista de licitaciones trabajando con ContRadar en pantalla"
            width="1600"
            height="1140"
            fetchpriority="high"
          />
        </picture>
      </div>
      <!-- Tarjeta flotante: el golpe del diagnóstico es la competencia — el
           mismo dato que la app calcula («un competidor te ganó N procesos en
           los últimos 24 meses»). Sello = lo que se te escapó. -->
      <div class="sombra-flota absolute bottom-4 left-3 flex items-center gap-3.5 rounded-xl border border-papel-200 bg-white px-4 py-3 lg:-left-5 lg:bottom-6">
        <Swords size={22} stroke-width={1.5} class="shrink-0 text-grafito-700" aria-hidden="true" />
        <div>
          <b class="block text-[0.9375rem] font-extrabold tracking-tight text-grafito-900">
            Un competidor te ganó <span class="dato text-sello-500">12</span> procesos
          </b>
          <span class="text-xs text-grafito-400">en los últimos <span class="dato">24</span> meses, en tus mismas entidades</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .sombra-flota {
    box-shadow: var(--sh-flota);
  }
</style>
