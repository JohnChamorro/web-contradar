---
// Arco de cinco (landing-v4): cada módulo resuelve un momento del proceso.
// Reemplaza a PAASection, BusquedaInteligente/ScoreSection sueltas y HowItWorks.
const pasos = [
  {
    n: "01",
    titulo: "Búsquedas automáticas",
    texto:
      "Cada madrugada revisamos SECOP I y II, entendemos a qué te dedicas y te llega solo lo tuyo, con puntaje de 0 a 100. Incluso procesos en borrador, antes de su publicación oficial.",
    tag: "Desde Alerta",
    pro: false,
  },
  {
    n: "02",
    titulo: "Análisis de contratantes",
    texto:
      "Cómo contrata esa entidad: qué compra, con qué modalidad y con cuánto descuento adjudica. Ofertas sabiendo cómo juega quien va a decidir.",
    tag: "Dominio",
    pro: true,
  },
  {
    n: "03",
    titulo: "Análisis de competencia",
    texto:
      "Quién ganó procesos como el tuyo entre 2023 y 2025, a qué precio y con qué efectividad. Y dentro de cada licitación, contra quién vas esta vez.",
    tag: "Dominio",
    pro: true,
  },
  {
    n: "04",
    titulo: "Seguimiento de licitaciones",
    texto:
      "Tablero de cinco etapas, responsable por oportunidad, comentarios con menciones y pliegos organizados. Sin correos perdidos ni hojas de cálculo paralelas.",
    tag: "Desde Alerta",
    pro: false,
  },
  {
    n: "05",
    titulo: "Ejecución del contrato",
    texto:
      "Ganaste. Ahora hitos, pólizas, actas, facturación y liquidación en el mismo sitio, con alertas para que nada se venza.",
    tag: "Dominio",
    pro: true,
  },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 lg:py-[100px]">
    <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
      Todo el ciclo, en un solo lugar
    </p>
    <h2 class="max-w-[20ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl">
      Cinco módulos de inteligencia que deciden si ganas
    </h2>
    <p class="mt-4 max-w-[56ch] text-grafito-500">
      Cada módulo resuelve un momento del proceso. Juntos, son la diferencia entre participar y ganar.
    </p>

    <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-papel-200 bg-papel-200">
      {pasos.map((p) => (
        <div class="group grid grid-cols-[auto_1fr] items-center gap-4 bg-white p-6 transition hover:bg-papel-50 sm:grid-cols-[auto_1fr_auto] sm:gap-7 sm:px-8">
          <span class="dato grid h-[34px] w-[34px] place-items-center rounded-full border border-papel-200 text-xs font-semibold text-grafito-400 transition group-hover:border-azul-300 group-hover:text-azul-600">
            {p.n}
          </span>
          <div>
            <h3 class="text-lg font-extrabold tracking-tight text-grafito-900">{p.titulo}</h3>
            <p class="mt-0.5 max-w-[64ch] text-[0.9063rem] text-grafito-500">{p.texto}</p>
          </div>
          <span
            class:list={[
              "dato col-start-2 justify-self-start whitespace-nowrap rounded-full px-2.5 py-1 text-[0.625rem] uppercase tracking-[0.1em] sm:col-start-auto sm:justify-self-auto",
              p.pro ? "bg-azul-50 text-azul-700" : "bg-papel-100 text-grafito-500",
            ]}
          >
            {p.tag}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
