---
// Arco de cinco — patrón de TARJETAS (prueba en la home antes de llevarlo al
// resto de la web). Reglas aplicadas: línea no sombra, radio 12, eyebrow en
// mono, Lucide currentColor, color solo con significado (azul = la única
// acción; jade = el módulo de lo ganado), dominante 3× (competencia),
// entrada escalonada ≤300ms con reduced-motion respetado.
// Los nombres son los del menú de la app (reorganización jul-2026). «Análisis
// de contratantes» dejó de ser un módulo suelto: hoy es una pestaña de
// Competencia y se cuenta en la tarjeta dominante. El hueco que dejó lo ocupa
// Sondeos (RFI), que no estaba en ninguna parte de la web.
import { Radar, MessageSquareText, Swords, SquareKanban, ClipboardCheck } from "@lucide/astro";

const normales = [
  {
    icon: Radar,
    tag: "Desde Alerta",
    titulo: "Búsquedas automáticas",
    texto:
      "Cada madrugada revisamos SECOP I y II y te llega solo lo tuyo, con puntaje de 0 a 100 — incluso borradores, antes de la publicación oficial.",
  },
  {
    icon: MessageSquareText,
    tag: "Antes del pliego",
    tagAmbar: true,
    titulo: "Sondeos (RFI)",
    texto:
      "Antes de licitar, la entidad pregunta al mercado qué existe y cuánto cuesta. Responder te pone en su radar meses antes del proceso.",
  },
  {
    icon: SquareKanban,
    tag: "Desde Alerta",
    titulo: "Mis licitaciones",
    texto:
      "Tablero de cinco etapas, responsable por licitación, comentarios con menciones y pliegos organizados. Sin hojas de cálculo paralelas.",
  },
  {
    icon: ClipboardCheck,
    tag: "Dominio · cuando ganas",
    tagJade: true,
    ancha: true,
    titulo: "Mis contratos",
    texto:
      "Hitos, pólizas, actas, facturación y liquidación en el mismo sitio, con alertas para que nada se venza — y tu capacidad residual siempre a la vista.",
  },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-[100px]">
    <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
      Todo el ciclo, en un solo lugar
    </p>
    <h2 class="max-w-[20ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl">
      Cinco módulos de inteligencia que deciden si ganas
    </h2>
    <p class="mt-4 max-w-[56ch] text-grafito-500">
      Cada módulo resuelve un momento del proceso. Juntos, son la diferencia entre participar y ganar.
    </p>

    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      <!-- DOMINANTE (3×): el argumento más vendedor, con la única acción azul -->
      <article
        class="arco-card group relative flex flex-col overflow-hidden rounded-xl border border-papel-200 bg-white p-8 transition hover:border-papel-300 lg:col-span-2 lg:row-span-2 lg:p-10"
        data-reveal
      >
        {/* Cuña diagonal: puro recorte, cero color. Va DETRÁS de todo (z-0) y
            el contenido entero se envuelve en una capa con z-10.

            Antes solo el rótulo «Dominio» llevaba `relative`: el título, el
            párrafo y la lista iban en flujo normal, así que la cuña —que es
            `absolute`— los pintaba por encima y cortaba las frases a media
            línea. Poner `relative` pieza por pieza es frágil; una sola capa
            de contenido lo resuelve para siempre. */}
        <div class="corte absolute inset-y-0 right-0 z-0 w-[46%]" aria-hidden="true"></div>
        <div class="relative z-10 flex flex-1 flex-col">
          <p class="dato text-[0.625rem] uppercase tracking-[0.14em] text-grafito-400">Dominio</p>
          <Swords size={24} stroke-width={1.5} class="mt-5 text-grafito-700" aria-hidden="true" />
          <h3 class="mt-4 text-2xl font-extrabold tracking-tight text-grafito-900 sm:text-[1.7rem]">
            Competencia
          </h3>
          <p class="mt-3 max-w-[52ch] text-grafito-500">
            Quién ganó procesos como el tuyo entre <span class="dato">2023</span> y
            <span class="dato">2026</span>, a qué precio y con qué efectividad. Y dentro de cada
            licitación, contra quién vas esta vez.
          </p>
          <ul class="mt-5 max-w-[54ch] space-y-2 text-[0.9063rem] text-grafito-700">
            {/* Los tres nombres son las pestañas reales del módulo. El rótulo
                lo marca el color, no la negrita: una sola negrita por pantalla
                (regla de léxico), y aquí la lleva el titular. */}
            <li class="flex gap-2"><span class="text-grafito-300" aria-hidden="true">—</span> <span><span class="text-grafito-900">Empresas:</span> el historial completo de tu competidor, dónde oferta y a quién le pierde.</span></li>
            <li class="flex gap-2"><span class="text-grafito-300" aria-hidden="true">—</span> <span><span class="text-grafito-900">Contratantes:</span> qué compra cada entidad, con qué modalidad y con cuánto descuento adjudica.</span></li>
            <li class="flex gap-2"><span class="text-grafito-300" aria-hidden="true">—</span> <span><span class="text-grafito-900">Mercado:</span> el tamaño real de tu sector hoy y desde <span class="dato">2023</span>.</span></li>
          </ul>
          <p class="mt-auto pt-6">
            <a
              href="https://app.contradar.com.co/diagnostico"
              class="text-sm font-semibold text-azul-600 hover:underline"
            >Mira un diagnóstico real de ejemplo →</a>
          </p>
        </div>
      </article>

      {normales.map((m) => (
        <article
          class:list={[
            "arco-card rounded-xl border border-papel-200 bg-white p-6 transition hover:border-papel-300",
            m.ancha && "lg:col-span-2",
          ]}
          data-reveal
        >
          <p
            class:list={[
              "dato text-[0.625rem] uppercase tracking-[0.14em]",
              m.tagJade && "text-jade-700",
              m.tagAmbar && "text-ambar-700",
              !m.tagJade && !m.tagAmbar && "text-grafito-400",
            ]}
          >
            {m.tag}
          </p>
          <m.icon size={20} stroke-width={1.5} class="mt-4 text-grafito-700" aria-hidden="true" />
          <h3 class="mt-3 text-lg font-extrabold tracking-tight text-grafito-900">{m.titulo}</h3>
          <p class="mt-1.5 text-[0.9063rem] text-grafito-500">{m.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Entrada escalonada, UNA vez (IntersectionObserver de Base): rise corto
     con los tokens de movimiento — t-med, ease-salida, bajo el techo de
     300ms. Se ve una sola vez al llegar: frecuencia rara, entrada permitida. */
  /* La cuña solo tiene sitio cuando la tarjeta ocupa 2 columnas (lg). Por
     debajo, la tarjeta es de ancho completo y el texto llega hasta el borde
     derecho: la cuña se le echaría encima. */
  .corte {
    display: none;
    background: var(--papel-100);
    clip-path: polygon(38% 0, 100% 0, 100% 100%, 72% 100%);
  }
  @media (min-width: 1024px) {
    .corte { display: block; }
  }

  .arco-card {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity var(--t-med) var(--ease-salida),
      transform var(--t-med) var(--ease-salida),
      border-color var(--t-fast) var(--ease-salida);
  }
  .arco-card.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  .arco-card:nth-child(2).revealed { transition-delay: 60ms; }
  .arco-card:nth-child(3).revealed { transition-delay: 120ms; }
  .arco-card:nth-child(4).revealed { transition-delay: 180ms; }
  .arco-card:nth-child(5).revealed { transition-delay: 240ms; }

  /* La única acción de la sección (enlace azul): presión física. */
  .arco-card a:active {
    display: inline-block;
    transform: scale(var(--press));
    transition: transform var(--t-fast) var(--ease-salida);
  }

  /* Menos y más suave, no cero: queda el fade, se va el desplazamiento. */
  @media (prefers-reduced-motion: reduce) {
    /* La cuña solo tiene sitio cuando la tarjeta ocupa 2 columnas (lg). Por
     debajo, la tarjeta es de ancho completo y el texto llega hasta el borde
     derecho: la cuña se le echaría encima. */
  .corte {
    display: none;
    background: var(--papel-100);
    clip-path: polygon(38% 0, 100% 0, 100% 100%, 72% 100%);
  }
  @media (min-width: 1024px) {
    .corte { display: block; }
  }

  .arco-card {
      transform: none;
      transition: opacity var(--t-med) linear;
    }
    .arco-card.revealed { transition-delay: 0ms; }
  }
</style>
