---
import Flecha from "./Flecha.astro";
// Arco de módulos — índice compacto (1-sep-2026, John: «muy grandes los
// cuadros y no aportan tanto»). La versión anterior metía maquetas inventadas
// —tabla de estadística, lista de rivales, escala del espejo— pero la home ya
// enseña cada módulo con SU CAPTURA REAL unas secciones más arriba: la
// maqueta duplicaba en falso lo que la pantalla de verdad ya mostró. Ahora
// esto es lo que era su trabajo: el directorio de los cuatro módulos, cuatro
// tarjetas parejas con su enlace, y nada más.
//
// Cuatro tarjetas, no seis (John, 29-ago): «Gestión de equipo» agrupa Mis
// licitaciones y Mis contratos; «Búsquedas» agrupa los cuatro buscadores.
import { Target, Swords, Users, Radar } from "@lucide/astro";

const modulos = [
  {
    icon: Target,
    titulo: "Estadística de la licitación",
    desc: "A qué precio se ganó en esa entidad, quién se suele presentar, en cuántos días paga y con qué frecuencia prorroga — en la misma pantalla del proceso.",
    href: "/producto/estadistica-de-la-licitacion/",
    enlace: "Ver qué trae cada licitación",
  },
  {
    icon: Swords,
    titulo: "Análisis de competencia",
    desc: "El historial completo de cada empresa que contrata con el Estado: qué ganó, ante quién y con qué efectividad. Con sus siglas y sus consorcios ya sumados.",
    href: "/producto/analisis-de-competencia/",
    enlace: "Ver el módulo",
  },
  {
    icon: Users,
    titulo: "Gestión de equipo",
    desc: "Mis licitaciones y Mis contratos: responsable por proceso, comentarios con menciones, y el contrato ganado hasta liquidarlo — no en WhatsApp y hojas de cálculo.",
    href: "/producto/mis-licitaciones/",
    enlace: "Ver cómo trabaja tu equipo",
  },
  {
    icon: Radar,
    titulo: "Búsquedas",
    desc: "Automáticas cada madrugada con puntaje, manuales sobre 20 millones de procesos, sondeos (RFI) y el plan anual (PAA): lo que todavía no existe.",
    href: "/producto/busquedas/",
    enlace: "Ver los buscadores",
  },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-20">
    <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
      Todo el ciclo, en un solo lugar
    </p>
    <h2 class="max-w-[20ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl">
      Cuatro módulos que deciden si ganas
    </h2>
    <p class="mt-4 max-w-[56ch] text-grafito-500">
      Cada uno resuelve un momento del proceso. Juntos, son la diferencia entre participar y ganar.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 [&>*]:min-w-0">
      {modulos.map((m) => (
        <article class="arco-card flex min-w-0 flex-col rounded-xl border border-papel-300 bg-white p-6 transition hover:border-azul-500/60" data-reveal>
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-papel-100 text-grafito-600" aria-hidden="true">
            <m.icon size={19} stroke-width={1.6} />
          </span>
          <h3 class="mt-4 text-lg font-extrabold leading-snug tracking-tight text-grafito-900">{m.titulo}</h3>
          <p class="mt-2 text-[0.875rem] leading-relaxed text-grafito-500">{m.desc}</p>
          <p class="mt-auto pt-5">
            <a href={m.href} class="text-sm font-semibold text-azul-600 hover:underline">
              {m.enlace} <Flecha />
            </a>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Entrada escalonada, UNA vez (IntersectionObserver de Base): rise corto
     con los tokens de movimiento — t-med, ease-salida, bajo el techo de
     300ms. Se ve una sola vez al llegar: frecuencia rara, entrada permitida. */
  .arco-card {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity var(--t-med) var(--ease-salida),
      transform var(--t-med) var(--ease-salida),
      border-color var(--t-fast) var(--ease-salida);
  }
  .arco-card.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  .arco-card:nth-child(2).revealed { transition-delay: 60ms; }
  .arco-card:nth-child(3).revealed { transition-delay: 120ms; }
  .arco-card:nth-child(4).revealed { transition-delay: 180ms; }

  /* La única acción de la sección (enlace azul): presión física. */
  .arco-card a:active {
    display: inline-block;
    transform: scale(var(--press));
    transition: transform var(--t-fast) var(--ease-salida);
  }

  /* Menos y más suave, no cero: queda el fade, se va el desplazamiento. */
  @media (prefers-reduced-motion: reduce) {
    .arco-card {
      transform: none;
      transition: opacity var(--t-med) linear;
    }
    .arco-card.revealed { transition-delay: 0ms; }
  }
</style>
