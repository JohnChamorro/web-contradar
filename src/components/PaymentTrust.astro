---
// Sellos de confianza de pago — la pieza OFICIAL de Wompi (pasarela de
// Bancolombia) maquetada en el sistema visual de ContRadar.
//
//   <PaymentTrust variant="medios" />   → «Recibimos todos los medios de pago»
//                                          logo + fila de círculos con rótulo
//   <PaymentTrust variant="seguro" />   → «Aquí puedes pagar seguro con»
//   <PaymentTrust variant="platform" /> → lockup compacto para el pie
//
// ESPEJO: web-contradar/src/components/PaymentTrust.astro y
// contradar/frontend/src/components/PaymentTrust.tsx son la misma pieza en dos
// superficies. Si tocas una, toca la otra.
//
// SOBRE LOS ICONOS (29-ago). Wompi publica cada medio de pago como un círculo
// con la marca a color. En el repo solo están el logo de Wompi y el de
// Bancolombia; los diez marcadores NO. Hasta que lleguen, cada círculo lleva un
// glifo Lucide que describe el MECANISMO (banco, QR, celular, corresponsal,
// tarjeta), monocromo en grafito, y el nombre de la marca debajo.
// Nunca se recolorea ni se imita una marca de terceros: encoger el logotipo de
// Bancolombia a 20 px fue el intento anterior y salía una mancha ilegible.
// Cuando estén los SVG oficiales: dejarlos en /wompi/metodos/<id>.svg y poner
// `oficial: true` en la fila. El resto del componente no cambia.
import { Lock, Landmark, QrCode, Smartphone, Store, Building2, Wallet, CreditCard } from "@lucide/astro";

interface Props {
  variant?: "medios" | "seguro" | "platform";
  class?: string;
}
const { variant = "medios", class: className = "" } = Astro.props;

const WOMPI_LOGO = "/LogosWompi/wompi-logo.svg";
const WOMPI_ICONO = "/LogosWompi/Icono principal/Wompi_ContraccionPrincipal.svg";
const BANCOLOMBIA = "/LogosWompi/bancolombia.png";

/* Los diez medios que Wompi lista en su pieza oficial, en su orden.
   `oficial` pasa a true cuando el SVG de la marca esté en /wompi/metodos/. */
const MEDIOS: { id: string; label: string; icono: any; oficial?: boolean }[] = [
  { id: "boton-bancolombia", label: "Botón Bancolombia", icono: Landmark },
  { id: "qr-bancolombia", label: "QR Bancolombia", icono: QrCode },
  { id: "nequi", label: "Nequi", icono: Smartphone },
  { id: "corresponsal", label: "Corresponsal bancario", icono: Store },
  { id: "pse", label: "PSE", icono: Building2 },
  { id: "daviplata", label: "Daviplata", icono: Wallet },
  { id: "tarjeta-wompi", label: "Tarjeta física app Wompi", icono: CreditCard },
  { id: "visa", label: "Visa", icono: CreditCard },
  { id: "mastercard", label: "Mastercard", icono: CreditCard },
  { id: "amex", label: "American Express", icono: CreditCard },
];
---

{
  variant === "platform" ? (
    <span class={`inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 ${className}`}>
      <img src={WOMPI_LOGO} alt="Wompi" class="block h-5 w-auto shrink-0" />
      <span class="whitespace-nowrap text-[10px] leading-none text-grafito-400">Una idea de</span>
      <img src={BANCOLOMBIA} alt="Bancolombia" class="block h-4 w-auto shrink-0 opacity-60 [filter:brightness(0)]" />
    </span>
  ) : variant === "seguro" ? (
    <div class={`rounded-2xl border border-papel-200 bg-white px-6 py-7 sm:px-8 ${className}`}>
      <img src={WOMPI_LOGO} alt="Wompi" class="block h-9 w-auto sm:h-10" />
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-4">
        <p class="text-base font-extrabold leading-snug text-grafito-900 sm:text-lg">
          Aquí puedes pagar seguro con
        </p>
        <span class="inline-flex items-center gap-3">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-papel-300 bg-white text-grafito-500">
            <Landmark size={20} stroke-width={1.5} aria-hidden="true" />
          </span>
          <span class="text-sm font-medium text-grafito-700">Botón Bancolombia</span>
        </span>
      </div>
      <p class="mt-5 inline-flex items-center gap-1.5 border-t border-papel-150 pt-5 text-sm text-grafito-500">
        <Lock size={15} stroke-width={2} class="shrink-0 text-grafito-400" aria-hidden="true" />
        No almacenamos los datos de tu tarjeta.
      </p>
    </div>
  ) : (
    <div class={`overflow-hidden rounded-2xl border border-papel-200 bg-white px-6 py-7 sm:px-8 sm:py-8 ${className}`}>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <img src={WOMPI_LOGO} alt="Wompi" class="block h-9 w-auto shrink-0 sm:h-11" />
        <p class="text-lg font-extrabold leading-snug text-grafito-900 sm:text-xl">
          Recibimos todos los medios de pago
        </p>
      </div>

      <ul class="mt-8 grid grid-cols-3 gap-x-3 gap-y-6 sm:grid-cols-5 lg:grid-cols-10">
        {MEDIOS.map((m) => {
          const Glifo = m.icono;
          return (
            <li class="flex min-w-0 flex-col items-center gap-2 text-center">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-papel-300 bg-white text-grafito-500">
                {m.oficial ? (
                  <img src={`/wompi/metodos/${m.id}.svg`} alt="" class="block h-6 w-6 object-contain" />
                ) : m.id === "tarjeta-wompi" ? (
                  <img src={WOMPI_ICONO} alt="" class="block h-[18px] w-[18px] object-contain opacity-80" />
                ) : (
                  <Glifo size={20} stroke-width={1.5} aria-hidden="true" />
                )}
              </span>
              <span class="text-[0.6875rem] leading-tight text-grafito-500">{m.label}</span>
            </li>
          );
        })}
      </ul>

      <div class="mt-8 flex flex-col gap-2 border-t border-papel-150 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-semibold text-grafito-900">
          Pagos procesados por Wompi, la pasarela de Bancolombia.
        </p>
        <p class="inline-flex items-center gap-1.5 text-sm text-grafito-500">
          <Lock size={15} stroke-width={2} class="shrink-0 text-grafito-400" aria-hidden="true" />
          No almacenamos los datos de tu tarjeta.
        </p>
      </div>
    </div>
  )
}
