---
// Sellos de confianza de pago — la pieza OFICIAL de Wompi (pasarela de
// Bancolombia) maquetada en el sistema visual de ContRadar.
//
//   <PaymentTrust variant="medios" />   → «Recibimos todos los medios de pago»
//                                          logo + fila de círculos con rótulo
//   <PaymentTrust variant="seguro" />   → «Aquí puedes pagar seguro con»
//   <PaymentTrust variant="platform" /> → lockup compacto para el pie
//
// ESPEJO: web-contradar/src/components/PaymentTrust.astro y
// contradar/frontend/src/components/PaymentTrust.tsx son la misma pieza en dos
// superficies. Si tocas una, toca la otra.
//
// DE DÓNDE SALE EL ARTE (29-ago). Los diez marcadores son los que Wompi sirve
// en su propio Web Checkout: https://checkout.wompi.co/bundle.js los lleva
// embebidos como data URI, y —esto es lo que evita adivinar— el mismo bundle
// trae la tabla `PaymentMethod.*` que dice qué icono pertenece a qué medio.
// Cada archivo de public/wompi/metodos/ se sacó de ahí y se cotejó contra esa
// tabla, no contra su parecido. Un ejemplo de por qué importa: el círculo rojo
// del bundle NO es Daviplata sino Sufi; Daviplata es el archivo remoto
// b6510b74…svg del propio checkout.
// Los diez son vectores. PSE y Daviplata fueron PNG en la primera versión
// porque Wompi no publica vector a color de ninguno de los dos; en monocromo sí
// los tiene (su familia «dsw/brands») y por ahí entran ya como SVG.
//
// A DOS TINTAS, LOS DIEZ (orden de John, 29-ago). Cada marca es un disco
// #2C2A29 con su geometría oficial calada en blanco, como los de Bancolombia.
// No es un filtro: cada archivo se compuso con los path oficiales repintados y
// colocados. Lo que costó trabajo y no se ve:
//   · Mastercard en blanco plano se funde en una mancha con forma de cacahuete,
//     así que el solape va en el color del disco. La geometría (r=9,99 · cx
//     10,115 y 22,11) está medida por píxeles sobre el archivo de Wompi.
//   · Amex es la única mancha sólida del juego: a 24 px pesaba el doble que sus
//     vecinas, va a 21.
//   · Los discos de Wompi no venían iguales —Botón Bancolombia y corresponsal a
//     radio 18, QR y tarjeta a 20— y corresponsal además usaba #2B2929. Todos
//     normalizados a radio 20 y al mismo negro.
//   · El isotipo del Botón Bancolombia era un HUECO en el disco, no tinta
//     blanca: sobre cualquier fondo que no fuera blanco se rompía. Lleva un
//     círculo blanco debajo.
// Verificado midiendo cada archivo sobre un fondo hostil: cero fugas, disco de
// radio 20 en los diez, y solo dos colores en todo el juego.
import { Lock } from "@lucide/astro";

interface Props {
  variant?: "medios" | "seguro" | "platform";
  class?: string;
}
const { variant = "medios", class: className = "" } = Astro.props;

const WOMPI_LOGO = "/LogosWompi/wompi-logo.svg";
const BANCOLOMBIA = "/LogosWompi/bancolombia.png";

/* Los diez medios que Wompi lista en su pieza oficial, en su orden. Cada
   archivo trae su propio disco y ocupa los 48 px enteros: aquí no se escala
   nada, el encaje vive dentro del SVG. */
const MEDIOS: { id: string; label: string }[] = [
  { id: "boton-bancolombia", label: "Botón Bancolombia" },
  { id: "qr-bancolombia", label: "QR Bancolombia" },
  { id: "nequi", label: "Nequi" },
  { id: "corresponsal", label: "Corresponsal bancario" },
  { id: "pse", label: "PSE" },
  { id: "daviplata", label: "Daviplata" },
  { id: "tarjeta-wompi", label: "Tarjeta física app Wompi" },
  { id: "visa", label: "Visa" },
  { id: "mastercard", label: "Mastercard" },
  { id: "amex", label: "American Express" },
];
---

{
  variant === "platform" ? (
    <span class={`inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 ${className}`}>
      <img src={WOMPI_LOGO} alt="Wompi" class="block h-5 w-auto shrink-0" />
      <span class="whitespace-nowrap text-[10px] leading-none text-grafito-400">Una idea de</span>
      <img src={BANCOLOMBIA} alt="Bancolombia" class="block h-4 w-auto shrink-0 opacity-60 [filter:brightness(0)]" />
    </span>
  ) : variant === "seguro" ? (
    <div class={`rounded-2xl border border-papel-200 bg-white px-6 py-7 sm:px-8 ${className}`}>
      <img src={WOMPI_LOGO} alt="Wompi" class="block h-9 w-auto self-start object-contain sm:h-10" />
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-4">
        <p class="text-base font-extrabold leading-snug text-grafito-900 sm:text-lg">
          Aquí puedes pagar seguro con
        </p>
        <span class="inline-flex items-center gap-3">
          <img
            src="/wompi/metodos/boton-bancolombia.svg"
            alt=""
            class="block h-11 w-11 shrink-0 rounded-full object-contain"
          />
          <span class="text-sm font-medium text-grafito-700">Botón Bancolombia</span>
        </span>
      </div>
      <p class="mt-5 inline-flex items-center gap-1.5 border-t border-papel-150 pt-5 text-sm text-grafito-500">
        <Lock size={15} stroke-width={2} class="shrink-0 text-grafito-400" aria-hidden="true" />
        No almacenamos los datos de tu tarjeta.
      </p>
    </div>
  ) : (
    <div class={`overflow-hidden rounded-2xl border border-papel-200 bg-white px-6 py-7 sm:px-8 sm:py-8 ${className}`}>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <img
          src={WOMPI_LOGO}
          alt="Wompi"
          class="block h-9 w-auto shrink-0 self-start object-contain sm:h-11 sm:self-center"
        />
        <p class="text-lg font-extrabold leading-snug text-grafito-900 sm:text-xl">
          Recibimos todos los medios de pago
        </p>
      </div>

      <ul class="mt-8 grid grid-cols-3 gap-x-3 gap-y-6 sm:grid-cols-5 lg:grid-cols-10">
        {MEDIOS.map((m) => (
          <li class="flex min-w-0 flex-col items-center gap-2 text-center">
            <img src={`/wompi/metodos/${m.id}.svg`} alt="" class="block h-12 w-12 shrink-0" />
            <span class="text-[0.6875rem] leading-tight text-grafito-500">{m.label}</span>
          </li>
        ))}
      </ul>

      <div class="mt-8 flex flex-col gap-2 border-t border-papel-150 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-semibold text-grafito-900">
          Pagos procesados por Wompi, la pasarela de Bancolombia.
        </p>
        <p class="inline-flex items-center gap-1.5 text-sm text-grafito-500">
          <Lock size={15} stroke-width={2} class="shrink-0 text-grafito-400" aria-hidden="true" />
          No almacenamos los datos de tu tarjeta.
        </p>
      </div>
    </div>
  )
}
