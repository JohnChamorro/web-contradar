---
// FranjaEquipo.astro — franja de confianza antes de Precios (2-sep-2026).
// Peso visual BAJO a propósito: una línea, cuatro caras y un enlace. No
// compite con el hero ni con las secciones de módulo — su trabajo es que la
// cifra tenga responsable con cara, justo antes de hablar de plata.
// Las fotos son las mismas de /nosotros (public/equipo/).
import Flecha from "./Flecha.astro";
const EQUIPO = [
  { foto: "/equipo/john-chamorro.webp", nombre: "John Chamorro" },
  { foto: "/equipo/jairo-marin.webp", nombre: "Jairo Marín" },
  { foto: "/equipo/alejandra-viveros.webp", nombre: "Alejandra Viveros" },
  { foto: "/equipo/jaderd-dorado.webp", nombre: "Jaderd Dorado" },
];
---

{/* Subida de visibilidad (2-sep, John: «poca visibilidad, auméntala un
    poquito»): baño azul-050 en vez de blanco, avatares de 10 a 14, titular a
    escala de titular (xl) y el CTA como botón de borde. Sigue siendo franja,
    no sección: una sola fila, sin eyebrow, sin competir con el hero. */}
<section class="border-y border-azul-500/20 bg-azul-50">
  <div class="mx-auto flex max-w-contenido flex-wrap items-center gap-x-10 gap-y-5 px-5 py-10 sm:px-8">
    <div class="flex -space-x-3" aria-hidden="true">
      {EQUIPO.map((m) => (
        <img
          src={m.foto}
          alt=""
          width="80"
          height="80"
          loading="lazy"
          decoding="async"
          class="h-14 w-14 rounded-full border-2 border-white object-cover"
        />
      ))}
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-xl font-extrabold leading-snug tracking-tight text-grafito-900">
        Detrás de cada cifra hay un equipo que responde por ella.
      </p>
      <p class="mt-1 text-[0.9375rem] text-grafito-500">
        Ingeniería, análisis de datos y experiencia en contratación pública.
      </p>
    </div>
    <a
      href="/nosotros/"
      class="inline-flex min-h-[44px] items-center whitespace-nowrap rounded-lg border border-azul-500/40 bg-white px-5 text-sm font-semibold text-azul-600 transition hover:border-azul-500 hover:text-azul-700"
    >
      Conoce al equipo <Flecha />
    </a>
  </div>
</section>
