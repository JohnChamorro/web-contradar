---
import TarjetasPlanes from "./TarjetasPlanes.astro";
import { PRUEBA } from "../data/producto";
// Precios en la portada: las mismas tarjetas de /precios/ (noviembre de 2026).
---

<section class="bg-papel-50">
  <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-[100px]">
    <p class="rotulo mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-500">Precios</p>
    <div class="mb-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <h2 class="text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl">Precios claros. Sin permanencia.</h2>
      <p class="text-sm text-grafito-500">
        <span class="dato">{PRUEBA.dias}</span> días gratis de {PRUEBA.plan} · sin tarjeta
      </p>
    </div>
    <TarjetasPlanes verTodas="/precios/#todas-las-funciones" />
  </div>
</section>
