---
// Precios resumidos para la home (fase 4): tres tarjetas compactas a la misma
// altura (regla 9: stretch + flex). El detalle vive en /precios.
/* Tres frases por plan: qué es, qué trae de nuevo y para quién. Alerta dejó
   de ser «solo automática» —lleva análisis, sondeos, visor y buscador
   ilimitado— y el resumen tenía que decirlo. */
const planes = [
  {
    nombre: "Alerta",
    precio: "$152.000",
    desc: "Todo lo que sale en SECOP I y II, filtrado a lo tuyo. Con 5 análisis de empresa al mes, sondeos y buscador ilimitado sobre 20 millones de procesos.",
    destacado: false,
  },
  {
    nombre: "Ventaja",
    precio: "$440.000",
    desc: "Abres una licitación y ves el análisis completo: a qué precio se ganó, quién se presenta y cuándo paga. Más la gestión de tus licitaciones y de tus contratos.",
    destacado: true,
  },
  {
    nombre: "Dominio",
    precio: "$792.000",
    desc: "El dato de ESA entidad, no el del sector. Análisis de empresas y contratantes sin tope, capacidad residual siempre a la vista y exportación de todo tu historial.",
    destacado: false,
  },
];

---

<section class="bg-papel-50">
  <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-[100px]">
    <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
      Precios
    </p>
    <h2 class="max-w-[20ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl">
      Un plan para cada forma de licitar
    </h2>
    <p class="mt-4 max-w-[56ch] text-grafito-500">
      Todos empiezan igual: 10 días de Ventaja completo + 10 análisis para verlo por dentro. Sin tarjeta.
    </p>

    <div class="mt-10 grid items-stretch gap-5 md:grid-cols-3">
      {planes.map((p) => (
        <div
          class:list={[
            "flex flex-col rounded-xl bg-white p-6",
            p.destacado ? "border-2 border-azul-500" : "border border-papel-200",
          ]}
        >
          <h3 class="text-lg font-extrabold tracking-tight text-grafito-900">{p.nombre}</h3>
          <p class="mt-0.5 flex-1 text-sm text-grafito-500">{p.desc}</p>
          <p class="mt-4 flex items-baseline gap-1.5">
            <span class="dato text-3xl font-extrabold tracking-tight text-grafito-900">{p.precio}</span>
            <span class="text-sm text-grafito-400">/mes</span>
          </p>
          <p class="mt-0.5 text-xs text-grafito-400">Plan anual · paga 10 meses, usa 12</p>
        </div>
      ))}
    </div>

    <a
      href="/precios/"
      class="mt-8 inline-flex min-h-[48px] items-center gap-2 whitespace-nowrap rounded-lg bg-azul-500 px-6 font-bold text-white transition hover:bg-azul-600 max-sm:w-full max-sm:justify-center"
    >
      Ver planes completos <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
