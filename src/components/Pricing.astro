---
// Pricing.astro — toggle + tarjetas de plan + sello de pagos + FAQ de precios.
// Sistema v2: tarjetas con línea (cero sombra), plan del medio con borde azul,
// CTA primario siempre azul. El toggle actualiza SOLO nodos .dato — nunca
// reescribe la frase completa (defecto de correcciones-web.md, fase 2).
import PaymentTrust from "./PaymentTrust.astro";
import { Gift } from "@lucide/astro";
---

<section id="precios" class="relative">

  <div class="bg-papel-50">
    <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-20">

      <!-- Header -->
      <div class="mb-8 text-center" data-reveal>
        <h2 class="text-3xl font-extrabold tracking-tight text-grafito-900 sm:text-4xl">
          Elige cómo prefieres pagar
        </h2>
        <p class="mt-3 text-lg text-grafito-500">
          A mayor plazo, mayor ahorro. Sin letra pequeña.
        </p>
        <p class="mx-auto mt-4 max-w-2xl text-base font-semibold text-grafito-900 sm:text-lg">
          Con <span class="font-extrabold text-grafito-700">Alerta</span> te enteras.
          Con <span class="font-extrabold text-azul-600">Ventaja</span> te adelantas.
          Con <span class="font-extrabold text-grafito-900">Dominio</span> controlas el mercado.
        </p>
        <!-- Trial: la puerta de entrada a cualquier plan -->
        <div class="mx-auto mt-5 inline-flex max-w-2xl flex-wrap items-center justify-center gap-2 rounded-xl border border-papel-200 bg-white px-5 py-3">
          <Gift size={18} stroke-width={1.7} class="shrink-0 text-jade-500" aria-hidden="true" />
          <span class="text-sm font-bold text-grafito-900">
            Todos empiezan igual: <span class="text-jade-700">10 días de Ventaja completo + 3 análisis de Dominio</span>.
          </span>
          <span class="text-sm text-grafito-500">Para que lo veas por dentro. Sin tarjeta · configuración guiada de 2 minutos.</span>
          <a href="#solicitar" class="text-sm font-bold text-azul-600 underline underline-offset-2 hover:text-azul-700">Empezar →</a>
        </div>
      </div>

      <!-- Toggle -->
      <div class="mb-10 flex justify-center" data-reveal>
        <div class="inline-flex rounded-full border border-papel-200 bg-white p-1">
          <button class="period-btn" data-period-btn="monthly">Mes a mes</button>
          <button class="period-btn" data-period-btn="biannual">6 meses</button>
          <button class="period-btn active" data-period-btn="annual">
            Anual <span class="annual-badge">Mejor valor</span>
          </button>
        </div>
      </div>

      <!-- Plan cards — misma altura: stretch + flex-col + mt-auto en el CTA -->
      <div class="grid items-stretch gap-5 lg:grid-cols-3" data-reveal data-delay="100">

        <!-- ALERTA -->
        <div class="flex flex-col rounded-xl border border-papel-200 bg-white p-7 transition hover:border-azul-300">
          <h3 class="text-xl font-extrabold text-grafito-900">Alerta</h3>
          <p class="mt-1 text-sm text-grafito-500">Entérate de cada oportunidad</p>

          <div class="mt-5">
            <div class="flex items-baseline gap-1">
              <span class="price-amount dato text-4xl font-extrabold tracking-tight text-grafito-900" data-price-el="vigia">$152.000</span>
              <span class="text-sm text-grafito-400">/mes + IVA</span>
            </div>
            <div class="mt-2 h-5">
              <p class="price-fade text-sm font-semibold text-jade-700" data-savings-el="vigia">
                Ahorras <span class="dato" data-savings-val>$456.000</span> al año
              </p>
            </div>
            <div class="mt-0.5 h-4">
              <p class="price-fade text-xs text-grafito-400" data-billing-el="vigia">
                Facturado <span class="dato" data-billing-val>$1.824.000</span> <span data-billing-label>al año · paga 10, usa 12</span>
              </p>
            </div>
          </div>

          <ul class="mt-7 space-y-3">
            {[
              "Monitoreo automático de tu sector en el territorio que elijas",
              "Alerta diaria a la hora que elijas · las 5 mejores del día",
              "Score de relevancia 0–100 (desglose desde Ventaja)",
              "Reporte «¿A qué precio ofertar?» — con datos del SECOP",
              "Buscador manual: 5 búsquedas al mes para probarlo",
              "CRM de seguimiento básico · hasta 10 licitaciones",
              "Análisis de mercado En Vivo (básico)",
              "Historial 1 mes · perfecto para empezar",
            ].map(f => (
              <li class="flex items-start gap-2.5 text-sm text-grafito-500">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-jade-500" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-7">
            <a href="#solicitar"
              class="block whitespace-nowrap rounded-lg border border-papel-300 px-5 py-3 text-center text-sm font-semibold text-grafito-900 transition hover:border-azul-500 hover:text-azul-600">
              Probar gratis 10 días
            </a>
          </div>
        </div>

        <!-- VENTAJA (destacado: borde azul, patrón del mockup) -->
        <div class="relative flex flex-col rounded-xl border-2 border-azul-500 bg-white p-7">
          <span class="dato absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-azul-500 px-4 py-1 text-[11px] font-bold uppercase tracking-wide text-white">
            El más elegido
          </span>

          <h3 class="text-xl font-extrabold text-grafito-900">Ventaja</h3>
          <p class="mt-1 text-sm text-grafito-500">Adelántate a tu competencia</p>

          <div class="mt-5">
            <div class="flex items-baseline gap-1">
              <span class="price-amount dato text-4xl font-extrabold tracking-tight text-grafito-900" data-price-el="radar">$440.000</span>
              <span class="text-sm text-grafito-400">/mes + IVA</span>
            </div>
            <div class="mt-2 h-5">
              <p class="price-fade text-sm font-semibold text-jade-700" data-savings-el="radar">
                Ahorras <span class="dato" data-savings-val>$1.320.000</span> al año
              </p>
            </div>
            <div class="mt-0.5 h-4">
              <p class="price-fade text-xs text-grafito-400" data-billing-el="radar">
                Facturado <span class="dato" data-billing-val>$5.280.000</span> <span data-billing-label>al año · paga 10, usa 12</span>
              </p>
            </div>
          </div>

          <div class="mb-3 mt-7 flex items-center gap-2 rounded-lg bg-papel-100 px-3.5 py-2.5">
            <svg class="h-4 w-4 shrink-0 text-jade-500" viewBox="0 0 16 16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg>
            <span class="text-sm font-extrabold text-grafito-900">Todo lo del plan Alerta — y además:</span>
          </div>
          <ul class="space-y-3">
            {[
              "3 búsquedas activas · hasta 4 zonas por búsqueda (deptos o ciudades)",
              "Las 10 mejores del día + buscador manual (30/mes)",
              "Score con desglose completo + visor de pliegos",
              "CRM completo: asignación, comentarios y checklist · hasta 20",
              "Dashboard completo + Reporte ROI mensual",
              "Análisis histórico 2023-2025 · 3 usuarios",
            ].map(f => (
              <li class="flex items-start gap-2.5 text-sm text-grafito-500">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-jade-500" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-7">
            <a href="#solicitar"
              class="block whitespace-nowrap rounded-lg bg-azul-500 px-5 py-3.5 text-center text-sm font-bold text-white transition hover:bg-azul-600">
              Probar gratis 10 días →
            </a>
          </div>
        </div>

        <!-- DOMINIO -->
        <div class="flex flex-col rounded-xl border border-papel-200 bg-white p-7 transition hover:border-azul-300">
          <h3 class="text-xl font-extrabold text-grafito-900">Dominio</h3>
          <p class="mt-1 text-sm text-grafito-500">Controla el mercado</p>

          <div class="mt-5">
            <div class="flex items-baseline gap-1">
              <span class="price-amount dato text-4xl font-extrabold tracking-tight text-grafito-900" data-price-el="enterprise">$792.000</span>
              <span class="text-sm text-grafito-400">/mes + IVA</span>
            </div>
            <div class="mt-2 h-5">
              <p class="price-fade text-sm font-semibold text-jade-700" data-savings-el="enterprise">
                Ahorras <span class="dato" data-savings-val>$2.376.000</span> al año
              </p>
            </div>
            <div class="mt-0.5 h-4">
              <p class="price-fade text-xs text-grafito-400" data-billing-el="enterprise">
                Facturado <span class="dato" data-billing-val>$9.504.000</span> <span data-billing-label>al año · paga 10, usa 12</span>
              </p>
            </div>
          </div>

          <div class="mb-3 mt-7 flex items-center gap-2 rounded-lg bg-papel-100 px-3.5 py-2.5">
            <svg class="h-4 w-4 shrink-0 text-jade-500" viewBox="0 0 16 16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg>
            <span class="text-sm font-extrabold text-grafito-900">Todo lo del plan Ventaja — y mucho más:</span>
          </div>
          <ul class="space-y-3">
            {[
              "Competencia en CADA licitación: quién le gana a esa entidad, cuántas veces y su efectividad — dentro de la tarjeta del proceso",
              "6 búsquedas · hasta 10 zonas por búsqueda · 3 sectores",
              "Sin tope de licitaciones/día · buscador manual ilimitado",
              "CRM sin tope + exporta historial y análisis a CSV · 5 usuarios",
              "Análisis de Competencia — quién gana y a qué precio",
              "Buscador PAA — oportunidades desde que se planean",
              "Historial 365 días · subir documentos propios",
            ].map(f => (
              <li class="flex items-start gap-2.5 text-sm text-grafito-500">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-jade-500" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
                </svg>
                {f}
              </li>
            ))}
            <li class="flex items-start gap-2.5 rounded-lg bg-jade-50 px-3 py-2.5 text-sm font-semibold text-grafito-900">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-jade-500" viewBox="0 0 16 16" fill="currentColor">
                <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
              </svg>
              <span>
                Módulos premium: Competencia + Buscador PAA
                <span class="dato ml-1 rounded-full bg-jade-500 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white">Exclusivo</span>
              </span>
            </li>
          </ul>

          <div class="mt-auto pt-7">
            <a href="#solicitar"
              class="block whitespace-nowrap rounded-lg border border-papel-300 px-5 py-3 text-center text-sm font-semibold text-grafito-900 transition hover:border-azul-500 hover:text-azul-600">
              Probar gratis 10 días
            </a>
          </div>
        </div>

      </div>

      <!-- Add-ons note -->
      <div class="mt-5 rounded-xl border border-papel-200 bg-white px-5 py-4 text-sm text-grafito-500" data-reveal>
        <span class="font-semibold text-grafito-900">Add-ons disponibles (Ventaja y Dominio):</span>
        &nbsp;Búsqueda extra · Locación adicional (departamento o ciudad) · Usuario adicional.
        <a href="mailto:soporte@contradar.com.co" class="ml-1 font-semibold text-azul-600 hover:text-azul-700">Escríbenos</a>
        para activarlos según tu operación.
      </div>

      <!-- Diferenciador Dominio: módulos premium (claro — la única banda oscura de /precios es el ROI) -->
      <div class="mt-6 overflow-hidden rounded-xl border border-papel-200 bg-white" data-reveal>
        <div class="grid items-center gap-6 px-7 py-7 sm:grid-cols-[auto_1fr] sm:px-9 sm:py-8">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-jade-50 text-jade-500">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <div>
            <p class="dato mb-2 text-[10px] font-medium uppercase tracking-[0.18em] text-jade-700">Solo en Dominio</p>
            <h3 class="text-lg font-extrabold text-grafito-900">Módulos premium, solo en Dominio</h3>
            <p class="mt-2 text-sm leading-relaxed text-grafito-500">
              <strong class="text-grafito-900">Análisis de Competencia</strong> (quién ganó procesos como el tuyo entre 2023 y 2025, y a qué precio),
              <strong class="text-grafito-900">Buscador PAA</strong> para adelantarte meses a lo que el Estado planea comprar,
              análisis histórico y reporte ROI mensual. Ofertas con datos, no a ciegas.
            </p>
          </div>
        </div>
      </div>

      <!-- Sello de pagos: la pasarela es Wompi (Bancolombia) — confianza antes de comprar -->
      <div class="mt-10" data-reveal>
        <PaymentTrust />
      </div>

      <!-- FAQ -->
      <div class="mt-10" data-reveal>
        <h3 class="mb-5 text-xl font-bold text-grafito-900">Preguntas sobre precios</h3>
        <div class="divide-y divide-papel-150 overflow-hidden rounded-xl border border-papel-200 bg-white">
          {[
            {
              q: "¿Puedo cancelar cuando quiera?",
              a: "Sí. No hay permanencia mínima ni penalización por cancelar. Escríbenos a soporte@contradar.com.co y cancelamos tu suscripción cuando quieras, sin cobros adicionales. Si estás en un plan anual y cancelas antes, no hay reembolso por los meses restantes — pero tampoco cobro extra.",
            },
            {
              q: "¿Qué pasa si necesito más búsquedas o territorio?",
              a: "Puedes agregar add-ons sin cambiar de plan: búsqueda extra ($100.000/mes), locación adicional —un departamento o una ciudad más en tus búsquedas— y usuario adicional ($30.000/mes). Escríbenos y quedan activos el mismo día, sin cambiar de plan.",
            },
            {
              q: "¿Los precios incluyen IVA?",
              a: "No. Los precios mostrados son antes de IVA (19%). Al facturar se aplica según el régimen tributario de tu empresa. Si eres régimen simplificado o no eres responsable de IVA, te indicamos cómo proceder en el momento del pago.",
            },
            {
              q: "¿Cómo funciona el onboarding?",
              a: "Una vez activas tu cuenta, un asesor de ContRadar te contacta para ayudarte a configurar tu primera búsqueda y verificar que las alertas sean relevantes para tu empresa. El proceso toma menos de 30 minutos. No comienzas solo.",
            },
          ].map((item) => (
            <div class="faq-item">
              <button
                class="faq-question flex w-full items-center justify-between px-6 py-5 text-left font-semibold text-grafito-900 transition-colors hover:text-azul-600"
                data-faq-question
                aria-expanded="false">
                {item.q}
                <svg class="faq-chevron ml-4 h-5 w-5 shrink-0 text-grafito-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div class="faq-answer" data-faq-answer>
                <p class="px-6 pb-5 text-sm leading-relaxed text-grafito-500">{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

</section>

<style>
  .period-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.2rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    background: transparent;
    border: none;
    color: var(--grafito-500);
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
    line-height: 1.5;
    min-height: 44px;
  }
  .period-btn:hover:not(.active) {
    background-color: var(--papel-100);
  }
  .period-btn.active {
    background-color: var(--azul-500);
    color: white;
  }
  .annual-badge {
    margin-left: 6px;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    padding: 2px 7px;
    font-size: 9px;
    font-weight: 700;
    font-family: var(--font-dato);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--jade-050);
    color: var(--jade-700);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .period-btn.active .annual-badge {
    background: rgb(255 255 255 / 0.2);
    color: white;
  }
  /* Bajo 380px el toggle no cabe con la insignia: se oculta, no se corta. */
  @media (max-width: 379px) {
    .annual-badge {
      display: none;
    }
  }
  .price-amount,
  .price-fade {
    transition: opacity 0.18s ease;
    will-change: opacity;
    display: inline-block;
  }
  .pr-animating {
    opacity: 0 !important;
  }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .faq-chevron {
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }
  .faq-item.is-open .faq-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  (() => {
    const PRICE_DATA: Record<string, Record<string, { monthly: number; savings: number; total: number; totalLabel: string }>> = {
      monthly: {
        vigia:      { monthly: 190000,  savings: 0,       total: 190000,    totalLabel: '' },
        radar:      { monthly: 550000,  savings: 0,       total: 550000,    totalLabel: '' },
        enterprise: { monthly: 990000,  savings: 0,       total: 990000,    totalLabel: '' },
      },
      biannual: {
        vigia:      { monthly: 180500,  savings: 114000,  total: 1083000,   totalLabel: 'cada 6 meses' },
        radar:      { monthly: 522500,  savings: 330000,  total: 3135000,   totalLabel: 'cada 6 meses' },
        enterprise: { monthly: 940500,  savings: 594000,  total: 5643000,   totalLabel: 'cada 6 meses' },
      },
      annual: {
        vigia:      { monthly: 152000,  savings: 456000,  total: 1824000,   totalLabel: 'al año · paga 10, usa 12' },
        radar:      { monthly: 440000,  savings: 1320000, total: 5280000,   totalLabel: 'al año · paga 10, usa 12' },
        enterprise: { monthly: 792000,  savings: 2376000, total: 9504000,   totalLabel: 'al año · paga 10, usa 12' },
      },
    };

    let currentPeriod = 'annual';

    function fmt(n: number): string {
      return '$' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    // Actualiza SOLO los nodos .dato internos — la frase y su markup quedan
    // intactos (antes se regeneraba con textContent y el formato se perdía).
    function updatePriceDOM(period: string) {
      const data = PRICE_DATA[period];
      for (const plan of ['vigia', 'radar', 'enterprise']) {
        const d = data[plan];

        // querySelectorAll: el precio también vive en la tabla comparativa
        // (PlanComparison) — el toggle debe actualizar TODAS las instancias.
        document.querySelectorAll(`[data-price-el="${plan}"]`).forEach((el) => {
          (el as HTMLElement).textContent = fmt(d.monthly);
        });

        const savingsEl = document.querySelector(`[data-savings-el="${plan}"]`) as HTMLElement | null;
        if (savingsEl) {
          const val = savingsEl.querySelector('[data-savings-val]') as HTMLElement | null;
          if (d.savings > 0 && val) {
            val.textContent = fmt(d.savings);
            savingsEl.style.visibility = 'visible';
          } else {
            savingsEl.style.visibility = 'hidden';
          }
        }

        const billingEl = document.querySelector(`[data-billing-el="${plan}"]`) as HTMLElement | null;
        if (billingEl) {
          const val = billingEl.querySelector('[data-billing-val]') as HTMLElement | null;
          const label = billingEl.querySelector('[data-billing-label]') as HTMLElement | null;
          if (d.totalLabel && val && label) {
            val.textContent = fmt(d.total);
            label.textContent = d.totalLabel;
            billingEl.style.visibility = 'visible';
          } else {
            billingEl.style.visibility = 'hidden';
          }
        }
      }
    }

    function changePeriod(period: string) {
      if (period === currentPeriod) return;
      currentPeriod = period;
      document.querySelectorAll('[data-period-btn]').forEach(btn => {
        const b = btn as HTMLButtonElement;
        b.classList.toggle('active', b.dataset.periodBtn === period);
      });
      const animEls = document.querySelectorAll('.price-amount, .price-fade');
      animEls.forEach(el => el.classList.add('pr-animating'));
      setTimeout(() => {
        updatePriceDOM(period);
        animEls.forEach(el => el.classList.remove('pr-animating'));
      }, 180);
    }

    document.querySelectorAll('[data-period-btn]').forEach(btn => {
      btn.addEventListener('click', () => changePeriod((btn as HTMLButtonElement).dataset.periodBtn ?? ''));
    });

    // FAQ accordion
    document.querySelectorAll('[data-faq-question]').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item') as HTMLElement;
        const answer = item.querySelector('[data-faq-answer]') as HTMLElement;
        const isOpen = item.classList.contains('is-open');

        document.querySelectorAll('.faq-item').forEach(other => {
          (other as HTMLElement).classList.remove('is-open');
          const a = other.querySelector('[data-faq-answer]') as HTMLElement | null;
          if (a) a.style.maxHeight = '';
          const b = other.querySelector('[data-faq-question]');
          if (b) b.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('is-open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>
