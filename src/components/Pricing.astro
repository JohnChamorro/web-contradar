---
import Flecha from "./Flecha.astro";
import { CTA_PRIMARIO } from "../consts";
// Pricing.astro — tarjetas de plan + paquete + sello de pagos + FAQ de precios.
import PagosConfianza from "./PagosConfianza.astro";
import { Gift } from "@lucide/astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { whatsappLink } from "../consts";
import { moneda } from "../lib/formato";
import TarjetasPlanes from "./TarjetasPlanes.astro";
import { COMPLEMENTO_MES, PAQUETE_PROPUESTAS, PRUEBA, ahorroAnual, plan } from "../data/producto";
import { TOPE_WOMPI } from "../lib/pagos";
import { PLANES } from "../data/producto";
// Qué anuales pasan el tope de una transacción de Wompi (hoy solo Dominio).
const porTransferencia = PLANES.filter((p) => p.total.anual > TOPE_WOMPI).map((p) => p.nombre).join(" y ");
---

<section id="precios" class="relative">

  <div class="bg-papel-50">
    <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-20">

      <!-- Header -->
      <div class="mb-8 text-center" data-reveal>
        <h2 class="text-3xl font-extrabold tracking-tight text-grafito-900 sm:text-4xl">
          Tres planes. Mensual o anual.
        </h2>
        <p class="mt-3 text-lg text-grafito-500">
          Pagando el año ahorras desde {moneda(ahorroAnual(plan("vigia")))}. Los topes de cada plan están en la tabla completa.
        </p>
        <!-- Trial: la puerta de entrada a cualquier plan -->
        <div class="mx-auto mt-5 inline-flex max-w-2xl flex-wrap items-center justify-center gap-2 rounded-xl border border-papel-200 bg-white px-5 py-3">
          <Gift size={18} stroke-width={1.7} class="shrink-0 text-jade-500" aria-hidden="true" />
          <span class="text-sm font-bold text-grafito-900">
            <span class="text-jade-700">{PRUEBA.dias} días de {PRUEBA.plan}: {PRUEBA.busquedas} búsquedas, {PRUEBA.pliegos} pliegos, {PRUEBA.propuestas} propuestas con formatos y {PRUEBA.analisis} análisis</span>.
          </span>
          <span class="text-sm text-grafito-500">Para que lo veas por dentro. Sin tarjeta · configuración guiada de 2 minutos.</span>
          <a href="#solicitar" class="text-sm font-bold text-azul-600 underline underline-offset-2 hover:text-azul-700">Empezar <Flecha /></a>
        </div>
      </div>

      <div class="mt-8" data-reveal>
        <TarjetasPlanes />
      </div>

      <p class="mt-5 rounded-xl border border-papel-200 bg-white px-5 py-4 text-sm text-grafito-500" data-reveal>
        <span class="font-semibold text-grafito-900">Paquete de propuestas:</span>
        <span class="dato">{PAQUETE_PROPUESTAS.cantidad}</span> propuestas con formatos más por
        <span class="dato">{moneda(PAQUETE_PROPUESTAS.precio)}</span>, en cualquier plan. Cada una trae su pliego analizado.
      </p>

      <!-- Complementos (antes «Add-ons», 2-nov-2026) -->
      <div class="mt-5 rounded-xl border border-papel-200 bg-white px-5 py-4 text-sm text-grafito-500" data-reveal>
        <span class="font-semibold text-grafito-900">Complementos:</span>
        Búsqueda extra en Ventaja · Usuario adicional en Ventaja y Dominio: <span class="dato">{moneda(COMPLEMENTO_MES)}</span> al mes cada uno.
        <a href={whatsappLink("Hola, quiero activar un complemento en ContRadar")} target="_blank" rel="noopener" class="ml-1 font-semibold text-azul-600 hover:text-azul-700">Se activan por WhatsApp</a>.
      </div>

      <!-- Sello de pagos: la pasarela es Wompi (Bancolombia) — confianza antes de comprar -->
      <div class="mt-10" data-reveal>
        <PagosConfianza />
      </div>

      <!-- FAQ -->
      <div class="mt-10" data-reveal>
        <h3 class="mb-5 text-xl font-bold text-grafito-900">Preguntas sobre precios</h3>
        <div class="divide-y divide-papel-150 overflow-hidden rounded-xl border border-papel-200 bg-white">
          {[
            {
              q: "¿Puedo cancelar cuando quiera?",
              a: "Sí. No hay permanencia mínima ni penalización por cancelar. Escríbenos a soporte@contradar.com.co o por WhatsApp y cancelamos tu suscripción cuando quieras, sin cobros adicionales. Si estás en un plan anual y cancelas antes, no hay reembolso por los meses restantes — pero tampoco cobro extra.",
              wa: "Hola, tengo una pregunta sobre ContRadar",
            },
            {
              q: "¿Qué pasa si necesito más búsquedas o usuarios?",
              a: `Sin cambiar de plan: búsqueda extra en Ventaja y usuario adicional en Ventaja y Dominio, por ${moneda(COMPLEMENTO_MES)} al mes cada uno. Se activan por WhatsApp. Dominio no tiene tope de búsquedas. Si necesitas más palabras o zonas por búsqueda, el plan que las trae es el siguiente.`,
            },
            {
              q: "¿El precio que veo es el que pago?",
              a: "Sí. El valor que aparece es el total: no cobramos IVA ni sumamos cargos al momento del pago. Si necesitas el documento soporte para tu contabilidad, pídelo y te lo enviamos.",
            },
            {
              q: "¿Cómo se paga?",
              a: `Con tarjeta, PSE y los demás medios de Wompi. ${porTransferencia} anual supera el tope de ${moneda(TOPE_WOMPI)} de la pasarela, así que se paga por transferencia; los demás planes anuales, en línea.`,
            },
            {
              q: "¿Cómo empiezo?",
              a: "Escribes tu NIT y tu correo, y con eso armamos tu primera búsqueda. Si quieres, te acompañamos por WhatsApp en tu primera búsqueda.",
            },
          ].map((item) => (
            <div class="faq-item">
              <button
                class="faq-question flex w-full items-center justify-between px-6 py-5 text-left font-semibold text-grafito-900 transition-colors hover:text-azul-600"
                data-faq-question
                aria-expanded="false">
                {item.q}
                <svg class="faq-chevron ml-4 h-5 w-5 shrink-0 text-grafito-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div class="faq-answer" data-faq-answer>
                <p class="px-6 pb-5 text-sm leading-relaxed text-grafito-500">
                  {item.a}
                  {"wa" in item && item.wa && (
                    <a href={whatsappLink(item.wa)} target="_blank" rel="noopener"
                      class="ml-1 inline-flex items-center gap-1 font-semibold text-azul-600 hover:text-azul-700">
                      <WhatsAppIcon class="h-3.5 w-3.5 text-[#25D366]" />
                      Escríbenos por WhatsApp <Flecha />
                    </a>
                  )}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

</section>

<style>
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .faq-chevron {
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }
  .faq-item.is-open .faq-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  (() => {
    // FAQ accordion
    document.querySelectorAll('[data-faq-question]').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item') as HTMLElement;
        const answer = item.querySelector('[data-faq-answer]') as HTMLElement;
        const isOpen = item.classList.contains('is-open');

        document.querySelectorAll('.faq-item').forEach(other => {
          (other as HTMLElement).classList.remove('is-open');
          const a = other.querySelector('[data-faq-answer]') as HTMLElement | null;
          if (a) a.style.maxHeight = '';
          const b = other.querySelector('[data-faq-question]');
          if (b) b.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('is-open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>
