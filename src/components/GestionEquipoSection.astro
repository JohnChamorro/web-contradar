---
// GestionEquipoSection.astro — el paraguas de Mis licitaciones y Mis contratos.
//
// Vivía en línea dentro de /funcionalidades/ y se perdió al partir esa página
// en cinco (M7). Se recupera como componente porque ahora hace falta en dos
// sitios: en la portada, donde John lo pidió el 31-ago, y en la página de Mis
// licitaciones.
//
// Es el argumento que ningún competidor del país tiene —nadie coordina al
// equipo dentro de la plataforma ni administra el contrato ganado—, así que se
// cuenta con esa palabra y se explica a fondo.
//
// El `id="gestion"` se conserva: hay enlaces publicados apuntando ahí.
import Flecha from "./Flecha.astro";
import { UserCheck, Flame, AtSign, History } from "@lucide/astro";
import { captura } from "../lib/capturas";

/* La captura del panel de asignación: quién responde, en qué estado va, qué
   tan importante es y la conversación del equipo — todo en una columna. Es
   vertical (716×869) y se sirve a 320 px, o sea reducida: a tamaño natural
   robaría la sección entera, y lo que tiene que hacer es acompañar al texto.
   Si el archivo no está, la sección se lee igual sin ella. */
const panel = captura("gestion-equipo");

/* Cada pieza con su icono y una MUESTRA de lo que hace (1-sep-2026). Antes
   eran cuatro celdas blancas de solo texto en una rejilla de filetes: John la
   sintió plana y tenía razón — la sección habla de gente trabajando y no se
   veía a nadie. Ahora cada una enseña su propio vocabulario de interfaz: los
   avatares del equipo, los chips de interés, una @mención y una línea de
   bitácora. Es la misma técnica que arregló «Hecho para tu sector»: demostrar
   en vez de describir. */
const PIEZAS = [
  {
    icon: UserCheck,
    t: "Un responsable por proceso",
    d: "Cada licitación tiene nombre y apellido. Se asigna, se reasigna y queda registrado quién respondía por ella.",
    muestra: "equipo",
  },
  {
    icon: Flame,
    t: "Interés: qué tan importante es",
    d: "Alta, media o sin definir. Es lo que separa las tres que hay que preparar en serio de las veinte que solo se miran.",
    muestra: "interes",
  },
  {
    icon: AtSign,
    t: "Comentarios con @menciones",
    d: "La conversación vive junto al proceso, no en un chat aparte. Etiquetas a un compañero con @ y le llega el aviso.",
    muestra: "mencion",
  },
  {
    icon: History,
    t: "Bitácora y documentos",
    d: "Qué se hizo, cuándo y quién. Los pliegos y tus documentos, abiertos en el visor sin descargar nada.",
    muestra: "bitacora",
  },
];

/* Iniciales del equipo de ejemplo. Nombres inventados: la landing no expone
   a nadie. */
const EQUIPO = [
  { ini: "DG", nombre: "David G." },
  { ini: "LC", nombre: "Leidy C." },
  { ini: "JM", nombre: "Julián M." },
];
---

<section id="gestion" class="scroll-mt-16 bg-white">
  <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-20">
    <div class="max-w-[62ch]">
        <p class="dato mb-3.5 flex items-center gap-3 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-azul-500">
          <span class="h-px w-8 bg-azul-500" aria-hidden="true"></span>
          Gestión de equipo
        </p>
        <h2 class="max-w-[62ch] text-3xl font-extrabold leading-tight tracking-tight text-grafito-900 sm:text-4xl">
          Licitar no lo hace una persona.
          <span class="text-azul-600">Aquí trabaja tu equipo.</span>
        </h2>
        <p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-grafito-500">
          Las plataformas de licitaciones terminan donde empieza el trabajo real: decidir a
          cuáles presentarse, repartir quién hace qué y no perderle el rastro a nada. Eso
          pasa dentro de ContRadar, no en WhatsApp y hojas de cálculo paralelas.
        </p>
    </div>

    {/* Las cuatro piezas rodean la captura: dos a la izquierda, dos a la
          derecha y la pantalla real en el medio (John, 1-sep). Bajo 1024 px
          la columna del medio pasa al final y las piezas quedan en 2×2. */}
      <div class="mt-8 grid items-start gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,18rem)_minmax(0,1fr)]">
        {PIEZAS.map((p, i) => (
          <div class:list={["pieza flex flex-col rounded-xl border border-papel-200 bg-white p-5 transition hover:border-azul-500/50",
                            i < 2 ? "lg:col-start-1" : "lg:col-start-3",
                            i % 2 === 0 ? "lg:row-start-1" : "lg:row-start-2"]}>
            <div class="flex items-center gap-2.5">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-azul-50 text-azul-600" aria-hidden="true">
                <p.icon size={16} stroke-width={1.7} />
              </span>
              <h3 class="text-[0.9375rem] font-bold leading-tight text-grafito-900">{p.t}</h3>
            </div>
            <p class="mt-2.5 text-[0.8125rem] leading-relaxed text-grafito-500">{p.d}</p>

            <div class="mt-auto pt-4">
              {p.muestra === "equipo" && (
                <div class="flex items-center gap-2">
                  <span class="flex -space-x-2" aria-hidden="true">
                    {EQUIPO.map((m) => (
                      <span class="dato grid h-7 w-7 place-items-center rounded-full border-2 border-white bg-azul-500 text-[10px] font-bold text-white">
                        {m.ini}
                      </span>
                    ))}
                  </span>
                  <span class="text-[0.75rem] text-grafito-500">
                    <strong class="font-semibold text-grafito-900">David G.</strong> responde por esta
                  </span>
                </div>
              )}
              {p.muestra === "interes" && (
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="inline-flex items-center gap-1 rounded-full border border-ambar-500/30 bg-ambar-50 px-2.5 py-1 text-[0.6875rem] font-bold text-ambar-700">
                    <span class="h-1.5 w-1.5 rounded-full bg-ambar-500" aria-hidden="true"></span>Alta
                  </span>
                  <span class="rounded-full border border-papel-300 px-2.5 py-1 text-[0.6875rem] font-semibold text-grafito-500">Media</span>
                  <span class="rounded-full border border-papel-300 px-2.5 py-1 text-[0.6875rem] font-semibold text-grafito-400">Sin definir</span>
                </div>
              )}
              {p.muestra === "mencion" && (
                <div class="flex items-start gap-2 rounded-lg border border-papel-200 bg-papel-50 px-3 py-2">
                  <span class="dato mt-px grid h-6 w-6 shrink-0 place-items-center rounded-full bg-grafito-900 text-[9px] font-bold text-white" aria-hidden="true">LC</span>
                  <p class="text-[0.75rem] leading-snug text-grafito-600">
                    <span class="font-semibold text-azul-600">@david</span> falta la póliza de seriedad
                  </p>
                </div>
              )}
              {p.muestra === "bitacora" && (
                <ul class="space-y-1.5">
                  {[["Hoy 09:14", "Pliego cargado"], ["Ayer 16:02", "Pasó a Revisando"]].map(([cuando, que]) => (
                    <li class="flex items-baseline gap-2 text-[0.75rem]">
                      <span class="dato shrink-0 text-grafito-400">{cuando}</span>
                      <span class="text-grafito-600">{que}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
        {panel && (
          <figure class="relative m-0 mx-auto w-full max-w-[18rem] sm:col-span-2 lg:col-span-1 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center">
            <img
              src={panel}
              alt="Panel de una licitación en ContRadar: a quién está asignada, en qué estado va, su nivel de interés y los comentarios del equipo"
              width="716"
              height="869"
              loading="lazy"
              decoding="async"
              class="sombra-panel block w-full rounded-xl border border-papel-200 bg-white"
            />
            <div class="sombra-panel absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-lg border border-papel-200 bg-white px-3 py-1.5">
              <span class="dato text-[10px] font-semibold uppercase tracking-[0.14em] text-grafito-400">Pantalla real del producto</span>
            </div>
            <figcaption class="mt-3 text-center text-[0.8125rem] leading-relaxed text-grafito-400">
              Todo en la misma columna: quién responde, en qué va, qué tan importante es y
              la conversación del equipo.
            </figcaption>
          </figure>
        )}
    </div>

    </div>

    <p class="mt-6 max-w-[62ch] text-[0.9375rem] leading-relaxed text-grafito-500">
      La gestión tiene <strong class="text-grafito-900">dos mitades</strong>: las
      licitaciones que estás persiguiendo y los contratos que ya ganaste. Las dos con el
      mismo equipo dentro.
    </p>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a href="/producto/mis-licitaciones/" class="inline-flex min-h-[48px] items-center justify-center whitespace-nowrap rounded-lg bg-azul-500 px-6 text-sm font-bold text-white transition hover:bg-azul-600">
        Mis licitaciones <Flecha />
      </a>
      <a href="/producto/mis-contratos/" class="inline-flex min-h-[48px] items-center justify-center whitespace-nowrap rounded-lg border border-papel-300 px-6 text-sm font-semibold text-grafito-900 transition hover:border-azul-500 hover:text-azul-600">
        Mis contratos <Flecha />
      </a>
    </div>
  </div>
</section>

<style>
  .sombra-panel { box-shadow: var(--sh-flota); }
</style>
