---
// Mis licitaciones — el módulo de gestión (antes «Seguimiento»). El nombre de
// archivo queda como estaba a propósito: renombrarlo obliga a tocar los dos
// imports y no aporta nada al visitante. Lo que sí cambia es TODO lo visible.
// «CRM» y «pipeline» están prohibidos en las dos superficies.
//
// PUESTA AL DÍA (30-ago-2026). Lo que estaba viejo:
//   · Decía «5 etapas … En ejecución». El tablero tiene SEIS carriles desde el
//     rediseño por estado: Nueva · Revisando · Participamos · Ganadas ·
//     Ejecución · Perdidas (frontend/src/pages/Opportunities.tsx::STAGES, y los
//     rótulos en locales/es.json). Perdidas va al final, angosta y apagada:
//     es registro histórico, no foco — y la web no lo contaba.
//   · Llamaba «sistema de seguimiento» al módulo. El nombre visible es
//     «Mis licitaciones»; «Seguimiento» está prohibido como nombre.
//   · Pintaba en `text-slate-*`, que son alias legados remapeados. Los colores
//     van por token.
//   · Los iconos eran `path` sueltos copiados de Heroicons. Van en Lucide, que
//     es la regla de la casa (currentColor, trazo 1.7).
//   · El segundo CTA apuntaba a `#producto`, ancla que no existe en
//     /funcionalidades: el clic se quedaba donde estaba.
import {
  Columns3,
  Users,
  History,
  UserCheck,
  MessageSquare,
  Tag,
  FileText,
  Download,
  Trophy,
} from "@lucide/astro";
import { captura, capturaO } from "../lib/capturas";

/* Las dos piezas se descubren desde public/capturas/ (lib/capturas.ts).
   OJO con el nombre: el descubrimiento acepta también .mp4, así que la imagen
   y el vídeo NO pueden compartir base — si los dos se llamaran
   `mis-licitaciones`, el vídeo podría acabar de póster. Por eso el vídeo lleva
   sufijo. */
const poster = captura("mis-licitaciones") ?? undefined;
const video = capturaO("mis-licitaciones-video", "/capturas/mis-licitaciones-video.mp4");

/* Los seis carriles, con el rótulo EXACTO de la app. Si cambian allá, cambian
   aquí: que la web prometa cinco y el producto muestre seis es de las cosas
   que un cliente nota el primer día. */
const CARRILES = ["Nueva", "Revisando", "Participamos", "Ganadas", "Ejecución", "Perdidas"];

const PILARES = [
  {
    icon: Columns3,
    t: "Seis carriles, un solo tablero",
    d: "Nueva, Revisando, Participamos, Ganadas, Ejecución y Perdidas. Nadie vuelve a preguntar en qué va un proceso.",
  },
  {
    icon: Users,
    t: "Cada quien ve lo suyo",
    d: "Asignas responsable por licitación. Al entrar, cada persona encuentra lo que le tocó y dónde la mencionaron.",
  },
  {
    icon: History,
    t: "Queda quién decidió qué",
    d: "Notas, adjuntos y bitácora en cada tarjeta. Cuando alguien pregunte por qué no nos presentamos, la respuesta está ahí.",
  },
];

const PIEZAS = [
  {
    icon: Columns3,
    t: "Tablero de seis carriles",
    d: "Del aviso al cierre, arrastrando la tarjeta. Perdidas va al final y apagada: es registro, no foco.",
  },
  {
    icon: UserCheck,
    t: "Responsable por licitación",
    d: "Con nombre y fecha de asignación. El gerente ve el tablero entero; cada quien, su carga.",
  },
  {
    icon: MessageSquare,
    t: "Comentarios con @menciones",
    d: "La conversación vive en la tarjeta, no en un grupo de WhatsApp. Mencionas a alguien y le llega.",
  },
  {
    icon: Tag,
    t: "Interés y nombre propio",
    d: "Marca el interés (alto o medio), ponle el nombre con que tu equipo llama al proceso y filtra por lo tuyo.",
  },
  {
    icon: FileText,
    t: "Documentos del proceso, en el visor",
    d: "Pliegos y anexos del SECOP con su estado —leído, listo, enviado— y su historial. Se abren sin descargar nada.",
  },
  {
    icon: Download,
    t: "Exporta el histórico completo",
    d: "Todo el seguimiento de la organización en un Excel, para el comité o la auditoría (plan Dominio).",
  },
];
---

<section class="relative overflow-hidden bg-papel-50">
  <div class="mx-auto max-w-contenido px-5 py-20 sm:px-8">

    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="dato inline-flex items-center gap-3 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-azul-500">
        <span class="h-px w-8 bg-azul-500" aria-hidden="true"></span>Mis licitaciones
      </p>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-grafito-900 sm:text-4xl">
        Cada proceso con un responsable,<br class="hidden sm:block"/>
        <span class="text-azul-600">y nadie preguntando en qué va</span>
      </h2>
      <p class="mt-3 text-lg leading-relaxed text-grafito-500">
        La licitación entra al tablero con su análisis ya hecho y se mueve por seis carriles
        hasta que se cierra. Sin correos reenviados, sin hojas de cálculo paralelas, sin que
        nadie tenga que acordarse.
      </p>
    </div>

    <!-- Los seis carriles, dichos con todas las letras -->
    <ul class="mt-8 flex flex-wrap items-center justify-center gap-2" data-reveal data-delay="100">
      {CARRILES.map((c) => (
        <li class="dato rounded-full border border-papel-200 bg-white px-3 py-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-grafito-500">
          {c}
        </li>
      ))}
    </ul>

    <!-- Los tres pilares -->
    <div class="mt-10 grid gap-4 sm:grid-cols-3" data-reveal data-delay="150">
      {PILARES.map((p) => (
        <div class="rounded-xl border border-papel-200 bg-white p-6 transition hover:border-azul-300">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-papel-100 text-grafito-500">
            <p.icon size={20} stroke-width={1.7} aria-hidden="true" />
          </span>
          <h3 class="mt-3.5 font-bold text-grafito-900">{p.t}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-grafito-500">{p.d}</p>
        </div>
      ))}
    </div>

    <!-- Copy | captura -->
    <div class="mt-12 grid items-center gap-12 lg:grid-cols-2">

      <div data-reveal data-delay="100">
        <h3 class="text-2xl font-extrabold tracking-tight text-grafito-900">
          Del aviso al contrato ganado,<br/>
          <span class="text-azul-600">sin salir de ContRadar</span>
        </h3>
        <p class="mt-4 text-lg leading-relaxed text-grafito-500">
          Cuando llega el aviso, la licitación ya entra con su estadística: a qué precio se ganó
          en esa entidad, quién se suele presentar y en cuántos días paga. El equipo la revisa,
          decide si se presenta y le sigue el rastro hasta la adjudicación.
        </p>

        <ul class="mt-7 space-y-4">
          {PIEZAS.map((f) => (
            <li class="flex items-start gap-3.5">
              <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-papel-100 text-grafito-500">
                <f.icon size={20} stroke-width={1.7} aria-hidden="true" />
              </span>
              <div class="min-w-0">
                <div class="font-semibold text-grafito-900">{f.t}</div>
                <div class="text-sm leading-relaxed text-grafito-500">{f.d}</div>
              </div>
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#solicitar" class="inline-flex min-h-[48px] w-full items-center justify-center whitespace-nowrap rounded-lg bg-azul-500 px-6 text-sm font-bold text-white transition hover:bg-azul-600 sm:w-auto">
            Quiero coordinar a mi equipo →
          </a>
          <a href="/precios/" class="inline-flex min-h-[48px] items-center justify-center whitespace-nowrap rounded-lg border border-papel-300 px-6 text-sm font-semibold text-grafito-900 transition hover:border-azul-500 hover:text-azul-600">
            Ver planes →
          </a>
        </div>
      </div>

      <!-- Captura -->
      <div class="relative" data-reveal data-delay="250">
        <div class="sombra-flota relative overflow-hidden rounded-2xl border border-papel-200 bg-white">
          <div class="flex items-center border-b border-papel-200 bg-papel-100 px-4 py-2.5">
            <div class="dato flex-1 rounded border border-papel-200 bg-white px-3 py-1 text-[11px] text-grafito-500">
              app.contradar.com.co/licitaciones
            </div>
          </div>
          <video
            autoplay loop muted playsinline preload="metadata"
            poster={poster}
            class="w-full"
            aria-label="Tablero de Mis licitaciones en ContRadar: tarjetas por carril, responsables y documentos"
          >
            <source src={video} type="video/mp4" />
          </video>
        </div>

        <div class="sombra-flota float-card-slow absolute -bottom-4 -left-4 rounded-xl border border-papel-200 bg-white px-4 py-3">
          <div class="flex items-center gap-2">
            <Trophy size={20} stroke-width={1.7} class="shrink-0 text-jade-500" aria-hidden="true" />
            <div>
              <div class="text-xs font-bold text-grafito-900">Ganadas este mes</div>
              <div class="dato text-lg font-extrabold text-jade-500">$4.850.000.000</div>
            </div>
          </div>
        </div>

        <div class="sombra-flota float-card-delay absolute -right-3 -top-3 rounded-xl border border-papel-200 bg-white px-3.5 py-2.5">
          <div class="flex items-center gap-2">
            <Users size={16} stroke-width={1.7} class="shrink-0 text-grafito-500" aria-hidden="true" />
            <div>
              <div class="text-[10px] font-semibold text-grafito-400">Equipo activo</div>
              <div class="dato text-xs font-bold text-grafito-900">5 usuarios</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .sombra-flota {
    box-shadow: var(--sh-flota);
  }
</style>
