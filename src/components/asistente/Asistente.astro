---
/* «Pregúntale a ContRadar»: el asistente flotante de la web (5-nov-2026).
   Reemplaza al acompañante de la home (AcompananteRadar, que solo abría
   WhatsApp) y va en TODAS las páginas desde Base.astro.

   Lo que carga cada página es mínimo: el botón, el globo y este script de
   arranque (~1 KB). El panel (lib/asistente/panel.ts + su CSS) se baja con
   import() al primer clic o cuando el navegador está ocioso, nunca antes.

   - Botón abajo a la derecha, con safe-area. Si hay una barra fija abajo
     (las que llevan data-fijo-abajo, p. ej. la de la calculadora K) se apila
     encima de ella.
   - Globo de invitación SOLO en escritorio: al pasar la primera pantalla o a los 6 s; se
     cierra y no vuelve en la sesión (sessionStorage, y si falla, no aparece);
     se aparta mientras el personaje de la página está en pantalla y en el cierre.
   El texto del globo cambia con la sección que se está leyendo (GLOBOS_SECCION).
   Textos y video: data/asistente.ts. Precios: data/producto.ts. */
import RadarBot from "../inicio/RadarBot.astro";
import { ASISTENTE_NOMBRE, GLOBOS, GLOBOS_SECCION, GLOBO_POR_DEFECTO } from "../../data/asistente";

const ruta = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const globo = GLOBOS[ruta] ?? GLOBO_POR_DEFECTO;
---

<div class="asis" data-asis data-secciones={JSON.stringify(GLOBOS_SECCION)}>
  <div class="asis-globo" data-asis-globo hidden>
    <button type="button" class="asis-globo-tx" data-asis-abrir="globo"><span data-asis-globo-msg>{globo}</span><b aria-hidden="true">→</b><span class="sr-only">. {ASISTENTE_NOMBRE}</span></button>
    <button type="button" class="asis-globo-x" data-asis-globo-x aria-label="Cerrar la invitación">×</button>
  </div>
  <button type="button" class="asis-btn" data-asis-abrir="boton" aria-haspopup="dialog" aria-expanded="false" aria-label={ASISTENTE_NOMBRE}>
    <span class="asis-cara"><RadarBot tono="oscuro" estado="reposo" gira="lento" /></span>
  </button>
</div>

<script>
  const raiz = document.querySelector<HTMLElement>("[data-asis]");
  if (raiz) {
    const btn = raiz.querySelector<HTMLButtonElement>(".asis-btn")!;
    const globo = raiz.querySelector<HTMLElement>("[data-asis-globo]")!;
    let seccion = "";
    let carga: Promise<typeof import("../../lib/asistente/panel")> | null = null;
    const panel = () => (carga ??= import("../../lib/asistente/panel"));

    raiz.querySelectorAll<HTMLElement>("[data-asis-abrir]").forEach((el) =>
      el.addEventListener("click", () => {
        const origen = el.dataset.asisAbrir === "globo" && seccion ? `globo:${seccion}` : el.dataset.asisAbrir || "boton";
        panel().then((m) => m.abrir(btn, origen));
      }));
    // Ocioso: se adelanta la descarga del panel para que el primer clic sea instantáneo.
    const ocioso = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 4000));
    ocioso(() => { panel(); }, { timeout: 8000 });

    // ── Apilarse encima de cualquier barra fija de abajo ──
    const barras = () => [...document.querySelectorAll<HTMLElement>("[data-fijo-abajo]")];
    let pend = false;
    const subir = () => {
      pend = false;
      let h = 0;
      for (const b of barras()) {
        if (b.hidden || getComputedStyle(b).display === "none") continue;
        const r = b.getBoundingClientRect();
        if (r.height && r.top < innerHeight) h = Math.max(h, innerHeight - r.top);
      }
      raiz.style.setProperty("--asis-sube", `${Math.round(h)}px`);
    };
    const pedir = () => { if (!pend) { pend = true; requestAnimationFrame(subir); } };
    addEventListener("scroll", pedir, { passive: true });
    addEventListener("resize", pedir);
    new MutationObserver(pedir).observe(document.body, { attributes: true, subtree: true, attributeFilter: ["hidden", "class", "style"] });
    subir();

    // ── Globo de invitación ──
    // Solo la × lo apaga en la sesión; abrir el asistente lo esconde mientras el
    // panel está abierto y vuelve al cerrarlo (5-nov-2026: con «abrir = apagar»,
    // los textos de Radar no volvían a verse). Clave nueva para no heredar el
    // apagado de la regla anterior.
    const CLAVE = "cr_asis_globo_x";
    let puede = false;
    try { puede = sessionStorage.getItem(CLAVE) !== "1"; } catch { puede = false; }
    function guardar() { try { sessionStorage.setItem(CLAVE, "1"); } catch { /* sin almacenamiento: no vuelve igual */ } }
    const escritorio = matchMedia("(min-width: 760px) and (hover: hover)");
    if (puede && escritorio.matches) {
      // El personaje de la página (hero, línea de tiempo, cierre) en pantalla: no se muestra.
      const visibles = new Set<Element>();
      // El muñeco pequeño dentro de la tarjeta del hero ([data-hp]) y el que camina
      // por «Del pliego a la liquidación» ([data-proc], su texto es «Te acompaño hasta
      // la liquidación») no tapan el globo: no tapa el globo (5-nov-2026: con él
      // contando, el globo no salía nunca en la portada).
      const ajenos = [...document.querySelectorAll("[data-radar]")].filter((e) => !raiz.contains(e) && !e.closest("[data-hp], [data-proc]"));
      // Con el personaje en pantalla el globo se aparta (no se cierra) y vuelve
      // cuando el personaje se va.
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)));
        globo.classList.toggle("tapado", visibles.size > 0);
      });
      ajenos.forEach((e) => io.observe(e));
      let listo = false;
      const mostrar = () => {
        if (listo || !puede) return;
        listo = true;
        globo.hidden = false;
        window.dispatchEvent(new CustomEvent("cr:evento", { detail: { nombre: "assistant_bubble_shown" } }));
      };
      // A los 6 s sin tener que bajar (antes 15 s: en incógnito, quieto en el hero,
      // parecía que el globo no existía). Con la entrada 30a, cuenta desde que
      // termina.
      let t = 0;
      const contar = () => { t = window.setTimeout(mostrar, 6000); };
      if (document.documentElement.hasAttribute("data-hero-intro")) addEventListener("cr:hero-listo", contar, { once: true });
      else contar();
      const alScroll = () => {
        // Al dejar atrás la primera pantalla (antes, el 40 % de la página: con el
        // texto por sección, conviene que acompañe desde la segunda).
        if (scrollY > innerHeight * 0.8) { clearTimeout(t); removeEventListener("scroll", alScroll); mostrar(); }
      };
      addEventListener("scroll", alScroll, { passive: true });
      // ── El texto sigue a la sección que se está leyendo, con un fundido corto ──
      const textos: Record<string, string> = JSON.parse(raiz.dataset.secciones || "{}");
      const msg = globo.querySelector<HTMLElement>("[data-asis-globo-msg]")!;
      const inicial = msg.textContent || "";
      const secciones = Object.keys(textos).map((id) => document.getElementById(id)).filter((e): e is HTMLElement => !!e)
        .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));
      const cierre = document.getElementById("cierre");
      let pendS = false, cambio = 0;
      const leer = () => {
        pendS = false;
        let id = "";
        for (const el of secciones) if (el.getBoundingClientRect().top < innerHeight * 0.5) id = el.id;
        // En el cierre manda su propio botón: el globo se aparta.
        // Con el formulario de prueba a la vista, tampoco: tapaba su esquina.
        const form = document.getElementById("solicitar")?.getBoundingClientRect();
        const enForm = !!form && form.top < innerHeight * 0.8 && form.bottom > innerHeight * 0.2;
        const enCierre = (!!cierre && cierre.getBoundingClientRect().top < innerHeight * 0.6) || enForm;
        globo.classList.toggle("aparte", enCierre || !!document.documentElement.dataset.asisAbierto);
        if (id === seccion) return;
        seccion = id;
        const nuevo = textos[id] || inicial;
        if (nuevo === msg.textContent) return;
        if (globo.hidden) { msg.textContent = nuevo; return; }
        globo.classList.add("cambia");
        clearTimeout(cambio);
        cambio = window.setTimeout(() => { msg.textContent = nuevo; globo.classList.remove("cambia"); }, 180);
      };
      new MutationObserver(() => leer()).observe(document.documentElement, { attributes: true, attributeFilter: ["data-asis-abierto"] });
      if (secciones.length || document.getElementById("solicitar")) {
        addEventListener("scroll", () => { if (!pendS) { pendS = true; requestAnimationFrame(leer); } }, { passive: true });
        leer();
      }
      raiz.querySelector("[data-asis-globo-x]")!.addEventListener("click", () => {
        globo.hidden = true; puede = false; guardar();
      });
    }
  }
</script>

<style>
  .asis { --asis-sube: 0px; position: fixed; right: 20px; bottom: calc(20px + env(safe-area-inset-bottom, 0px) + var(--asis-sube)); z-index: 45; display: flex; align-items: flex-end; gap: 12px; transition: bottom .2s; }
  .asis-btn { width: 64px; height: 64px; border-radius: 50%; border: 0; padding: 11px; box-sizing: border-box; background: var(--panel-ink); cursor: pointer; display: block; touch-action: manipulation; -webkit-tap-highlight-color: transparent; transition: transform .15s; }
  .asis-btn:active { transform: scale(.94); }
  .asis-btn:focus-visible, .asis-globo button:focus-visible { outline: 3px solid var(--link); outline-offset: 3px; }
  :global(:root[data-theme="dark"]) .asis-btn { box-shadow: inset 0 0 0 1px var(--panel-line); }
  .asis-cara { display: block; width: 100%; height: 100%; pointer-events: none; }
  .asis-globo { position: relative; margin-bottom: 14px; max-width: min(380px, calc(100vw - 120px)); border-radius: var(--radius-pill) var(--radius-pill) 4px var(--radius-pill); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--sh-flota); }
  .asis-globo[hidden] { display: none; }
  /* Celular y tableta: solo Radar girando en el botón, sin texto. */
  @media (max-width: 759.98px), (hover: none) { .asis-globo { display: none !important; } .asis-btn { width: 52px; height: 52px; padding: 9px; } }
  .asis-globo { transition: opacity .2s; }
  .asis-globo:is(.aparte, .tapado) { opacity: 0; pointer-events: none; }
  .asis-globo-tx > span { display: block; transition: opacity .18s; }
  /* Una sola línea siempre y letra pequeña (John, 5-nov-2026: en 14" el globo
     de dos líneas invadía). Si no cabe, se corta con puntos suspensivos. */
  .asis-globo-tx > b { flex-shrink: 0; font-weight: 800; color: var(--link); }
  .asis-globo-tx > [data-asis-globo-msg] { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .asis-globo.cambia .asis-globo-tx > span { opacity: 0; }
  @media (prefers-reduced-motion: reduce) { .asis-globo, .asis-globo-tx > span { transition: none; } }
  .asis-globo-tx { display: flex; align-items: center; gap: 8px; white-space: nowrap; width: 100%; padding: 8px 34px 8px 14px; border: 0; background: none; text-align: left; font: inherit; font-size: var(--fs-w-13); line-height: 1.3; font-weight: 600; color: var(--ink); cursor: pointer; border-radius: inherit; }
  .asis-globo-x { position: absolute; top: 50%; right: 4px; transform: translateY(-50%); width: 28px; height: 28px; border: 0; border-radius: 50%; background: none; color: var(--muted); font-size: var(--fs-w-16); line-height: 1; cursor: pointer; }
  .asis-globo-x:hover { color: var(--ink); }
  @media (max-width: 759.98px) {
    .asis { right: 14px; bottom: calc(14px + env(safe-area-inset-bottom, 0px) + var(--asis-sube)); }
    .asis-btn { width: 56px; height: 56px; padding: 9px; }
  }
  @media (prefers-reduced-motion: reduce) { .asis, .asis-btn { transition: none; } }
  @media print { .asis { display: none; } }
</style>
