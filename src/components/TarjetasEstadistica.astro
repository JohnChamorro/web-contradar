---
// TarjetasEstadistica.astro — solo en /producto/estadistica-de-la-licitacion/
// (1-sep-2026, dos vueltas de John el mismo día: «dibujar las tarjetas con un
// contrato de 350 millones» → «con el diseño exactamente igual al de la app»
// → «cada tarjeta alrededor del video»).
//
// Es el PANEL DE LA APP a tamaño página: el mismo envoltorio azul de
// BloquesInteligencia.tsx, la grabación real en el centro, y las ocho
// tarjetas reales alrededor — «Antes de ofertar» a la izquierda con filete
// azul, «Si ganas» a la derecha con filete jade. La anatomía de cada tarjeta
// está COPIADA de la app (Tarjeta/Fila/ChipNivel de BloquesInteligencia.tsx):
// borde papel-200 sobre blanco, cabecera 11px mayúscula gris con icono azul,
// cifra 24px en .dato, y el chip «Basado en N…» con ring azul. Si la app
// cambia, esto se cambia con ella.
//
// El video viene de ExpedienteSection, que en esta página va con
// conPanel={false} para no enseñarlo dos veces.
//
// Cifras de un proceso de EJEMPLO coherente ($350 M); empresas inventadas
// (regla: la landing no expone a nadie).
import { Target, Users, ListChecks, FileText, Coins, Banknote, CalendarClock, MapPin } from "@lucide/astro";
import VideoDemo from "./VideoDemo.astro";
import Captura from "./Captura.astro";
import { captura } from "../lib/capturas";
const videoPanel = captura("panel-estadistica-video");
const posterPanel = captura("panel-estadistica");

const antes = [
  {
    icon: Target,
    titulo: "Dónde ofertaron las ganadoras",
    cifra: "$322 M – $339 M",
    sufijo: "mediana −5,2 % frente al presupuesto",
    base: "Basado en 214 procesos de esta entidad",
  },
  {
    icon: Users,
    titulo: "Competidores probables",
    lista: [
      ["CONSTRUCTORA MERIDIANO", "8/3 · 38 %"],
      ["CONSORCIO VÍAS DEL NORTE", "6/2 · 33 %"],
      ["INGENIERÍA VERTEX", "5/1 · 20 %"],
    ],
    base: "Basado en procesos parecidos 2019–2026",
  },
  {
    icon: ListChecks,
    titulo: "¿Venía en el plan anual?",
    cifra: "Sí",
    sufijo: "en el PAA desde enero, por $340 M",
    base: "Basado en el PAA 2026 de la entidad",
  },
  {
    icon: FileText,
    titulo: "Documentos del proceso",
    cifra: "12",
    sufijo: "pliego, estudios previos y presupuesto, enlazados",
    base: "Directo del expediente del SECOP",
  },
];

const siGanas = [
  {
    icon: Coins,
    titulo: "De dónde sale la plata",
    lista: [
      ["Regalías — SGR", "41,3 %"],
      ["Participaciones", "28,7 %"],
      ["Recursos propios", "19,4 %"],
    ],
    base: "Basado en 214 procesos de esta entidad",
  },
  {
    icon: Banknote,
    titulo: "Cuánto tarda en pagar",
    cifra: "14 días",
    sufijo: "mediana entre acta aprobada y pago",
    base: "Basado en 1.240 pagos de esta entidad",
  },
  {
    icon: CalendarClock,
    titulo: "Probabilidad de prórroga",
    cifra: "32 %",
    sufijo: "de sus contratos, con mediana de +64 días",
    base: "Basado en 486 contratos terminados",
  },
  {
    icon: MapPin,
    titulo: "Dónde se ejecuta",
    cifra: "3",
    sufijo: "municipios, georreferenciados en mapa",
    base: "Directo del expediente del SECOP",
  },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-20">
    <div data-reveal>
      <h2 class="max-w-[26ch] text-3xl font-extrabold leading-tight tracking-tight text-grafito-900 sm:text-4xl">
        Las ocho tarjetas, sobre un proceso de ejemplo
      </h2>
      <p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-grafito-500">
        Tal cual se ven en la app, con una licitación de <span class="dato font-semibold text-grafito-900">$350&#160;M</span> en
        la mano: cuatro responden antes de ofertar y cuatro te dicen qué te espera si la ganas.
        En el centro, el panel de verdad, calculando.
      </p>
    </div>

    <!-- El envoltorio del panel de la app: rounded-2xl, borde y baño azul -->
    <div class="mt-10 rounded-2xl border border-azul-500/30 bg-azul-50 p-4 ring-1 ring-azul-500/10 sm:p-5" data-reveal data-delay="100">

      <!-- Cabecera del panel, como en la app -->
      <header class="flex flex-wrap items-center gap-x-3 gap-y-1.5 px-1 pb-4">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-azul-500 text-white" aria-hidden="true">
          <Target size={18} stroke-width={1.75} />
        </span>
        <h3 class="text-base font-bold text-grafito-900">
          Estadística de la licitación
          <span class="ml-2 rounded-full bg-azul-500/10 px-2 py-0.5 align-middle text-[11px] font-semibold text-azul-700">Lo que decide</span>
        </h3>
        <p class="w-full text-[13px] leading-snug text-grafito-600 sm:ml-auto sm:w-auto">
          <span class="codigo dato">LP-014-2026</span> · Mejoramiento de vía terciaria ·
          <span class="dato font-semibold">$350.000.000</span>
        </p>
      </header>

      <div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.9fr)_minmax(0,1fr)] [&>*]:min-w-0">

        <!-- Fila «Antes de ofertar», filete azul (Fila de la app) -->
        <div class="border-l-[3px] border-azul-500 pl-3 max-xl:order-2">
          <h4 class="mb-2 flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-azul-700">
            <span class="h-1.5 w-1.5 rounded-full bg-azul-500" aria-hidden="true"></span>
            Antes de ofertar
          </h4>
          <div class="grid gap-2 sm:max-xl:grid-cols-2">
            {antes.map((t) => (
              <article class="flex min-h-[132px] min-w-0 flex-col rounded-xl border border-papel-200 bg-white p-3 transition hover:border-papel-300">
                <header class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-grafito-500">
                  <span class="text-azul-600" aria-hidden="true"><t.icon size={16} stroke-width={1.5} /></span>
                  {t.titulo}
                </header>
                <div class="mt-1.5 min-w-0 flex-1">
                  {t.cifra && (
                    <div class="flex items-center gap-1.5">
                      <span class="dato text-2xl font-bold leading-none text-grafito-900">{t.cifra}</span>
                      {t.sufijo && <span class="text-xs leading-snug text-grafito-500">{t.sufijo}</span>}
                    </div>
                  )}
                  {t.lista && (
                    <ul>
                      {t.lista.map(([n, v]) => (
                        <li class="flex items-baseline justify-between gap-2 border-b border-papel-150 py-1 last:border-b-0">
                          <span class="truncate text-[12px] text-grafito-700">{n}</span>
                          <span class="dato shrink-0 text-[12px] font-semibold text-grafito-900">{v}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="mt-2 inline-block rounded-lg bg-azul-500/5 px-2 py-0.5 text-[11px] font-semibold leading-snug text-azul-700 ring-1 ring-azul-500/20">{t.base}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- El panel de verdad, calculando, en el centro -->
        <div class="self-center max-xl:order-1">
          {videoPanel ? (
            <div class="overflow-hidden rounded-xl border border-papel-200 bg-white">
              <div class="flex items-center border-b border-papel-200 bg-papel-100 px-4 py-2.5">
                <div class="dato flex-1 truncate rounded border border-papel-200 bg-white px-3 py-1 text-[11px] text-grafito-500">
                  app.contradar.com.co/busquedas
                </div>
              </div>
              <VideoDemo
                src={videoPanel}
                poster={posterPanel}
                alt="Estadística de la licitación en ContRadar: el panel calcula y va llenando sus bloques con los datos de esa entidad"
              />
            </div>
          ) : (
            <Captura src={null} alt="Grabación del panel de estadística" archivo="panel-estadistica-video.mp4" />
          )}
          <p class="mt-3 px-1 text-center text-[11px] leading-snug text-grafito-500">
            Cifras históricas de los datos abiertos del SECOP, con su nivel de evidencia.
            Describen lo que pasó; no recomiendan precio.
          </p>
        </div>

        <!-- Fila «Si ganas», filete jade (Fila de la app, tono jade) -->
        <div class="border-l-[3px] border-jade-500 pl-3 max-xl:order-3">
          <h4 class="mb-2 flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-jade-700">
            <span class="h-1.5 w-1.5 rounded-full bg-jade-500" aria-hidden="true"></span>
            Si ganas
          </h4>
          <div class="grid gap-2 sm:max-xl:grid-cols-2">
            {siGanas.map((t) => (
              <article class="flex min-h-[132px] min-w-0 flex-col rounded-xl border border-papel-200 bg-white p-3 transition hover:border-papel-300">
                <header class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-grafito-500">
                  <span class="text-azul-600" aria-hidden="true"><t.icon size={16} stroke-width={1.5} /></span>
                  {t.titulo}
                </header>
                <div class="mt-1.5 min-w-0 flex-1">
                  {t.cifra && (
                    <div class="flex items-center gap-1.5">
                      <span class="dato text-2xl font-bold leading-none text-grafito-900">{t.cifra}</span>
                      {t.sufijo && <span class="text-xs leading-snug text-grafito-500">{t.sufijo}</span>}
                    </div>
                  )}
                  {t.lista && (
                    <ul>
                      {t.lista.map(([n, v]) => (
                        <li class="flex items-baseline justify-between gap-2 border-b border-papel-150 py-1 last:border-b-0">
                          <span class="truncate text-[12px] text-grafito-700">{n}</span>
                          <span class="dato shrink-0 text-[12px] font-semibold text-grafito-900">{v}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="mt-2 inline-block rounded-lg bg-azul-500/5 px-2 py-0.5 text-[11px] font-semibold leading-snug text-azul-700 ring-1 ring-azul-500/20">{t.base}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

      </div>
    </div>

    <p class="mt-6 max-w-[70ch] text-xs leading-relaxed text-grafito-400">
      Proceso y cifras de ejemplo, con empresas inventadas. En la app cada tarjeta se calcula
      para la licitación que estás mirando — y si el dato no existe, se dice: no se rellena.
    </p>
  </div>
</section>
