---
// TarjetasEstadistica.astro — solo en /producto/estadistica-de-la-licitacion/
// (1-sep-2026, dos vueltas de John el mismo día: «dibujar las tarjetas con un
// contrato de 350 millones» → «con el diseño exactamente igual al de la app»
// → «cada tarjeta alrededor del video»).
//
// Es el PANEL DE LA APP a tamaño página: el mismo envoltorio azul de
// BloquesInteligencia.tsx, la grabación real en el centro, y las ocho
// tarjetas reales alrededor — «Antes de ofertar» a la izquierda con filete
// azul, «Si ganas» a la derecha con filete jade. La anatomía de cada tarjeta
// está COPIADA de la app (Tarjeta/Fila/ChipNivel de BloquesInteligencia.tsx):
// borde papel-200 sobre blanco, cabecera 11px mayúscula gris con icono azul,
// cifra 24px en .dato, y el chip «Basado en N…» con ring azul. Si la app
// cambia, esto se cambia con ella.
//
// El video viene de ExpedienteSection, que en esta página va con
// conPanel={false} para no enseñarlo dos veces.
//
// Cifras de un proceso de EJEMPLO coherente ($350 M); empresas inventadas
// (regla: la landing no expone a nadie).
import { Target, Users, ListChecks, FileText, Coins, Banknote, CalendarClock, MapPin } from "@lucide/astro";
import VideoDemo from "./VideoDemo.astro";
import Captura from "./Captura.astro";
import { captura } from "../lib/capturas";
const videoPanel = captura("panel-estadistica-video");
const posterPanel = captura("panel-estadistica");

const antes = [
  { icon: Target, titulo: "Dónde ofertaron las ganadoras", cifra: "$322 – $339 M", pie: "mediana −5,2 % del presupuesto", base: "214 procesos de esta entidad" },
  { icon: Users, titulo: "Competidores probables", cifra: "3 rivales", pie: "el más fuerte gana 3 de cada 8", base: "procesos parecidos 2019–2026" },
  { icon: ListChecks, titulo: "¿Venía en el plan anual?", cifra: "Sí", pie: "en el PAA desde enero, por $340 M", base: "PAA 2026 de la entidad" },
  { icon: FileText, titulo: "Documentos del proceso", cifra: "12", pie: "pliego, estudios previos y presupuesto", base: "expediente del SECOP" },
];

const siGanas = [
  { icon: Coins, titulo: "De dónde sale la plata", cifra: "41,3 %", pie: "regalías; el resto, participaciones", base: "214 procesos de esta entidad" },
  { icon: Banknote, titulo: "Cuánto tarda en pagar", cifra: "14 días", pie: "mediana entre acta y pago", base: "1.240 pagos de esta entidad" },
  { icon: CalendarClock, titulo: "Probabilidad de prórroga", cifra: "32 %", pie: "con mediana de +64 días", base: "486 contratos terminados" },
  { icon: MapPin, titulo: "Dónde se ejecuta", cifra: "3", pie: "municipios, en mapa", base: "expediente del SECOP" },
];

/* Posiciones de las ocho tarjetas alrededor del video (John, 1-sep): las
   azules arriba, saliendo de cada esquina superior y montadas POR DELANTE
   del video; las jade abajo, en las esquinas y dos en el medio.

   Se anclan al VIDEO, no al contenedor: los porcentajes resuelven contra la
   caja del panel, así que el solape con sus esquinas es el mismo a cualquier
   ancho. Con 40 % de ancho cada una, las cuatro de abajo dejan 2-4 % de aire
   entre sí — comprobado midiendo, no a ojo.

   Umbral 1400 px, no `xl` (1280): medido, a 1280 el panel mide 301 px de
   alto y dos tarjetas apiladas por lado piden 300 — la de «Dónde ofertaron
   las ganadoras» parte el título en dos líneas y se comía 24 px de la de
   abajo. Por debajo del umbral se apilan en rejilla, que es legible y no
   miente. La sección corre además su propio ancho (90rem) en ese tramo,
   para que el panel sea alto y las tarjetas quepan de sobra. */
const sitio = {
  a0: "min-[1400px]:absolute min-[1400px]:-left-[34%] min-[1400px]:-top-[7%] min-[1400px]:w-[40%]",
  a1: "min-[1400px]:absolute min-[1400px]:-left-[20%] min-[1400px]:top-[26%] min-[1400px]:w-[40%]",
  a2: "min-[1400px]:absolute min-[1400px]:-right-[34%] min-[1400px]:-top-[7%] min-[1400px]:w-[40%]",
  a3: "min-[1400px]:absolute min-[1400px]:-right-[20%] min-[1400px]:top-[26%] min-[1400px]:w-[40%]",
  g0: "min-[1400px]:absolute min-[1400px]:-left-[34%] min-[1400px]:-bottom-[7%] min-[1400px]:w-[40%]",
  g1: "min-[1400px]:absolute min-[1400px]:left-[8%] min-[1400px]:-bottom-[24%] min-[1400px]:w-[40%]",
  g2: "min-[1400px]:absolute min-[1400px]:right-[8%] min-[1400px]:-bottom-[24%] min-[1400px]:w-[40%]",
  g3: "min-[1400px]:absolute min-[1400px]:-right-[34%] min-[1400px]:-bottom-[7%] min-[1400px]:w-[40%]",
};
---

<section class="bg-white">
  <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-20 min-[1400px]:max-w-[90rem]">
    <div data-reveal>
      {/* Esta sección ABRE la página desde el 1-sep, así que lleva el titular
          principal del módulo; el que traía («Las ocho tarjetas…») pasa a la
          entradilla, donde sigue diciendo lo que se va a ver. */}
      <h2 class="max-w-[26ch] text-3xl font-extrabold leading-tight tracking-tight text-grafito-900 sm:text-4xl">
        Abres una licitación y ya sabes
        <span class="text-azul-600">ocho cosas que el pliego no dice</span>
      </h2>
      <p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-grafito-500">
        Las ocho tarjetas, sobre un proceso de ejemplo.

        Una licitación de <span class="dato font-semibold text-grafito-900">$350&#160;M</span> en la mano.
        Arriba, lo que decides <strong class="font-semibold text-grafito-900">antes de ofertar</strong>;
        abajo, lo que te espera <strong class="font-semibold text-grafito-900">si ganas</strong>.
        En el centro, el panel de verdad calculando.
      </p>
    </div>

    {/* El escenario: el video en el centro y las ocho tarjetas por delante.
        Desde 1280 px van absolutas (ver `sitio`); por debajo se apilan. */}
    <div class="mt-10 min-[1400px]:mt-12 min-[1400px]:pb-[8%] min-[1400px]:pt-[3%]" data-reveal data-delay="100">

      {/* El proceso de ejemplo, para que las cifras cuelguen de algo */}
      <p class="mx-auto mb-5 flex max-w-[58%] flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center text-[0.8125rem] text-grafito-500 max-[1399px]:max-w-none">
        <span class="codigo dato">LP-014-2026</span>
        <span>Mejoramiento de vía terciaria · GOBERNACIÓN DEL ALTIPLANO</span>
        <span class="dato font-semibold text-grafito-900">$350.000.000</span>
      </p>

      {/* El panel, calculando. Es el CONTEXTO de posicionamiento: las
          tarjetas cuelgan de sus esquinas, no del contenedor. */}
      <div class="relative mx-auto min-[1400px]:w-[58%]">
        {videoPanel ? (
          <div class="sombra-flota overflow-hidden rounded-2xl border border-papel-200 bg-white">
            <div class="flex items-center border-b border-papel-200 bg-papel-100 px-4 py-2.5">
              <div class="dato flex-1 truncate rounded border border-papel-200 bg-white px-3 py-1 text-[11px] text-grafito-500">
                app.contradar.com.co/busquedas
              </div>
            </div>
            <VideoDemo
              src={videoPanel}
              poster={posterPanel}
              alt="Estadística de la licitación en ContRadar: el panel calcula y va llenando sus bloques con los datos de esa entidad"
            />
          </div>
        ) : (
          <Captura src={null} alt="Grabación del panel de estadística" archivo="panel-estadistica-video.mp4" />
        )}

      {/* Las ocho, sueltas. En móvil y tableta caen en rejilla debajo. */}
      <div class="grid grid-cols-1 gap-3 pt-8 sm:grid-cols-2 min-[1400px]:block min-[1400px]:pt-0">
        {antes.map((t, i) => (
          <article class:list={["tarjeta-suelta rounded-xl border border-azul-500/30 bg-azul-50 p-3.5", sitio[`a${i}`]]}>
            <header class="flex items-center gap-1.5 text-[11px] font-bold uppercase leading-tight tracking-wide text-azul-700">
              <span class="shrink-0 text-azul-600" aria-hidden="true"><t.icon size={15} stroke-width={1.6} /></span>
              {t.titulo}
            </header>
            <p class="dato mt-2 text-xl font-bold leading-none text-grafito-900">{t.cifra}</p>
            <p class="mt-1.5 text-[12px] leading-snug text-grafito-600">{t.pie}</p>
            <p class="dato mt-2 text-[10px] leading-snug text-grafito-400">Basado en {t.base}</p>
          </article>
        ))}
        {siGanas.map((t, i) => (
          <article class:list={["tarjeta-suelta rounded-xl border border-jade-500/30 bg-jade-50 p-3.5", sitio[`g${i}`]]}>
            <header class="flex items-center gap-1.5 text-[11px] font-bold uppercase leading-tight tracking-wide text-jade-700">
              <span class="shrink-0 text-jade-600" aria-hidden="true"><t.icon size={15} stroke-width={1.6} /></span>
              {t.titulo}
            </header>
            <p class="dato mt-2 text-xl font-bold leading-none text-grafito-900">{t.cifra}</p>
            <p class="mt-1.5 text-[12px] leading-snug text-grafito-600">{t.pie}</p>
            <p class="dato mt-2 text-[10px] leading-snug text-grafito-400">Basado en {t.base}</p>
          </article>
        ))}
      </div>
      </div>

      {/* Rótulos de las dos familias: el color no es el único portador */}
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[11px] font-bold uppercase tracking-wide min-[1400px]:mt-[8%]">
        <span class="flex items-center gap-1.5 text-azul-700">
          <span class="h-2.5 w-2.5 rounded-sm border border-azul-500/30 bg-azul-50" aria-hidden="true"></span>
          Antes de ofertar
        </span>
        <span class="flex items-center gap-1.5 text-jade-700">
          <span class="h-2.5 w-2.5 rounded-sm border border-jade-500/30 bg-jade-50" aria-hidden="true"></span>
          Si ganas
        </span>
      </div>
    </div>

    <p class="mt-8 max-w-[70ch] text-xs leading-relaxed text-grafito-400">
      Proceso y cifras de ejemplo, con empresas inventadas. En la app cada tarjeta se calcula
      para la licitación que estás mirando y dice sobre cuántos casos está medida — y si el
      dato no existe, se dice: no se rellena.
    </p>
  </div>
</section>

<style>
  .sombra-flota {
    box-shadow: var(--sh-flota);
  }
  /* Estas tarjetas SÍ flotan —van por delante del video—, así que la sombra
     está permitida: es lo que las despega del plano de atrás. */
  @media (min-width: 1400px) {
    .tarjeta-suelta {
      z-index: 2;
      box-shadow: var(--sh-flota);
    }
  }
</style>
