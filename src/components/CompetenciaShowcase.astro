---
import Flecha from "./Flecha.astro";
// CompetenciaShowcase.astro — LA sección estrella: Análisis de competencia.
// Cifras vivas desde GET /public/stats; el markup trae respaldo estático.
// Copy honesto: referencias con datos abiertos, nunca promesa de ganar.
// v2 claro: la banda tinta de cada página es una sola (VS en la home);
// el jade se reserva para "ganado" — aquí el acento es azul (producto).
// El CTA va al formulario de solicitud: la app NO tiene ruta /registro.
//
// PUESTA AL DÍA (30-ago-2026). Tres cosas habían quedado atrás:
//   1. El rótulo decía «Inteligencia competitiva». El nombre del módulo se
//      decidió el 29-ago y es **Análisis de competencia**, el mismo del menú
//      de la app. Era el último nombre viejo que quedaba en toda la web.
//   2. No se mencionaba que el espejo trae **SECOP I y SECOP II**. Es el
//      argumento más fuerte que tenemos y estaba callado: mirar solo SECOP II
//      deja fuera a 859.786 proveedores —los que solo ganan en SECOP I— y
//      $1.523,9 billones, la mitad de la contratación del espejo.
//      (regla de CLAUDE.md, 26-ago; el sesgo nos costó ese medio país una vez).
//   3. Faltaban los alias de proveedor: la misma empresa escrita de cinco
//      maneras se resuelve con sigla del RUES y dominio de correo del SECOP
//      (~498k alias). Sin eso, un perfil se parte en cinco perfiles pobres.
//
// LA CAPTURA se descubre desde public/capturas/ (lib/capturas.ts): en cuanto
// exista `perfil-competidor.*` sustituye a la de julio, sin tocar código.
import Captura from "./Captura.astro";
import { captura } from "../lib/capturas";
const foto = captura("perfil-competidor");
---

<section id="competencia" class="scroll-mt-16 bg-papel-100">
  <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-20">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <!-- Texto -->
      <div data-reveal>
        <p class="dato flex items-center gap-3 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-azul-500">
          <span class="h-px w-8 bg-azul-500" aria-hidden="true"></span>
          Análisis de competencia
        </p>

        <h2 class="mt-5 max-w-[24ch] text-3xl font-extrabold leading-tight tracking-tight text-grafito-900 sm:text-4xl">
          Antes de ofertar ya sabes
          <span class="text-azul-600">contra quién compites y con qué precio ganó</span>
        </h2>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-grafito-500">
          Cada adjudicación deja huella en los datos abiertos. ContRadar la convierte en el
          perfil de tu competidor —<strong class="text-grafito-900">qué ganó, con qué entidades,
          a qué precio y con quién se asocia</strong>— en SECOP&#160;I y SECOP&#160;II, desde
          2012 y al día.
        </p>

        <ul class="mt-7 space-y-3.5 text-[15px] leading-relaxed text-grafito-500">
          {[
            ["Las dos plataformas, no una", "SECOP I y SECOP II en el mismo perfil. Mirar solo SECOP II deja fuera a 859.786 proveedores y la mitad de la contratación del país."],
            ["El rival, aunque lo escriban de cinco maneras", "lo encuentras por NIT, por sigla o por el nombre viejo: contratos ganados, entidades que le compran, ticket típico y evolución año a año."],
            ["Quién oferta contra ti, no solo quién ganó", "los proponentes de cada proceso y con qué desvío quedó la adjudicación — así mides qué tan peleado está tu mercado."],
            ["Consorcios y uniones temporales", "con quién se asocia tu competencia, en qué porcentaje participa y qué socios repite."],
          ].map(([b, rest]) => (
            <li class="flex gap-3">
              <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-azul-500"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              <span><strong class="text-grafito-900">{b}:</strong> {rest}</span>
            </li>
          ))}
        </ul>

        <!-- Números reales de la base, servidos por GET /public/stats de la app
             (caché 24h). El markup trae un respaldo estático conservador: si el
             fetch falla, la sección queda exactamente así. El acumulado se
             redondea HACIA ABAJO a cifra defendible; el del año va exacto. -->
        <div class="mt-8 grid grid-cols-2 gap-3" data-reveal data-delay="150">
          <div class="rounded-xl border border-papel-200 bg-white px-4 py-3">
            <div class="text-xl font-extrabold tracking-tight text-grafito-900">
              más de <span class="dato" data-stat-contratos>11&#160;M</span> contratos analizados ·
              <span class="dato" data-stat-proveedores>2,3&#160;M</span> proveedores perfilados
            </div>
            <div class="mt-0.5 text-[11px] leading-snug text-grafito-400">SECOP I y SECOP II, desde 2012</div>
          </div>
          <div class="rounded-xl border border-papel-200 bg-white px-4 py-3">
            <div class="text-xl font-extrabold tracking-tight text-grafito-900">
              <span class="dato" data-stat-procesos>más de 1,3&#160;M</span> procesos nuevos en
              <span class="dato" data-stat-year>2026</span>
            </div>
            <div class="mt-0.5 text-[11px] leading-snug text-grafito-400">y creciendo</div>
          </div>
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal data-delay="250">
          {/* Rótulo corto: con whitespace-nowrap, 57 caracteres imponían 434 px
              de ancho mínimo y recortaban la página en móvil. La oferta de los
              3 análisis baja a la letra pequeña, no se pierde. */}
          <a href="#solicitar" class="inline-flex min-h-[48px] w-full items-center justify-center whitespace-nowrap rounded-lg bg-azul-500 px-6 text-sm font-bold text-white transition hover:bg-azul-600 sm:w-auto">
            Analiza a tu competencia <Flecha />
          </a>
          <a href="/precios/" class="inline-flex min-h-[48px] items-center justify-center whitespace-nowrap rounded-lg border border-papel-300 px-6 text-sm font-semibold text-grafito-900 transition hover:border-azul-500 hover:text-azul-600">
            Ver planes <Flecha />
          </a>
        </div>

        <p class="mt-4 text-xs leading-relaxed text-grafito-400">
          Incluye <strong class="font-semibold text-grafito-500">10 análisis</strong> en tu prueba de 7 días, sin tarjeta.
          Todo sale de datos abiertos oficiales (SECOP I y SECOP II). Un dato no adjudica
          contratos — pero ofertar a ciegas sí los pierde.
        </p>
      </div>

      <!-- Screenshot real del módulo, flotando como en SectorFoto/PrecioFoto -->
      <div class="relative" data-reveal data-delay="200">
        {/* Sin respaldo a /AnalisisCompetencia2.png: esa captura es de julio y
            enseña «Jaderd Smith», «Smith Soluciones S.A» y «Plan Enterprise»
            —nombres que el producto ya no usa— además del menú viejo. Si algún
            día falta la captura, mejor el marco que dice qué falta. */}
        <Captura
          src={foto}
          alt="Módulo de análisis de competencia de ContRadar: contratos ganados por un competidor, entidades y precios"
          archivo="perfil-competidor.webp"
        />
        <div class="sombra-flota absolute -bottom-4 left-6 rounded-xl border border-papel-200 bg-white px-4 py-2.5">
          <div class="dato text-[10px] font-semibold uppercase tracking-[0.14em] text-grafito-400">Pantalla real del producto</div>
          <div class="text-sm font-bold text-grafito-900">Perfil de competidor · <span class="dato">2012 <Flecha /> hoy</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sombra-flota {
    box-shadow: var(--sh-flota);
  }
</style>

<script>
  // Cifras vivas desde la app. Si algo falla (red, CORS, JSON raro), se queda
  // el respaldo estático del markup — la sección nunca se rompe.
  (async () => {
    const STATS_URL = "https://app.contradar.com.co/api/v1/public/stats";
    const set = (attr: string, value: string) => {
      const el = document.querySelector(`[data-stat-${attr}]`);
      if (el) el.textContent = value;
    };
    // Redondeo HACIA ABAJO a una cifra defendible: 3.399.460 → "3,3 M".
    const floorM = (n: number) =>
      (Math.floor(n / 100_000) / 10).toLocaleString("es-CO", {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
      }) + " M";
    const floorMil = (n: number) =>
      Math.floor(n / 1000).toLocaleString("es-CO") + " mil";
    try {
      const res = await fetch(STATS_URL, { signal: AbortSignal.timeout(4000) });
      if (!res.ok) return;
      const d = await res.json();
      if (!(d.total_contratos > 0 && d.total_proveedores > 0 && d.procesos_year > 0)) return;
      set("contratos", d.total_contratos >= 1_000_000 ? floorM(d.total_contratos) : floorMil(d.total_contratos));
      set("proveedores", d.total_proveedores >= 1_000_000 ? floorM(d.total_proveedores) : floorMil(d.total_proveedores));
      set("procesos", Number(d.procesos_year).toLocaleString("es-CO"));
      if (d.year) set("year", String(d.year));
    } catch {
      /* respaldo estático */
    }
  })();
</script>
