---
// Captura.astro — marco de captura del producto, con el hueco resuelto.
//
// Tres modos, y el tercero es el que importa:
//   · Con `src`  → pinta la imagen.
//   · Sin `src`  → pinta un marco técnico que DICE qué archivo falta y con qué
//                  tamaño. Reserva la proporción, así que soltar el archivo no
//                  mueve nada de sitio en la página.
//   · `barra`    → añade la barra de navegador con la ruta de la app, que es
//                  como se enmarcan las capturas en esta web.
//
// Un hueco que se anuncia es mejor que una imagen rota: se ve que falta, se ve
// qué falta, y la maqueta alrededor se puede revisar igual.
import { Image as ImageIcon } from "@lucide/astro";

interface Props {
  /** Ruta pública ya resuelta (usa `capturaO`/`captura` de lib/capturas). */
  src?: string | null;
  alt: string;
  /** Nombre del archivo que hay que soltar, para el marco vacío. */
  archivo: string;
  /** Tamaño recomendado, para el marco vacío. */
  medida?: string;
  /** Proporción reservada. Por defecto 8:5, la de las capturas de escritorio. */
  ratio?: string;
  /** Ruta que se ve en la barra del navegador. Sin barra si se omite. */
  barra?: string;
  class?: string;
  /* El resto se reenvía al <figure>: sin esto, un `data-reveal` puesto por
     quien usa el componente se perdía en silencio y la sección no animaba. */
  [key: string]: unknown;
}
const {
  src = null,
  alt,
  archivo,
  medida = "2400×1500",
  ratio = "8/5",
  barra,
  class: className = "",
  ...resto
} = Astro.props;
---

<figure class={`relative m-0 ${className}`} {...resto}>
  <div class="sombra-captura overflow-hidden rounded-2xl border border-papel-200 bg-white">
    {barra && (
      <div class="flex items-center border-b border-papel-200 bg-papel-100 px-4 py-2.5">
        <div class="dato flex-1 truncate rounded border border-papel-200 bg-white px-3 py-1 text-[11px] text-grafito-500">
          {barra}
        </div>
      </div>
    )}
    {src ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" class="block w-full" />
    ) : (
      <div
        class="grid w-full place-items-center bg-papel-50 px-6 text-center"
        style={`aspect-ratio:${ratio}`}
      >
        <div>
          <span class="mx-auto grid h-11 w-11 place-items-center rounded-xl border border-dashed border-papel-300 text-grafito-400">
            <ImageIcon size={20} stroke-width={1.7} aria-hidden="true" />
          </span>
          <p class="mt-3 text-sm font-semibold text-grafito-500">{alt}</p>
          <p class="dato mt-1 text-[11px] text-grafito-400">
            public/capturas/{archivo} · {medida}
          </p>
        </div>
      </div>
    )}
  </div>
</figure>

<style>
  .sombra-captura {
    box-shadow: var(--sh-flota);
  }
</style>
