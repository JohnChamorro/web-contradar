---
import { CTA_PRIMARIO } from "../consts";
import Flecha from "./Flecha.astro";
// Banda full-bleed (landing-v4, patrón Subaru): foto de fondo SOLO con
// scrim y SOLO titular corto. Nunca párrafos largos encima de foto.
//
// LAS CIFRAS VIVEN DENTRO DE LA BANDA (1-sep-2026). Vivían como franja
// aparte debajo y John lo vio: «los números se ven como separados, como que
// no conectan». La banda afirma «la información con la que ganan, no» y las
// cifras son esa información dimensionada — un solo argumento, una sola
// superficie. Van vivas: GET /public/stats las sirve de la base real
// (tablas refrescadas a diario, caché 24 h); el HTML trae respaldo estático
// conservador y si el fetch falla la banda queda exactamente así (regla 10:
// ninguna cifra nace en 0).
const cifras = [
  { k: "procesos", v: "20 M", t: "procesos públicos", d: "SECOP I y II, desde 2012" },
  { k: "contratos", v: "11 M", t: "contratos analizados", d: "con su ganador y su precio" },
  { k: "empresas", v: "2,3 M", t: "empresas perfiladas", d: "consorcios ya sumados" },
  { k: "entidades", v: "13.145", t: "entidades contratantes", d: "de todo el país" },
];
---

<section
  class="bleed relative flex min-h-[clamp(420px,48vw,560px)] flex-col items-center justify-center bg-tinta-900 bg-cover bg-center px-5 py-12 text-center sm:px-8"
>
  <div class="relative z-[2] max-w-2xl text-white">
    <h2 class="text-3xl font-extrabold leading-[1.05] tracking-tight sm:text-4xl">
      El SECOP es público. La información con la que ganan, no.
    </h2>
    <p class="mx-auto mt-3 max-w-[48ch] text-tinta-txt/85">
      Contra quién vas, a qué precio adjudica esa entidad y en cuántos días paga.
      Sobre datos reales, no promedios del país.
    </p>
    <a
      href="#solicitar"
      class="mt-7 inline-flex min-h-[48px] items-center gap-2 whitespace-nowrap rounded-lg bg-azul-500 px-7 font-bold text-white transition hover:bg-azul-600"
    >
      {CTA_PRIMARIO} <span aria-hidden="true"><Flecha /></span>
    </a>
  </div>

  <!-- La información, dimensionada: mismas superficie y luz que el titular -->
  <div class="relative z-[2] mt-10 w-full max-w-contenido border-t border-white/15 pt-7">
    <p class="dato flex items-center justify-center gap-2 text-[0.6875rem] font-medium uppercase tracking-[0.16em] text-tinta-txt/70">
      <span class="relative inline-flex h-2.5 w-2.5 items-center justify-center" aria-hidden="true">
        <span class="pulso-onda absolute inline-flex h-2 w-2 rounded-full bg-azul-300"></span>
        <span class="pulso-nucleo relative inline-flex h-2 w-2 rounded-full bg-azul-300"></span>
      </span>
      Cifras vivas de la base — se actualizan a diario
    </p>
    <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-7 lg:grid-cols-4">
      {cifras.map((c, i) => (
        <div class={i > 0 ? "lg:border-l lg:border-white/15 lg:pl-6" : ""}>
          <div class="dato text-2xl font-semibold leading-none tracking-tight text-white sm:text-3xl" data-cifra={c.k}>
            {c.v}
          </div>
          <div class="mt-2 text-[0.875rem] font-semibold text-white/90">{c.t}</div>
          <div class="mt-0.5 text-[0.75rem] leading-snug text-tinta-txt/70">{c.d}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Cifras vivas, mismo contrato que CompetenciaShowcase: si algo falla
  // (red, CORS, campo ausente), se queda el respaldo estático del markup.
  (async () => {
    const STATS_URL = "https://app.contradar.com.co/api/v1/public/stats";
    const set = (k: string, v: string) => {
      const el = document.querySelector(`[data-cifra="${k}"]`);
      if (el) el.textContent = v;
    };
    // Redondeo HACIA ABAJO a cifra defendible: 20.114.933 → "20,1 M".
    const floorM = (n: number) =>
      (Math.floor(n / 100_000) / 10).toLocaleString("es-CO", {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
      }) + " M";
    try {
      const res = await fetch(STATS_URL, { signal: AbortSignal.timeout(4000) });
      if (!res.ok) return;
      const d = await res.json();
      if (d.total_procesos > 1_000_000) set("procesos", floorM(d.total_procesos));
      if (d.total_contratos > 1_000_000) set("contratos", floorM(d.total_contratos));
      if (d.total_proveedores > 1_000_000) set("empresas", floorM(d.total_proveedores));
      if (d.total_entidades > 1_000) set("entidades", Number(d.total_entidades).toLocaleString("es-CO"));
    } catch {
      /* respaldo estático */
    }
  })();
</script>

<style>
  /* La foto NO se declara aquí: la pone el observador de Base.astro cuando la
     banda se acerca a la pantalla (`.bleed.cargada`). Un background-image de
     CSS se descarga siempre, esté donde esté, y esta banda vive al final de la
     página: eran 474 KB que se pagaban aunque nadie bajara hasta ella. Medido
     el 30-ago: la portada pesaba 1,60 MB y esta foto era el 30 %.
     Bajó además de 2000 a 1600 px de ancho y a calidad 62 (474 → 257 KB); a
     sangre y bajo un velo tinta al 50-72 % la diferencia no se ve, y se
     comprobó comparando la sección pintada antes y después. */
  .bleed.cargada {
    background-image: image-set(
      url("/fotos/territorio.webp") type("image/webp"),
      url("/fotos/territorio.jpg") type("image/jpeg")
    );
  }
  /* El testigo de «esto está vivo»: el núcleo se PRENDE Y SE APAGA y la onda
     sale de él, como el eco del radar. Propósito «señalar estado», que es uno
     de los cinco permitidos; y es una página que se ve pocas veces, así que la
     entrada está justificada (regla de frecuencia).

     La onda arranca en el mismo instante en que el núcleo enciende: sin ese
     retardo de 0,3 s las dos animaciones se cruzaban y parecía parpadeo, no
     latido. Con prefers-reduced-motion el testigo se queda ENCENDIDO y fijo —
     menos y más suave, nunca apagar el dato. */
  .pulso-nucleo {
    animation: pulso-encender 2.4s ease-in-out infinite;
  }
  .pulso-onda {
    animation: pulso-eco 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    animation-delay: 0.3s;
    opacity: 0;
  }
  @keyframes pulso-encender {
    0%, 55%, 100% { opacity: 1; }
    30% { opacity: 0.18; }
  }
  @keyframes pulso-eco {
    0% { transform: scale(1); opacity: 0.55; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulso-nucleo { animation: none; opacity: 1; }
    .pulso-onda { animation: none; opacity: 0; }
  }

  .bleed::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgb(var(--tinta-900-rgb) / 0.72),
      rgb(var(--tinta-900-rgb) / 0.5)
    );
  }
</style>
