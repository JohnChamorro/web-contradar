---
import { APP_URL, CONTACT_EMAIL, LOGIN_URL, whatsappLink } from "../consts";
const year = new Date().getFullYear();

/* FOOTER «COLUMNAS EN BLANCO» (propuesta 3a de Claude Design, 24-sep-2026).
   CSS portado literal del prompt al <style> de abajo, con los tokens donde el
   valor coincide. Astro limita ese <style> a este componente: sus clases no
   chocan con nada del resto de la web.

   Lo sustituye todo: el pie anterior era una sola franja gris con los enlaces
   en fila, que se rompía entre 900 y 1300 px (ver el historial de git). */
const COLUMNAS = [
  {
    titulo: "Producto",
    enlaces: [
      { href: "/funcionalidades/", label: "Funcionalidades" },
      { href: "/precios/", label: "Precios" },
      { href: `${APP_URL}/diagnostico?utm_campaign=footer`, label: "Diagnóstico gratis" },
      { href: LOGIN_URL, label: "Ingresar" },
    ],
  },
  {
    titulo: "Empresa",
    enlaces: [
      { href: "/nosotros/", label: "Nosotros" },
      { href: "/servicios-a-medida/", label: "Servicios a medida" },
      { href: "/ayuda/", label: "Ayuda" },
    ],
  },
  {
    titulo: "Legal",
    enlaces: [
      { href: "/terminos/", label: "Términos" },
      { href: "/politica-de-datos/", label: "Política de datos" },
    ],
  },
];
---

{/* Cierre 5b (24-sep-2026): el contenido va en el contenedor común (.cr-wrap)
    para caer en el mismo borde que las preguntas y la prueba; la línea
    superior, en el <footer>, va de borde a borde. */}
<footer class="cr-foot">
  <div class="cr-wrap cr-foot__in">
  <div class="cr-foot__grid">
    <div class="cr-foot__brand">
      <a href="/" class="cr-foot__logo" aria-label="ContRadar — inicio">
        <img src="/marca/cr-mark.svg" alt="" height="28" class="cr-foot__mark" />
        <img src="/marca/cr-wordmark.svg" alt="ContRadar" height="16" class="cr-foot__word" />
      </a>
      <p class="cr-foot__tag">Detectamos oportunidades en el SECOP. Tú tomas la decisión.</p>
    </div>

    {COLUMNAS.map((c) => (
      <nav class="cr-foot__col" aria-label={c.titulo}>
        <h3>{c.titulo}</h3>
        {c.enlaces.map((e) => <a href={e.href}>{e.label}</a>)}
      </nav>
    ))}

    <div class="cr-foot__col cr-foot__contact">
      <h3>Contacto</h3>
      {/* email_off: el correo es un punto de contacto, no un botón; ver la
          nota en nosotros.astro. */}
      <!--email_off-->
      <a href={`mailto:${CONTACT_EMAIL}`} class="cr-foot__strong">{CONTACT_EMAIL}</a>
      <!--/email_off-->
      <a
        href={whatsappLink("Hola, tengo una pregunta sobre ContRadar")}
        target="_blank"
        rel="noopener"
        class="cr-foot__strong cr-foot__wa"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3 3Z" /><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2Z" /></svg>
        WhatsApp
      </a>
      <span class="cr-foot__hours">Lunes a viernes · horario laboral</span>
    </div>
  </div>

  <div class="cr-foot__legal">
    <div class="cr-foot__legal-row">
      <div class="cr-foot__pay">
        <span>Pagos procesados por</span>
        <img src="/LogosWompi/wompi-logo.svg" alt="Wompi" height="16" class="cr-foot__wompi" />
        <span>· una idea de Bancolombia</span>
      </div>
      <span class="cr-foot__copy">© {year} ContRadar · Popayán, Colombia · un producto de <strong>eulertech</strong></span>
    </div>
    <p class="cr-foot__disc">
      Trabajamos sobre datos abiertos oficiales del SECOP (datos.gov.co). Las referencias de precio y de
      capacidad residual son estimaciones para apoyar tu decisión; los requisitos y condiciones definitivos
      de cada proceso están en su pliego. ContRadar no es una entidad estatal ni garantiza la adjudicación
      de contratos.
    </p>
  </div>
  </div>
</footer>

<style>
  .cr-foot {
    background: var(--papel-000);                          /* #FFFFFF */
    border-top: 1px solid var(--papel-200);                /* #DCE3EA, de borde a borde */
    padding-block: 56px 36px;
    font-family: 'Manrope', system-ui, sans-serif; color: var(--grafito-900);
  }
  .cr-foot__in { display: flex; flex-direction: column; gap: 40px; }
  .cr-foot__grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1.3fr; gap: 40px; }

  .cr-foot__brand { display: flex; flex-direction: column; gap: 16px; }
  .cr-foot__logo { display: flex; align-items: center; gap: 9px; }
  .cr-foot__logo img { display: block; width: auto; }
  /* El alto va en CSS: la base de Tailwind (`img { height: auto }`) pisa el
     atributo `height` y el logo saldría a su tamaño natural. */
  .cr-foot__mark { height: 28px; }
  .cr-foot__word { height: 16px; }
  .cr-foot__tag { margin: 0; max-width: 250px; font-size: 14px; line-height: 1.6; color: var(--grafito-500); }

  .cr-foot__col { display: flex; flex-direction: column; gap: 12px; }
  .cr-foot__col h3 {
    margin: 0 0 4px;                                       /* 16 px hasta el primer enlace */
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px; font-weight: 400; letter-spacing: .14em; text-transform: uppercase;
    color: var(--grafito-400);                             /* #7E8FA1 */
  }
  .cr-foot__col a { font-size: 14px; font-weight: 500; color: var(--grafito-700); text-decoration: none; }  /* #2C3E50 */
  .cr-foot__col a:hover { color: var(--azul-500); }

  .cr-foot__contact .cr-foot__strong { font-weight: 600; color: var(--azul-500); }   /* #0D4488 */
  .cr-foot__contact .cr-foot__strong:hover { color: var(--azul-600); }               /* #093366 */
  .cr-foot__wa { display: flex; align-items: center; gap: 8px; }
  .cr-foot__wa svg {
    width: 18px; height: 18px; flex: none;
    fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
  }
  .cr-foot__hours { font-size: 14px; color: var(--grafito-500); }

  .cr-foot__legal { padding-top: 22px; border-top: 1px solid var(--papel-200); display: flex; flex-direction: column; gap: 12px; }
  .cr-foot__legal-row { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .cr-foot__pay { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--grafito-400); white-space: nowrap; }
  .cr-foot__wompi { display: block; height: 16px; width: auto; }
  .cr-foot__copy { font-size: 12px; color: var(--grafito-400); }
  .cr-foot__copy strong { font-weight: 700; }
  .cr-foot__disc { margin: 0; max-width: 1080px; font-size: 12px; line-height: 1.65; color: var(--grafito-400); }

  @media (max-width: 1023px) {
    .cr-foot__grid { grid-template-columns: repeat(3, 1fr); }
    .cr-foot__brand, .cr-foot__contact { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .cr-foot__grid { grid-template-columns: 1fr 1fr; gap: 32px 24px; }
    .cr-foot__legal-row { flex-direction: column; align-items: flex-start; }
    .cr-foot__pay { flex-wrap: wrap; white-space: normal; }
  }
</style>
