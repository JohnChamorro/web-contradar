---
import { CONTACT_EMAIL, LOGIN_URL, diagnosticoUrl, whatsappLink } from "../consts";
const year = new Date().getFullYear();
/* «Entidades» solo aparece cuando el build trae snapshot (fase 3): sin él la
   página no existe y el enlace daría 404. */
import { leerSnapshot } from "../lib/entidades";
const HAY_ENTIDADES = !!leerSnapshot();

/* FOOTER «COLUMNAS EN BLANCO» (propuesta 3a de Claude Design, 24-sep-2026).
   CSS portado literal del prompt al <style> de abajo, con los tokens donde el
   valor coincide. Astro limita ese <style> a este componente: sus clases no
   chocan con nada del resto de la web.

   Lo sustituye todo: el pie anterior era una sola franja gris con los enlaces
   en fila, que se rompía entre 900 y 1300 px (ver el historial de git). */
const COLUMNAS = [
  {
    titulo: "Producto",
    enlaces: [
      { href: "/funcionalidades/", label: "Funcionalidades" },
      { href: "/inteligencia/", label: "Inteligencia" },
      { href: "/precios/", label: "Precios" },
      { href: "/diagnostico/", label: "Diagnóstico gratis" },
      { href: LOGIN_URL, label: "Ingresar" },
    ],
  },
  {
    titulo: "Recursos",
    enlaces: [
      { href: "/guias/", label: "Guías" },
      { href: "/informes/", label: "Informes" },
      { href: "/ayuda/", label: "Ayuda" },
      { href: "/licitaciones-colombia/", label: "Licitaciones en Colombia" },
      { href: "/guias/minima-cuantia/", label: "Mínima cuantía 2026" },
      { href: "/sectores/", label: "Sectores" },
      { href: "/herramientas/calculadora-capacidad-residual/", label: "Calculadora de K" },
      ...(HAY_ENTIDADES ? [{ href: "/entidades/", label: "Entidades" }] : []),
      { href: "/alternativas/", label: "Comparativas" },
    ],
  },
  {
    titulo: "Empresa",
    enlaces: [
      { href: "/nosotros/", label: "Nosotros" },
      { href: `mailto:${CONTACT_EMAIL}`, label: "Contacto" },
      { href: whatsappLink("Hola, tengo una pregunta sobre ContRadar"), label: "WhatsApp" },
      { href: "/servicios-a-medida/", label: "Servicios a medida" },
      { href: "/terminos/", label: "Términos" },
      { href: "/politica-de-datos/", label: "Privacidad" },
    ],
  },
];
---

{/* Ancho: casi de borde a borde, con 120 px de margen (John, 24-sep). Probó
    el contenedor común del cierre 5b (1200 px, alineado con las preguntas y
    la prueba) y prefirió este ancho; del 5b se queda el resto del diseño. */}
<footer class="cr-foot">
  <div class="cr-foot__in">
  <div class="cr-foot__grid">
    <div class="cr-foot__brand">
      <a href="/" class="cr-foot__logo" aria-label="ContRadar — inicio">
        <img src="/marca/cr-mark.svg" alt="" width="30" height="28" class="cr-foot__mark solo-claro" />
        <img src="/marca/cr-wordmark.svg" alt="ContRadar" width="109" height="16" class="cr-foot__word solo-claro" />
        <img src="/marca/cr-mark-blanco.svg" alt="" width="30" height="28" class="cr-foot__mark solo-oscuro" />
        <img src="/marca/cr-wordmark-blanco.svg" alt="ContRadar" width="109" height="16" class="cr-foot__word solo-oscuro" />
      </a>
      <p class="cr-foot__tag">Toda la contratación pública de Colombia, en un solo radar.</p>
    </div>

    {COLUMNAS.map((c) => (
      <nav class="cr-foot__col" aria-label={c.titulo}>
        <h3>{c.titulo}</h3>
        {c.enlaces.map((e) => <a href={e.href}>{e.label}</a>)}
      </nav>
    ))}
  </div>

  <div class="cr-foot__legal">
    <div class="cr-foot__legal-row">
      <span class="cr-foot__copy">© {year} ContRadar · Un producto de Eulertech</span>
      <span class="cr-foot__copy">Datos abiertos del SECOP I y II</span>
    </div>
    <div class="cr-foot__pay">
      <span>Pagos procesados por</span>
      <img src="/LogosWompi/wompi-logo.svg" alt="Wompi" width="68" height="16" class="cr-foot__wompi" />
      <span>· una idea de Bancolombia</span>
    </div>
    <p class="cr-foot__disc">
      Las referencias de precio y de capacidad residual son estimaciones para apoyar tu decisión; los requisitos y
      condiciones definitivos de cada proceso están en su pliego. ContRadar no es una entidad estatal ni garantiza la
      adjudicación de contratos.
    </p>
  </div>
  </div>
</footer>

<style>
  .cr-foot {
    background: var(--bg-web);
    padding: 72px var(--web-pad) 32px; /* a todo el ancho de la pantalla (John, 31-oct-2026) */
    font-family: 'Manrope', system-ui, sans-serif; color: var(--ink);
  }
  .cr-foot__in { display: flex; flex-direction: column; gap: 40px; }
  .cr-foot__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr)); gap: 40px; }

  .cr-foot__brand { display: flex; flex-direction: column; gap: 16px; }
  .cr-foot__logo { display: flex; align-items: center; gap: 9px; }
  .cr-foot__logo img { display: block; width: auto; }
  /* El `display: block` de arriba pisaba el `.solo-claro`/`.solo-oscuro` global
     y en oscuro salían los dos logos (2-nov-2026). */
  .cr-foot__logo img.solo-oscuro { display: none; }
  :global(:root[data-theme="dark"]) .cr-foot__logo img.solo-claro { display: none; }
  :global(:root[data-theme="dark"]) .cr-foot__logo img.solo-oscuro { display: block; }
  /* El alto va en CSS: la base de Tailwind (`img { height: auto }`) pisa el
     atributo `height` y el logo saldría a su tamaño natural. */
  .cr-foot__mark { height: 28px; }
  .cr-foot__word { height: 16px; }
  .cr-foot__tag { margin: 0; max-width: 280px; font-size: 15px; line-height: 1.6; color: var(--muted); }

  .cr-foot__col { display: flex; flex-direction: column; gap: 12px; }
  .cr-foot__col h3 {
    margin: 0;
    font-size: var(--fs-w-14); font-weight: 800; letter-spacing: normal; word-spacing: normal;
    color: var(--ink);
  }
  .cr-foot__col a { font-size: 14px; color: var(--muted); text-decoration: none; font-weight: 400; }
  .cr-foot__col a:hover { color: var(--link); }

  .cr-foot__contact .cr-foot__strong { font-weight: 600; color: var(--link); }   /* #0D4488 */
  .cr-foot__contact .cr-foot__strong:hover { color: var(--link-hover); }               /* #093366 */
  .cr-foot__wa { display: flex; align-items: center; gap: 8px; }
  .cr-foot__wa svg {
    width: 18px; height: 18px; flex: none;
    fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
  }
  .cr-foot__hours { font-size: 14px; color: var(--grafito-500); }

  .cr-foot__legal { padding-top: 22px; border-top: 1px solid var(--papel-200); display: flex; flex-direction: column; gap: 12px; }
  .cr-foot__legal-row { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .cr-foot__pay { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--grafito-500); white-space: nowrap; }
  .cr-foot__wompi { display: block; height: 16px; width: auto; }
  .cr-foot__copy { font-size: 12px; color: var(--grafito-500); }
  .cr-foot__copy strong { font-weight: 700; }
  .cr-foot__disc { margin: 0; max-width: 1080px; font-size: 12px; line-height: 1.65; color: var(--grafito-500); }

  @media (max-width: 1023px) {
    .cr-foot__grid { grid-template-columns: repeat(3, 1fr); }
    .cr-foot__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .cr-foot__grid { grid-template-columns: 1fr 1fr; gap: 32px 24px; }
    .cr-foot__legal-row { flex-direction: column; align-items: flex-start; }
    .cr-foot__pay { flex-wrap: wrap; white-space: normal; }
  }
</style>
