---
import Flecha from "./Flecha.astro";
// ExpedienteSection.astro — los ocho bloques de estadística por licitación.
// Es el foso: ningún competidor del país lo tiene, y hasta ago-2026 la web no
// lo mencionaba una sola vez.
//
// PATRÓN REUTILIZADO: el de CompetenciaShowcase.astro — copy a la izquierda
// (rótulo → h2 con la segunda mitad en azul → párrafo lg → checks → par de
// tarjetas de cifra → CTA doble → pie de honestidad) y OBJETO DENSO a la
// derecha, enmarcado como captura con `sombra-flota rounded-2xl border` y su
// chip flotante colgando del borde inferior.
//
// El objeto denso NO es una rejilla de ocho celdas iguales: eso se lee plano.
// Es la ficha real —cabecera del proceso, un bloque DOMINANTE (la banda de
// precio, a 3× del resto) y cinco filas de apoyo—, que es como se ve dentro.
//
// Fondo papel-100: entra entre la banda tinta (VSBand) y ArcoCinco, que es
// blanco. Nunca dos fondos iguales seguidos.
//
// Verificación PRINCIPIOS: objetos = 7 (rótulo, h2, párrafo, checks, par de
// cifras, CTA, panel) · dominante = el panel, y dentro de él la banda de
// precio a 3× · azul en 3 sitios (h2, checks, botón) · cero ámbar/jade/sello.
import { ArrowRight } from "@lucide/astro";
import { captura } from "../lib/capturas";
import PanelEstadisticaMock from "./PanelEstadisticaMock.astro";
import PanelConTarjetas from "./PanelConTarjetas.astro";

/* EL VÍDEO MANDA SOBRE LA MAQUETA. A la derecha va el panel de la app: si
   existe la grabación real (`panel-estadistica-video.mp4`) se pone esa, porque
   enseña lo que ninguna maqueta puede —el panel calculando y llenándose—; si
   no, se queda la réplica en HTML, que nunca envejece. Las dos ocupan el mismo
   sitio, así que la sección no cambia de forma según lo que haya. */
const videoPanel = captura("panel-estadistica-video");
const posterPanel = captura("panel-estadistica");

/* El fondo se pasa desde fuera: en la home entra entre la banda tinta y el
   arco blanco (papel-100); en /funcionalidades cae entre el índice blanco y
   BusquedaInteligente, que ya es papel-100 — ahí va papel-50. La regla de la
   casa es que nunca haya dos fondos iguales seguidos. */
interface Props {
  /** `tinta` es el tratamiento oscuro con trama, el mismo del ROI. */
  fondo?: "tinta" | "papel-100" | "papel-50" | "white";
  /** false = sin el video/maqueta del panel: la página de estadística lo
   *  pinta ella misma rodeado de las ocho tarjetas (TarjetasEstadistica). */
  conPanel?: boolean;
  /** `abre` = el titular de siempre. `detalle` = el de la página de módulo,
   *  donde esta sección ya NO abre: allí manda TarjetasEstadistica con
   *  «Abres una licitación…» y repetirlo diría lo mismo dos veces seguidas
   *  (John, 1-sep). El segundo titular dice que cada licitación se estudia
   *  APARTE — con su entidad, su sector y su territorio. Un primer intento
   *  decía «Ninguna cifra sale del promedio del país» y John lo tumbó con
   *  razón: negar el promedio lo mete en la cabeza del lector y acaba
   *  pareciendo que promediamos. Se afirma lo que hacemos, no lo que no. */
  variante?: "abre" | "detalle";
}
const { fondo = "tinta", conPanel = true, variante = "abre" } = Astro.props;
const esDetalle = variante === "detalle";
const oscuro = fondo === "tinta";
const CLASE_FONDO = {
  tinta: "bg-tinta-900",
  "papel-100": "bg-papel-100",
  "papel-50": "bg-papel-50",
  white: "bg-white",
}[fondo];

/* Los colores de texto se escribieron para la banda tinta —`tinta-txt`,
   `azul-300`, filetes en `white/12`—. En /funcionalidades la sección entra
   sobre papel y ahí ese juego es invisible: blanco sobre blanco. Cada rol
   tiene su pareja clara, y se elige aquí una sola vez. */
const C = oscuro
  ? {
      rotulo: "text-azul-300",
      regla: "bg-azul-300",
      titulo: "text-tinta-txt",
      acento: "text-azul-300",
      cuerpo: "text-tinta-txt-2",
      fuerte: "text-tinta-txt",
      check: "text-azul-300",
      caja: "border-white/12 bg-white/[0.04]",
      btn2: "border-white/20 text-tinta-txt hover:border-azul-300 hover:text-azul-300",
    }
  : {
      rotulo: "text-azul-500",
      regla: "bg-azul-500",
      titulo: "text-grafito-900",
      acento: "text-azul-600",
      cuerpo: "text-grafito-500",
      fuerte: "text-grafito-900",
      check: "text-azul-500",
      caja: "border-papel-200 bg-white",
      btn2: "border-papel-300 text-grafito-900 hover:border-azul-500 hover:text-azul-600",
    };

/* Los cuatro que más deciden, de los ocho. La lista completa vive en la app. */
const claves = [
  ["A qué precio se ganó", "el desvío con el que quedaron las ganadoras de esa entidad, medido sobre sus propias adjudicaciones."],
  ["En cuántos días paga", "de la factura al pago, medido sobre los pagos reales de esa entidad."],
  ["Quién se suele presentar", "los proponentes habituales del comprador, y cuántas veces han ganado."],
  ["Si va a ampliar el presupuesto", "con qué frecuencia esta entidad adiciona sus obras, y cuánto suele añadir cuando lo hace."],
];

---

<section id="inteligencia" class:list={["relative scroll-mt-16", CLASE_FONDO]}>
  {oscuro && (
    <>
      <div class="pointer-events-none absolute inset-0 opacity-[0.03]" aria-hidden="true">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="dots-estadistica" width="32" height="32" patternUnits="userSpaceOnUse">
              <circle cx="1.5" cy="1.5" r="1.5" fill="white" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#dots-estadistica)" />
        </svg>
      </div>
      <div class="pointer-events-none absolute right-1/4 top-0 h-96 w-96 rounded-full bg-azul-500/10 blur-3xl" aria-hidden="true"></div>
    </>
  )}
  {/* Con el panel de tarjetas el contenedor se ensancha a 90rem desde
      1400 px: las ocho cuelgan 34 % del ancho del video a cada lado, y en
      max-w-contenido se salían del área visible (medido: −9 px). Es el mismo
      ancho que usa la página del módulo, donde ya estaba comprobado. Los
      bloques de texto siguen atados a max-w-contenido, para no alargar la
      línea de lectura. */}
  <div class:list={["relative mx-auto px-5 py-14 sm:px-8 lg:py-20",
                    conPanel ? "max-w-contenido min-[1440px]:max-w-[90rem]" : "max-w-contenido"]}>

    <!-- Encabezado, centrado: el panel es el objeto dominante y va debajo, así
         que el texto no compite por el lado. -->
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class:list={["dato inline-flex items-center gap-3 text-[0.6875rem] font-medium uppercase tracking-[0.18em]", C.rotulo]}>
        <span class:list={["h-px w-8", C.regla]} aria-hidden="true"></span>
        {esDetalle ? "Licitación por licitación" : "Estadística de la licitación"}
      </p>

      {esDetalle ? (
        <h2 class:list={["mx-auto mt-5 max-w-[26ch] text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl", C.titulo]}>
          Cada licitación se estudia aparte:
          <span class={C.acento}>su entidad, su sector, su territorio</span>
        </h2>
      ) : (
        <h2 class:list={["mx-auto mt-5 max-w-[24ch] text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl", C.titulo]}>
          Abres una licitación y ya sabes
          <span class={C.acento}>ocho cosas que el pliego no dice</span>
        </h2>
      )}

      <p class:list={["mx-auto mt-5 max-w-xl text-lg leading-relaxed", C.cuerpo]}>
        {esDetalle ? (
          <>
            El proceso que tienes delante se estudia con su propia historia: cómo adjudica
            <strong class={C.fuerte}> esa entidad</strong>, qué pasa en tu sector y qué pasa en
            tu territorio. Cada bloque enseña sobre cuántos casos está medido — eso es lo que
            separa un dato que sirve para ofertar de una cifra de relleno.
          </>
        ) : (
          <>
            No llega sola: llega con su análisis. Ocho bloques de estadística medidos sobre el
            histórico completo del SECOP y cruzados por
            <strong class={C.fuerte}>esa entidad</strong>, tu sector y tu departamento
            — cada uno con la muestra a la vista.
          </>
        )}
      </p>
    </div>

    <!-- EL PANEL, EN EL CENTRO (John, 30-ago). Era la columna derecha de una
         rejilla de dos; ahí competía con el texto y se leía como ilustración.
         Es la pieza dominante de la sección —el producto entero cabe en ella—,
         así que va sola y centrada. El ancho se mantiene: `max-w-3xl` es
         prácticamente el que tenía como media columna a 1440, y desde el 30-ago va un
         30 % más grande (768 → 992 px) a pedido de John: es la pieza que más
         vende y aguanta el tamaño.

         Si existe la grabación real se pone esa, porque enseña lo que ninguna
         maqueta puede —el panel calculando y llenándose—; si no, se queda la
         réplica en HTML, que nunca envejece. -->
    <!-- En la portada el panel va con sus ocho tarjetas alrededor, igual que
         en la página del módulo (John, 1-sep). Sin la ficha del proceso: el
         encabezado de esta sección ya presentó de qué se habla.

         OJO, y esto ya costó una fuga a producción: este comentario va FUERA
         de la expresión de abajo, porque dentro de una expresión solo cabe UN
         hijo. Y va en comentario HTML, no en el de llaves: escribir un
         comentario de llaves ANIDADO dentro de otro lo cierra en el primer
         cierre y el resto del texto se pinta en la página. Fue exactamente lo
         que pasó aquí: en PRD se leía «ahí rompe la compilación» debajo del
         titular. Los comentarios de llaves NO se anidan. -->
    {conPanel && (
      <PanelConTarjetas conFicha={false} class="mx-auto mt-12 max-w-[62rem] min-[1440px]:max-w-none" />
    )}

    <!-- Lo que dice el panel, debajo y en dos columnas -->
    <div class="mx-auto mt-12 grid max-w-contenido gap-10 lg:grid-cols-2 lg:gap-12">

      <div data-reveal>
        <ul class:list={["space-y-3.5 text-[15px] leading-relaxed", C.cuerpo]}>
          {claves.map(([b, resto]) => (
            <li class="flex gap-3">
              <svg viewBox="0 0 20 20" fill="currentColor" class:list={["mt-0.5 h-5 w-5 shrink-0", C.check]} aria-hidden="true">
                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/>
              </svg>
              <span><strong class={C.fuerte}>{b}:</strong> {resto}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8 grid grid-cols-2 gap-3">
          <div class:list={["rounded-xl border px-4 py-3", C.caja]}>
            <div class:list={["text-xl font-extrabold tracking-tight", C.titulo]}>
              <span class="dato">6</span> de <span class="dato">8</span> bloques
            </div>
            <div class:list={["mt-0.5 text-[11px] leading-snug", C.cuerpo]}>
              con datos de esa misma entidad, en obra
            </div>
          </div>
          <div id="la-muestra" class:list={["scroll-mt-24 rounded-xl border px-4 py-3", C.caja]}>
            <div class:list={["text-xl font-extrabold tracking-tight", C.titulo]}>
              <span class="dato">658&#160;M</span> de registros
            </div>
            <div class:list={["mt-0.5 text-[11px] leading-snug", C.cuerpo]}>
              de <span class="dato">81</span> fuentes oficiales, desde <span class="dato">2012</span>
            </div>
          </div>
        </div>
      </div>

      <div data-reveal data-delay="150">
        <div class:list={["rounded-xl border p-5", C.caja]}>
          <p class:list={["dato text-[0.625rem] uppercase tracking-[0.14em]", C.rotulo]}>
            Cómo salen estos números
          </p>
          <p class:list={["mt-2 text-[0.9375rem] leading-relaxed", C.cuerpo]}>
            Bajamos y analizamos
            <strong class={C.fuerte}>toda la contratación pública del país</strong>,
            y de ahí se estudia tu proceso: el comportamiento de esa entidad, el de tu
            sector y el de tu territorio, con varios pasos de análisis estadístico hasta
            que cada cifra aguanta.
          </p>
          <p class:list={["mt-3 text-[0.9375rem] leading-relaxed", C.cuerpo]}>
            Por eso cada número te dice <strong class={C.fuerte}>de dónde sale</strong>
            —de esa entidad, de tu departamento o del país— y
            <strong class={C.fuerte}>sobre cuántos casos está medido</strong>.
          </p>
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href="#solicitar" class="inline-flex min-h-[48px] w-full items-center justify-center whitespace-nowrap rounded-lg bg-azul-500 px-6 text-sm font-bold text-white transition hover:bg-azul-600 sm:w-auto">
            Ver una licitación por dentro <ArrowRight size={16} stroke-width={2} class="ml-2" aria-hidden="true" />
          </a>
          <a href="/producto/analisis-de-competencia/" class:list={["inline-flex min-h-[48px] items-center justify-center whitespace-nowrap rounded-lg border px-6 text-sm font-semibold transition", C.btn2]}>
            Ver el módulo <Flecha />
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
