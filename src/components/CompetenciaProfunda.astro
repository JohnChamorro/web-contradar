---
// CompetenciaProfunda.astro — solo en /producto/analisis-de-competencia/
// (1-sep-2026, John: «ampliar cada concepto y explicar un poco más»).
//
// REGLA DE CONTENIDO, del encargo mismo: se explica desde lo LLAMATIVO —
// qué preguntas responde el módulo y qué decides con eso — y jamás el CÓMO
// lo construimos (qué fuentes cruzamos, cómo resolvemos nombres, qué
// pesa en el perfil): eso es receta para la competencia. Si un texto de
// aquí empieza a contar mecánica interna, va mal.
//
// Estructura: los tres conceptos son las tres pestañas reales del módulo
// (Empresas · Contratantes · Mercado), en el mismo orden que en la app y
// que en las capturas de CompetenciaShowcase, justo arriba. Cada bloque:
// qué es, y las cuatro preguntas que deja respondidas.
import { Swords, Landmark, ChartNoAxesCombined } from "@lucide/astro";
import Captura from "./Captura.astro";
import { captura } from "../lib/capturas";

const bloques = [
  {
    icon: Swords,
    pestana: "Empresas",
    foto: captura("perfil-competidor"),
    archivo: "perfil-competidor.webp",
    alt: "Perfil de un competidor en ContRadar: contratos y valor ganado por año, entidades que le compran y dónde opera",
    titulo: "El perfil del rival, completo",
    intro:
      "Escribes un nombre o un NIT y tienes delante la trayectoria entera de esa empresa en la contratación pública: catorce años de historia, las dos plataformas del SECOP, y sus consorcios ya sumados.",
    preguntas: [
      ["¿Cuánto gana y dónde?", "Contratos año a año, las entidades que le compran una y otra vez, en qué departamentos opera y cuál es su ticket típico."],
      ["¿Qué tan efectivo es?", "No solo lo que ganó: cuántas veces se presentó para ganarlo. Un rival que gana 3 de 8 no se enfrenta igual que uno que gana 8 de 9."],
      ["¿Con quién se asocia?", "Sus consorcios y uniones temporales, con qué porcentaje participa en cada uno y qué socios repite cuando el contrato es grande."],
      ["¿Es el mismo aunque cambie el nombre?", "Por la sigla, por la razón social vieja o por el NIT: llegas al mismo perfil. Un rival no se esconde detrás de cómo lo escribieron."],
    ],
  },
  {
    icon: Landmark,
    pestana: "Contratantes",
    foto: captura("competencia-contratantes"),
    archivo: "competencia-contratantes.webp",
    alt: "Pestaña Contratantes: cuánto tiene abierto cada entidad en procesos, cuántos publica y su valor promedio",
    titulo: "La entidad, antes de ofertarle",
    intro:
      "Cada entidad pública tiene sus costumbres: cuánto publica, a quién le adjudica y en qué rangos de valor. Verlas antes de ofertar es la diferencia entre escoger proceso y caer en uno.",
    preguntas: [
      ["¿Cuánto mueve?", "Lo que tiene abierto en procesos ahora mismo, cuántos publica y el valor promedio de sus contratos — para saber si tu tamaño encaja con el suyo."],
      ["¿A quién le compra?", "Los ganadores habituales de esa entidad. Si existe un proveedor de casa que se lleva todo, lo ves antes de gastar una oferta en esa puerta."],
      ["¿Cómo se comporta pagando?", "Su historial como contratante — plazos, prórrogas, adiciones — junto al proceso que estás mirando, para dimensionar el riesgo antes de comprometerte."],
      ["¿Vale la pena pelearla?", "Con las tres respuestas anteriores la decisión deja de ser corazonada: ofertas donde tienes opciones reales y no desperdicias equipo donde no."],
    ],
  },
  {
    icon: ChartNoAxesCombined,
    pestana: "Mercado",
    foto: captura("competencia-mercado"),
    archivo: "competencia-mercado.webp",
    alt: "Pestaña Mercado: procesos publicados, valor total del sector, entidades que más contratan y concentración por departamento",
    titulo: "Tu sector en cifras, hoy y desde 2012",
    intro:
      "El pulso del mercado donde compites: filtras por sector, territorio y modalidad, y las cifras se recalculan para TU mercado — no para el promedio del país.",
    preguntas: [
      ["¿Cuánto vale tu mercado?", "Procesos publicados, valor total y valor promedio por contrato, del año corrido o del histórico completo."],
      ["¿Dónde está la plata?", "La concentración por departamento, en mapa: dónde se contrata mucho tu sector y dónde casi nadie está mirando."],
      ["¿Quién la reparte?", "Las entidades que más contratan lo tuyo, ordenadas por procesos y por valor — tu lista de puertas a tocar, salida de los datos."],
      ["¿Crece o se enfría?", "El año en curso contra catorce de historia: si tu sector se expande, se concentra o se muda de territorio, lo ves antes de decidir dónde crecer."],
    ],
  },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-20">
    <div data-reveal>
      <h2 class="max-w-[26ch] text-3xl font-extrabold leading-tight tracking-tight text-grafito-900 sm:text-4xl">
        Lo que sabes antes de gastar una oferta
      </h2>
      <p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-grafito-500">
        Preparar una oferta cuesta días de trabajo. El módulo existe para que esos días se
        inviertan donde hay opciones reales — estas son las preguntas que deja respondidas,
        pestaña por pestaña.
      </p>
    </div>

    <div class="mt-12 space-y-14">
      {bloques.map((b) => (
        <div class="border-t border-papel-200 pt-10" data-reveal>
          <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] [&>*]:min-w-0">
          <div>
            <div class="flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-papel-100 text-grafito-600" aria-hidden="true">
                <b.icon size={19} stroke-width={1.6} />
              </span>
              <span class="dato rounded-md border border-papel-200 bg-papel-50 px-2.5 py-1 text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-grafito-500">
                Pestaña · {b.pestana}
              </span>
            </div>
            <h3 class="mt-4 text-2xl font-extrabold tracking-tight text-grafito-900">{b.titulo}</h3>
            <p class="mt-3 max-w-[48ch] text-[0.9375rem] leading-relaxed text-grafito-500">{b.intro}</p>
          </div>

          <dl class="grid gap-3 sm:grid-cols-2 [&>*]:min-w-0">
            {b.preguntas.map(([q, a]) => (
              <div class="rounded-xl border border-papel-200 bg-papel-50 p-5 transition hover:border-azul-500/50">
                <dt class="text-[0.9375rem] font-bold leading-snug text-grafito-900">{q}</dt>
                <dd class="mt-2 text-[0.875rem] leading-relaxed text-grafito-500">{a}</dd>
              </div>
            ))}
          </dl>
          </div>

          {/* La captura de ESTA pestaña, junto a la explicación que la
              describe (John, 1-sep): antes las tres vivían amontonadas
              arriba, lejos del texto que las explica. */}
          <Captura
            src={b.foto}
            alt={b.alt}
            archivo={b.archivo}
            class="mt-8"
          />
        </div>
      ))}
    </div>
  </div>
</section>
