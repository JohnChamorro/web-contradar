---
import { CTA_PRIMARIO } from "../consts";
import Flecha from "./Flecha.astro";
import { moneda } from "../lib/formato";
import { plan, precioMes, DESDE } from "../data/producto";
import { LANZAMIENTO_NOV, nov } from "../lib/lanzamiento";
import { TOPE_WOMPI } from "../lib/pagos";
// PlanComparison.astro — comparativa curada de planes (solo lo de más valor).
// ACCESIBILIDAD DE LAS CELDAS (31-ago, hallazgo M8). El significado no puede
// viajar SOLO en el icono. Antes el ✕ era un <span> con `aria-label`: en un
// elemento sin rol, `aria-label` no se anuncia de forma fiable —solo aplica a
// elementos con rol propio—, así que la celda podía leerse vacía. Ahora el
// carácter va `aria-hidden` y el significado en un `.sr-only` de verdad; el
// ✓ es un <svg> con `role="img"`, que es lo que hace válido su `aria-label`.
// El tratamiento visual NO cambia: sigue siendo ✓/✕ en jade y sello, que es
// la decisión de estilo registrada abajo.
//
// Estilo .tabla del sistema v2: encabezados en mono, cebra suave, ✓/✕ en
// jade/sello, borde de línea y radio 12. El precio sigue el interruptor mensual/anual
// de las tarjetas (2-nov-2026); el mensual de un anual, con el total del año debajo.
const plans = [
  { name: "Alerta", p: plan("vigia"), key: "vigia" },
  { name: "Ventaja", p: plan("radar"), key: "radar", featured: true },
  { name: "Dominio", p: plan("enterprise"), key: "enterprise" },
];
const [a, v, d] = [plan("vigia"), plan("radar"), plan("enterprise")];
const n = (x: number | null) => (x == null ? "Sin tope" : String(x));
const T = "Sí"; // el render pinta «Sí» como ✓ y «—» como ✕
// La tabla completa del lanzamiento (John, 2-nov-2026), la misma de la app
// (contradar/frontend/src/lib/comparativaPlanes.tsx) y en el mismo orden. Solo
// PREPARAR va detrás de LANZAMIENTO_NOV. Contra la tabla `plans` (migración
// 19eaca0a923e). «Mercado histórico desde 2012»: verificado contra los datos (SECOP
// Integrado 2012-2017, SECOP I y II desde 2015-2018).
const rows = [
  { g: "Equipo" },
  { f: "Usuarios", v: [a.usuarios, v.usuarios, d.usuarios].map(String) },
  { f: "Tareas, comentarios y asignación", v: ["—", T, T] },
  { g: "Encontrar" },
  { f: "Licitaciones al día en el correo", v: ["Sin tope", "Sin tope", "Sin tope"] },
  { f: "Buscador de SECOP I y II", v: [T, T, T] },
  { f: "Búsquedas automáticas, del sector que quieras", v: [a.busquedas, v.busquedas, d.busquedas].map(n) },
  { f: "Palabras por búsqueda, cada una con sus sinónimos", v: ["3", "6", "18"] },
  { f: "Zonas por búsqueda", v: ["2", "4", "10"] },
  { f: "Días de historial en alertas", v: ["30", "90", "365"] },
  { f: "Filtro por duración", v: [T, T, T] },
  { f: "Por qué te llegó cada licitación", v: [T, T, T] },
  { f: "PAA y sondeos (licitaciones anticipadas)", v: ["—", "—", T] },
  { g: "Decidir" },
  { f: "Cruce con tu RUP e indicadores financieros", v: [T, T, T] },
  { f: "Capacidad residual (K)", v: [T, T, T] },
  { f: "Análisis de empresa, entidad o licitación al mes", v: [a.analisisMes, v.analisisMes, d.analisisMes].map(n) },
  { f: "Cuánto ofertan los que ganan y días de pago", v: ["—", T, T] },
  { f: "Precio de adjudicación por sector y territorio", v: ["—", T, T] },
  { f: "Precio de adjudicación por entidad", v: ["—", "—", T] },
  { f: `Mercado histórico desde ${DESDE}`, v: ["—", T, T] },
  { f: "Quién compite en cada licitación", v: ["Solo cuántos", T, T] },
  { f: "Aviso cuando sale una adenda", v: [T, T, T] },
  { f: "Adendas: qué cambió", v: ["—", T, T] },
  ...(LANZAMIENTO_NOV ? [
    { g: "Preparar" },
    { f: "Pliegos analizados al mes", v: [a.pliegosMes, v.pliegosMes, d.pliegosMes].map(String) },
    { f: "Propuestas con formatos llenos al mes", v: [a.propuestasMes, v.propuestasMes, d.propuestasMes].map(String) },
    { f: "Preguntas al chat del pliego al mes", v: ["—", "300", "1.500"] },
  ] : []),
  { g: "Seguimiento y documentos" },
  { f: "Licitaciones activas en seguimiento", v: [a.seguimiento, v.seguimiento, d.seguimiento].map(n) },
  { f: "Calendario de cierres y vencimientos", v: [T, T, T] },
  { f: "Subir documentos dentro de una licitación", v: ["—", T, T] },
  { f: "Biblioteca de documentos de la empresa", v: ["—", T, T] },
  { f: "Espacio para documentos", v: ["—", "2 GB", "20 GB"] },
  { g: "Ejecutar" },
  { f: "Mis contratos: hitos, pólizas, actas y avisos", v: ["—", T, T] },
  { f: "Exportar tu seguimiento a Excel", v: ["—", T, T] },
  { g: "Soporte" },
  { f: "Soporte", v: ["Correo", "WhatsApp, días hábiles", "WhatsApp con prioridad"] },
] as ({ g: string } | { f: string; v: string[] })[];

---
<section id="todas-las-funciones" class="bg-papel-50 scroll-mt-20">
  <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8 lg:py-20">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-3xl font-extrabold tracking-tight text-grafito-900">Todas las funciones</h2>
      <p class="mt-3 text-lg text-grafito-500">
        Lo que trae cada plan, con sus topes.
      </p>
    </div>

    <div class="mt-10 overflow-x-auto rounded-xl border border-papel-200 bg-white" data-reveal data-delay="100">
      <table class="w-full min-w-[640px] border-collapse text-sm">
        <thead>
          <tr class="border-b border-papel-200">
            <th class="w-[36%] py-4 pl-5 pr-4 text-left"></th>
            {plans.map((p) => (
              <th class="relative px-4 py-4 text-center">
                {p.featured && <div class="absolute left-2 right-2 top-0 h-0.5 rounded-full bg-azul-500"></div>}
                <div class={`dato text-[0.6875rem] font-semibold uppercase tracking-[0.14em] ${p.featured ? "text-azul-600" : "text-grafito-500"}`}>{p.name}</div>
                <div class="pago-par mt-1 text-xs font-semibold text-grafito-900">
                  <div class="solo-anual"><span class="dato">{moneda(precioMes(p.p, "anual"))}</span><span class="font-normal text-grafito-500"> /mes</span>
                    <div class="font-normal text-grafito-500"><span class="dato">{moneda(p.p.total.anual)}</span> al año</div></div>
                  <div class="solo-mensual"><span class="dato">{moneda(p.p.total.mensual)}</span><span class="font-normal text-grafito-500"> /mes</span></div>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => "g" in row ? (
            <tr class="bg-papel-100"><th colspan="4" scope="colgroup" class="py-2.5 pl-5 pr-4 text-left text-[0.8125rem] font-semibold text-grafito-900">{row.g}</th></tr>
          ) : (
            <tr class="border-t border-papel-150 bg-white">
              <td class="py-3 pl-5 pr-4 text-grafito-700">{row.f}</td>
              {row.v.map((val) => (
                <td class="px-4 py-3 text-center text-grafito-700">
                  {val === "—" ? (
                    <span class="text-grafito-300"><span aria-hidden="true">—</span><span class="sr-only">No incluido</span></span>
                  ) : val === "Sí" ? (
                    <svg class="mx-auto h-4 w-4 text-grafito-900" viewBox="0 0 20 20" fill="currentColor" role="img" aria-label="Incluido">
                      <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/>
                    </svg>
                  ) : (
                    <span class="dato">{val}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-5 text-sm leading-relaxed text-grafito-500" data-reveal>
      {nov(<>Topes diarios en todos los planes: <span class="dato">20</span> lecturas nuevas de pliego por empresa y <span class="dato">40</span> preguntas al pliego por persona. </>, null)}Dominio anual se paga por transferencia: supera el tope de <span class="dato">{moneda(TOPE_WOMPI)}</span> de Wompi. Alerta y Ventaja anuales, en línea.
    </p>

    <div class="mt-8 text-center" data-reveal data-delay="150">
      <a href="#solicitar" class="inline-flex min-h-[48px] items-center whitespace-nowrap rounded-lg bg-azul-500 px-7 text-sm font-bold text-white transition hover:bg-azul-600">
        {CTA_PRIMARIO} <Flecha />
      </a>
      <p class="mt-3 text-sm text-grafito-500">Sin permanencia · Configuración guiada en minutos</p>
    </div>
  </div>
</section>
