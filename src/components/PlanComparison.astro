---
import { CTA_PRIMARIO } from "../consts";
import Flecha from "./Flecha.astro";
import { moneda } from "../lib/formato";
import { plan, DESDE } from "../data/producto";
import { LANZAMIENTO_NOV, nov } from "../lib/lanzamiento";
// PlanComparison.astro — comparativa curada de planes (solo lo de más valor).
// ACCESIBILIDAD DE LAS CELDAS (31-ago, hallazgo M8). El significado no puede
// viajar SOLO en el icono. Antes el ✕ era un <span> con `aria-label`: en un
// elemento sin rol, `aria-label` no se anuncia de forma fiable —solo aplica a
// elementos con rol propio—, así que la celda podía leerse vacía. Ahora el
// carácter va `aria-hidden` y el significado en un `.sr-only` de verdad; el
// ✓ es un <svg> con `role="img"`, que es lo que hace válido su `aria-label`.
// El tratamiento visual NO cambia: sigue siendo ✓/✕ en jade y sello, que es
// la decisión de estilo registrada abajo.
//
// Estilo .tabla del sistema v2: encabezados en mono, cebra suave, ✓/✕ en
// jade/sello, borde de línea y radio 12. Precio mensual, como en las tarjetas.
const plans = [
  { name: "Alerta", price: moneda(plan("vigia").total.mensual), key: "vigia" },
  { name: "Ventaja", price: moneda(plan("radar").total.mensual), key: "radar", featured: true },
  { name: "Dominio", price: moneda(plan("enterprise").total.mensual), key: "enterprise" },
];
const [a, v, d] = [plan("vigia"), plan("radar"), plan("enterprise")];
// v = [alerta, ventaja, dominio]; hl = fila donde cambia el plan. Contra la tabla
// `plans` y config.py (migración 8df7fe72b0d4).
const rows = [
  { g: "Equipo" },
  { f: "Usuarios", v: [a.usuarios, v.usuarios, d.usuarios].map(String) },
  { f: "Tareas, comentarios y asignación", v: ["—", "Sí", "Sí"] },
  { f: "Mi día", v: ["—", "Sí", "Sí"] },
  { g: "Encontrar" },
  { f: "Licitaciones al día en el correo", v: ["Sin tope", "Sin tope", "Sin tope"] },
  { f: "Buscador de SECOP I y II", v: ["Sí", "Sí", "Sí"] },
  { f: "Búsquedas automáticas", v: ["1", "3", "6"] },
  { f: "Palabras por búsqueda", v: ["3", "6", "18"] },
  { f: "Zonas por búsqueda", v: ["2", "4", "10"] },
  { f: "Sectores", v: ["1", "1", "3"] },
  { f: "Días de historial en alertas", v: ["30", "90", "365"] },
  { f: "Filtro por duración", v: ["—", "Sí", "Sí"] },
  { f: "Desglose del puntaje", v: ["—", "Sí", "Sí"] },
  { f: "PAA y sondeos (licitaciones anticipadas)", v: ["—", "—", "Sí"] },
  { g: "Decidir" },
  { f: "Cruce con tu RUP e indicadores financieros", v: ["Sí", "Sí", "Sí"] },
  { f: "Capacidad residual (K)", v: ["Sí", "Sí", "Sí"] },
  { f: "Análisis de empresa, entidad o licitación al mes", v: ["5", "30", "Sin tope"] },
  { f: "Cuánto ofertan los que ganan y días de pago de la entidad", v: ["—", "Sí", "Sí"] },
  { f: "Precio de adjudicación por sector y territorio", v: ["—", "Sí", "Sí"] },
  { f: "Precio de adjudicación por entidad", v: ["—", "—", "Sí"] },
  { f: `Mercado histórico desde ${DESDE}`, v: ["—", "Sí", "Sí"] },
  { f: "Quién compite en cada licitación", v: ["Solo cuántos", "Sí", "Sí"] },
  { f: "Adendas: qué cambió", v: ["—", "Sí", "Sí"] },
  { g: nov("Preparar", "Pliego") },
  { f: "Pliegos analizados con IA al mes", v: [a.pliegosMes, v.pliegosMes, d.pliegosMes].map(String) },
  ...(LANZAMIENTO_NOV ? [
    { f: "Preguntas al pliego al mes", v: ["—", "300", "1.500"] },
    { f: "Propuestas con formatos llenos al mes", v: [a.propuestasMes, v.propuestasMes, d.propuestasMes].map(String) },
    { f: "Oferta económica con AIU y APU", v: ["—", "Sí", "Sí"] },
    { f: "Aliados para consorcio", v: ["—", "—", "Sí"] },
  ] : []),
  { f: "Licitaciones activas en seguimiento", v: ["10", "20", "Sin tope"] },
  { f: "Subir documentos dentro de una licitación", v: ["—", "Sí", "Sí"] },
  { f: "Biblioteca de documentos de la empresa", v: ["—", "—", "Sí"] },
  { f: "Espacio para documentos", v: ["—", "2 GB", "20 GB"] },
  { g: "Ejecutar" },
  { f: "Mis contratos: hitos, pólizas, actas y avisos", v: ["—", "Sí", "Sí"] },
  ...(LANZAMIENTO_NOV ? [
    { f: "Vencimientos de la empresa, con avisos a 30, 15 y 7 días", v: ["Sí", "Sí", "Sí"] },
    { f: "Calendario, con Google y Outlook", v: ["Sí", "Sí", "Sí"] },
  ] : []),
  { f: "Exportar a Excel", v: ["—", "—", "Sí"] },
  { f: "Soporte por WhatsApp", v: ["—", "—", "Sí"] },
] as ({ g: string } | { f: string; v: string[] })[];

---
<section id="todas-las-funciones" class="bg-papel-50 scroll-mt-20">
  <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8 lg:py-20">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-3xl font-extrabold tracking-tight text-grafito-900">Todas las funciones</h2>
      <p class="mt-3 text-lg text-grafito-500">
        Lo que trae cada plan, con sus topes.
      </p>
    </div>

    <div class="mt-10 overflow-x-auto rounded-xl border border-papel-200 bg-white" data-reveal data-delay="100">
      <table class="w-full min-w-[640px] border-collapse text-sm">
        <thead>
          <tr class="border-b border-papel-200">
            <th class="w-[36%] py-4 pl-5 pr-4 text-left"></th>
            {plans.map((p) => (
              <th class="relative px-4 py-4 text-center">
                {p.featured && <div class="absolute left-2 right-2 top-0 h-0.5 rounded-full bg-azul-500"></div>}
                <div class={`dato text-[0.6875rem] font-semibold uppercase tracking-[0.14em] ${p.featured ? "text-azul-600" : "text-grafito-500"}`}>{p.name}</div>
                <div class="mt-1 text-xs font-semibold text-grafito-900"><span class="dato">{p.price}</span><span class="font-normal text-grafito-500"> /mes</span></div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => "g" in row ? (
            <tr class="bg-papel-100"><th colspan="4" scope="colgroup" class="py-2.5 pl-5 pr-4 text-left text-[0.8125rem] font-semibold text-grafito-900">{row.g}</th></tr>
          ) : (
            <tr class="border-t border-papel-150 bg-white">
              <td class="py-3 pl-5 pr-4 text-grafito-700">{row.f}</td>
              {row.v.map((val) => (
                <td class="px-4 py-3 text-center text-grafito-700">
                  {val === "—" ? (
                    <span class="text-grafito-300"><span aria-hidden="true">—</span><span class="sr-only">No incluido</span></span>
                  ) : val === "Sí" ? (
                    <svg class="mx-auto h-4 w-4 text-grafito-900" viewBox="0 0 20 20" fill="currentColor" role="img" aria-label="Incluido">
                      <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/>
                    </svg>
                  ) : (
                    <span class="dato">{val}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-5 text-sm leading-relaxed text-grafito-500" data-reveal>
      {nov(<>Topes diarios en todos los planes: <span class="dato">20</span> lecturas nuevas de pliego por empresa y <span class="dato">40</span> preguntas al pliego por persona. </>, null)}Ventaja anual y Dominio anual se pagan por transferencia: superan el tope de <span class="dato">$2.500.000</span> de Wompi.
    </p>

    <div class="mt-8 text-center" data-reveal data-delay="150">
      <a href="#solicitar" class="inline-flex min-h-[48px] items-center whitespace-nowrap rounded-lg bg-azul-500 px-7 text-sm font-bold text-white transition hover:bg-azul-600">
        {CTA_PRIMARIO} <Flecha />
      </a>
      <p class="mt-3 text-sm text-grafito-500">Sin permanencia · Configuración guiada en minutos</p>
    </div>
  </div>
</section>
