---
/**
 * Cronograma: hitos en orden con su plazo (20-nov-2026). Horizontal cuando hay
 * ancho, vertical en celular. El plazo va en ámbar: ámbar = tiempo.
 */
interface Hito { t: string; d?: string; plazo?: string }
interface Props { hitos: Hito[] }
const { hitos } = Astro.props;
---

<ol class="cr" style={`--n:${hitos.length}`}>
  {hitos.map((h, i) => (
    <li>
      <span class="cr-p" aria-hidden="true"><span class="gx-num">{i + 1}</span></span>
      <span class="cr-tx">
        <strong>{h.t}</strong>
        {h.plazo && <span class="cr-plazo">{h.plazo}</span>}
        {h.d && <span class="cr-d gx-mut">{h.d}</span>}
      </span>
    </li>
  ))}
</ol>

<style>
  .cr { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0 14px; position: relative; }
  .cr li { position: relative; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  /* La línea que une los puntos. */
  .cr li:not(:last-child)::after { content: ""; position: absolute; top: 15px; left: 36px; right: -14px; height: 0; border-top: var(--linea-fuerte); }
  .cr-p { width: 32px; height: 32px; border-radius: var(--radius-pill); display: grid; place-items: center; background: var(--soft); color: var(--azul-texto); font-size: var(--fs-w-13); border: 1px solid var(--azul-line); }
  .cr li:last-child .cr-p { background: var(--action); color: var(--on-action); border-color: var(--action); }
  .cr-tx { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .cr-tx strong { font-size: var(--fs-w-15); line-height: 1.3; font-weight: 700; color: var(--ink); text-wrap: balance; }
  .cr-d { font-size: var(--fs-w-13); line-height: 1.45; text-wrap: pretty; }
  .cr-plazo { display: inline-flex; align-items: center; min-height: 24px; padding: 0 10px; border-radius: var(--radius-pill); background: var(--ambar-050); color: var(--ambar-texto); font-size: var(--fs-w-12); font-weight: 700; white-space: nowrap; }
  @container (max-width: 680px) {
    .cr { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .cr li { flex-direction: row; gap: 14px; }
    .cr li:not(:last-child)::after { top: 36px; bottom: -18px; left: 15.5px; right: auto; width: 0; height: auto; border-top: 0; border-left: var(--linea-fuerte); }
    .cr-p { flex: 0 0 32px; }
  }
</style>
