---
/**
 * Barra apilada: de qué se compone un total (20-nov-2026). Rampa tonal del
 * azul, nunca colores nuevos; la leyenda repite cada parte con su cifra.
 */
interface Parte { etiqueta: string; valor: number; texto: string }
interface Props { partes: Parte[]; total?: string }
const { partes, total } = Astro.props;
const suma = partes.reduce((a, p) => a + p.valor, 0);
const tonos = ["var(--azul-700)", "var(--azul-600)", "var(--azul-500)", "var(--azul-300)", "var(--azul-100)"];
---

<div class="ap">
  <div class="ap-barra" aria-hidden="true">
    {partes.map((p, i) => <span style={`flex:${p.valor} 1 0;background:${tonos[i % tonos.length]}`}></span>)}
  </div>
  <ul class="ap-ley">
    {partes.map((p, i) => (
      <li><span class="ap-mu" style={`background:${tonos[i % tonos.length]}`} aria-hidden="true"></span><span>{p.etiqueta}</span><span class="dato ap-v">{p.texto}</span></li>
    ))}
    {total && <li class="ap-tot"><span></span><span>Total</span><span class="dato ap-v">{total}</span></li>}
  </ul>
</div>

<style>
  .ap-barra { display: flex; gap: 3px; height: 40px; border-radius: var(--radius-celda); overflow: hidden; }
  .ap-barra span { min-width: 6px; }
  .ap-ley { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 10px 28px; }
  .ap-ley li { display: grid; grid-template-columns: 12px minmax(0, 1fr) auto; align-items: center; gap: 10px; font-size: var(--fs-w-14); color: var(--ink); }
  .ap-mu { width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--line); }
  .ap-v { font-weight: 700; font-variant-numeric: tabular-nums; }
  .ap-tot { font-weight: 800; }
</style>
