---
/**
 * Ramas: una cosa que se abre en sus tipos (20-nov-2026). Raíz en tinta,
 * ramas con una línea fina que las une. Hasta 4 ramas por fila; en celular,
 * lista con la línea a la izquierda.
 */
interface Rama { t: string; d?: string; tag?: string }
interface Props { raiz: string; ramas: Rama[] }
const { raiz, ramas } = Astro.props;
---

<div class="ra" style={`--n:${ramas.length}`}>
  <p class="ra-raiz">{raiz}</p>
  <ul>
    {ramas.map((r) => (
      <li>
        <strong>{r.t}</strong>
        {r.tag && <span class="ra-tag">{r.tag}</span>}
        {r.d && <span class="gx-mut ra-d">{r.d}</span>}
      </li>
    ))}
  </ul>
</div>

<style>
  .ra { display: flex; flex-direction: column; align-items: center; }
  .ra-raiz { position: relative; padding: 12px 22px; border-radius: var(--radius-pill); background: var(--panel-ink); color: var(--on-action); font-size: var(--fs-w-16); font-weight: 800; text-align: center; }
  .ra-raiz::after { content: ""; position: absolute; left: 50%; top: 100%; width: 0; height: 24px; border-left: var(--linea-fuerte); }
  .ra ul { list-style: none; margin: 24px 0 0; padding: 24px 0 0; width: 100%; display: grid; grid-template-columns: repeat(min(var(--n), 4), minmax(0, 1fr)); gap: 14px; position: relative; }
  /* La barra horizontal va del centro de la primera rama al de la última. */
  .ra ul::before { content: ""; position: absolute; top: 0; left: calc(100% / (2 * min(var(--n), 4))); right: calc(100% / (2 * min(var(--n), 4))); height: 0; border-top: var(--linea-fuerte); }
  .ra li { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 16px; border: 1px solid var(--line); border-radius: var(--radius-celda); background: var(--surface); }
  .ra li::before { content: ""; position: absolute; left: 50%; bottom: calc(100% + 1px); width: 0; height: 24px; border-left: var(--linea-fuerte); }
  .ra strong { font-size: var(--fs-w-15); line-height: 1.3; font-weight: 700; color: var(--ink); }
  .ra-d { font-size: var(--fs-w-13); line-height: 1.45; }
  .ra-tag { display: inline-flex; min-height: 22px; align-items: center; padding: 0 9px; border-radius: var(--radius-pill); background: var(--soft); color: var(--azul-texto); font-size: var(--fs-w-12); font-weight: 700; }
  @container (max-width: 640px) {
    .ra { align-items: stretch; }
    .ra-raiz { align-self: flex-start; }
    .ra-raiz::after { left: 24px; }
    .ra ul { grid-template-columns: minmax(0, 1fr); padding: 0 0 0 48px; margin-top: 24px; }
    .ra ul::before { top: 0; bottom: 28px; left: 24px; right: auto; width: 0; height: auto; border-top: 0; border-left: var(--linea-fuerte); }
    .ra li::before { left: -24px; bottom: auto; top: 26px; width: 24px; height: 0; border-left: 0; border-top: var(--linea-fuerte); }
  }
</style>
