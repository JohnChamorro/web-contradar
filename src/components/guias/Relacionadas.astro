---
import Flecha from "../Flecha.astro";
import { guia } from "../../data/guias";
interface Props {
  slugs: string[];
  titulo?: string;
}
const { slugs, titulo = "Sigue leyendo" } = Astro.props;
const lista = slugs.map(guia);
---

<section class="not-prose mt-12" aria-labelledby="rel-t">
  <h2 id="rel-t" class="text-base font-bold text-grafito-900">{titulo}</h2>
  <ul class="mt-3 grid gap-3 sm:grid-cols-2">
    {lista.map((g) => (
      <li>
        <a href={`/guias/${g.slug}/`} class="group block h-full rounded-xl border border-papel-200 bg-white p-4 transition hover:border-azul-300">
          <span class="block text-[0.9375rem] font-bold text-grafito-900 group-hover:text-azul-600">{g.titulo}</span>
          <span class="mt-1 block text-[0.8125rem] leading-relaxed text-grafito-500">{g.resumen}</span>
          <span class="mt-2 inline-block text-[0.8125rem] font-semibold text-azul-600">Leer <Flecha /></span>
        </a>
      </li>
    ))}
  </ul>
</section>
