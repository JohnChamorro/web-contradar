---
/**
 * Índice lateral de las guías (John, 20-nov-2026: «que al lateral de las guías
 * aparezca un menú con las demás, para que puedan entrar fácil a otras»).
 *
 * Sale de src/data/guias.ts: una guía nueva aparece sola, agrupada por etapa y
 * en el mismo orden del índice /guias/. La actual va marcada con aria-current
 * y en --soft + --link, como el ítem activo del menú de la app.
 *
 * Escritorio (≥1024 px): columna fija a la izquierda que acompaña la lectura.
 * Celular y tableta: un <details> cerrado arriba del texto («Todas las guías»),
 * para no empujar el contenido; se abre con un toque.
 */
import { GUIAS, ETAPAS, type Etapa } from "../../data/guias";

interface Props {
  actual: string;
}
const { actual } = Astro.props;
const etapas = Object.keys(ETAPAS) as Etapa[];
const grupos = etapas
  .map((e) => ({ etapa: e, nombre: ETAPAS[e], guias: GUIAS.filter((g) => g.etapa === e) }))
  .filter((g) => g.guias.length > 0);
---

<nav class="ig" aria-label="Todas las guías">
  <details class="ig-caja" data-indice-guias>
    <summary class="ig-sum">
      <span>Todas las guías</span>
      <span class="ig-n dato">{GUIAS.length}</span>
      <svg class="ig-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </summary>
    <div class="ig-lista">
      <a class="ig-todas" href="/guias/">Todas las guías</a>
      {grupos.map((g) => (
        <section class="ig-grupo" aria-label={g.nombre}>
          <p class="rotulo ig-rot">{g.nombre}</p>
          <ul>
            {g.guias.map((x) => (
              <li>
                <a href={`/guias/${x.slug}/`} aria-current={x.slug === actual ? "page" : undefined}>{x.titulo}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </details>
</nav>

<script>
  /* En escritorio el índice siempre va abierto (es la columna lateral); en
     celular arranca cerrado. Se sincroniza con el ancho, sin parpadeo de
     contenido porque el <details> abierto o cerrado no cambia el texto. */
  const mq = window.matchMedia("(min-width: 1024px)");
  const sync = () => document.querySelectorAll<HTMLDetailsElement>("[data-indice-guias]").forEach((d) => { d.open = mq.matches; });
  sync();
  mq.addEventListener("change", sync);
</script>

<style>
  .ig { min-width: 0; }
  .ig-caja { border: 1px solid var(--line); border-radius: var(--radius-celda); background: var(--surface); }
  .ig-sum { list-style: none; display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 16px; cursor: pointer; font-size: var(--fs-w-15); font-weight: 700; color: var(--ink); touch-action: manipulation; }
  .ig-sum::-webkit-details-marker { display: none; }
  .ig-sum:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; border-radius: var(--radius-celda); }
  .ig-n { color: var(--muted); font-weight: 400; font-variant-numeric: tabular-nums; }
  .ig-chev { margin-left: auto; color: var(--muted); transition: transform var(--motion-fast) ease; }
  .ig-caja[open] .ig-chev { transform: rotate(180deg); }
  .ig-lista { padding: 4px 8px 12px; border-top: 1px solid var(--line-soft); }
  .ig-todas { display: none; }
  .ig-grupo { margin-top: 14px; }
  .ig-rot { margin: 0 0 4px; padding: 0 10px; color: var(--muted); font-size: var(--fs-rotulo-web); }
  .ig ul { list-style: none; margin: 0; padding: 0; }
  .ig li a { display: flex; align-items: center; min-height: 44px; padding: 8px 10px; border-radius: var(--radius-celda); font-size: var(--fs-w-14); line-height: 1.35; color: var(--ink); text-decoration: none; text-wrap: pretty; touch-action: manipulation; }
  .ig li a:hover { background: var(--surface-2); }
  .ig li a[aria-current="page"] { background: var(--soft); color: var(--link); font-weight: 700; }
  .ig a:focus-visible { outline: 2px solid var(--link); outline-offset: -2px; }

  /* Escritorio: columna lateral fija, sin caja ni cabecera plegable. */
  @media (min-width: 1024px) {
    .ig { position: sticky; top: 96px; max-height: calc(100svh - 120px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
    .ig-caja { border: 0; background: none; }
    .ig-sum { display: none; }
    .ig-lista { padding: 0; border-top: 0; }
    .ig-todas { display: flex; align-items: center; min-height: 36px; padding: 0 10px; font-size: var(--fs-w-15); font-weight: 800; color: var(--ink); text-decoration: none; }
    .ig-todas:hover { color: var(--link); }
    .ig li a { min-height: 36px; padding: 6px 10px; }
    .ig-grupo { margin-top: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .ig-chev { transition: none; } }
</style>
