---
/* Fuentes oficiales de la guía: norma, manual o guía de Colombia Compra
   Eficiente con su enlace. Toda afirmación normativa de la guía debe poder
   rastrearse a una de estas. */
export interface Fuente {
  titulo: string;
  url: string;
  /** Qué se tomó de ahí (artículo, numeral). */
  nota?: string;
}
interface Props {
  fuentes: Fuente[];
  /** Fecha en que se consultaron (AAAA-MM-DD). */
  consultadas: string;
  /** «Fuentes oficiales» en guías normativas; «Fuentes» en comparativas,
   *  donde se citan las webs de las propias plataformas. */
  titulo?: string;
}
const { fuentes, consultadas, titulo = "Fuentes oficiales" } = Astro.props;
---

<section class="not-prose mt-12 border-t border-papel-200 pt-6" aria-labelledby="fuentes-t">
  <h2 id="fuentes-t" class="text-base font-bold text-grafito-900">{titulo}</h2>
  <ul class="mt-3 space-y-2 text-[0.875rem] leading-relaxed text-grafito-500">
    {fuentes.map((f) => (
      <li>
        <a href={f.url} rel="noopener" target="_blank" class="font-semibold text-azul-600 hover:underline">{f.titulo}</a>
        {f.nota && <span> — {f.nota}</span>}
      </li>
    ))}
  </ul>
  <p class="dato mt-3 text-[0.75rem] text-grafito-500">Consultadas el {consultadas}. Si algo cambió, escríbenos y lo corregimos.</p>
</section>
