---
/* Migas visibles. El BreadcrumbList del JSON-LD lo pone Base.astro con la
   misma lista: lo que se ve y lo que se declara no pueden diferir. */
interface Props {
  migas: { nombre: string; url: string }[];
  /** Sobre fondo tinta (cabecera de guía) o sobre papel. */
  tono?: "tinta" | "papel";
}
const { migas, tono = "papel" } = Astro.props;
const todas = [{ nombre: "Inicio", url: "/" }, ...migas];
const enlace = tono === "tinta" ? "text-tinta-txt-2 hover:text-white" : "text-grafito-500 hover:text-azul-600";
const actual = tono === "tinta" ? "text-tinta-txt" : "text-grafito-700";
---

<nav aria-label="Ruta de navegación" class="text-xs">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    {todas.map((m, i) => (
      <li class="flex min-w-0 items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class={tono === "tinta" ? "text-tinta-txt-2/60" : "text-grafito-300"}>/</span>}
        {i < todas.length - 1 ? (
          <a href={m.url} class={`transition ${enlace}`}>{m.nombre}</a>
        ) : (
          <span aria-current="page" class={`truncate ${actual}`}>{m.nombre}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
