---
import Logo from "./Logo.astro";
// Nav fase 4 (landing-v4): header claro, mega menú Funcionalidades (6 entradas en dos
// columnas, orden del arco) + Recursos. Hover Y :focus-within; Esc cierra.
// En móvil: acordeón dentro del hamburguesa.
import { APP_URL, LOGIN_URL } from "../consts";
import {
  Radar,
  Target,
  Swords,
  MessageSquareText,
  ChartLine,
  CalendarClock,
  SquareKanban,
  ClipboardCheck,
  BookOpen,
  Building2,
  CircleQuestionMark,
  Users,
  ChevronDown,
  BellRing,
  ArrowRight,
  Sparkles,
  CalendarDays,
} from "@lucide/astro";

// Los módulos se llaman aquí igual que en el menú de la app (reorganización
// jul-2026): quien entra desde la landing encuentra los mismos nombres. Las
// tres primeras entradas son las pestañas de Búsquedas que se venden solas;
// «Análisis de contratantes» desapareció como módulo — hoy es una pestaña de
// Competencia y se cuenta dentro de ella.
/* CINCO ENTRADAS, CINCO PÁGINAS (31-ago-2026, hallazgo M7). Antes eran seis y
   las seis eran anclas del MISMO documento: el menú prometía seis páginas y
   entregaba una de 17.149 px. Ahora cada módulo tiene la suya, bajo /producto/.

   Sondeos (RFI) y Plan anual (PAA) salen del primer nivel y se cuentan dentro
   de Búsquedas, que es lo que ya hacía el resto de la web: son las dos señales
   tempranas de la misma capacidad, no módulos aparte.

   «Gestión de equipo» se parte en sus dos mitades reales —Mis licitaciones y
   Mis contratos—, que es como se llaman en el menú de la app. */
const modulos = [
  {
    href: "/producto/estadistica-de-la-licitacion/",
    icon: Target,
    titulo: "Estadística de la licitación",
    desc: "A qué precio se ganó en tu sector y tu zona, quién se presenta y en cuántos días paga la entidad",
  },
  {
    href: "/producto/analisis-de-competencia/",
    icon: Swords,
    titulo: "Análisis de competencia",
    desc: "El historial completo de tu rival, con sus siglas y consorcios sumados",
  },
  {
    href: "/producto/busquedas/",
    icon: Radar,
    titulo: "Búsquedas automáticas",
    desc: "SECOP I y II cada día, con puntaje de 0 a 100 · incluye sondeos y plan anual",
  },
  {
    href: "/producto/mis-licitaciones/",
    icon: Users,
    titulo: "Mis licitaciones",
    desc: "Tu equipo coordinado hasta la adjudicación, en seis carriles",
  },
  {
    href: "/producto/mis-contratos/",
    icon: CalendarClock,
    titulo: "Mis contratos",
    desc: "Del acta de inicio a la liquidación, sin que se venza una póliza",
  },
  {
    href: "/inteligencia/",
    icon: Sparkles,
    titulo: "Asistente IA",
    desc: "Lee el pliego, responde con la página y llena los formatos",
  },
  {
    href: "/producto/calendario/",
    icon: CalendarDays,
    titulo: "Calendario",
    desc: "Cierres, pólizas y las fechas del equipo, en un solo lugar",
  },
  {
    href: "/producto/notificaciones/",
    icon: BellRing,
    titulo: "Avisos",
    desc: "En la campana y en tu correo: 17 cosas que se vigilan solas",
  },
];


const DIAGNOSTICO_URL_RECURSOS = "/diagnostico/";
const recursos = [
  { href: "/guias/", icon: BookOpen, titulo: "Guías", desc: "Cómo licitar, paso a paso" },
  { href: "/sectores/", icon: Building2, titulo: "Sectores", desc: "Cómo se licita en el tuyo" },
  { href: "/ayuda/", icon: CircleQuestionMark, titulo: "Ayuda", desc: "Preguntas frecuentes y soporte" },
  { href: DIAGNOSTICO_URL_RECURSOS, icon: Radar, titulo: "Diagnóstico gratis", desc: "Lo que dice el SECOP de tu empresa" },
];

/* UN SOLO PRIMARIO POR PANTALLA (31-ago-2026, hallazgo C1).
   La barra ofrecía «Diagnóstico gratis» (enlace), «Ingresar» (botón de
   contorno) y «Prueba gratis» (relleno azul). Medido, solo uno era azul
   lleno, así que la regla ya casi se cumplía — pero en la PORTADA ese azul
   competía con el botón del diagnóstico del hero: dos rellenos azules con
   DESTINOS DISTINTOS por encima del pliegue.

   Ahora el primario de la barra depende de la página:
     · en la portada es «Diagnóstico gratis» y lleva al mismo hero, así que
       refuerza el embudo del NIT en vez de competir con él;
     · en el resto es «Solicitar acceso», que es donde no hay hero que compita.
   «Ingresar» baja a enlace de texto: es para quien YA es cliente, no una
   llamada a la acción. */

/* «DIAGNÓSTICO GRATIS» VA A LA LANDING DE LA WEB (13-oct-2026, John).
   Del 24-sep al 13-oct llevaba a la herramienta en la app
   (app.contradar.com.co/diagnostico, noindex), con utm nav/menu. Es el enlace
   interno más fuerte del sitio —sale en todas las páginas— y se lo estaba
   llevando una URL que Google no puede indexar (Search Console la marcaba
   «Rastreada: actualmente sin indexar»), mientras /diagnostico/, la que sí
   puede posicionar, solo la enlazaban el pie y algunas guías. La landing
   tiene el campo de NIT pegado al H1, visible sin scroll, y su formulario
   manda a la app con utm diagnostico/landing. El hero y los CTA de las guías
   siguen yendo directo a la app. */
const DIAGNOSTICO_URL = "/diagnostico/";

/* Web y app 2027 (#16a): en la portada el menú flota sobre el radar, sin línea. */
const { portada = false } = Astro.props as { portada?: boolean };
const pill = "cr-pil inline-flex items-center gap-1.5 rounded-full px-[15px] py-2 text-sm font-bold transition";

---

<header class={`cabecera sticky top-0 z-50${portada ? " portada" : ""}`} data-cabecera>
  <div class="cab-in">
    <a href="/" class="cab-logo" aria-label="ContRadar">
      <Logo size={32} nombre={23} />
    </a>
    {portada && (
      <script is:inline>
        // Logo 2027 §4.3: en la portada la cuña del logo da UNA vuelta al cargar,
        // con el barrido del radar del hero, una sola vez por sesión.
        (() => {
          try { if (sessionStorage.getItem("cr-logo-vuelta")) return; sessionStorage.setItem("cr-logo-vuelta", "1"); } catch { return; }
          const m = document.querySelector(".cab-logo .cr-mark");
          if (m) m.classList.add("cr-mark--once");
        })();
      </script>
    )}

    <nav class="cab-pildora hidden items-center min-[1240px]:flex" aria-label="principal">
      <!-- Funcionalidades -->
      <div class="mega-item relative">
        <a
          href="/funcionalidades/"
          class={pill}
          aria-haspopup="true"
        >
          Funcionalidades
          <ChevronDown size={14} stroke-width={2.5} class="mega-caret transition-transform" />
        </a>
        <div class="mega-panel absolute left-0 top-full z-[60] pt-2.5">
          <div class="mm mm-ancho flota">
            <div class="mm-lista">
              {modulos.filter((m) => m.href !== "/inteligencia/").map((m) => (
                <a href={m.href} class="mega-link mm-l">
                  <span class="mm-ico"><m.icon size={18} stroke-width={1.7} /></span>
                  <span class="mm-tx"><b>{m.titulo}</b><small>{m.desc}</small></span>
                </a>
              ))}
              <a href="/funcionalidades/" class="mega-link mm-l">
                <span class="mm-ico"><ArrowRight size={18} stroke-width={1.7} /></span>
                <span class="mm-tx"><b>Ver todas</b><small>Lo que hace ContRadar, del plan anual a la liquidación</small></span>
              </a>
            </div>
            {/* Lo más nuevo, destacado; la entrada «Asistente IA» vive aquí. */}
            <a href="/inteligencia/" class="mega-link mm-ia">
              <span class="mm-chip">IA</span>
              <span class="mm-ia-t"><span>El pliego, leído.</span> <b>Los formatos, llenos.</b></span>
              <span class="mm-ia-d">Lee el pliego, responde con la página y llena los formatos.</span>
              <span class="mm-ia-v">Ver cómo funciona →</span>
            </a>
            <a href="/servicios-a-medida/" class="mega-link mm-pie">
              <span>¿Necesitas algo hecho para tu empresa? <b>Servicios a medida</b></span>
              <ArrowRight size={14} stroke-width={2} />
            </a>
          </div>
        </div>
      </div>

      <a href="/inteligencia/" class={pill}>Inteligencia <span class="cab-ia">IA</span></a>

      <a href="/precios/" class={pill}>Precios</a>

      <!-- Recursos -->
      <div class="mega-item relative">
        <button
          type="button"
          class={pill}
          aria-haspopup="true"
        >
          Recursos
          <ChevronDown size={14} stroke-width={2.5} class="mega-caret transition-transform" />
        </button>
        <div class="mega-panel absolute left-0 top-full z-[60] pt-2.5">
          <div class="mm mm-corto flota">
            {recursos.map((r) => (
              <a href={r.href} class="mega-link mm-l">
                <span class="mm-ico"><r.icon size={18} stroke-width={1.7} /></span>
                <span class="mm-tx"><b>{r.titulo}</b><small>{r.desc}</small></span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Nosotros: de primer nivel desde el 30-ago. -->
      <a href="/nosotros/" class={pill}>Nosotros</a>
    </nav>

    <div class="cab-der">
      <button type="button" class="cab-tema" data-tema aria-label="Cambiar el tema"><span aria-hidden="true"></span></button>
      <a href={LOGIN_URL} class="cab-btn borde hidden lg:inline-flex">Ingresar</a>
      <a href="/demo/" class="cab-btn demo hidden lg:inline-flex" data-cta="demo" data-ubicacion="menu" title="Agendar demo"><CalendarDays size={17} stroke-width={1.8} aria-hidden="true" /><span class="tx">Agendar demo</span></a>
      <a href="#solicitar" class="cab-btn tinta hidden lg:inline-flex" data-cta="trial" data-ubicacion="menu">Prueba gratis</a>
    </div>

    <button id="nav-toggle" class="text-grafito-900 min-[1240px]:hidden" aria-label="menú" aria-expanded="false">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Móvil: acordeón -->
  <div id="nav-mobile" class="hidden max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-t border-papel-200 px-5 py-3 min-[1240px]:hidden">
    <a href="/demo/" data-cta="demo" data-ubicacion="menu" class="nav-mobile-link cab-demo-movil flex min-h-[44px] items-center gap-2 border-b border-papel-150 py-2.5 text-sm font-bold">
      <CalendarDays size={17} stroke-width={1.8} aria-hidden="true" />
      Agendar demo
    </a>
    <details class="group border-b border-papel-150">
      <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between py-2.5 text-sm font-semibold text-grafito-900 marker:content-none">
        Funcionalidades
        <ChevronDown size={16} class="text-grafito-500 transition-transform group-open:rotate-180" />
      </summary>
      <div class="pb-2">
        {modulos.map((m) => (
          <a href={m.href} class="nav-mobile-link flex min-h-[44px] items-center gap-3 py-2 pl-2 text-sm text-grafito-500">
            <m.icon size={17} stroke-width={1.7} class="text-grafito-500" />
            {m.titulo}
          </a>
        ))}
        <a href="/servicios-a-medida/" class="nav-mobile-link flex min-h-[44px] items-center gap-2 border-t border-papel-150 py-2 pl-2 text-[0.8rem] text-grafito-500">
          Servicios a medida <ArrowRight size={13} stroke-width={2} />
        </a>
      </div>
    </details>
    <a href="/inteligencia/" class="nav-mobile-link flex min-h-[44px] items-center gap-1.5 border-b border-papel-150 py-2.5 text-sm font-semibold text-grafito-900">
      Inteligencia <span class="cab-ia">IA</span>
    </a>
    <a href="/precios/" class="nav-mobile-link flex min-h-[44px] items-center border-b border-papel-150 py-2.5 text-sm font-semibold text-grafito-900">
      Precios
    </a>
    <a href="/nosotros/" class="nav-mobile-link flex min-h-[44px] items-center border-b border-papel-150 py-2.5 text-sm font-semibold text-grafito-900">
      Nosotros
    </a>
    <details class="group border-b border-papel-150">
      <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between py-2.5 text-sm font-semibold text-grafito-900 marker:content-none">
        Recursos
        <ChevronDown size={16} class="text-grafito-500 transition-transform group-open:rotate-180" />
      </summary>
      <div class="pb-2">
        {recursos.map((r) => (
          <a href={r.href} class="nav-mobile-link flex min-h-[44px] items-center gap-3 py-2 pl-2 text-sm text-grafito-500">
            <r.icon size={17} stroke-width={1.7} class="text-grafito-500" />
            {r.titulo}
          </a>
        ))}
      </div>
    </details>
    <a href={DIAGNOSTICO_URL} class="nav-mobile-link flex min-h-[44px] items-center py-2.5 text-sm font-semibold text-grafito-900">
      Diagnóstico gratis
    </a>
    <div class="mt-2 flex items-center gap-4 border-t border-papel-150 pt-3">
      <a href={LOGIN_URL} class="whitespace-nowrap py-2.5 text-sm font-semibold text-azul-600">
        Ingresar
      </a>
      <a href="#solicitar" class="nav-mobile-link ml-auto flex-1 whitespace-nowrap rounded-full bg-tinta-900 px-4 py-2.5 text-center text-sm font-bold text-white">
        Prueba gratis
      </a>
    </div>
  </div>
</header>

<style>
  /* La cabecera se separa con UNA línea de 1 px, sin sombra (8f, 24-sep-2026).
     La cabecera toma el color del bloque siguiente: el hero empieza en blanco
     a la izquierda, así que el menú sigue blanco, y bajo él entra la forma
     tinta del hero, donde una sombra difusa se veía sucia. Antes: hairline al
     5 % más una difusa corta. */
  .cabecera {
    border-bottom: 1px solid var(--line);
    box-shadow: none;
    background: var(--bg-web);
  }
  .cabecera.portada { border-bottom-color: transparent; background: transparent; transition: background-color var(--t-med); }
  /* Web Radar §0: fondo al 94 % con desenfoque y la línea de 1 px al bajar. */
  .cabecera.portada.bajo { background: color-mix(in srgb, var(--bg-web) 94%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-bottom-color: var(--line); }
  .cab-in { min-height: 76px; padding: 0 var(--web-pad); display: flex; align-items: center; gap: 36px; box-sizing: border-box; }
  .cab-logo { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

  .cab-pildora { gap: 6px; padding: 5px; border-radius: var(--radius-pill); background: var(--surface-3); border: 1px solid var(--line); }
  .cr-pil { color: var(--muted); background: none; border: 0; }
  .cr-pil:hover { color: var(--ink); }
  .cab-ia { font-size: var(--fs-w-10); font-weight: 800; padding: 2px 6px; border-radius: var(--radius-pill); background: var(--action); color: var(--on-action); }
  .cab-der { margin-left: auto; display: flex; align-items: center; gap: 12px; }
  .cab-tema { width: 40px; height: 40px; border-radius: var(--radius-pill); border: 1px solid var(--line); background: var(--bg-web); color: var(--ink); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; flex-shrink: 0; }
  .cab-tema span { width: 16px; height: 16px; border-radius: var(--radius-pill); border: 2px solid currentColor; background: linear-gradient(90deg, currentColor 50%, transparent 50%); box-sizing: border-box; display: block; }
  .cab-btn { height: 42px; align-items: center; border-radius: var(--radius-pill); font-size: var(--fs-w-15); text-decoration: none; white-space: nowrap; }
  /* «Agendar demo»: el handoff lo pedía como texto sin borde; John lo quiere más
     visible (6-nov-2026): borde azul con ícono, secundario. «Prueba gratis» sigue
     siendo el único botón relleno. */
  .cab-btn.demo { gap: 7px; padding: 0 16px; border: 1.5px solid var(--action); color: var(--action); font-weight: 700; transition: background-color var(--t-fast, .12s); }
  .cab-btn.demo:hover { background: var(--soft); }
  .cab-btn.demo :global(svg), .cab-demo-movil :global(svg) { flex-shrink: 0; width: 17px; height: 17px; }
  .cab-demo-movil { color: var(--action); }
  /* Entre 1240 y 1499 px no caben el ícono y los tres botones: sin ícono y más apretado. */
  @media (max-width: 1499.98px) { .cab-btn.demo { padding: 0 14px; } .cab-btn.demo :global(svg) { display: none; } }
  /* 1240–1365: con texto se sale de la cabecera; queda el ícono en un botón redondo. */
  @media (min-width: 1240px) and (max-width: 1365.98px) {
    .cab-btn.demo { width: 42px; padding: 0; justify-content: center; }
    .cab-btn.demo :global(svg) { display: block; }
    .cab-btn.demo .tx { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  :global(:root[data-theme="dark"]) .cab-btn.demo { border-color: var(--link); color: var(--link); }
  .cab-btn.borde { padding: 0 18px; border: 1px solid var(--line); color: var(--ink); font-weight: 700; }
  .cab-btn.tinta { padding: 0 20px; background: var(--web-boton); color: var(--web-boton-tx); font-weight: 800; }
  #nav-toggle { color: var(--ink); }
  #nav-mobile { background: var(--bg-web); }
  @media (max-width: 1023.98px) { .cab-in { gap: 12px; min-height: 64px; } }
  /* 1024-1239: la píldora del menú no cabe junto a Ingresar y Prueba gratis (el botón
     se salía de la pantalla, medido el 2-nov-2026); ahí manda el botón de menú. */
  @media (min-width: 1024px) and (max-width: 1239.98px) { .cab-in { gap: 16px; } }

  /* Sombra que sí flota (menús): la única sombra difusa permitida. */
  .flota {
    box-shadow: var(--sh-flota);
  }
  /* El panel cuelga del BORDE IZQUIERDO de su botón, no centrado sobre él.
     Centrado, un panel de 560 px sobre un botón de 110 dejaba media caja
     flotando encima del logo —lejos del cursor y de las opciones—. Alineado,
     la primera opción cae justo debajo de la palabra que se acaba de señalar.
     El origen del crecimiento se ancla al disparador, como manda el sistema. */
  /* Menú en el lenguaje de Web y app 2027 (31-oct-2026): panel de radio 24 con línea,
     filas con ícono en cuadro y un solo bloque tinta para la IA. */
  .mm { background: var(--bg-web); border: 1px solid var(--line); border-radius: var(--radius-widget); padding: 12px; box-sizing: border-box; font-family: var(--font-body); }
  .mm-ancho { width: min(820px, 92vw); display: grid; grid-template-columns: minmax(0, 1fr) 236px; gap: 8px 12px; }
  .mm-corto { width: min(320px, 90vw); display: flex; flex-direction: column; gap: 2px; }
  .mm-lista { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; align-content: start; }
  .mm-l { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: start; gap: 12px; padding: 10px; border-radius: 16px; color: var(--ink); text-decoration: none; transition: background-color var(--t-fast, .12s); }
  .mm-ico { width: 40px; height: 40px; border-radius: var(--radius-celda); background: var(--surface-3); color: var(--muted); display: grid; place-items: center; transition: background-color var(--t-fast, .12s), color var(--t-fast, .12s); }
  .mm-tx { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mm-tx b { font-size: var(--fs-w-14); line-height: 1.3; font-weight: 800; color: var(--ink); }
  .mm-tx small { font-size: var(--fs-w-12); line-height: 1.35; color: var(--muted); }
  @media (hover: hover) {
    .mm-l:hover { background: var(--surface-3); }
    .mm-l:hover .mm-ico { background: var(--soft); color: var(--link); }
    .mm-ia:hover .mm-ia-v { color: var(--on-action); }
    .mm-pie:hover { color: var(--ink); }
  }
  .mm-ia { grid-column: 2; grid-row: 1; display: flex; flex-direction: column; gap: 10px; padding: 20px; border-radius: 18px; background: var(--panel-ink); color: var(--on-action); text-decoration: none; }
  :global(:root[data-theme="dark"]) .mm-ia { box-shadow: inset 0 0 0 1px var(--panel-line); }
  .mm-chip { align-self: flex-start; padding: 2px 10px; border-radius: var(--radius-pill); background: var(--panel-chip); color: var(--panel-link); font-size: var(--fs-w-12); font-weight: 800; }
  .mm-ia-t { font-size: var(--fs-w-20); line-height: 1.2; letter-spacing: -.02em; }
  .mm-ia-t > span { font-weight: var(--fw-ligero, 300); display: block; }
  .mm-ia-t b { font-weight: 800; display: block; }
  .mm-ia-d { font-size: var(--fs-w-13); line-height: 1.4; color: var(--panel-claro); }
  .mm-ia-v { margin-top: auto; font-size: var(--fs-w-13); font-weight: 800; color: var(--panel-link); }
  .mm-pie { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 10px 4px; border-top: 1px solid var(--line); font-size: var(--fs-w-13); color: var(--muted); text-decoration: none; }
  .mm-pie b { font-weight: 700; color: var(--ink); }

  .mega-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.985);
    transform-origin: top left;
    transition: opacity 0.18s, visibility 0.18s, transform 0.18s var(--ease-salida, ease-out);
  }
  .mega-item:hover .mega-panel,
  .mega-item:focus-within .mega-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  .mega-item:hover .mega-caret,
  .mega-item:focus-within .mega-caret {
    transform: rotate(180deg);
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const mobile = document.getElementById("nav-mobile");

  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
  document.querySelectorAll(".nav-mobile-link").forEach((a) =>
    a.addEventListener("click", () => mobile?.classList.add("hidden")),
  );

  // La portada: el menú toma fondo al bajar.
  const cabecera = document.querySelector<HTMLElement>("[data-cabecera].portada");
  if (cabecera) {
    const mirar = () => cabecera.classList.toggle("bajo", window.scrollY > 40);
    mirar();
    window.addEventListener("scroll", mirar, { passive: true });
  }

  // Botón de tema: la preferencia queda en este navegador (ver Base.astro).
  document.querySelectorAll("[data-tema]").forEach((b) => b.addEventListener("click", () => {
    const oscuro = document.documentElement.getAttribute("data-theme") !== "dark";
    if (oscuro) document.documentElement.setAttribute("data-theme", "dark");
    else document.documentElement.removeAttribute("data-theme");
    try { localStorage.setItem("contradar.tema", oscuro ? "oscuro" : "claro"); } catch { /* sin almacenamiento */ }
  }));

  // Esc cierra el mega menú (quita el foco del item abierto).
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const activo = document.activeElement;
    if (activo instanceof HTMLElement && activo.closest(".mega-item")) activo.blur();
    mobile?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  });
</script>
