---
import { CTA_PRIMARIO } from "../consts";
// Nav fase 4 (landing-v4): header claro, mega menú Funcionalidades (6 entradas en dos
// columnas, orden del arco) + Recursos. Hover Y :focus-within; Esc cierra.
// En móvil: acordeón dentro del hamburguesa.
import Logo from "./Logo.astro";
import { LOGIN_URL } from "../consts";
import {
  Radar,
  Target,
  Swords,
  MessageSquareText,
  ChartLine,
  CalendarClock,
  SquareKanban,
  ClipboardCheck,
  BookOpen,
  Building2,
  CircleQuestionMark,
  Users,
  ChevronDown,
  BellRing,
} from "@lucide/astro";

// Los módulos se llaman aquí igual que en el menú de la app (reorganización
// jul-2026): quien entra desde la landing encuentra los mismos nombres. Las
// tres primeras entradas son las pestañas de Búsquedas que se venden solas;
// «Análisis de contratantes» desapareció como módulo — hoy es una pestaña de
// Competencia y se cuenta dentro de ella.
/* CINCO ENTRADAS, CINCO PÁGINAS (31-ago-2026, hallazgo M7). Antes eran seis y
   las seis eran anclas del MISMO documento: el menú prometía seis páginas y
   entregaba una de 17.149 px. Ahora cada módulo tiene la suya, bajo /producto/.

   Sondeos (RFI) y Plan anual (PAA) salen del primer nivel y se cuentan dentro
   de Búsquedas, que es lo que ya hacía el resto de la web: son las dos señales
   tempranas de la misma capacidad, no módulos aparte.

   «Gestión de equipo» se parte en sus dos mitades reales —Mis licitaciones y
   Mis contratos—, que es como se llaman en el menú de la app. */
const modulos = [
  {
    href: "/producto/estadistica-de-la-licitacion/",
    icon: Target,
    titulo: "Estadística de la licitación",
    desc: "A qué precio se ganó, quién se presenta y en cuántos días paga esa entidad",
  },
  {
    href: "/producto/analisis-de-competencia/",
    icon: Swords,
    titulo: "Análisis de competencia",
    desc: "El historial completo de tu rival, con sus siglas y consorcios sumados",
  },
  {
    href: "/producto/busquedas/",
    icon: Radar,
    titulo: "Búsquedas automáticas",
    desc: "SECOP I y II cada día, con puntaje de 0 a 100 · incluye sondeos y plan anual",
  },
  {
    href: "/producto/mis-licitaciones/",
    icon: Users,
    titulo: "Mis licitaciones",
    desc: "Tu equipo coordinado hasta la adjudicación, en seis carriles",
  },
  {
    href: "/producto/mis-contratos/",
    icon: CalendarClock,
    titulo: "Mis contratos",
    desc: "Del acta de inicio a la liquidación, sin que se venza una póliza",
  },
  {
    href: "/producto/notificaciones/",
    icon: BellRing,
    titulo: "Avisos",
    desc: "En la campana y en tu correo: doce cosas que se vigilan solas",
  },
];


const recursos = [
  { href: "/guias/", icon: BookOpen, titulo: "Guías", desc: "Cómo licitar, paso a paso" },
  { href: "/sectores/", icon: Building2, titulo: "Sectores", desc: "Cómo se licita en el tuyo" },
  { href: "/ayuda/", icon: CircleQuestionMark, titulo: "Ayuda", desc: "Preguntas frecuentes y soporte" },
];

/* UN SOLO PRIMARIO POR PANTALLA (31-ago-2026, hallazgo C1).
   La barra ofrecía «Diagnóstico gratis» (enlace), «Ingresar» (botón de
   contorno) y «Prueba gratis» (relleno azul). Medido, solo uno era azul
   lleno, así que la regla ya casi se cumplía — pero en la PORTADA ese azul
   competía con el botón del diagnóstico del hero: dos rellenos azules con
   DESTINOS DISTINTOS por encima del pliegue.

   Ahora el primario de la barra depende de la página:
     · en la portada es «Diagnóstico gratis» y lleva al mismo hero, así que
       refuerza el embudo del NIT en vez de competir con él;
     · en el resto es «Solicitar acceso», que es donde no hay hero que compita.
   «Ingresar» baja a enlace de texto: es para quien YA es cliente, no una
   llamada a la acción. */
/* Páginas que YA traen su propio primario por encima del pliegue: ahí la
   barra no pone otro. La portada lo tiene en el hero («Ver mi diagnóstico») y
   /precios/ en su cabecera. Medido: sin esto, /precios/ mostraba DOS
   «Solicitar acceso» azules en el fold — repetición, no competencia, pero
   ruido igual. */
const CON_PRIMARIO_PROPIO = ["/", "/precios/", "/precios", "/servicios-a-medida/", "/servicios-a-medida"];
const esPortada = CON_PRIMARIO_PROPIO.includes(Astro.url.pathname);
---

<header class="cabecera sticky top-0 z-50 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-cabecera items-center justify-between gap-6 px-5 py-3 sm:px-8">
    <a href="/" class="shrink-0">
      <Logo showIcon={true} />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="principal">
      <!-- Funcionalidades -->
      <div class="mega-item relative">
        <a
          href="/funcionalidades/"
          class="inline-flex items-center gap-1 rounded-lg px-3.5 py-2 text-sm font-semibold text-grafito-500 transition hover:bg-papel-100 hover:text-grafito-900"
          aria-haspopup="true"
        >
          Funcionalidades
          <ChevronDown size={14} stroke-width={2.5} class="mega-caret transition-transform" />
        </a>
        <div class="mega-panel absolute left-0 top-full z-[60] w-[min(560px,92vw)] pt-2.5">
          <div class="grid grid-cols-2 gap-0.5 rounded-2xl border border-papel-200 bg-white p-3 flota">
            {modulos.map((m) => (
              <a href={m.href} class="mega-link group grid grid-cols-[auto_1fr] items-start gap-3 rounded-xl p-3 transition hover:bg-papel-100">
                <span class="grid h-8 w-8 place-items-center rounded-lg bg-papel-100 text-grafito-500 transition group-hover:bg-azul-50 group-hover:text-azul-600">
                  <m.icon size={17} stroke-width={1.7} />
                </span>
                <span>
                  <b class="block text-[0.84rem] font-bold text-grafito-900">{m.titulo}</b>
                  <span class="block text-[0.72rem] leading-snug text-grafito-400">{m.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/precios/" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-grafito-500 transition hover:bg-papel-100 hover:text-grafito-900">
        Precios
      </a>

      <!-- Nosotros: de primer nivel desde el 30-ago. Estaba dentro de Recursos,
           donde nadie lo busca. -->
      <a href="/nosotros/" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-grafito-500 transition hover:bg-papel-100 hover:text-grafito-900">
        Nosotros
      </a>

      <!-- Recursos -->
      <div class="mega-item relative">
        <button
          type="button"
          class="inline-flex items-center gap-1 rounded-lg px-3.5 py-2 text-sm font-semibold text-grafito-500 transition hover:bg-papel-100 hover:text-grafito-900"
          aria-haspopup="true"
        >
          Recursos
          <ChevronDown size={14} stroke-width={2.5} class="mega-caret transition-transform" />
        </button>
        <div class="mega-panel absolute left-0 top-full z-[60] w-[min(280px,90vw)] pt-2.5">
          <div class="grid gap-0.5 rounded-2xl border border-papel-200 bg-white p-3 flota">
            {recursos.map((r) => (
              <a href={r.href} class="mega-link group grid grid-cols-[auto_1fr] items-start gap-3 rounded-xl p-3 transition hover:bg-papel-100">
                <span class="grid h-8 w-8 place-items-center rounded-lg bg-papel-100 text-grafito-500 transition group-hover:bg-azul-50 group-hover:text-azul-600">
                  <r.icon size={17} stroke-width={1.7} />
                </span>
                <span>
                  <b class="block text-[0.84rem] font-bold text-grafito-900">{r.titulo}</b>
                  <span class="block text-[0.72rem] leading-snug text-grafito-400">{r.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/#diagnostico" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-grafito-500 transition hover:bg-papel-100 hover:text-grafito-900">
        Diagnóstico gratis
      </a>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a
        href={LOGIN_URL}
        class="whitespace-nowrap text-sm font-semibold text-azul-600 transition hover:text-azul-700 hover:underline"
      >
        Ingresar
      </a>
      {!esPortada && (
        <a
          href="#solicitar"
          class="whitespace-nowrap rounded-lg bg-azul-500 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-azul-600"
        >
          {CTA_PRIMARIO}
        </a>
      )}
    </div>

    <button id="nav-toggle" class="text-grafito-900 lg:hidden" aria-label="menú" aria-expanded="false">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Móvil: acordeón -->
  <div id="nav-mobile" class="hidden max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-t border-papel-200 bg-white px-5 py-3 lg:hidden">
    <details class="group border-b border-papel-150">
      <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between py-2.5 text-sm font-semibold text-grafito-900 marker:content-none">
        Funcionalidades
        <ChevronDown size={16} class="text-grafito-400 transition-transform group-open:rotate-180" />
      </summary>
      <div class="pb-2">
        {modulos.map((m) => (
          <a href={m.href} class="nav-mobile-link flex min-h-[44px] items-center gap-3 py-2 pl-2 text-sm text-grafito-500">
            <m.icon size={17} stroke-width={1.7} class="text-grafito-400" />
            {m.titulo}
          </a>
        ))}
      </div>
    </details>
    <a href="/precios/" class="nav-mobile-link flex min-h-[44px] items-center border-b border-papel-150 py-2.5 text-sm font-semibold text-grafito-900">
      Precios
    </a>
    <a href="/nosotros/" class="nav-mobile-link flex min-h-[44px] items-center border-b border-papel-150 py-2.5 text-sm font-semibold text-grafito-900">
      Nosotros
    </a>
    <details class="group border-b border-papel-150">
      <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between py-2.5 text-sm font-semibold text-grafito-900 marker:content-none">
        Recursos
        <ChevronDown size={16} class="text-grafito-400 transition-transform group-open:rotate-180" />
      </summary>
      <div class="pb-2">
        {recursos.map((r) => (
          <a href={r.href} class="nav-mobile-link flex min-h-[44px] items-center gap-3 py-2 pl-2 text-sm text-grafito-500">
            <r.icon size={17} stroke-width={1.7} class="text-grafito-400" />
            {r.titulo}
          </a>
        ))}
      </div>
    </details>
    <a href="/#diagnostico" class="nav-mobile-link flex min-h-[44px] items-center py-2.5 text-sm font-semibold text-grafito-900">
      Diagnóstico gratis
    </a>
    <div class="mt-2 flex items-center gap-4 border-t border-papel-150 pt-3">
      <a href={LOGIN_URL} class="whitespace-nowrap py-2.5 text-sm font-semibold text-azul-600">
        Ingresar
      </a>
      <a href={esPortada ? "/#diagnostico" : "#solicitar"} class="nav-mobile-link ml-auto flex-1 whitespace-nowrap rounded-lg bg-azul-500 px-4 py-2.5 text-center text-sm font-bold text-white">
        {esPortada ? "Diagnóstico gratis" : CTA_PRIMARIO}
      </a>
    </div>
  </div>
</header>

<style>
  /* La cabecera no se separa con una línea plana: se despega del contenido
     con una sombra muy corta (hairline + difusa mínima). */
  .cabecera {
    box-shadow:
      0 1px 0 rgba(16, 32, 54, 0.05),
      0 6px 20px -14px rgba(16, 32, 54, 0.35);
  }

  /* Sombra que sí flota (menús): la única sombra difusa permitida. */
  .flota {
    box-shadow: var(--sh-flota);
  }
  /* El panel cuelga del BORDE IZQUIERDO de su botón, no centrado sobre él.
     Centrado, un panel de 560 px sobre un botón de 110 dejaba media caja
     flotando encima del logo —lejos del cursor y de las opciones—. Alineado,
     la primera opción cae justo debajo de la palabra que se acaba de señalar.
     El origen del crecimiento se ancla al disparador, como manda el sistema. */
  .mega-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.985);
    transform-origin: top left;
    transition: opacity 0.18s, visibility 0.18s, transform 0.18s var(--ease-salida, ease-out);
  }
  .mega-item:hover .mega-panel,
  .mega-item:focus-within .mega-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  .mega-item:hover .mega-caret,
  .mega-item:focus-within .mega-caret {
    transform: rotate(180deg);
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const mobile = document.getElementById("nav-mobile");

  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
  document.querySelectorAll(".nav-mobile-link").forEach((a) =>
    a.addEventListener("click", () => mobile?.classList.add("hidden")),
  );

  // Esc cierra el mega menú (quita el foco del item abierto).
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const activo = document.activeElement;
    if (activo instanceof HTMLElement && activo.closest(".mega-item")) activo.blur();
    mobile?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  });
</script>
