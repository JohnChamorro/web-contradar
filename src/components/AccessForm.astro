---
import { APP_URL, CONTACT_EMAIL, CTA_PRIMARIO, LOGIN_URL, whatsappLink } from "../consts";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { PRUEBA } from "../data/producto";

// PRUEBA GRATIS «FICHA DE LO QUE INCLUYE» (propuesta 1b de Claude Design,
// 24-sep-2026). CSS portado literal del prompt al <style> de abajo, con los
// tokens donde el valor coincide. Campos: NIT, correo y WhatsApp (ver «NIT EN
// VEZ DE EMPRESA» abajo), la misma trampa, el mismo Turnstile y el mismo
// respaldo a /api/contact, que manda los dos correos y registra la solicitud.
//
// LA PRUEBA SE ACTIVA EN EL ACTO desde el 1-oct-2026 (John): «si ya está ahí,
// no lo dejemos ir». El formulario crea la cuenta en la app
// (POST /public/prueba/crear, solo el correo) y lleva a la persona dentro con
// la sesión abierta; allí la app le pide la contraseña en un modal. Si la app
// no responde, cae al camino de antes (/api/contact, activación manual), así
// que ninguna solicitud se pierde.
//
// NIT EN VEZ DE EMPRESA (6-oct-2026, plan de activación de John): «nunca
// preguntes lo que ya sabemos». Con el NIT la app sabe el nombre, el sector y
// la zona, así que el formulario pide solo NIT y correo (el WhatsApp sigue
// opcional). El NIT viaja limpio: solo dígitos, sin el de verificación
// («900.123.456-7» → «900123456»). Si la empresa ya tiene cuenta, la app
// responde 409 `empresa_existe` y aquí se ofrece entrar o pedir acceso al
// administrador (POST /public/prueba/pedir-acceso, sin captcha).
//
// Turnstile (captcha invisible). Sin la clave configurada el widget no se pinta
// y la Function lo trata como apagado. Cada envío dispara dos correos por
// Resend, así que sin captcha el formulario es un relé de correo abierto —
// configúrala en Pages > Environment variables junto con TURNSTILE_SECRET_KEY.
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

/* Lo que incluye la prueba. Dos textos se ajustaron a lo que la prueba da de
   verdad (24-sep): no es «sin límites» —tiene 3 búsquedas y 10 análisis—, y
   los 10 análisis son perfiles de empresa (`analysis_quota_trial` en la app),
   no la estadística de la licitación, que no se descuenta. */
const INCLUYE = [
  { n: "01", titulo: `${PRUEBA.plan} completo`, texto: "Búsquedas, estadística, competencia y equipo." },
  { n: "02", titulo: `${PRUEBA.analisis} análisis`, texto: "Perfiles completos de competidores: historial, contratos y precios." },
  { n: "03", titulo: "Listo con tu NIT", texto: "Tu búsqueda nace armada por sector y zona; la afinas cuando quieras." },
];
---

<section id="solicitar" class="cr-trial scroll-mt-16">
  {/* Cierre 5b (24-sep-2026): banda clara DENTRO del contenedor común del
      cierre (.cr-wrap, el mismo que las preguntas y el footer), con 72 px de
      blanco arriba y abajo. El ancla sigue siendo #solicitar: la usan 26
      enlaces de la web. */}
  <div class="cr-wrap">
  <div class="cr-trial__band">
  <div class="cr-trial__copy">
    <div class="cr-trial__eyebrow">Prueba gratis · {PRUEBA.dias} días</div>
    {/* h2 con el aspecto del h1 del diseño: la página ya tiene su h1 en el
        hero, y dos h1 en una página confunden a los buscadores. */}
    <h2 class="cr-trial__title">Siete días para ver<br />lo que otros no ven.</h2>
    <p class="cr-trial__lead">Entras de una vez a ver las licitaciones abiertas para tu empresa. Sin tarjeta.</p>

    <ol class="cr-trial__list">
      {INCLUYE.map((i) => (
        <li><span class="cr-trial__n">{i.n}</span><strong>{i.titulo}</strong><span>{i.texto}</span></li>
      ))}
    </ol>

    {/* Atención al cliente a la vista, ANTES de dejar los datos: en Colombia
        el canal es WhatsApp. */}
    <div class="cr-trial__talk">
      <span>Si quieres, te la mostramos en 15 minutos por videollamada.</span>
      <a
        href={whatsappLink("Hola, quiero que me muestren ContRadar en 15 minutos por videollamada")}
        target="_blank"
        rel="noopener"
        class="cr-trial__talk-wa"
      ><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3 3Z" /><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2Z" /></svg>Escribir por WhatsApp</a>
      <!--email_off-->
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <!--/email_off-->
    </div>
  </div>

  <form id="access-form" class="cr-trial__card" novalidate>
    {/* NIT primero: es lo que decide qué licitaciones ve la persona al entrar. */}
    <div class="cr-field" id="f-nit-campo">
      <label for="f-nit">NIT de tu empresa <span class="cr-field__req" aria-hidden="true">*</span></label>
      <div class="cr-input">
        <svg class="cr-input__icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="3.5" width="16" height="17" rx="1.5" /><path d="M8.5 7.5h2M13.5 7.5h2M8.5 11.5h2M13.5 11.5h2M10 20.5v-4h4v4" /></svg>
        <input id="f-nit" name="nit" type="text" inputmode="numeric" autocomplete="off" spellcheck="false"
          placeholder="900123456" aria-required="true" aria-describedby="f-nit-ayuda f-nit-error" />
      </div>
      <p id="f-nit-ayuda" class="cr-field__ayuda">Con tu NIT te traemos las licitaciones de tu sector y tu zona. Sin dígito de verificación.</p>
      <p id="f-nit-error" class="cr-field__error" hidden></p>
    </div>

    <div class="cr-field" id="f-email-campo">
      <label for="f-email">Correo <span class="cr-field__req" aria-hidden="true">*</span></label>
      <div class="cr-input">
        <svg class="cr-input__icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
        <input id="f-email" name="email" type="email" autocomplete="email" spellcheck="false"
          placeholder="Tu correo electrónico" aria-required="true" aria-describedby="f-email-error" />
      </div>
      <p id="f-email-error" class="cr-field__error" hidden></p>
    </div>

    <div class="cr-field">
      <label for="f-whatsapp">WhatsApp <span class="cr-field__opcional">(opcional) — para ayudarte a usarla en 15 minutos</span></label>
      <div class="cr-input">
        <svg class="cr-input__icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="6.5" y="2.5" width="11" height="19" rx="2" /><path d="M11 18h2" /></svg>
        <input id="f-whatsapp" name="whatsapp" type="tel" autocomplete="tel-national" inputmode="tel" spellcheck="false" placeholder="300 000 0000" />
      </div>
    </div>

    {/* Honeypot: invisible para una persona, irresistible para un bot que
        rellena todo lo que encuentra. Si llega con contenido, la Function
        responde ok y no envía nada. Fuera de pantalla y no `display:none`,
        que es lo que los bots saltan; la etiqueta no dice lo que es. */}
    <div class="absolute left-[-9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
      <label for="f-website">Sitio web</label>
      <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="cr-field" id="f-consent-campo">
      <label class="cr-consent" for="f-consent">
        <input id="f-consent" name="consent" type="checkbox" aria-required="true" aria-describedby="f-consent-error" />
        <span>Autorizo el tratamiento de mis datos conforme a la <a href="/politica-de-datos/">Política de datos</a>.</span>
      </label>
      <p id="f-consent-error" class="cr-field__error" hidden></p>
    </div>

    {TURNSTILE_SITE_KEY && (
      <div class="cr-turnstile">
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light" data-size="flexible" />
      </div>
    )}

    {/* El arco del sistema vive en el marcado y se enseña al enviar: así el
        botón no cambia de ancho a mitad de la acción. */}
    <button id="f-submit" type="submit" class="cr-btn-primary">
      <svg class="cr-arco-btn hidden" viewBox="0 0 107.54822 99.293579" aria-hidden="true">
        <g transform="matrix(1.3333333,0,0,-1.3333333,-1861.0553,308.57397)">
          <g transform="translate(1453.64,224.749)"><path d="m 0,0 c -5.24,2.734 -11.198,4.279 -17.518,4.279 -20.947,0 -37.928,-16.981 -37.928,-37.928 0,-13.277 6.822,-24.961 17.152,-31.737" /></g>
        </g>
      </svg>
      <span id="f-submit-txt">{CTA_PRIMARIO}</span>
      <svg class="cr-btn-primary__flecha" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13" /><path d="M12.5 6.5 19 12l-6.5 5.5" /></svg>
    </button>

    <p id="f-msg" class="cr-field__error" role="status" hidden></p>
    <p class="cr-trial__micro">Sin tarjeta · {PRUEBA.alta} · sin permanencia. Si no te sirve, no haces nada y se apaga sola.</p>
  </form>
  </div>
  </div>
</section>

<!-- Popup de resultado: visible esté donde esté el scroll (el mensaje inline
     queda fuera de pantalla si el usuario está abajo). -->
<div id="f-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-tinta-900/70 p-4">
  <div class="w-full max-w-sm rounded-xl bg-white p-6 text-center shadow-2xl">
    <div id="f-modal-emoji" class="dato mx-auto grid h-12 w-12 place-items-center rounded-full bg-jade-50 text-2xl font-bold text-jade-500">✓</div>
    <h3 id="f-modal-title" class="mt-3 text-lg font-bold text-grafito-900"></h3>
    <p id="f-modal-body" class="mt-2 text-sm text-grafito-500"></p>
    <a id="f-modal-wa" href={whatsappLink("Hola, acabo de solicitar mi prueba de ContRadar")}
      target="_blank" rel="noopener"
      class="mt-4 hidden items-center justify-center gap-2 text-sm font-semibold text-azul-600 hover:text-azul-700">
      <WhatsAppIcon class="h-4 w-4 text-[#25D366]" />
      ¿Dudas? Escríbenos por WhatsApp
    </a>
    <!-- Ya tiene cuenta (6-oct-2026): en vez de «Entendido» y nada más, la
         puerta de entrada con su correo puesto, y la recuperación a mano. -->
    <div id="f-modal-entrar" class="hidden">
      <a id="f-modal-login" href={LOGIN_URL} data-login={LOGIN_URL}
        class="mt-5 flex min-h-[44px] w-full items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-azul-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-azul-600">
        Entrar a mi cuenta <span aria-hidden="true">→</span>
      </a>
      <a href={`${APP_URL}/recuperar`}
        class="mt-3 inline-block text-sm font-semibold text-azul-600 hover:text-azul-700">
        ¿No recuerdas tu contraseña? Recupérala aquí
      </a>
    </div>
    <!-- La empresa ya tiene cuenta (6-oct-2026): la persona es nueva pero su
         empresa no. Dos salidas: entrar (por si ya la agregaron) o pedir que
         el administrador la agregue. -->
    <div id="f-modal-empresa" class="hidden">
      <a id="f-modal-empresa-login" href={LOGIN_URL} data-login={LOGIN_URL}
        class="mt-5 flex min-h-[44px] w-full items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-azul-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-azul-600">
        Entrar <span aria-hidden="true">→</span>
      </a>
      <button id="f-modal-pedir" type="button"
        class="mt-3 flex min-h-[44px] w-full items-center justify-center whitespace-nowrap rounded-lg border border-azul-500 bg-white px-5 py-3 text-sm font-bold text-azul-600 transition hover:bg-azul-50 disabled:cursor-default disabled:border-grafito-300 disabled:text-grafito-400">
        Pedir acceso
      </button>
    </div>
    <p id="f-modal-pedir-msg" class="mt-4 hidden text-sm" role="status"></p>
    <button id="f-modal-close" type="button"
      class="mt-5 min-h-[44px] w-full whitespace-nowrap rounded-lg bg-azul-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-azul-600">
      Entendido
    </button>
  </div>
</div>

{TURNSTILE_SITE_KEY && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<script>
  import { API_URL, APP_URL } from "../consts";
  import { medir } from "../lib/analitica";
  import { CTA_PRIMARIO } from "../consts";
  const form    = document.getElementById("access-form") as HTMLFormElement | null;
  const btn     = document.getElementById("f-submit") as HTMLButtonElement | null;
  const nit     = document.getElementById("f-nit") as HTMLInputElement | null;
  const email   = document.getElementById("f-email") as HTMLInputElement | null;
  const consent = document.getElementById("f-consent") as HTMLInputElement | null;
  const msg     = document.getElementById("f-msg");
  const modal   = document.getElementById("f-modal");
  let sent = false; // tras un envío OK el botón queda deshabilitado hasta que cambien algo

  const API = `${API_URL}/public/prueba`;
  const SOPORTE = "soporte@contradar.com.co";
  const CORREO_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

  /* NIT limpio: lo de antes del guion (el dígito de verificación va después),
     solo dígitos. «900.123.456-7» → «900123456»; «900 123 456» → «900123456». */
  const limpiarNit = (v: string) => v.split("-")[0].replace(/\D/g, "");
  function errorNit(v: string): string | null {
    const limpio = limpiarNit(v);
    if (!v.trim()) return "Escribe el NIT de tu empresa.";
    if (limpio.length < 8 || limpio.length > 10) return "El NIT tiene entre 8 y 10 números, sin el dígito de verificación.";
    return null;
  }

  /* Errores bajo cada campo (diseño 1b): el mensaje en .cr-field__error y el
     .cr-field con aria-invalid, sin cajas rojas. */
  function marcar(campo: string, texto: string | null) {
    const caja = document.getElementById(`f-${campo}-campo`);
    const error = document.getElementById(`f-${campo}-error`);
    if (!caja || !error) return;
    if (texto) {
      caja.setAttribute("aria-invalid", "true");
      error.textContent = texto;
      error.hidden = false;
    } else {
      caja.removeAttribute("aria-invalid");
      error.hidden = true;
    }
  }
  nit?.addEventListener("input", () => marcar("nit", null));
  // Validación al salir del campo, no mientras escribe: no regaña a medias.
  nit?.addEventListener("blur", () => { if (nit.value.trim()) marcar("nit", errorNit(nit.value)); });
  email?.addEventListener("input", () => marcar("email", null));
  consent?.addEventListener("change", () => marcar("consent", null));

  function setMsg(text: string | null) {
    if (!msg) return;
    msg.textContent = text ?? "";
    msg.hidden = !text;
  }

  /* Cuatro tipos de aviso: ok (solicitud de respaldo), error, «cuenta» (el
     correo ya tiene cuenta) y «empresa» (la empresa ya tiene cuenta). Tener
     cuenta no es un error: ni la ✕ ni el rojo. */
  type Tipo = "ok" | "error" | "cuenta" | "empresa";
  let pedirDatos: { nit: string; email: string } | null = null;

  function conCorreo(a: HTMLAnchorElement | null, correo: string) {
    if (!a) return;
    const u = new URL(a.dataset.login ?? a.href);
    u.searchParams.set("email", correo);
    a.href = u.href;
  }

  function showModal(tipo: Tipo, title: string, body: string, correo?: string) {
    if (!modal) return;
    const icono = document.getElementById("f-modal-emoji") as HTMLElement;
    const ok = tipo === "ok";
    const tieneCuenta = tipo === "cuenta" || tipo === "empresa";
    icono.textContent = ok ? "✓" : tieneCuenta ? "→" : "✕";
    icono.className = `dato mx-auto grid h-12 w-12 place-items-center rounded-full text-2xl font-bold ${ok ? "bg-jade-50 text-jade-500" : tieneCuenta ? "bg-azul-50 text-azul-500" : "bg-sello-50 text-sello-500"}`;
    (document.getElementById("f-modal-title") as HTMLElement).textContent = title;
    (document.getElementById("f-modal-body") as HTMLElement).textContent = body;
    // El canal de dudas solo aparece en la confirmación de envío, no en errores.
    document.getElementById("f-modal-wa")?.classList.toggle("hidden", !ok);
    document.getElementById("f-modal-wa")?.classList.toggle("flex", ok);
    // «Entrar» es el botón principal cuando ya hay cuenta; «Entendido» pasa a
    // ser un «Cerrar» discreto.
    document.getElementById("f-modal-entrar")?.classList.toggle("hidden", tipo !== "cuenta");
    document.getElementById("f-modal-empresa")?.classList.toggle("hidden", tipo !== "empresa");
    const pedirMsg = document.getElementById("f-modal-pedir-msg");
    pedirMsg?.classList.add("hidden");
    const pedir = document.getElementById("f-modal-pedir") as HTMLButtonElement | null;
    if (pedir) { pedir.disabled = false; pedir.textContent = "Pedir acceso"; }
    cerrarComo(tieneCuenta ? "Cerrar" : "Entendido");
    if (correo) {
      conCorreo(document.getElementById("f-modal-login") as HTMLAnchorElement | null, correo);
      conCorreo(document.getElementById("f-modal-empresa-login") as HTMLAnchorElement | null, correo);
    }
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }
  function cerrarComo(rotuloCerrar: "Cerrar" | "Entendido") {
    const cerrar = document.getElementById("f-modal-close");
    if (!cerrar) return;
    cerrar.textContent = rotuloCerrar;
    cerrar.className = rotuloCerrar === "Cerrar"
      ? "mt-3 min-h-[44px] w-full rounded-lg px-5 py-2 text-sm font-semibold text-grafito-500 transition hover:text-grafito-900"
      : "mt-5 min-h-[44px] w-full whitespace-nowrap rounded-lg bg-azul-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-azul-600";
  }
  function hideModal() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
  }
  document.getElementById("f-modal-close")?.addEventListener("click", hideModal);
  modal?.addEventListener("click", (e) => { if (e.target === modal) hideModal(); });

  /* «Pedir acceso»: la app avisa al administrador de la empresa y a nosotros.
     Sin captcha (el endpoint no lo pide); el botón se bloquea tras el primer
     clic para no mandar dos avisos. */
  document.getElementById("f-modal-pedir")?.addEventListener("click", async (e) => {
    const boton = e.currentTarget as HTMLButtonElement;
    const pedirMsg = document.getElementById("f-modal-pedir-msg");
    if (!pedirDatos || !pedirMsg) return;
    boton.disabled = true;
    boton.textContent = "Pidiendo…";
    let listo = false;
    try {
      const r = await fetch(`${API}/pedir-acceso`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(pedirDatos),
      });
      listo = r.ok;
    } catch {
      listo = false;
    }
    if (listo) {
      void medir("prueba_pedir_acceso", {});
      document.getElementById("f-modal-empresa")?.classList.add("hidden");
      pedirMsg.className = "mt-4 text-sm font-semibold text-grafito-900";
      pedirMsg.textContent = "Listo. Le avisamos al administrador de tu empresa para que te agregue, y te escribiremos nosotros.";
      cerrarComo("Entendido");
    } else {
      boton.disabled = false;
      boton.textContent = "Pedir acceso";
      pedirMsg.className = "mt-4 text-sm text-sello-700";
      pedirMsg.textContent = `No pudimos pedir el acceso. Escríbenos a ${SOPORTE}.`;
    }
  });

  /* El rótulo del botón vive en su propio <span> y la flecha es su hermana:
     se toca solo el texto, y la flecha se esconde mientras el botón está
     ocupado. */
  const txt = document.getElementById("f-submit-txt");
  const flechaBtn = btn?.querySelector(".cr-btn-primary__flecha");
  const rotulo = (t: string, conFlecha = true) => {
    if (txt) txt.textContent = t;
    flechaBtn?.classList.toggle("hidden", !conFlecha);
  };
  /* Botón de vuelta a su estado normal + captcha nuevo: los tokens de
     Turnstile son de UN solo uso, y la app ya consumió el que llevaba el envío.
     En /servicios-a-medida/ hay OTRO widget (el del formulario de encargos):
     se reinicia el de este formulario, no «el primero» de la página. */
  function liberar() {
    if (!btn) return;
    btn.disabled = false;
    btn.removeAttribute("aria-busy");
    btn.querySelector(".cr-arco-btn")?.classList.add("hidden");
    rotulo(CTA_PRIMARIO);
    (window as unknown as { turnstile?: { reset: (el?: Element) => void } }).turnstile?.reset(form?.querySelector(".cf-turnstile") ?? undefined);
  }

  // Si el usuario edita cualquier campo después de un envío OK, se rehabilita
  // (puede registrar a otra persona/correo).
  form?.addEventListener("input", () => {
    if (sent && btn) {
      sent = false;
      btn.disabled = false;
      btn.removeAttribute("aria-busy");
      btn.querySelector(".cr-arco-btn")?.classList.add("hidden");
      rotulo(CTA_PRIMARIO);
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!btn || sent) return;
    setMsg(null);
    // NIT, correo y consentimiento OBLIGATORIOS: sin ellos no se envía.
    const valorNit = limpiarNit(nit?.value ?? "");
    const valorCorreo = (email?.value ?? "").trim();
    const errNit = errorNit(nit?.value ?? "");
    const errorCorreo = !valorCorreo ? "Escribe tu correo." : !CORREO_RE.test(valorCorreo) ? "Revisa el correo: le falta algo." : null;
    const errorConsent = consent?.checked ? null : "Debes autorizar el tratamiento de tus datos personales para continuar.";
    marcar("nit", errNit);
    marcar("email", errorCorreo);
    marcar("consent", errorConsent);
    if (errNit || errorCorreo || errorConsent) {
      (errNit ? nit : errorCorreo ? email : consent)?.focus();
      return;
    }
    btn.disabled = true;
    btn.setAttribute("aria-busy", "true");
    btn.querySelector(".cr-arco-btn")?.classList.remove("hidden");
    rotulo("Enviando…", false);
    try {
      const payload: Record<string, unknown> = Object.fromEntries(new FormData(form).entries());
      payload.nit = valorNit;
      payload.consent = consent?.checked ?? false;
      // Turnstile inyecta un input oculto `cf-turnstile-response` dentro del
      // form; se manda con nombre propio para que la Function no dependa de ese
      // detalle. Vacío = captcha apagado (sin clave configurada).
      payload.turnstile_token = payload["cf-turnstile-response"] ?? "";
      // 1) Alta en el acto en la app y adentro con la sesión.
      try {
        const alta = await fetch(`${API}/crear`, {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-Turnstile-Token": String(payload.turnstile_token ?? "") },
          body: JSON.stringify({
            email: valorCorreo, nit: valorNit, whatsapp: payload.whatsapp || null,
            consent: true, utm: "landing", website: payload.website || "",
          }),
        });
        const cuerpo = await alta.json().catch(() => ({}));
        if (alta.ok && cuerpo.access_token) {
          rotulo("Entrando…", false);
          await medir("prueba_solicitada", { via: "app" });
          window.location.assign(`${APP_URL}/prueba/activada?estado=ok&token=${encodeURIComponent(cuerpo.access_token)}`);
          return;
        }
        if (alta.status === 409) {
          liberar();
          // Un backend anterior manda `detail` como texto: eso es «correo existe».
          const detalle = cuerpo?.detail;
          if (detalle && typeof detalle === "object" && detalle.codigo === "empresa_existe") {
            pedirDatos = { nit: valorNit, email: valorCorreo };
            const empresa = typeof detalle.empresa === "string" && detalle.empresa.trim() ? ` (${detalle.empresa.trim()})` : "";
            showModal("empresa", `Tu empresa ya tiene cuenta en ContRadar${empresa}`,
              "Si ya te agregaron, entra con tu correo. Si no, pide acceso y el administrador de tu empresa te agrega.",
              valorCorreo);
            return;
          }
          showModal("cuenta", "Ya tienes una cuenta",
            `${valorCorreo} ya está registrado en ContRadar. Entra con tu contraseña y sigue donde ibas.`,
            valorCorreo);
          return;
        }
        // 400 con explicación de la app (p. ej. un NIT que no cuadra): se
        // muestra tal cual y NO se cae al respaldo, que no lo arreglaría.
        if (alta.status === 400 && typeof cuerpo?.detail === "string" && cuerpo.detail.trim()) {
          liberar();
          setMsg(cuerpo.detail);
          showModal("error", "Revisa tus datos", cuerpo.detail);
          return;
        }
      } catch {
        // La app no respondió: sigue el camino de antes, que no pierde la solicitud.
      }
      // 2) Respaldo: la solicitud de siempre, con activación manual. Lleva el
      //    NIT limpio para que ventas sepa de qué empresa es.
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error ?? "Error");
      sent = true;
      void medir("prueba_solicitada", { via: "respaldo" });
      btn.querySelector(".cr-arco-btn")?.classList.add("hidden");
      rotulo("Solicitud enviada ✓", false);
      showModal("ok", "¡Solicitud recibida!",
        "En breve creamos tu prueba de 7 días y te avisamos a tu correo.");
    } catch {
      liberar();
      setMsg(`No se pudo enviar. Escríbenos directamente a ${SOPORTE}`);
      showModal("error", "No pudimos enviar tu solicitud",
        `Intenta de nuevo en un momento o escríbenos a ${SOPORTE}.`);
    }
  });
</script>

