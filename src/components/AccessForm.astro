---
// Fase 4: banda clara (la única tinta de la home es la banda VS) y formulario
// de 3 campos — correo, empresa, WhatsApp (regla del sistema visual).
import { CONTACT_EMAIL } from "../consts";
---

<section id="solicitar" class="scroll-mt-16 bg-papel-100">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 sm:px-8 lg:grid-cols-2 lg:gap-12 lg:py-[100px]">
    <div>
      <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
        10 días gratis · Plan completo · Sin tarjeta
      </p>
      <h2 class="max-w-[20ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl">
        Activa tu prueba gratis
      </h2>
      <p class="mt-4 max-w-md text-grafito-500">
        Déjanos tu correo y te activamos la prueba: <strong class="font-bold text-grafito-900">10
        días con el plan completo</strong>. Un asistente guiado configura tus búsquedas en 2 minutos
        y ves tus primeras licitaciones de una vez. Sin tarjeta y sin permanencia.
      </p>
      <p class="mt-6 text-sm text-grafito-400">
        ¿Prefieres escribirnos directo?
        <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-azul-600 hover:text-azul-700">
          {CONTACT_EMAIL}
        </a>
      </p>
    </div>

    <div class="rounded-xl border border-papel-200 bg-white p-7">
      <form id="access-form" class="space-y-4">
        <div>
          <label for="f-email" class="mb-1 block text-sm font-medium text-grafito-700">Correo <span class="text-azul-600">*</span></label>
          <input id="f-email" name="email" type="email" required
            class="min-h-[44px] w-full rounded-lg border border-papel-300 px-3 py-2.5 text-base outline-none focus:border-azul-500 focus:ring-[3px] focus:ring-azul-100" />
        </div>
        <div>
          <label for="f-company" class="mb-1 block text-sm font-medium text-grafito-700">Empresa</label>
          <input id="f-company" name="company" type="text"
            class="min-h-[44px] w-full rounded-lg border border-papel-300 px-3 py-2.5 text-base outline-none focus:border-azul-500 focus:ring-[3px] focus:ring-azul-100" />
        </div>
        <div>
          <label for="f-whatsapp" class="mb-1 block text-sm font-medium text-grafito-700">WhatsApp</label>
          <input id="f-whatsapp" name="whatsapp" type="tel" inputmode="tel" placeholder="300 000 0000"
            class="dato min-h-[44px] w-full rounded-lg border border-papel-300 px-3 py-2.5 text-base outline-none placeholder:font-sans focus:border-azul-500 focus:ring-[3px] focus:ring-azul-100" />
        </div>

        <label for="f-consent" class="flex items-start gap-2 text-xs text-grafito-500">
          <input id="f-consent" name="consent" type="checkbox" required class="mt-0.5 shrink-0" />
          <span>
            Autorizo el tratamiento de mis datos personales conforme a la
            <a href="/politica-de-datos" class="font-semibold text-azul-600 hover:text-azul-700">Política de Tratamiento de Datos</a>.
          </span>
        </label>

        <button id="f-submit" type="submit"
          class="min-h-[48px] w-full whitespace-nowrap rounded-lg bg-azul-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-azul-600 disabled:opacity-60">
          Empezar mi prueba gratis →
        </button>

        <p class="text-left text-xs text-grafito-400">
          Sin tarjeta de crédito. Te contactamos para activar tu cuenta; la configuración es un asistente guiado de 2 minutos.
        </p>

        <p id="f-msg" class="hidden text-sm" role="status"></p>
      </form>
    </div>
  </div>
</section>

<!-- Popup de resultado: visible esté donde esté el scroll (el mensaje inline
     queda fuera de pantalla si el usuario está abajo). -->
<div id="f-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-tinta-900/70 p-4">
  <div class="w-full max-w-sm rounded-xl bg-white p-6 text-center shadow-2xl">
    <div id="f-modal-emoji" class="dato mx-auto grid h-12 w-12 place-items-center rounded-full bg-jade-50 text-2xl font-bold text-jade-500">✓</div>
    <h3 id="f-modal-title" class="mt-3 text-lg font-bold text-grafito-900"></h3>
    <p id="f-modal-body" class="mt-2 text-sm text-grafito-500"></p>
    <button id="f-modal-close" type="button"
      class="mt-5 min-h-[44px] w-full whitespace-nowrap rounded-lg bg-azul-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-azul-600">
      Entendido
    </button>
  </div>
</div>

<script>
  const form    = document.getElementById("access-form") as HTMLFormElement | null;
  const btn     = document.getElementById("f-submit") as HTMLButtonElement | null;
  const consent = document.getElementById("f-consent") as HTMLInputElement | null;
  const msg     = document.getElementById("f-msg");
  const modal   = document.getElementById("f-modal");
  let sent = false; // tras un envío OK el botón queda deshabilitado hasta que cambien algo

  function setMsg(text: string, ok: boolean) {
    if (!msg) return;
    msg.textContent = text;
    msg.className = `text-sm ${ok ? "text-jade-500" : "text-sello-500"}`;
    msg.classList.remove("hidden");
  }

  function showModal(ok: boolean, title: string, body: string) {
    if (!modal) return;
    const icono = document.getElementById("f-modal-emoji") as HTMLElement;
    icono.textContent = ok ? "✓" : "✕";
    icono.className = `dato mx-auto grid h-12 w-12 place-items-center rounded-full text-2xl font-bold ${ok ? "bg-jade-50 text-jade-500" : "bg-sello-50 text-sello-500"}`;
    (document.getElementById("f-modal-title") as HTMLElement).textContent = title;
    (document.getElementById("f-modal-body") as HTMLElement).textContent = body;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }
  function hideModal() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
  }
  document.getElementById("f-modal-close")?.addEventListener("click", hideModal);
  modal?.addEventListener("click", (e) => { if (e.target === modal) hideModal(); });

  // Si el usuario edita cualquier campo después de un envío OK, se rehabilita
  // (puede registrar a otra persona/correo).
  form?.addEventListener("input", () => {
    if (sent && btn) {
      sent = false;
      btn.disabled = false;
      btn.textContent = "Empezar mi prueba gratis →";
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!btn || sent) return;
    // Consentimiento OBLIGATORIO: sin él no se envía.
    if (!consent || !consent.checked) {
      setMsg("Debes autorizar el tratamiento de tus datos personales para continuar.", false);
      return;
    }
    btn.disabled = true;
    btn.textContent = "Enviando…";
    try {
      const payload: Record<string, unknown> = Object.fromEntries(new FormData(form).entries());
      payload.consent = consent.checked;
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error ?? "Error");
      sent = true;
      btn.textContent = "✅ Solicitud enviada";
      setMsg("¡Solicitud recibida! En breve creamos tu prueba y te avisamos a tu correo.", true);
      showModal(true, "¡Solicitud recibida!",
        "En breve creamos tu prueba de 10 días y te avisamos a tu correo.");
    } catch {
      btn.disabled = false;
      btn.textContent = "Empezar mi prueba gratis →";
      setMsg("No se pudo enviar. Escríbenos directamente a soporte@contradar.com.co", false);
      showModal(false, "No pudimos enviar tu solicitud",
        "Intenta de nuevo en un momento o escríbenos a soporte@contradar.com.co.");
    }
  });
</script>
