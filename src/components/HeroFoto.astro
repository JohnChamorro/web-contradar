---
/**
 * Hero con foto para las páginas internas (15-nov-2026, «todo full»).
 *
 * El mismo lenguaje de la portada nueva: una foto de Colombia a todo el marco
 * (FLUX local, public/fotos/), velo tinta desde abajo a la izquierda y el
 * título en dos pesos encima, en blanco. Un marco redondeado dentro de la
 * página (como en las referencias Winzy/ShipX), no una banda de borde a borde.
 *
 * - `foto`: nombre base en public/fotos/ (se sirven -1280, -1920 y -2560 en AVIF y WebP).
 * - Título: `fino` + `fuerte`, o `titulo` y se parte solo en dos pesos (16-nov-2026).
 * - `rotulo`: no se usa en páginas nuevas: en la web nada va encima de un título
 *   (contradar-ui, regla 2, 15-nov-2026). Queda por la 404 hasta que se retire.
 * - slots: `arriba` (migas), el de por defecto (firma, botones) y `tarjeta`
 *   (vidrio a la derecha, solo en escritorio ancho).
 * La foto es decorativa (alt vacío): el contenido está en el texto.
 */
interface Props {
  foto: string;
  titulo?: string;
  fino?: string;
  fuerte?: string;
  rotulo?: string;
  bajada?: string;
  /** "medio" (por defecto) para producto y secciones; "bajo" para guías y artículos. */
  alto?: "medio" | "bajo";
  /** Encuadre de la foto (object-position). */
  encuadre?: string;
}
const { foto: pedida, titulo, fino, fuerte, rotulo, bajada, alto = "medio", encuadre = "50% 50%" } = Astro.props;
/* Si la foto todavía no existe (FLUX las va generando), se usa la de la cordillera:
   nunca se publica un hero que pida un archivo que no está (16-nov-2026). */
import { existsSync } from "node:fs";
import { join } from "node:path";
const foto = existsSync(join(process.cwd(), "public/fotos", `${pedida}-2560.webp`)) ? pedida : "cordillera";
const tarjeta = Astro.slots.has("tarjeta");
/* Títulos en dos pesos SIEMPRE (John, 16-nov-2026). Si el H1 llega como un solo texto
   (sale de datos o del SEO), se parte solo: en los dos puntos, o si no en la
   preposición o conjunción más cercana a la mitad. El texto no cambia, solo el peso. */
function partir(t: string): [string, string] {
  const dos = t.indexOf(": ");
  if (dos > 0 && dos < t.length - 3) return [t.slice(0, dos + 1), t.slice(dos + 2)];
  const mitad = t.length / 2;
  let mejor = -1;
  /* Nunca dentro de un paréntesis: «Qué es el RUP (Registro Único de Proponentes)». */
  const dentro = (i: number) => (t.slice(0, i).match(/\(/g)?.length ?? 0) > (t.slice(0, i).match(/\)/g)?.length ?? 0);
  for (const m of t.matchAll(/ (?:de|del|en|para|y|con|que|a) /g)) {
    const i = m.index ?? -1;
    if (i >= 4 && !dentro(i) && (mejor < 0 || Math.abs(i - mitad) < Math.abs(mejor - mitad))) mejor = i;
  }
  if (mejor < 0) { const antes = t.lastIndexOf(" ", Math.ceil(mitad)), despues = t.indexOf(" ", Math.floor(mitad)); mejor = antes > 0 ? antes : despues; }
  return mejor > 0 ? [t.slice(0, mejor), t.slice(mejor + 1)] : ["", t];
}
const [finoAuto, fuerteAuto] = !fino && !fuerte && titulo ? partir(titulo) : [fino ?? "", fuerte ?? ""];
---

<section class={`hf hf-${alto}`}>
  <div class="hf-marco">
    <picture>
      <source type="image/avif" srcset={`/fotos/${foto}-1280.avif 1280w, /fotos/${foto}-1920.avif 1920w, /fotos/${foto}-2560.avif 2560w`} sizes="(max-width: 1440px) 100vw, 1400px" />
      <img class="hf-foto" src={`/fotos/${foto}-2560.webp`} srcset={`/fotos/${foto}-1280.webp 1280w, /fotos/${foto}-1920.webp 1920w, /fotos/${foto}-2560.webp 2560w`} sizes="(max-width: 1440px) 100vw, 1400px" width="2560" height="1463" alt="" fetchpriority="high" decoding="async" style={`object-position:${encuadre}`} />
    </picture>
    <div class="hf-in">
      <div class="hf-tx">
        <slot name="arriba" />
        {rotulo && <p class="rotulo hf-rot">{rotulo}</p>}
        {Astro.slots.has("titulo") ? <h1><slot name="titulo" /></h1> : <h1>{finoAuto && <span class="fino">{finoAuto}</span>} <span class="fuerte">{fuerteAuto}</span></h1>}
        {bajada && <p class="hf-baj">{bajada}</p>}
        <slot />
      </div>
      {tarjeta && <aside class="hf-tarjeta"><slot name="tarjeta" /></aside>}
    </div>
  </div>
</section>

<style>
  .hf { background: var(--bg-web); padding: 12px var(--web-pad) 0; }
  .hf-marco { position: relative; max-width: var(--web-max); margin: 0 auto; border-radius: var(--radius-tile-lg); overflow: hidden; background: var(--panel-ink); color: var(--on-action); isolation: isolate; }
  .hf-medio .hf-marco { min-height: clamp(440px, 60vh, 640px); }
  .hf-bajo .hf-marco { min-height: clamp(360px, 46vh, 500px); }
  .hf-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hf-marco::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: var(--velo-tinta-lado), var(--velo-tinta-pie); }
  .hf-in { position: relative; min-height: inherit; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; padding: clamp(28px, 4.4vw, 64px); padding-top: clamp(96px, 12vh, 140px); box-sizing: border-box; }
  .hf-tx { display: flex; flex-direction: column; gap: 18px; max-width: 720px; min-width: 0;
    --ink: var(--on-action); --muted: var(--panel-muted); --link: var(--panel-link); }
  .hf-rot { margin: 0; color: var(--panel-link); }
  h1 { margin: 0; font-size: var(--fs-web-h1-foto); line-height: 1.02; letter-spacing: var(--ls-titular-web); font-weight: 800; text-wrap: balance; color: var(--on-action); }
  .fino, h1 :global(.fino) { font-weight: var(--fw-ligero); } .fuerte, h1 :global(.fuerte) { font-weight: 800; display: block; }
  h1 :global(br) { display: none; }
  .hf-tx :global(.hf-baj) { margin: 0; max-width: var(--ancho-lectura); font-size: var(--fs-w-17); line-height: 1.5; color: var(--on-action-2); text-wrap: pretty; }
  .hf-baj { margin: 0; max-width: var(--ancho-lectura); font-size: var(--fs-w-17); line-height: 1.5; color: var(--on-action-2); text-wrap: pretty; }
  /* Botones y notas que las páginas meten en el slot. */
  .hf-tx :global(.hf-acc) { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin-top: 6px; }
  .hf-tx :global(.hf-btn) { height: var(--pildora-alto); padding: 0 8px 0 24px; border-radius: var(--radius-pill); background: var(--on-action); color: var(--panel-ink); display: inline-flex; align-items: center; gap: 16px; font-size: var(--fs-w-17); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .hf-tx :global(.hf-btn i) { width: var(--pildora-circulo); height: var(--pildora-circulo); border-radius: var(--radius-pill); background: var(--web-boton-circulo); color: var(--on-action); display: grid; place-items: center; font-style: normal; }
  .hf-tx :global(.hf-btn:focus-visible), .hf-tx :global(.hf-sec:focus-visible) { outline: 2px solid var(--panel-link); outline-offset: 3px; }
  .hf-tx :global(.hf-sec) { font-size: var(--fs-w-16); font-weight: 700; color: var(--on-action); text-decoration: none; white-space: nowrap; }
  .hf-tx :global(.hf-sec:hover) { text-decoration: underline; text-underline-offset: 3px; }
  .hf-tx :global(.hf-nota) { margin: 0; font-size: var(--fs-w-14); color: var(--on-action-2); }
  .hf-tarjeta { flex: 0 0 auto; width: min(320px, 30%); padding: 14px; border-radius: var(--radius-widget); background: var(--vidrio-bg); border: 1px solid var(--vidrio-linea); -webkit-backdrop-filter: blur(var(--vidrio-blur)); backdrop-filter: blur(var(--vidrio-blur)); }
  @media (max-width: 899.98px) { .hf-tarjeta { display: none; } }
  @media (max-width: 759.98px) {
    .hf { padding: 8px 12px 0; }
    .hf-marco { border-radius: var(--radius-tile-sm); }
    .hf-medio .hf-marco, .hf-bajo .hf-marco { min-height: 0; }
    .hf-in { padding: 140px 22px 28px; }
    .hf-marco::before { background: var(--velo-tinta-movil); }
  }
</style>
