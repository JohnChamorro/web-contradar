---
import { VERTICALS } from "../data/content";
import {
  Building2,
  DraftingCompass,
  Laptop,
  Zap,
  Leaf,
  Truck,
  Hospital,
  GraduationCap,
  Microscope,
  Factory,
  Wheat,
  Armchair,
  Shield,
  Briefcase,
} from "@lucide/astro";

const ICONS: Record<string, typeof Building2> = {
  "building-2": Building2,
  "drafting-compass": DraftingCompass,
  laptop: Laptop,
  zap: Zap,
  leaf: Leaf,
  truck: Truck,
  hospital: Hospital,
  "graduation-cap": GraduationCap,
  microscope: Microscope,
  factory: Factory,
  wheat: Wheat,
  armchair: Armchair,
  shield: Shield,
  briefcase: Briefcase,
};
---

<section id="sectores" class="bg-papel-50">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-grafito-900">Hecho para tu sector</h2>
      <p class="mt-3 text-lg text-slate-600">
        Cubrimos los 14 sectores del SECOP. Activas el tuyo y olvídate del resto.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {VERTICALS.map((v) => {
        const Icono = ICONS[v.icon];
        return (
        <div class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50 px-4 py-3.5 transition hover:border-azul-500/40 hover:bg-white hover:shadow-sm">
          <Icono size={20} stroke-width={1.7} class="shrink-0 text-grafito-500" aria-hidden="true" />
          <span class="min-w-0 break-words text-sm font-medium text-slate-700">{v.label}</span>
        </div>
        );
      })}
    </div>
  </div>
</section>
