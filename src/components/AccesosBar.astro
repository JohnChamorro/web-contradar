---
// Accesos a los módulos: cuatro tarjetas del sistema (línea, radio 12) bajo
// el hero. Cada una es un enlace real a su módulo en Funcionalidades, con
// afordancia visible — flecha que avanza al pasar y borde que se enciende.
import { Radar, SquareKanban, Swords, ClipboardCheck } from "@lucide/astro";

const accesos = [
  { icon: Radar,          titulo: "Búsquedas automáticas", nota: "Alertas diarias con puntaje de 0 a 100.", href: "/funcionalidades#busquedas" },
  { icon: Swords,         titulo: "Análisis de competencia", nota: "Quién gana, a qué precio y con qué efectividad.", href: "/funcionalidades#competencia" },
  { icon: SquareKanban,   titulo: "Seguimiento", nota: "Tablero, responsables y pliegos con tu equipo.", href: "/funcionalidades#seguimiento" },
  { icon: ClipboardCheck, titulo: "Ejecución", nota: "Del acta de inicio a la liquidación.", href: "/funcionalidades#ejecucion" },
];
---

<section class="bg-papel-50" aria-labelledby="accesos-titulo">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 lg:py-14">
    <p id="accesos-titulo" class="dato mb-5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
      Entra directo al módulo que te interesa
    </p>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {accesos.map((a) => (
        <a
          href={a.href}
          class="acceso group flex flex-col rounded-xl border border-papel-200 bg-white p-5 transition hover:border-azul-300 hover:bg-white"
        >
          <a.icon size={22} stroke-width={1.5} class="text-grafito-700 transition group-hover:text-azul-600" aria-hidden="true" />
          <b class="mt-3.5 block text-base font-extrabold tracking-tight text-grafito-900">{a.titulo}</b>
          <span class="mt-1 block text-[0.875rem] leading-relaxed text-grafito-500">{a.nota}</span>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-azul-600">
            Ver cómo funciona
            <span class="flecha" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* La tarjeta se ve en cada visita: no entra con animación (regla de
     frecuencia). Solo responde al puntero y al pulsar. */
  .flecha {
    display: inline-block;
    transition: transform var(--t-fast) var(--ease-salida);
  }
  .acceso:hover .flecha {
    transform: translateX(3px);
  }
  .acceso:active {
    transform: scale(var(--press));
    transition: transform var(--t-fast) var(--ease-salida);
  }
  @media (prefers-reduced-motion: reduce) {
    .acceso:hover .flecha { transform: none; }
  }
</style>
