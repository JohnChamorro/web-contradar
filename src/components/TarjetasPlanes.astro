---
// Las tarjetas de precios (noviembre de 2026), las mismas en /precios/ y en la
// portada: nombre, para quién, formatos, precio, precio anual, permanencia y
// 5 líneas en el mismo orden. Solo Ventaja va destacada. Sin IVA aparte: el
// precio es el total (terminos.astro, sección 4). Cifras de src/data/producto.ts; texto igual al de la app
// (contradar/frontend/src/lib/tarjetasPlanes.ts). Si cambia uno, cambia el otro.
import { CTA_PRIMARIO, whatsappLink } from "../consts";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { moneda } from "../lib/formato";
import { DESCUENTO_ANUAL, ahorroAnual, plan, precioMes } from "../data/producto";
import { TOPE_WOMPI } from "../lib/pagos";

const a = plan("vigia");
const v = plan("radar");
const d = plan("enterprise");
const veces = (x: number, y: number) => Math.round(x / y);
type Linea = [number | null, string];
/* Las tarjetas finales del lanzamiento (John, 2-nov-2026). Ninguna repite la franja
   común. Todas las cifras salen de src/data/producto.ts. */
/** Primera línea de Ventaja: lo que cuesta de más contra Alerta. Cambia con el
 *  interruptor (anual: mes pagando el año; mensual: mes a mes). */
const colaVentaja = `, con ${v.propuestasMes} propuestas con formatos en vez de ${a.propuestasMes}`;
const tarjetas = [
  {
    p: a, paraQuien: "Para enterarte a tiempo", cta: CTA_PRIMARIO, href: "#solicitar",
    primera: null,
    lineas: [
      [a.usuarios, "usuarios"], [a.busquedas, "búsquedas automáticas"],
      [a.propuestasMes, `${a.propuestasMes === 1 ? "propuesta" : "propuestas"} con formatos llenos y ${a.pliegosMes} pliegos analizados al mes`],
      [a.analisisMes, "análisis de empresa, entidad o licitación al mes"], [a.seguimiento, "licitaciones en seguimiento"],
    ] as Linea[],
  },
  {
    p: v, paraQuien: "Para preparar ofertas con datos", cta: CTA_PRIMARIO, href: "#solicitar", recomendado: true,
    primera: {
      anual: `${moneda(precioMes(v, "anual") - precioMes(a, "anual"))} más al mes que Alerta${colaVentaja}`,
      mensual: `${moneda(v.total.mensual - a.total.mensual)} más que Alerta${colaVentaja}`,
    },
    lineas: [
      [v.usuarios, "usuarios, con tareas y comentarios"], [v.busquedas, "búsquedas automáticas"],
      [v.propuestasMes, `propuestas con formatos y ${v.pliegosMes} pliegos al mes, con chat con el pliego`],
      [null, "Cuánto ofertan los que ganan y cuánto tarda en pagar la entidad"], [null, "Qué cambió en cada adenda"],
      [null, "Biblioteca de documentos y tus contratos en ejecución"], [null, "Exporta tus licitaciones a Excel"],
      [null, "Soporte por WhatsApp"],
    ] as Linea[],
  },
  {
    p: d, paraQuien: "Para quien presenta más de 10 propuestas al mes",
    cta: CTA_PRIMARIO, href: "#solicitar",
    primera: (() => {
      const t = `Todo lo de Ventaja, con ${veces(d.usuarios, v.usuarios)} veces los usuarios, ${veces(d.pliegosMes, v.pliegosMes)} veces los pliegos y ${veces(d.propuestasMes, v.propuestasMes)} veces las propuestas`;
      return { anual: t, mensual: t };
    })(),
    lineas: [
      [d.usuarios, "usuarios"], d.busquedas == null ? [null, "Búsquedas y análisis sin tope"] : [d.busquedas, "búsquedas, y análisis sin tope"],
      [d.propuestasMes, `propuestas con formatos y ${d.pliegosMes} pliegos al mes`],
      [null, "Precio de adjudicación por entidad"], [null, "PAA y sondeos, antes de que salga el proceso"],
      [null, "API privada para conectar tus sistemas"], [null, "Soporte por WhatsApp con prioridad"],
    ] as Linea[],
  },
];
const { verTodas = "#todas-las-funciones" } = Astro.props as { verTodas?: string };
---
<p class="mb-6 rounded-xl border border-papel-200 bg-white px-5 py-4 text-left text-sm leading-relaxed text-grafito-700">
  <strong class="font-semibold text-grafito-900">Todos los planes incluyen:</strong>
  las licitaciones de tus búsquedas sin tope diario, alertas por correo, buscador de SECOP I y II, cruce con tu RUP e
  indicadores financieros, capacidad residual (K), aviso cuando sale una adenda y calendario de cierres.
</p>

{/* Interruptor mensual/anual (John, 2-nov-2026). Por defecto, anual; ?pago=mensual
    lo deja en mensual para compartir el enlace. El modo se pone en <html> ANTES de
    pintar las tarjetas, para que no parpadee. La tabla completa lo sigue. */}
<script is:inline>
  document.documentElement.dataset.pago = new URLSearchParams(location.search).get("pago") === "mensual" ? "mensual" : "anual";
</script>
<div class="mb-6 flex justify-center">
  <div class="pago-sel" role="radiogroup" aria-label="Forma de pago" data-pago-sel>
    <button type="button" role="radio" aria-checked="true" tabindex="0" data-modo="anual">Anual <span class="etq">Ahorras {DESCUENTO_ANUAL}&nbsp;%</span></button>
    <button type="button" role="radio" aria-checked="false" tabindex="-1" data-modo="mensual">Mensual</button>
  </div>
</div>

{/* Tres columnas con línea y solo el recomendado en tinta (John, 14-nov-2026: la
    forma de la portada). El contenido de cada plan es el mismo de antes. */}
<div class="tp">
  {tarjetas.map((t) => (
    <div class:list={["tp-plan", { reco: "recomendado" in t && t.recomendado }]}>
      <h3>{t.p.nombre}{"recomendado" in t && t.recomendado && <span class="tp-tag">Recomendado</span>}</h3>
      <p class="tp-para">{t.paraQuien}</p>
      {/* Bloque de precio en sus dos modos (John, 2-nov-2026). El mensual de un anual
          nunca va sin el total del año pegado debajo. Sin precios tachados. */}
      <div class="pago-par tp-precio">
        <p class="solo-anual"><span class="precio-plan">{moneda(precioMes(t.p, "anual"))}</span><span class="tp-per">al mes, pago anual</span></p>
        <p class="solo-mensual"><span class="precio-plan">{moneda(t.p.total.mensual)}</span><span class="tp-per">al mes</span></p>
      </div>
      <div class="pago-par ahorro-plan">
        <p class="solo-anual">Pagas {moneda(t.p.total.anual)} al año · <span class="whitespace-nowrap">Ahorras {moneda(ahorroAnual(t.p))}</span></p>
        <p class="solo-mensual">Pagando el año: {moneda(precioMes(t.p, "anual"))}/mes y <span class="whitespace-nowrap">ahorras {moneda(ahorroAnual(t.p))}</span></p>
      </div>
      <div class="pago-par tp-nota">
        <p class="solo-anual">o <span class="dato">{moneda(t.p.total.mensual)}</span> pagando mes a mes · Sin permanencia{t.p.total.anual > TOPE_WOMPI ? " · Pago anual por transferencia" : ""}</p>
        <p class="solo-mensual">Sin permanencia: cancelas cuando quieras</p>
      </div>
      <ul>
        {t.primera && (
          <li class="pago-par tp-primera">
            <span class="solo-anual">{t.primera.anual}</span>
            <span class="solo-mensual">{t.primera.mensual}</span>
          </li>
        )}
        {t.lineas.map((l) => (
          <li>{l[0] != null && <strong class="dato">{l[0]} </strong>}{l[1]}</li>
        ))}
      </ul>
      <a class="tp-cta" data-plan={t.p.nombre} href={t.href} {...(t.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>{t.cta}</a>
      {t.p.total.anual > TOPE_WOMPI && (
        <a class="tp-wa" href={whatsappLink(`Hola, quiero pagar el plan ${t.p.nombre} anual por transferencia`)} target="_blank" rel="noopener">
          <WhatsAppIcon class="h-3.5 w-3.5 shrink-0" />
          ¿Pago anual por transferencia? Escríbenos
        </a>
      )}
    </div>
  ))}
  <div class="tp-grupos">
    <h3>Grupos de empresas: a la medida</h3>
    <a class="tp-cta" href="/demo/" data-cta="demo" data-ubicacion="precios">Agendar demo</a>
  </div>
</div>

<p class="mt-5 text-center text-sm">
  <a href={verTodas} class="font-semibold text-azul-600 underline underline-offset-2 hover:text-azul-700">Ver todas las funciones</a>
</p>

<script>
  // El interruptor: clic, flechas del teclado, ?pago= en la URL y el evento de Umami.
  const grupo = document.querySelector<HTMLElement>("[data-pago-sel]");
  if (grupo) {
    const botones = [...grupo.querySelectorAll<HTMLButtonElement>("[data-modo]")];
    const pintar = (modo: string) => botones.forEach((b) => {
      const si = b.dataset.modo === modo;
      b.setAttribute("aria-checked", String(si));
      b.tabIndex = si ? 0 : -1;
    });
    const poner = (modo: string) => {
      const antes = document.documentElement.dataset.pago || "anual";
      if (modo === antes) return;
      document.documentElement.dataset.pago = modo;
      pintar(modo);
      const u = new URL(location.href);
      if (modo === "mensual") u.searchParams.set("pago", "mensual");
      else u.searchParams.delete("pago");
      history.replaceState(history.state, "", u);
      window.dispatchEvent(new CustomEvent("cr:evento", { detail: { nombre: "precio_periodo_cambio", datos: { de: antes, a: modo } } }));
    };
    pintar(document.documentElement.dataset.pago || "anual");
    botones.forEach((b) => b.addEventListener("click", () => poner(b.dataset.modo!)));
    grupo.addEventListener("keydown", (e) => {
      if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(e.key)) return;
      e.preventDefault();
      const i = botones.findIndex((b) => b.getAttribute("aria-checked") === "true");
      const sig = botones[(i + (e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 1) + botones.length) % botones.length];
      poner(sig.dataset.modo!);
      sig.focus();
    });
  }
</script>

<style>
  /* Precio en Plex Mono, como la cifra protagonista de la portada (John, 14-nov-2026;
     antes, 2-nov, iba en la letra del texto). */
  .precio-plan { font-family: var(--font-codigo); font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -.03em; line-height: 1.05; font-size: var(--fs-w-hoy); white-space: nowrap; }
  .ahorro-plan { color: var(--link); font-weight: 600; font-size: var(--fs-w-15); line-height: 1.35; font-variant-numeric: tabular-nums; margin-top: 4px; }
  .tp { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid var(--ink); text-align: left; }
  .tp-plan { display: flex; flex-direction: column; padding: 36px 32px; min-width: 0; color: var(--ink); }
  .tp-plan:first-child { padding-left: 0; } .tp-plan:nth-child(3) { padding-right: 0; }
  .tp-plan h3, .tp-grupos h3 { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; font-size: var(--fs-w-22); font-weight: 800; letter-spacing: -.02em; }
  .tp-tag { font-size: var(--fs-w-13); font-weight: 700; color: var(--panel-link); letter-spacing: 0; }
  .tp-para { margin: 4px 0 0; font-size: var(--fs-w-16); color: var(--muted); }
  .tp-precio { margin-top: 20px; }
  .tp-precio p { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin: 0; }
  .tp-per, .tp-nota { font-size: var(--fs-w-14); color: var(--muted); }
  .tp-nota { margin-top: 4px; } .tp-nota p, .ahorro-plan p { margin: 0; }
  .tp-plan ul { flex: 1; list-style: none; margin: 24px 0 0; padding: 0; font-size: var(--fs-w-16); line-height: 1.45; }
  .tp-plan li { padding: 10px 0; border-top: 1px solid var(--line-soft); }
  .tp-plan li strong { font-weight: 700; }
  .tp-primera { font-weight: 700; }
  .tp-cta { margin-top: 28px; min-height: 48px; padding: 0 20px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--ink); border-radius: var(--radius-pill); color: var(--ink); font-size: var(--fs-w-16); font-weight: 800; text-decoration: none; white-space: nowrap; transition: background-color var(--t-fast, .12s); }
  .tp-cta:hover { background: var(--surface-3); }
  .tp-cta:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
  .tp-wa { margin-top: 12px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; font-size: var(--fs-w-14); font-weight: 700; color: var(--link); text-decoration: none; }
  .tp-wa:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* El recomendado: bloque tinta en los dos temas. */
  .tp-plan.reco { background: var(--panel-ink); color: var(--on-action); --ink: var(--on-action); --muted: var(--panel-muted); --link: var(--panel-link); --line-soft: var(--panel-line); }
  .tp-plan.reco .tp-cta { background: var(--on-action); border-color: var(--on-action); color: var(--panel-ink); }
  .tp-grupos { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; padding: 24px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .tp-grupos .tp-cta { margin-top: 0; }
  @media (max-width: 1023.98px) {
    .tp { grid-template-columns: minmax(0, 1fr); border-top: 0; gap: 14px; }
    .tp-plan, .tp-plan:first-child, .tp-plan:nth-child(3) { padding: 28px 24px; border: 1px solid var(--line); border-radius: var(--radius-widget); }
    .tp-plan.reco { border-color: var(--panel-ink); }
    .tp-grupos { border: 0; padding: 12px 0; }
  }
</style>
