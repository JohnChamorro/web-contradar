---
// Las tarjetas de precios (noviembre de 2026), las mismas en /precios/ y en la
// portada: nombre, para quién, formatos, precio, precio anual, permanencia y
// 5 líneas en el mismo orden. Solo Ventaja va destacada. Sin IVA aparte: el
// precio es el total (terminos.astro, sección 4). Cifras de src/data/producto.ts; texto igual al de la app
// (contradar/frontend/src/lib/tarjetasPlanes.ts). Si cambia uno, cambia el otro.
import { CTA_PRIMARIO, whatsappLink } from "../consts";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { moneda } from "../lib/formato";
import { DESCUENTO_ANUAL, ahorroAnual, plan, precioMes } from "../data/producto";
import { LANZAMIENTO_NOV, nov } from "../lib/lanzamiento";
import { TOPE_WOMPI } from "../lib/pagos";

const a = plan("vigia");
const v = plan("radar");
const d = plan("enterprise");
const veces = (x: number, y: number) => Math.round(x / y);
type Linea = [number | null, string];
/* Las tarjetas finales del lanzamiento (John, 2-nov-2026). Ninguna repite la franja
   común. Lo que va con [bandera] en el encargo sale solo con LANZAMIENTO_NOV: las
   líneas de propuestas y pliegos, la primera línea de Ventaja que habla de
   propuestas y el «para quién» y la primera línea de Dominio. Todas las cifras
   salen de src/data/producto.ts. */
const conIa = (l: Linea[]) => nov(l, [] as Linea[]);
/** Primera línea de Ventaja: lo que cuesta de más contra Alerta. Cambia con el
 *  interruptor (anual: mes pagando el año; mensual: mes a mes). */
const colaVentaja = LANZAMIENTO_NOV
  ? `, con ${v.propuestasMes} propuestas con formatos en vez de ${a.propuestasMes}`
  : `, con ${v.busquedas} búsquedas en vez de ${a.busquedas}`;
const tarjetas = [
  {
    p: a, paraQuien: "Para enterarte a tiempo", cta: CTA_PRIMARIO, href: "#solicitar",
    primera: null,
    lineas: [
      [a.usuarios, "usuarios"], [a.busquedas, "búsquedas automáticas"],
      ...conIa([[a.propuestasMes, `${a.propuestasMes === 1 ? "propuesta" : "propuestas"} con formatos llenos y ${a.pliegosMes} pliegos analizados al mes`]]),
      [a.analisisMes, "análisis de empresa, entidad o licitación al mes"], [a.seguimiento, "licitaciones en seguimiento"],
    ] as Linea[],
  },
  {
    p: v, paraQuien: "Para preparar ofertas con datos", cta: CTA_PRIMARIO, href: "#solicitar", recomendado: true,
    primera: {
      anual: `${moneda(precioMes(v, "anual") - precioMes(a, "anual"))} más al mes que Alerta${colaVentaja}`,
      mensual: `${moneda(v.total.mensual - a.total.mensual)} más que Alerta${colaVentaja}`,
    },
    lineas: [
      [v.usuarios, "usuarios, con tareas y comentarios"], [v.busquedas, "búsquedas automáticas"],
      ...conIa([[v.propuestasMes, `propuestas con formatos y ${v.pliegosMes} pliegos al mes, con chat con el pliego`]]),
      [null, "Cuánto ofertan los que ganan y cuánto tarda en pagar la entidad"], [null, "Qué cambió en cada adenda"],
      [null, "Biblioteca de documentos y tus contratos en ejecución"], [null, "Soporte por WhatsApp"],
    ] as Linea[],
  },
  {
    p: d, paraQuien: nov("Para quien presenta más de 10 propuestas al mes", "Para equipos de licitaciones"),
    cta: CTA_PRIMARIO, href: "#solicitar",
    primera: (() => {
      const t = nov(
        `Todo lo de Ventaja, con ${veces(d.usuarios, v.usuarios)} veces los usuarios, ${veces(d.pliegosMes, v.pliegosMes)} veces los pliegos y ${veces(d.propuestasMes, v.propuestasMes)} veces las propuestas`,
        `Todo lo de Ventaja, con ${veces(d.usuarios, v.usuarios)} veces los usuarios`,
      );
      return { anual: t, mensual: t };
    })(),
    lineas: [
      [d.usuarios, "usuarios"], d.busquedas == null ? [null, "Búsquedas y análisis sin tope"] : [d.busquedas, "búsquedas, y análisis sin tope"],
      ...conIa([[d.propuestasMes, `propuestas con formatos y ${d.pliegosMes} pliegos al mes`]]),
      [null, "Precio de adjudicación por entidad"], [null, "PAA y sondeos, antes de que salga el proceso"],
      [null, "Soporte por WhatsApp con prioridad"],
    ] as Linea[],
  },
];
const { verTodas = "#todas-las-funciones" } = Astro.props as { verTodas?: string };
---
<p class="mb-6 rounded-xl border border-papel-200 bg-white px-5 py-4 text-left text-sm leading-relaxed text-grafito-700">
  <strong class="font-semibold text-grafito-900">Todos los planes incluyen:</strong>
  las licitaciones de tus búsquedas sin tope diario, alertas por correo, buscador de SECOP I y II, cruce con tu RUP e
  indicadores financieros, capacidad residual (K), aviso cuando sale una adenda y calendario de cierres.
</p>

{/* Interruptor mensual/anual (John, 2-nov-2026). Por defecto, anual; ?pago=mensual
    lo deja en mensual para compartir el enlace. El modo se pone en <html> ANTES de
    pintar las tarjetas, para que no parpadee. La tabla completa lo sigue. */}
<script is:inline>
  document.documentElement.dataset.pago = new URLSearchParams(location.search).get("pago") === "mensual" ? "mensual" : "anual";
</script>
<div class="mb-6 flex justify-center">
  <div class="pago-sel" role="radiogroup" aria-label="Forma de pago" data-pago-sel>
    <button type="button" role="radio" aria-checked="true" tabindex="0" data-modo="anual">Anual <span class="etq">Ahorras {DESCUENTO_ANUAL}&nbsp;%</span></button>
    <button type="button" role="radio" aria-checked="false" tabindex="-1" data-modo="mensual">Mensual</button>
  </div>
</div>

<div class="grid items-stretch gap-5 md:grid-cols-3">
  {tarjetas.map((t) => (
    <div class:list={["relative flex flex-col rounded-xl bg-white p-7", "recomendado" in t && t.recomendado ? "border-2 border-azul-500" : "border border-papel-200"]}>
      {"recomendado" in t && t.recomendado && (
        <span class="rotulo absolute -top-3 left-7 whitespace-nowrap rounded-full bg-azul-500 px-3 py-1 text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-white">
          Recomendado
        </span>
      )}
      <h3 class="text-xl font-extrabold tracking-tight text-grafito-900">{t.p.nombre}</h3>
      <p class="mt-1 text-sm text-grafito-500">{t.paraQuien}</p>
      {/* Bloque de precio en sus dos modos (John, 2-nov-2026). El mensual de un anual
          nunca va sin el total del año pegado debajo. Sin precios tachados. */}
      <div class="pago-par mt-6">
        <p class="solo-anual flex items-baseline gap-2">
          <span class="precio-plan text-4xl text-grafito-900">{moneda(precioMes(t.p, "anual"))}</span>
          <span class="text-sm text-grafito-500">/mes</span>
        </p>
        <p class="solo-mensual flex items-baseline gap-2">
          <span class="precio-plan text-4xl text-grafito-900">{moneda(t.p.total.mensual)}</span>
          <span class="text-sm text-grafito-500">/mes</span>
        </p>
      </div>
      <div class="pago-par ahorro-plan mt-1">
        <p class="solo-anual">Pagas {moneda(t.p.total.anual)} al año · <span class="whitespace-nowrap">Ahorras {moneda(ahorroAnual(t.p))}</span></p>
        <p class="solo-mensual">Pagando el año: {moneda(precioMes(t.p, "anual"))}/mes y <span class="whitespace-nowrap">ahorras {moneda(ahorroAnual(t.p))}</span></p>
      </div>
      <div class="pago-par mt-1 text-sm text-grafito-500">
        <p class="solo-anual">o <span class="dato">{moneda(t.p.total.mensual)}</span> pagando mes a mes · Sin permanencia{t.p.total.anual > TOPE_WOMPI ? " · Pago anual por transferencia" : ""}</p>
        <p class="solo-mensual">Sin permanencia: cancelas cuando quieras</p>
      </div>
      <ul class="mt-6 flex-1 space-y-3 border-t border-papel-150 pt-6 text-left">
        {t.primera && (
          <li class="pago-par text-sm font-semibold text-grafito-900">
            <span class="solo-anual">{t.primera.anual}</span>
            <span class="solo-mensual">{t.primera.mensual}</span>
          </li>
        )}
        {t.lineas.map((l) => (
          <li class="text-sm text-grafito-700">
            {l[0] != null && <strong class="dato font-semibold text-grafito-900">{l[0]} </strong>}{l[1]}
          </li>
        ))}
      </ul>
      <a data-plan={t.p.nombre} href={t.href} {...(t.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}
        class:list={["mt-7 flex min-h-[48px] items-center justify-center whitespace-nowrap rounded-lg px-5 text-center text-sm font-bold transition",
          "recomendado" in t && t.recomendado ? "bg-azul-500 text-white hover:bg-azul-600" : "border border-papel-300 text-grafito-900 hover:border-azul-300"]}>
        {t.cta}
      </a>
      {t.p.total.anual > TOPE_WOMPI && (
        <a href={whatsappLink(`Hola, quiero pagar el plan ${t.p.nombre} anual por transferencia`)} target="_blank" rel="noopener"
          class="mt-3 inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-azul-600 underline-offset-2 hover:underline">
          <WhatsAppIcon class="h-3.5 w-3.5 shrink-0" />
          ¿Pago anual por transferencia? Escríbenos
        </a>
      )}
    </div>
  ))}
  <div class="flex flex-col gap-4 rounded-xl border border-papel-200 bg-white p-5 md:col-span-3 md:flex-row md:items-center md:justify-between">
    <h3 class="text-base font-bold text-grafito-900">Grupos de empresas: a la medida</h3>
    <a href={whatsappLink("Hola, quiero información de ContRadar para un grupo de empresas")} target="_blank" rel="noopener"
      class="flex min-h-[44px] items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-papel-300 px-3 text-center text-sm font-bold text-grafito-900 transition hover:border-azul-300">
      <WhatsAppIcon class="h-4 w-4 shrink-0" />
      Escribir por WhatsApp
    </a>
  </div>
</div>

<p class="mt-5 text-center text-sm">
  <a href={verTodas} class="font-semibold text-azul-600 underline underline-offset-2 hover:text-azul-700">Ver todas las funciones</a>
</p>

<script>
  // El interruptor: clic, flechas del teclado, ?pago= en la URL y el evento de Umami.
  const grupo = document.querySelector<HTMLElement>("[data-pago-sel]");
  if (grupo) {
    const botones = [...grupo.querySelectorAll<HTMLButtonElement>("[data-modo]")];
    const pintar = (modo: string) => botones.forEach((b) => {
      const si = b.dataset.modo === modo;
      b.setAttribute("aria-checked", String(si));
      b.tabIndex = si ? 0 : -1;
    });
    const poner = (modo: string) => {
      const antes = document.documentElement.dataset.pago || "anual";
      if (modo === antes) return;
      document.documentElement.dataset.pago = modo;
      pintar(modo);
      const u = new URL(location.href);
      if (modo === "mensual") u.searchParams.set("pago", "mensual");
      else u.searchParams.delete("pago");
      history.replaceState(history.state, "", u);
      window.dispatchEvent(new CustomEvent("cr:evento", { detail: { nombre: "precio_periodo_cambio", datos: { de: antes, a: modo } } }));
    };
    pintar(document.documentElement.dataset.pago || "anual");
    botones.forEach((b) => b.addEventListener("click", () => poner(b.dataset.modo!)));
    grupo.addEventListener("keydown", (e) => {
      if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(e.key)) return;
      e.preventDefault();
      const i = botones.findIndex((b) => b.getAttribute("aria-checked") === "true");
      const sig = botones[(i + (e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 1) + botones.length) % botones.length];
      poner(sig.dataset.modo!);
      sig.focus();
    });
  }
</script>

<style>
  /* Precio en la letra del texto con cifras tabulares, no en la mono (John, 2-nov-2026). */
  .precio-plan { font-family: var(--font-body); font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -.02em; line-height: 1.1; }
  .ahorro-plan { color: var(--link); font-weight: 600; font-size: var(--fs-w-15); line-height: 1.35; font-variant-numeric: tabular-nums; }
</style>
