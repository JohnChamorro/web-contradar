---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { CONTACT_EMAIL, whatsappLink } from "../consts";
/* Equipo. Las credenciales son legalmente sensibles: van textuales, no se
   completan ni se abrevian.
   Patrón de color, igual en las cuatro: solo el rol va en azul de marca; el
   aporte y los años, en gris. Antes «Producto y arquitectura de datos» era una
   segunda línea azul en la tarjeta del fundador y desnivelaba la fila.
   `foto` queda listo para la imagen real (cuadrada);
   mientras no exista, la tarjeta pinta las iniciales.
   OJO con la ligadura: Manrope convierte «(c)» en «©», así que «PhD(c)» salía
   como «PhD©». El badge lleva font-variant-ligatures: none para que la
   credencial se lea tal cual está escrita. */
const equipo = [
  {
    nombre: "John Euler Chamorro",
    iniciales: "JC",
    rol: "Fundador",
    aporte: "Producto y arquitectura de datos",
    anios: "8 años en datos, 7 en desarrollo",
    credencial: "Magíster en Automatización",
    foto: null as string | null,
  },
  {
    nombre: "Jairo Marín",
    iniciales: "JM",
    rol: "Análisis de datos",
    aporte: "Estadística y rigor",
    anios: "9 años en análisis de datos",
    credencial: "PhD(c) en Ciencias de la Electrónica",
    foto: null as string | null,
  },
  {
    nombre: "Jaderd Smith",
    iniciales: "JS",
    rol: "Especialista en obra pública",
    aporte: "Dirección de obra, licitaciones y consorcios",
    anios: "4 años en obra y licitaciones",
    credencial: "Ingeniero Civil",
    foto: null as string | null,
  },
  {
    nombre: "Alejandra Viveros",
    iniciales: "AV",
    rol: "Relación con clientes",
    aporte: "Implementaciones y acompañamiento al cliente",
    anios: "2 años en atención al cliente",
    credencial: "Estudiante de Ingeniería de Sistemas",
    foto: null as string | null,
  },
];
---

<Base
  title="Nosotros — ContRadar"
  description="ContRadar es un producto de eulertech, empresa colombiana de software para la contratación pública, construido en Popayán, Cauca. Automatizamos la vigilancia de SECOP I y SECOP II para que vender al Estado deje de depender de revisar el portal a mano."
>
  <Nav />
  <main>

    <!-- Page intro — claro (v2) -->
    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-5 py-14 text-center sm:px-8">
        <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">Nosotros</p>
        <h1 class="text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl lg:text-5xl">Somos ContRadar.</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-grafito-500">
          Un producto de <strong class="text-grafito-900">eulertech</strong>, construido en Popayán,
          Colombia. Analizamos toda la contratación pública del país con estadística y análisis de
          datos, para que vender al Estado deje de ser una apuesta y pase a decidirse con números.
        </p>
      </div>
    </section>

    <!-- Equipo. Va justo después de la intro: antes de explicar por qué existe
         el producto, se ve quién lo hace.
         Fondo papel-100 para no repetir el de la sección siguiente; la página
         alterna blanco → 100 → 50 → 100 → 50 → 100 (slate-50 está remapeado a
         papel-100 en el config, no es un neutro distinto).
         Las fotos son marcadores con iniciales: el hueco ya está maquetado como
         cuadrado, así que sustituirlas por la foto real es cambiar una línea. -->
    <section class="bg-papel-100">
      <div class="mx-auto max-w-contenido px-5 py-16 sm:px-8">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <p class="dato text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">Equipo</p>
          <h2 class="mt-4 text-2xl font-bold tracking-tight text-grafito-900 sm:text-3xl text-wrap-balance">
            Quiénes están detrás de los números
          </h2>
          <p class="mx-auto mt-5 max-w-[58ch] leading-relaxed text-grafito-500">
            Un equipo conformado por profesionales de alto nivel en ingeniería, análisis de datos y
            contratación pública. Cada uno, dueño de su parte.
          </p>
        </div>

        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal data-delay="100">
          {equipo.map((p) => (
            <li class="flex min-w-0 flex-col rounded-xl border border-papel-200 bg-white p-5">
              {p.foto ? (
                <img
                  src={p.foto}
                  alt={p.nombre}
                  width="480"
                  height="480"
                  loading="lazy"
                  class="aspect-square w-full rounded-lg object-cover"
                />
              ) : (
                <span
                  class="dato grid aspect-square w-full place-items-center rounded-lg bg-azul-50 text-2xl font-semibold text-azul-300"
                  aria-hidden="true"
                >{p.iniciales}</span>
              )}
              <h3 class="mt-4 text-lg font-extrabold leading-tight tracking-tight text-grafito-900">{p.nombre}</h3>
              <p class="mt-1 text-sm font-bold leading-snug text-azul-600">{p.rol}</p>
              <p class="mt-2 text-sm leading-relaxed text-grafito-500">{p.aporte}</p>
              <p class="mt-1 text-sm leading-relaxed text-grafito-400">{p.anios}</p>
              <p class="mt-auto pt-4">
                <span
                  class="inline-block rounded-full bg-papel-100 px-2.5 py-1 text-[0.6875rem] font-semibold leading-none text-grafito-700"
                  style="font-variant-ligatures: none"
                >
                  {p.credencial}
                </span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Por qué existimos. El titular parte en dos como el de la portada: la
         primera frase plantea, la segunda remata en azul. Mismo patrón, misma
         lectura.
         Los párrafos van en grafito-700, que es exactamente el color al que
         resolvía el slate-600 que había aquí: mismo tono, nombre del sistema. -->
    <section class="bg-papel-50">
      <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8" data-reveal>
        <p class="dato text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">Por qué existimos</p>
        <h2 class="mt-4 text-2xl font-bold tracking-tight text-grafito-900 sm:text-3xl text-wrap-balance">
          En las licitaciones no gana quien más busca.
          <em class="not-italic block text-azul-600">Gana quien mejor decide.</em>
        </h2>
        <p class="mt-5 leading-relaxed text-grafito-700">
          Encontrar la oportunidad es lo fácil — está publicada en el SECOP, a la vista de todos.
          Lo difícil, y lo que separa a quien gana de quien solo participa, es saber contra quién
          compites, a qué precio se adjudica en esa entidad y cómo contrata de verdad. Esa
          información no está en el pliego.
        </p>
        <p class="mt-4 leading-relaxed text-grafito-700">
          ContRadar nació para medirla. Analizamos toda la contratación pública del país con
          estadística y análisis de datos, y lo cruzamos con la experiencia real de quienes conocen
          las licitaciones por dentro. El resultado: cada oferta se decide con números, no con
          intuición.
        </p>
        <p class="mt-4 leading-relaxed text-grafito-700">
          Y sí, también automatizamos la vigilancia — detectamos cada proceso apenas entra al SECOP
          y lo filtramos con los datos de tu empresa, incluido tu RUP. Pero eso es apenas el punto
          de partida. El valor está en lo que sabes antes de ofertar.
        </p>
      </div>
    </section>

    <!-- Cómo trabajamos -->
    <section class="bg-slate-50">
      <div class="mx-auto max-w-contenido px-5 py-16 sm:px-8">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <p class="dato inline-block text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
            Cómo trabajamos
          </p>
          <h2 class="mt-4 text-2xl font-bold tracking-tight text-grafito-900 sm:text-3xl">
            Trabajamos con clientes, no solo para clientes.
          </h2>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-3" data-reveal data-delay="100">
          {[
            {
              icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
              title: "Configuración guiada, sin manuales",
              desc: "Un asistente paso a paso deja tus búsquedas funcionando en 2 minutos y te muestra tus primeras licitaciones al terminar. Y si te trabas, nos escribes directo.",
            },
            {
              icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.8L3 20l.8-4A7.94 7.94 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
              title: "Soporte directo, no tickets",
              desc: "Cuando tienes una duda o un problema, respondes al mismo equipo que construyó la herramienta. Sin niveles de soporte, sin bots.",
            },
            {
              icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
              title: "Desarrollo a la medida cuando lo necesitas",
              desc: "Si tu operación tiene un requerimiento que no está en el producto estándar, lo evaluamos y lo construimos sobre ContRadar.",
            },
          ].map((c) => (
            <div class="rounded-xl border border-papel-200 bg-white p-6 card-hover">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-azul-500/10 text-azul-300">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={c.icon}/>
                </svg>
              </div>
              <h3 class="mt-4 font-bold text-grafito-900">{c.title}</h3>
              <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sobre eulertech -->
    <section class="bg-papel-50">
      <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8" data-reveal>
        <p class="dato text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">Sobre eulertech</p>
        <h2 class="mt-4 text-2xl font-bold tracking-tight text-grafito-900 sm:text-3xl">
          Software colombiano para la contratación pública.
        </h2>
        <p class="mt-5 text-slate-600 leading-relaxed">
          eulertech es una empresa colombiana de software especializada en herramientas para la
          contratación pública. Operamos desde Popayán, Cauca, para toda
          Colombia de forma remota.
        </p>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Construimos sobre fuentes oficiales — SECOP I, SECOP II y Colombia Compra Eficiente.
          Nada de datos de terceros no verificados.
        </p>
      </div>
    </section>

    <!-- Hablemos -->
    <section class="bg-white">
      <div class="mx-auto max-w-3xl px-5 py-14 text-center sm:px-8" data-reveal>
        <h2 class="text-2xl font-bold tracking-tight text-grafito-900 sm:text-3xl">Hablemos</h2>
        <p class="mt-3 mx-auto max-w-xl text-slate-600 leading-relaxed">
          ¿Quieres conocer ContRadar o necesitas algo a la medida? Te respondemos rápido,
          directo con el equipo.
        </p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
          <a href={`mailto:${CONTACT_EMAIL}`} class="whitespace-nowrap inline-block min-h-[44px] rounded-lg bg-azul-500 px-6 py-3 text-sm font-bold text-white transition hover:bg-azul-600">
            {CONTACT_EMAIL} →
          </a>
          <a href={whatsappLink("Hola, quiero conocer ContRadar")} target="_blank" rel="noopener"
            class="inline-flex min-h-[44px] items-center gap-2 whitespace-nowrap rounded-lg border border-papel-300 bg-white px-6 py-3 text-sm font-semibold text-grafito-900 transition hover:border-azul-500 hover:text-azul-600">
            <WhatsAppIcon class="h-5 w-5 text-[#25D366]" />
            Escríbenos por WhatsApp
          </a>
        </div>
        <p class="mt-3 text-xs text-slate-500">Te respondemos en menos de 24 horas hábiles.</p>
      </div>
    </section>

    <AccessForm />

  </main>
  <Footer />
</Base>
