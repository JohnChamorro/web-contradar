---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import fs from "node:fs";
import { CONTACT_EMAIL, whatsappLink } from "../consts";
import { CIFRAS, CIFRAS_CORTE, DESDE, DESDE_CONTRATOS } from "../data/producto";

/* Las fotos del equipo se recogen del disco en tiempo de compilación: basta
   dejar el archivo en public/equipo/<slug>.webp (o .jpg) y aparece sola en el
   siguiente despliegue. Si no está, la tarjeta pinta las iniciales. Así nadie
   tiene que acordarse de editar esta lista. */
const CARPETA_EQUIPO = new URL("../../public/equipo/", import.meta.url);
const ARCHIVOS_EQUIPO = fs.existsSync(CARPETA_EQUIPO) ? fs.readdirSync(CARPETA_EQUIPO) : [];
const ORDEN_EXT = ["webp", "jpg", "jpeg", "png"];

/* Se lee la carpeta y se compara en minúsculas, en vez de adivinar el nombre
   exacto: las fotos llegaron como .JPEG en mayúsculas y un existsSync con la
   extensión escrita a mano no las habría encontrado — en Linux el disco
   distingue mayúsculas y el fallo habría sido silencioso. */
const buscarFoto = (slug: string): string | null => {
  const candidatos = ARCHIVOS_EQUIPO.filter((f) => {
    const punto = f.lastIndexOf(".");
    return punto > 0 && f.slice(0, punto).toLowerCase() === slug;
  });
  candidatos.sort(
    (a, b) =>
      ORDEN_EXT.indexOf(a.split(".").pop()!.toLowerCase()) -
      ORDEN_EXT.indexOf(b.split(".").pop()!.toLowerCase()),
  );
  return candidatos[0] ? `/equipo/${candidatos[0]}` : null;
};
/* Equipo. Las credenciales son legalmente sensibles: van textuales, no se
   completan ni se abrevian.
   Molde 2027 (2-nov-2026): sin tarjeta alrededor de cada persona; la foto, el
   nombre en 800, el rol en el color del texto y lo demás en --muted. El azul se
   queda para enlaces y acciones. Sin foto, el hueco pinta las iniciales.
   OJO con la ligadura: Manrope convierte «(c)» en «©», así que «PhD(c)» salía
   como «PhD©». El badge lleva font-variant-ligatures: none para que la
   credencial se lea tal cual está escrita. */
const equipo = [
  {
    nombre: "John Euler Chamorro",
    slug: "john-chamorro",
    iniciales: "JC",
    rol: "Fundador",
    aporte: "Producto y arquitectura de datos",
    anios: "8 años en datos, 7 en desarrollo",
    credencial: "Magíster en Automatización",
  },
  {
    nombre: "Jairo Marín",
    slug: "jairo-marin",
    iniciales: "JM",
    rol: "Análisis de datos",
    aporte: "Estadística y rigor",
    anios: "9 años en análisis de datos",
    credencial: "PhD(c) en Ciencias de la Electrónica",
  },
  {
    nombre: "Jaderd Dorado",
    slug: "jaderd-dorado",
    iniciales: "JD",
    rol: "Especialista en obra pública",
    aporte: "Dirección de obra, licitaciones y consorcios",
    anios: "4 años en obra y licitaciones",
    credencial: "Ingeniero Civil",
  },
  {
    nombre: "Alejandra Viveros",
    slug: "alejandra-viveros",
    iniciales: "AV",
    rol: "Relación con clientes",
    aporte: "Implementaciones y acompañamiento al cliente",
    anios: "2 años en atención al cliente",
    credencial: "Estudiante de Ingeniería de Sistemas",
  },
].map((p) => ({ ...p, foto: buscarFoto(p.slug) }));

/* Lo que medimos, con su fecha: salen de src/data/producto.ts, la misma fuente
   que la portada. */
const [anio, mes, dia] = CIFRAS_CORTE.split("-");
const MESES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
const corte = `${Number(dia)} de ${MESES[Number(mes) - 1]} de ${anio}`;
const cifras = [
  [CIFRAS.procesos, `procesos públicos, desde ${DESDE}`],
  [CIFRAS.contratos, `contratos con su ficha, desde ${DESDE_CONTRATOS}`],
  [CIFRAS.empresas, "proveedores perfilados"],
  [CIFRAS.entidades, "entidades contratantes"],
];

const hechos = [
  ["Popayán, Cauca", "desde donde lo construimos"],
  ["SECOP I y SECOP II", "las dos plataformas, siempre"],
  ["Soporte directo", "responde quien hizo la herramienta"],
];

const modos = [
  ["Configuración guiada, sin manuales", "Con tu NIT tu búsqueda nace armada y entras directo a ver tus licitaciones abiertas. Si quieres, te la mostramos en 15 minutos por videollamada."],
  ["Soporte directo, no tickets", "Cuando tienes una duda, respondes al mismo equipo que construyó la herramienta. Sin niveles de soporte ni bots."],
  ["A la medida cuando lo necesitas", "Si tu operación pide algo que no está en el producto, lo evaluamos y lo construimos sobre ContRadar."],
];
---

<Base
  title="Nosotros: el equipo detrás de ContRadar"
  description="ContRadar es un producto de eulertech, hecho en Popayán: un equipo de ingeniería, estadística y obra pública que analiza toda la contratación pública del país."
  migas={[{ nombre: "Nosotros", url: "/nosotros/" }]}
>
  <Nav />
  <main class="nos">
    <section class="cabeza">
      <div class="marco">
        <span class="ceja">NOSOTROS</span>
        <h1><span class="fino">Somos ContRadar.</span><br /><span class="fuerte">Datos y obra pública, desde Popayán.</span></h1>
        <p class="sub">
          Un producto de eulertech, construido en Popayán, Colombia. Analizamos toda la contratación pública
          del país con estadística y análisis de datos, para que vender al Estado deje de ser una apuesta y
          pase a decidirse con números.
        </p>
      </div>
      <div class="marco hechos">
        {hechos.map(([v, k]) => <div><b>{v}</b><span>{k}</span></div>)}
      </div>
    </section>

    <div class="marco cuerpo">
      <section class="columna" id="equipo" data-reveal>
        <div class="cab">
          <div>
            <span class="ceja">01 · EQUIPO</span>
            <h2><span class="fino">Quiénes están</span><br /><span class="fuerte">detrás de los números.</span></h2>
          </div>
          <p>Ingeniería, análisis de datos y contratación pública. Cada uno, dueño de su parte.</p>
        </div>
        <ul class="equipo">
          {equipo.map((p) => (
            <li id={p.slug}>
              {p.foto ? (
                <img
                  src={p.foto}
                  alt={`${p.nombre}, ${p.rol.toLowerCase()} de ContRadar`}
                  width="480"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="iniciales" aria-hidden="true">{p.iniciales}</span>
              )}
              <h3>{p.nombre}</h3>
              <p class="rol">{p.rol}</p>
              <p class="nota">{p.aporte}</p>
              <p class="nota">{p.anios}</p>
              <span class="credencial">{p.credencial}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="fila" data-reveal>
        <div class="txt">
          <span class="ceja">02 · POR QUÉ EXISTIMOS</span>
          <h2><span class="fino">Buscar licitaciones es la parte fácil.</span><br /><span class="fuerte">Lo difícil es decidir cuáles y a qué precio.</span></h2>
          <p>
            La oportunidad está publicada en el SECOP, a la vista de todos. Lo que cuesta es saber contra quién
            compites, a qué precio se adjudica en tu sector y tu zona y cómo contrata de verdad cada entidad. Esa
            información no está en el pliego.
          </p>
          <p>
            ContRadar nació para medirla, y lo cruzamos con la experiencia de quienes conocen las licitaciones por
            dentro. También revisamos el SECOP cada día con los datos de tu empresa, incluido tu RUP, pero eso es
            el punto de partida: el valor está en lo que sabes antes de ofertar.
          </p>
        </div>
        <div class="tile ink cifras">
          <span class="rot">Lo que medimos</span>
          <dl>
            {cifras.map(([v, k]) => <div><dt>{k}</dt><dd class="cifra">{v}</dd></div>)}
          </dl>
          <p class="fuente">SECOP I y SECOP II, datos abiertos de Colombia Compra Eficiente. Corte del {corte}.</p>
        </div>
      </section>

      <section class="columna" data-reveal>
        <div class="cab">
          <div>
            <span class="ceja">03 · CÓMO TRABAJAMOS</span>
            <h2><span class="fino">Con clientes,</span><br /><span class="fuerte">no solo para clientes.</span></h2>
          </div>
          <p>eulertech es una empresa colombiana de software para la contratación pública. Trabajamos sobre fuentes oficiales: nada de datos de terceros sin verificar.</p>
        </div>
        <div class="modos">
          {modos.map(([t, d]) => <div class="tile gris"><b>{t}</b><span>{d}</span></div>)}
        </div>
      </section>

      <section class="hablemos" data-reveal>
        <h2><span class="fino">¿Hablamos?</span><br /><span class="fuerte">Te responde el equipo.</span></h2>
        <div>
          <p>¿Quieres conocer ContRadar o necesitas algo a la medida? Escríbenos y te respondemos en menos de 24 horas hábiles.</p>
          <div class="acciones">
            <a href={whatsappLink("Hola, quiero conocer ContRadar")} target="_blank" rel="noopener" class="pildora">
              <WhatsAppIcon class="wa" />Escríbenos por WhatsApp<i aria-hidden="true">→</i>
            </a>
            {/* email_off: Cloudflare ofusca los correos del HTML y hasta que su
                script los descifra se lee «[email protected]». Aquí no puede
                pasar: es donde la persona decide escribirnos. En el pie se deja
                ofuscado, que es donde de verdad lo cosechan los bots. */}
            <!--email_off-->
            <a href={`mailto:${CONTACT_EMAIL}`} class="secundario">{CONTACT_EMAIL}</a>
            <!--/email_off-->
          </div>
        </div>
      </section>
    </div>

    <AccessForm />
  </main>
  <Footer />
</Base>

<style>
  .nos { color: var(--ink); font-family: var(--font-body); overflow-x: clip; }
  .marco { max-width: var(--web-max); margin-inline: auto; padding-inline: var(--web-pad); box-sizing: border-box; }
  .fino { font-weight: var(--fw-ligero); } .fuerte { font-weight: 800; }
  .ceja { display: block; font-family: var(--font-codigo); font-size: var(--fs-w-13); letter-spacing: .12em; color: var(--muted); }
  h1 { margin: 16px 0 0; font-size: var(--fs-web-h1); line-height: 1.02; letter-spacing: -.045em; word-spacing: normal; }
  h2 { margin: 12px 0 0; font-size: var(--fs-web-h2-c); line-height: 1.06; letter-spacing: -.045em; word-spacing: normal; }
  .cabeza { padding-block: clamp(40px, 5vw, 72px) 0; }
  .sub { margin: 20px 0 0; max-width: 62ch; font-size: var(--fs-w-18); line-height: 1.5; color: var(--muted); }
  .hechos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: clamp(32px, 4vw, 56px); }
  .hechos > div { display: flex; flex-direction: column; gap: 2px; padding: 20px 24px; border-block: 1px solid var(--line); border-left: 1px solid var(--line); }
  .hechos > div:first-child { padding-left: 0; border-left: 0; }
  .hechos b { font-size: var(--fs-w-18); font-weight: 800; }
  .hechos span { font-size: var(--fs-w-14); color: var(--muted); }
  .cuerpo { display: flex; flex-direction: column; gap: var(--web-sec-y); padding-block: var(--web-sec-y); }
  .columna { display: flex; flex-direction: column; gap: 32px; }
  .cab { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 16px clamp(32px, 4.4vw, 64px); align-items: end; }
  .cab p, .txt p { margin: 0; font-size: var(--fs-w-17); line-height: 1.5; color: var(--muted); }
  .txt p { margin-top: 16px; }

  .equipo { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(20px, 2.2vw, 32px); }
  .equipo li { display: flex; flex-direction: column; min-width: 0; scroll-margin-top: 96px; }
  .equipo img, .iniciales { width: 100%; aspect-ratio: 1; border-radius: var(--radius-tile-sm); object-fit: cover; }
  .iniciales { display: grid; place-items: center; background: var(--surface-3); font-family: var(--font-cifra); font-size: var(--fs-w-28); font-weight: 600; color: var(--muted); }
  .equipo h3 { margin: 18px 0 0; font-size: var(--fs-w-20); font-weight: 800; letter-spacing: -.02em; line-height: 1.2; }
  .rol { margin: 4px 0 0; font-size: var(--fs-w-15); font-weight: 700; }
  .nota { margin: 4px 0 0; font-size: var(--fs-w-14); line-height: 1.45; color: var(--muted); }
  .rol + .nota { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); }
  /* Manrope convierte «(c)» en «©»: la credencial se lee tal cual está escrita. */
  .credencial { align-self: flex-start; margin-top: 14px; padding: 5px 12px; border-radius: var(--radius-pill); background: var(--surface-3); font-size: var(--fs-w-12); font-weight: 600; color: var(--ink); font-variant-ligatures: none; }

  .fila { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 4.4vw, 64px); align-items: center; }
  .tile { border-radius: var(--radius-tile); padding: clamp(24px, 2.8vw, 40px); box-sizing: border-box; min-width: 0; }
  .tile.ink { background: var(--panel-ink); color: var(--on-action); }
  :global(:root[data-theme="dark"]) .tile.ink { box-shadow: inset 0 0 0 1px var(--panel-line); }
  .tile.gris { background: var(--surface-3); display: flex; flex-direction: column; gap: 10px; }
  .rot { font-family: var(--font-codigo); font-size: var(--fs-w-12); letter-spacing: .1em; text-transform: uppercase; color: var(--panel-muted); }
  .cifras dl { margin: 12px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cifras dl > div { display: flex; flex-direction: column-reverse; gap: 4px; padding: 18px 0; border-top: 1px solid var(--panel-line); }
  .cifras dl > div:nth-child(even) { padding-left: 20px; border-left: 1px solid var(--panel-line); }
  .cifras dd { margin: 0; font-size: var(--fs-web-cifra-44); font-weight: 600; line-height: 1; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .cifras dt { font-size: var(--fs-w-14); line-height: 1.4; color: var(--panel-muted); }
  .fuente { margin: 8px 0 0; font-size: var(--fs-w-13); line-height: 1.45; color: var(--panel-muted); }

  .modos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .modos b { font-size: var(--fs-w-18); font-weight: 800; letter-spacing: -.01em; }
  .modos span { font-size: var(--fs-w-15); line-height: 1.5; color: var(--muted); }

  .hablemos { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(32px, 4.4vw, 64px); align-items: end; padding-top: clamp(32px, 4vw, 56px); border-top: 1px solid var(--line); }
  .hablemos h2 { margin: 0; }
  .hablemos p { margin: 0; max-width: 52ch; font-size: var(--fs-w-17); line-height: 1.5; color: var(--muted); }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 24px; }
  .pildora { height: 60px; padding: 0 10px 0 22px; border-radius: var(--radius-pill); background: var(--web-boton); color: var(--web-boton-tx); display: inline-flex; align-items: center; gap: 12px; font-size: var(--fs-w-17); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .pildora :global(.wa) { width: 20px; height: 20px; flex: none; }
  .pildora i { width: 42px; height: 42px; margin-left: 4px; border-radius: var(--radius-pill); background: var(--capa-licitaciones); color: var(--on-action); display: flex; align-items: center; justify-content: center; font-style: normal; }
  .secundario { font-size: var(--fs-w-15); font-weight: 700; color: var(--link); text-decoration: none; }
  .secundario:hover { text-decoration: underline; }

  @media (max-width: 1099.98px) {
    .equipo { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 899.98px) {
    .fila, .cab, .hablemos, .hechos, .modos { grid-template-columns: minmax(0, 1fr); }
    .hechos > div { padding-left: 0; border-left: 0; border-bottom: 0; }
    .hechos > div:last-child { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 480px) {
    .equipo { grid-template-columns: minmax(0, 1fr); }
    .pildora { width: 100%; justify-content: space-between; }
  }
</style>
