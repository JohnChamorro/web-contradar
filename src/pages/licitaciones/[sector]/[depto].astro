---
/* /licitaciones/<sector>/<departamento>/ — agregados del snapshot
   (sectorDepto), solo combinaciones que pasaron el umbral en el exportador
   (≥ 100 contratos y ≥ 10 compradoras). Despliegue gradual: noindex hasta
   que INDEXAR_SECTOR_DEPTO=1 (después de medir la tanda 1 de entidades). */
import Base from "../../../layouts/Base.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import AccessForm from "../../../components/AccessForm.astro";
import Migas from "../../../components/guias/Migas.astro";
import CtaDiagnostico from "../../../components/guias/CtaDiagnostico.astro";
import { moneda } from "../../../lib/formato";
import { absoluta, ID } from "../../../lib/esquemas";
import { leerSnapshot, type SectorDepto, type Snapshot } from "../../../lib/entidades";
import { SECTORES } from "../../../data/sectores";

export function getStaticPaths() {
  const snap = leerSnapshot();
  if (!snap?.sectorDepto) return [];
  return snap.sectorDepto.map((c) => ({
    params: { sector: c.sectorSlug, depto: c.departamentoSlug },
    props: { c, snap },
  }));
}
const { c, snap } = Astro.props as { c: SectorDepto; snap: Snapshot };
const url = `/licitaciones/${c.sectorSlug}/${c.departamentoSlug}/`;
const paginaSector = SECTORES.find((s) => s.slug === c.sectorSlug);
const migas = [
  { nombre: "Entidades", url: "/entidades/" },
  { nombre: c.departamento, url: `/entidades/${c.departamentoSlug}/` },
  { nombre: c.sector, url },
];
const num = (x: number) => x.toLocaleString("es-CO");
const pct = (x: number) => `${x.toLocaleString("es-CO", { maximumFractionDigits: 1 })} %`;
const top = c.topEntidades[0];
const partTop = top && c.valor > 0 ? (top.valor / c.valor) * 100 : 0;
const frases = [
  `Entre 2023 y 2025 se firmaron ${num(c.contratos)} contratos de ${c.sector.toLowerCase()} en ${c.departamento} por ${moneda(c.valor, "abreviado")}, con ${num(c.compradoras)} entidades compradoras.`,
  `El contrato típico (mediana) fue de ${moneda(c.mediana, "abreviado")}.`,
  top &&
    (partTop >= 30
      ? `La demanda está concentrada: ${top.nombre} compró el ${pct(partTop)} del valor.`
      : `La demanda está repartida: la entidad que más compró, ${top.nombre}, sumó el ${pct(partTop)} del valor.`),
].filter(Boolean) as string[];
const indexar = process.env.INDEXAR_SECTOR_DEPTO === "1" && !snap.maqueta;
---

<Base
  title={`Licitaciones de ${c.sector.toLowerCase()} en ${c.departamento} · ContRadar`.slice(0, 70)}
  description={`${num(c.contratos)} contratos de ${c.sector.toLowerCase()} en ${c.departamento} entre 2023 y 2025: quién compra, cuánto vale un contrato típico y dónde ofertar.`.slice(0, 160)}
  noindex={!indexar}
  migas={migas}
  esquemas={[{ "@context": "https://schema.org", "@type": "WebPage", name: `Licitaciones de ${c.sector} en ${c.departamento}`, url: absoluta(url), inLanguage: "es-CO", isPartOf: { "@id": ID.sitio }, dateModified: snap.corte }]}
>
  <Nav />
  <main>
    <section class="bg-white">
      <div class="mx-auto max-w-contenido px-5 pb-8 pt-10 sm:px-8 lg:pt-14">
        <Migas migas={migas} />
        <h1 class="mt-5 text-3xl font-extrabold leading-[1.08] tracking-tight text-grafito-900 sm:text-4xl lg:text-5xl text-wrap-balance">
          Licitaciones de {c.sector.toLowerCase()} en {c.departamento}
        </h1>
        <ul class="mt-5 max-w-[65ch] space-y-2 text-[0.9375rem] leading-relaxed text-grafito-700">
          {frases.map((f) => <li class="border-l-2 border-azul-300 pl-3">{f}</li>)}
        </ul>
        {paginaSector && <p class="mt-4 text-sm"><a href={`/sectores/${paginaSector.slug}/`} class="font-semibold text-azul-600 hover:underline">Cómo se licita en {paginaSector.nombre.toLowerCase()}</a></p>}
      </div>
    </section>
    <section class="bg-papel-50">
      <div class="mx-auto grid max-w-contenido gap-10 px-5 py-12 sm:px-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <div class="min-w-0">
          <h2 class="text-xl font-extrabold tracking-tight text-grafito-900">Entidades que más compran</h2>
          <div class="mt-4 overflow-x-auto rounded-xl border border-papel-200 bg-white">
            <table class="w-full min-w-[420px] border-collapse text-sm">
              <thead><tr class="text-left text-[0.75rem] uppercase tracking-[0.08em] text-grafito-500"><th class="px-4 py-3 font-semibold">Entidad</th><th class="px-4 py-3 text-right font-semibold">Contratos</th><th class="px-4 py-3 text-right font-semibold">Valor</th></tr></thead>
              <tbody>
                {c.topEntidades.map((t) => (
                  <tr class="border-t border-papel-150">
                    <td class="px-4 py-2.5">{t.slug ? <a href={`/entidades/${t.slug}-${t.nit}/`} class="font-semibold text-grafito-900 hover:text-azul-600">{t.nombre}</a> : <span class="text-grafito-900">{t.nombre}</span>}</td>
                    <td class="dato px-4 py-2.5 text-right text-grafito-700">{num(t.contratos)}</td>
                    <td class="dato px-4 py-2.5 text-right text-grafito-700">{moneda(t.valor, "abreviado")}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-[0.8125rem] text-grafito-500">Fuente: SECOP II, contratos firmados 2023-2025, sector por código UNSPSC. Corte al <span class="dato">{snap.corte}</span>.</p>
        </div>
        <aside class="min-w-0">
          <CtaDiagnostico medio="sector-depto" campana={`${c.sectorSlug}-${c.departamentoSlug}`} titulo="¿Ofertas en este mercado?" texto="Mira qué has ganado aquí y contra quién compites, gratis con tu NIT." />
        </aside>
      </div>
    </section>
    <AccessForm />
  </main>
  <Footer />
</Base>
