---
import { moneda } from "../lib/formato";
import { PRECIO_DESDE, PRUEBA } from "../data/producto";
import { CTA_PRIMARIO } from "../consts";
import Flecha from "../components/Flecha.astro";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import HeroFoto from "../components/HeroFoto.astro";
import Pricing from "../components/Pricing.astro";
import PlanComparison from "../components/PlanComparison.astro";
import CustomDevCTA from "../components/CustomDevCTA.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title={`Precios de ContRadar: planes desde ${moneda(PRECIO_DESDE)}/mes`}
  description={`Precios de la app de licitaciones ContRadar: planes desde ${moneda(PRECIO_DESDE)}/mes en plan anual, sin permanencia. Empieza con ${PRUEBA.dias} días gratis de ${PRUEBA.plan}, sin tarjeta.`}
  migas={[{ nombre: "Precios", url: "/precios/" }]}
>
  <Nav />
  <main>

    <!-- Hero con foto (15-nov-2026) -->
    <HeroFoto foto="precios" fino="Precios claros." fuerte="Sin permanencia." bajada={`Tres planes, mensual o anual. Empiezas con ${PRUEBA.dias} días gratis y decides después.`} encuadre="50% 60%">
      <p class="hf-nota">{PRUEBA.dias} días de {PRUEBA.plan} con análisis de competencia y estadísticas · Sin tarjeta · Sin permanencia</p>
      <div class="hf-acc"><a href="#solicitar" class="hf-btn">{CTA_PRIMARIO}<i aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></i></a></div>
    </HeroFoto>

    <Pricing />
    <PlanComparison />
    <CustomDevCTA />
    <ComparisonTable />
    <AccessForm />

  </main>
  <Footer />
</Base>
