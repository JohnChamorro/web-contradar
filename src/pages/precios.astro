---
import Flecha from "../components/Flecha.astro";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Pricing from "../components/Pricing.astro";
import PlanComparison from "../components/PlanComparison.astro";
import ROISection from "../components/ROISection.astro";
import CustomDevCTA from "../components/CustomDevCTA.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";
import { Gift } from "@lucide/astro";
---

<Base
  title="Precios — ContRadar"
  description="Planes desde $152.000/mes en plan anual. Sin permanencia. Alerta para empezar, Ventaja para equipos, Dominio para toda tu organización. Cancela cuando quieras."
>
  <Nav />
  <main>

    <!-- Page intro — claro: la única banda oscura de /precios es el ROI -->
    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-5 py-14 text-center sm:px-8 lg:py-20">
        <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
          Precios
        </p>
        <h1 class="text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl lg:text-5xl">
          Precios claros.
          <span class="text-azul-600">Sin permanencia.</span>
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-lg text-grafito-500">
          Un analista de licitaciones cuesta entre <span class="dato">$2,5&#160;M</span> y <span class="dato">$4&#160;M</span> al mes.
          ContRadar hace su trabajo de búsqueda y seguimiento desde mucho menos.
        </p>
        <div class="mt-6 inline-flex flex-wrap items-center justify-center gap-2 rounded-full border border-papel-200 bg-papel-50 px-4 py-2 text-sm font-semibold text-grafito-900">
          <Gift size={18} stroke-width={1.7} class="shrink-0 text-jade-500" aria-hidden="true" />
          7 días de Ventaja con análisis de competencia y estadísticas · Sin tarjeta · Sin permanencia
        </div>
        <div class="mt-6">
          <a
            href="#solicitar"
            class="inline-flex min-h-[48px] items-center whitespace-nowrap rounded-lg bg-azul-500 px-7 text-base font-bold text-white transition hover:bg-azul-600"
          >
            Empezar mi prueba gratis <Flecha />
          </a>
        </div>
      </div>
    </section>

    <ROISection plansHref="#precios" />
    <Pricing />
    <PlanComparison />
    <CustomDevCTA />
    <ComparisonTable />
    <AccessForm />

  </main>
  <Footer />
</Base>
