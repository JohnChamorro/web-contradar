---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import AccessForm from "../../components/AccessForm.astro";
import Migas from "../../components/guias/Migas.astro";
import Flecha from "../../components/Flecha.astro";

const migas = [{ nombre: "Herramientas", url: "/herramientas/" }];
const herramientas = [
  {
    href: "/herramientas/calculadora-capacidad-residual/",
    titulo: "Calculadora de capacidad residual (K)",
    texto: "Comprueba si tu K alcanza para una licitación de obra pública, con la metodología de Colombia Compra Eficiente.",
  },
];
---

<Base
  title="Herramientas gratis para licitar en Colombia · ContRadar"
  description="Herramientas gratis para preparar licitaciones en Colombia: calculadora de capacidad residual (K) para obra pública y diagnóstico de tu empresa en SECOP."
  migas={migas}
>
  <Nav />
  <main>
    <section class="bg-white">
      <div class="mx-auto max-w-contenido px-5 py-12 sm:px-8 lg:py-16">
        <Migas migas={migas} />
        <h1 class="mt-5 text-3xl font-extrabold leading-[1.08] tracking-tight text-grafito-900 sm:text-4xl lg:text-5xl">Herramientas gratis</h1>
        <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-grafito-500">Para hacer en dos minutos lo que hoy haces a mano en cada licitación. Sin registro.</p>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2">
          {herramientas.map((h) => (
            <li>
              <a href={h.href} class="group block h-full rounded-xl border border-papel-200 bg-white p-6 transition hover:border-azul-300">
                <span class="block text-lg font-bold text-grafito-900 group-hover:text-azul-600">{h.titulo}</span>
                <span class="mt-2 block text-sm leading-relaxed text-grafito-500">{h.texto}</span>
                <span class="mt-4 inline-block text-sm font-semibold text-azul-600">Usar <Flecha /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <AccessForm />
  </main>
  <Footer />
</Base>
