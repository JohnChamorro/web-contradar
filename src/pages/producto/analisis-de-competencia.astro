---
import ProductoLayout from "../../layouts/ProductoLayout.astro";
import CompetenciaShowcase from "../../components/CompetenciaShowcase.astro";
import CompetenciaProfunda from "../../components/CompetenciaProfunda.astro";
import EntidadesEstado from "../../components/EntidadesEstado.astro";
---
<ProductoLayout
  guias={["como-ganar-una-licitacion", "consorcios-y-uniones-temporales", "mejores-apps-licitaciones-colombia"]}
  tituloSeo="Análisis de competencia en licitaciones SECOP · ContRadar"
  titulo="Análisis de competencia"
  momento="Antes de ofertar"
  entradilla="Antes de ofertar ya sabes contra quién compites y con qué precio ganó: qué contratos se llevó, con qué entidades, a qué precio y con quién se asocia — en SECOP I y SECOP II, desde 2012."
  description="Mira qué contratos ganó tu competencia, con qué entidades, a qué precio y con quién se asocia, en SECOP I y II desde 2012. Prueba gratis el análisis."
>
  {/* Sin capturas y centrada: las tres bajan a su bloque en
      CompetenciaProfunda, junto a la explicación que las describe. */}
  <CompetenciaShowcase conCapturas={false} />
  {/* La ampliación pedida el 1-sep: cada pestaña explicada desde lo que el
      usuario decide con ella — nunca desde cómo lo construimos. */}
  <CompetenciaProfunda />
  <EntidadesEstado />
</ProductoLayout>
