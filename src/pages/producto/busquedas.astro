---
import ProductoLayout from "../../layouts/ProductoLayout.astro";
import BusquedaInteligente from "../../components/BusquedaInteligente.astro";
import BusquedasComoFunciona from "../../components/BusquedasComoFunciona.astro";
import ScoreSection from "../../components/ScoreSection.astro";
import SondeosSection from "../../components/SondeosSection.astro";
import PAASection from "../../components/PAASection.astro";
---
{/* Sondeos (RFI) y Plan anual (PAA) viven AQUÍ y no como entradas propias del
    menú: son las dos señales tempranas de la misma capacidad —encontrar antes
    que los demás—, no módulos separados. Es lo que pedía el hallazgo M7 y lo
    que ya hacía el resto de la web. */}
<ProductoLayout
  tituloSeo="Alertas de licitaciones SECOP I y II con puntaje · ContRadar"
  titulo="Búsquedas automáticas"
  momento="Cuando sale el proceso"
  entradilla="La configuras una tarde y trabaja todos los días: recorre SECOP I y SECOP II cada madrugada y te devuelve lo tuyo con un puntaje de 0 a 100 que dice qué revisar primero."
  description="Alertas de licitaciones del SECOP I y II cada mañana, con puntaje 0–100 y los procesos que el portal nombra distinto. Configúralas gratis en 2 minutos."
>
  <BusquedaInteligente />
  <BusquedasComoFunciona />
  <ScoreSection />
  <SondeosSection />
  <PAASection />
</ProductoLayout>
