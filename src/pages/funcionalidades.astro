---
// /funcionalidades — índice del producto (molde Web y app 2027, 2-nov-2026).
// Cada módulo tiene su página bajo /producto/ (hallazgo M7) y aquí solo se
// ordena por CUÁNDO entra en la vida de una licitación, con una miniatura de su
// captura real (public/capturas/indice, recortes 16:10 de las capturas de cada
// página; se regeneran con scratchpad/miniaturas.mjs desde el repo web).
// Los anclajes viejos (#competencia, #ejecucion…) siguen vivos por el script
// puente del final: hay correos y enlaces externos apuntando ahí.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import AyudaSection from "../components/AyudaSection.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";

const arco = [
  {
    momento: "Antes del pliego",
    cuando: "Meses antes de que el proceso exista",
    modulos: [
      { slug: "paa", href: "/producto/busquedas/#paa", t: "Plan anual (PAA)", d: "Lo que el Estado planea comprar, meses antes de publicarlo." },
      { slug: "sondeos", href: "/producto/busquedas/#sondeos", t: "Sondeos (RFI)", d: "Cuando la entidad sale a preguntarle al mercado." },
    ],
  },
  {
    momento: "Cuando sale",
    cuando: "El proceso se publica y hay que decidir",
    modulos: [
      { slug: "busquedas", href: "/producto/busquedas/", t: "Búsquedas automáticas", d: "SECOP I y II cada día, con un puntaje de 0 a 100." },
      { slug: "estadistica", href: "/producto/estadistica-de-la-licitacion/", t: "Estadística de la licitación", d: "Cuánto bajan las ganadoras, quién oferta y en cuánto paga la entidad." },
      { slug: "competencia", href: "/producto/analisis-de-competencia/", t: "Análisis de competencia", d: "Empresas, contratantes y tu mercado." },
      { slug: "ia", href: "/inteligencia/", t: "Asistente IA", d: "Lee el pliego, responde con la página y llena los formatos." },
    ],
  },
  {
    momento: "Cuando ya es tuyo",
    cuando: "De la propuesta a la liquidación",
    modulos: [
      { slug: "mis-licitaciones", href: "/producto/mis-licitaciones/", t: "Mis licitaciones", d: "Cada proceso con su responsable, hasta la adjudicación." },
      { slug: "mis-contratos", href: "/producto/mis-contratos/", t: "Mis contratos", d: "Del acta de inicio a la liquidación, con la K al día." },
      { slug: "calendario", href: "/producto/calendario/", t: "Calendario", d: "Cierres, pólizas, pagos y las fechas del equipo." },
    ],
  },
  {
    momento: "Todo el tiempo",
    cuando: "Lo que cambia, te llega",
    modulos: [
      { slug: "avisos", href: "/producto/notificaciones/", t: "Avisos", d: "Campana y correo: adendas, cierres, resultados y vencimientos." },
    ],
  },
];
---

<Base
  title="Plataforma de licitaciones: funciones de ContRadar"
  description="Plataforma de licitaciones para Colombia: búsquedas en SECOP I y II, estadística de cada proceso, competencia, asistente IA, licitaciones y contratos en equipo, calendario y avisos."
  migas={[{ nombre: "Funcionalidades", url: "/funcionalidades/" }]}
>
  <Nav />
  <main class="fx">
    <section class="cabeza">
      <div class="marco">
        <span class="ceja">FUNCIONALIDADES</span>
        <h1><span class="fino">Del plan anual del Estado</span><br /><span class="fuerte">a la liquidación de tu contrato.</span></h1>
        <p class="sub">Diez módulos sobre los mismos datos: el histórico completo de SECOP I y SECOP II. El primero se enciende meses antes de que exista el pliego; el último, cuando el contrato ya es tuyo.</p>
      </div>
    </section>

    <div class="marco cuerpo">
      {arco.map((fase) => (
        <section class="fase" data-reveal>
          <h2><span class="fino">{fase.momento}.</span><br /><span class="fuerte">{fase.cuando}.</span></h2>
          <div class="tarjetas" style={`--cols: ${fase.modulos.length === 3 ? 3 : 2}`}>
            {fase.modulos.map((m) => (
              <a class="tarjeta" href={m.href}>
                <span class="mini" aria-hidden="true">
                  <img class="solo-claro" src={`/capturas/indice/${m.slug}-claro.webp`} alt="" width="960" height="600" loading="lazy" />
                  <img class="solo-oscuro" src={`/capturas/indice/${m.slug}-oscuro.webp`} alt="" width="960" height="600" loading="lazy" />
                </span>
                <span class="texto">
                  <b>{m.t}</b>
                  <span>{m.d}</span>
                  <i>Ver cómo funciona<span aria-hidden="true"> →</span></i>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
    <AyudaSection />
    <AccessForm />
  </main>
  <Footer />
</Base>

<style>
  .fx { color: var(--ink); font-family: var(--font-body); overflow-x: clip; }
  .marco { max-width: var(--web-max); margin-inline: auto; padding-inline: var(--web-pad); box-sizing: border-box; }
  .fino { font-weight: var(--fw-ligero); } .fuerte { font-weight: 800; }
  .ceja { display: block; font-family: var(--font-codigo); font-size: var(--fs-w-13); letter-spacing: .12em; color: var(--muted); }
  h1 { margin: 16px 0 0; font-size: var(--fs-web-h1); line-height: 1.02; letter-spacing: -.045em; word-spacing: normal; }
  h2 { margin: 0; font-size: var(--fs-web-40); line-height: 1.08; letter-spacing: -.04em; word-spacing: normal; }
  .cabeza { padding-block: clamp(40px, 5vw, 72px) 0; }
  .sub { margin: 20px 0 0; max-width: 62ch; font-size: var(--fs-w-18); line-height: 1.5; color: var(--muted); }
  .cuerpo { display: flex; flex-direction: column; gap: clamp(48px, 6vw, 88px); padding-block: clamp(48px, 6vw, 88px) var(--web-sec-y); }
  .fase { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px clamp(32px, 4.4vw, 64px); align-items: start; padding-top: 32px; border-top: 1px solid var(--line); }
  /* Cada momento fija su reparto (3 · 2 · 2×2 · 1 en dos): sin celdas huecas. */
  .tarjetas { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 20px; }
  .tarjeta { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius-tile-sm); background: var(--surface); overflow: hidden; color: inherit; text-decoration: none; transition: border-color .15s; }
  .tarjeta:hover { border-color: var(--link); }
  .tarjeta:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  .mini { aspect-ratio: 16 / 10; background: var(--surface-3); border-bottom: 1px solid var(--line); overflow: hidden; }
  .mini img { width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .texto { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px 22px; flex: 1; }
  .texto b { font-size: var(--fs-w-18); font-weight: 800; }
  .texto > span { font-size: var(--fs-w-15); line-height: 1.45; color: var(--muted); }
  .texto i { margin-top: auto; padding-top: 10px; font-style: normal; font-size: var(--fs-w-14); font-weight: 700; color: var(--link); }
  @media (max-width: 1199.98px) {
    .fase { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 759.98px) {
    .tarjetas { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  /* PUENTE DE ANCLAJES VIEJOS (31-ago-2026, hallazgo M7).
     /funcionalidades/#competencia y sus hermanos están publicados en correos,
     menús de la app y enlaces externos. NO se pueden redirigir en el servidor:
     el navegador nunca manda el fragmento, así que Cloudflare no lo ve. El
     único sitio donde se puede leer es el cliente.
     `replace` y no `assign`: quien llega por un enlace viejo no debería
     encontrarse esta página en su historial de «atrás». */
  const DESTINOS: Record<string, string> = {
    "#inteligencia": "/producto/estadistica-de-la-licitacion/",
    "#competencia": "/producto/analisis-de-competencia/",
    "#contratantes": "/producto/analisis-de-competencia/#contratantes",
    "#busquedas": "/producto/busquedas/",
    "#score": "/producto/busquedas/#score",
    "#sondeos": "/producto/busquedas/#sondeos",
    "#paa": "/producto/busquedas/#paa",
    "#gestion": "/producto/mis-licitaciones/",
    "#licitaciones": "/producto/mis-licitaciones/",
    "#seguimiento": "/producto/mis-licitaciones/",
    "#contratos": "/producto/mis-contratos/",
    "#ejecucion": "/producto/mis-contratos/",
    "#capacidad": "/producto/mis-contratos/#capacidad",
  };
  const puente = () => {
    const destino = DESTINOS[window.location.hash];
    if (destino) window.location.replace(destino);
  };
  puente();
  window.addEventListener("hashchange", puente);
</script>
