---
// /funcionalidades — donde aterriza el mega menú Producto. Cada módulo tiene
// su ancla (#busquedas, #sondeos, #paa, #competencia, #licitaciones,
// #contratos — mismos slugs que enlaza Nav.astro) y su explicación a fondo.
// La única banda oscura es CompetenciaShowcase.
//
// ORDEN (jul-2026): el mismo del menú de la app — primero lo que hay ahí fuera
// (los tres buscadores y Competencia), después lo mío (licitaciones y
// contratos). Los slugs viejos (#contratantes, #seguimiento, #ejecucion) se
// conservan como anclas puente: hay correos, menús y enlaces externos
// apuntando ahí, y un ancla rota manda al visitante al principio de la página
// sin decirle nada.
import { CalendarRange, Megaphone, Search, Sigma, Swords, SquareKanban, FileCheck } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import ExpedienteSection from "../components/ExpedienteSection.astro";
import BusquedaInteligente from "../components/BusquedaInteligente.astro";
import BusquedasComoFunciona from "../components/BusquedasComoFunciona.astro";
import ScoreSection from "../components/ScoreSection.astro";
import EntidadesEstado from "../components/EntidadesEstado.astro";
import CompetenciaShowcase from "../components/CompetenciaShowcase.astro";
import CapacidadResidualSection from "../components/CapacidadResidualSection.astro";
import PAASection from "../components/PAASection.astro";
import SondeosSection from "../components/SondeosSection.astro";
import CRMShowcase from "../components/CRMShowcase.astro";
import EjecucionSection from "../components/EjecucionSection.astro";
import NotificacionesSection from "../components/NotificacionesSection.astro";
import AyudaSection from "../components/AyudaSection.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";

// ÍNDICE — rehecho el 30-ago-2026. Antes era una rejilla de tres columnas con
// los siete módulos numerados 01–07: siete no es múltiplo de tres, así que la
// última fila dejaba DOS celdas grises vacías, y la numeración no codificaba
// nada (ni el orden del menú de la app ni el de la propia página, que empieza
// por Estadística). Un número que no significa nada es decoración.
//
// Ahora el índice cuenta lo único que de verdad los ordena: CUÁNDO entra cada
// módulo en la vida de una licitación. Dos antes de que exista el pliego, tres
// cuando el proceso sale, dos cuando el contrato ya es tuyo. Los huecos
// desaparecen por estructura —cada momento fija su propio reparto— y no por
// rellenar celdas.
const arco = [
  {
    momento: "Antes del pliego",
    cuando: "Meses antes de que el proceso exista",
    modulos: [
      { icon: CalendarRange, href: "/producto/busquedas/#paa", t: "Plan anual (PAA)", d: "Lo que el Estado planea comprar, meses antes de publicarlo" },
      { icon: Megaphone, href: "/producto/busquedas/#sondeos", t: "Sondeos (RFI)", d: "Cuando la entidad sale a preguntarle al mercado" },
    ],
  },
  {
    momento: "Cuando sale",
    cuando: "El proceso se publica y hay que decidir",
    modulos: [
      { icon: Search, href: "/producto/busquedas/", t: "Búsquedas automáticas", d: "SECOP I y II cada día, con puntaje 0–100" },
      { icon: Sigma, href: "/producto/estadistica-de-la-licitacion/", t: "Estadística de la licitación", d: "Precio, pagos, rivales y adiciones de esa entidad" },
      { icon: Swords, href: "/producto/analisis-de-competencia/", t: "Análisis de competencia", d: "Empresas, contratantes y tu mercado" },
    ],
  },
  {
    momento: "Cuando ya es tuyo",
    cuando: "De la propuesta a la liquidación",
    modulos: [
      { icon: SquareKanban, href: "/producto/mis-licitaciones/", t: "Mis licitaciones", d: "Tu equipo coordinado hasta la adjudicación" },
      { icon: FileCheck, href: "/producto/mis-contratos/", t: "Mis contratos", d: "Del acta de inicio a la liquidación" },
    ],
  },
];
---

<Base
  title="Funcionalidades — ContRadar"
  description="Búsquedas automáticas con puntaje, sondeos de mercado (RFI), Plan Anual de Adquisiciones, análisis de competencia y contratantes, gestión de tus licitaciones y de tus contratos. Todo lo que necesitas para ganar más contratos públicos en Colombia."
>
  <Nav />
  <main>

    <!-- Page intro — claro -->
    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-5 pb-4 pt-14 text-center sm:px-8 lg:pt-20">
        <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
          Producto
        </p>
        <h1 class="mx-auto max-w-[18ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:max-w-none sm:text-4xl lg:text-5xl">
          Del plan anual del Estado
          <span class="block text-azul-600">a la liquidación de tu contrato</span>
        </h1>
        <p class="mx-auto mt-5 max-w-[54ch] text-lg leading-relaxed text-grafito-500">
          Siete módulos sobre los mismos datos: el histórico completo de SECOP&#160;I y
          SECOP&#160;II.
          El primero se enciende meses antes de que exista el pliego; el último, cuando el
          contrato ya es tuyo.
        </p>
      </div>
    </section>

    <!-- Índice: el arco por momentos. Cada franja es un momento de la vida de
         una licitación y fija su propio reparto (2 · 3 · 2), así que no hay
         celdas vacías que rellenar. `flex-1 min-w-[15rem]` reparte a partes
         iguales dentro de cada franja y baja solo en móvil. -->
    <section class="bg-papel-50">
      <div class="mx-auto max-w-contenido px-5 pb-14 pt-12 sm:px-8">
        <div class="space-y-8">
          {arco.map((fase, i) => (
            <div class:list={["grid gap-5 lg:grid-cols-[13rem_1fr] lg:gap-8", i > 0 && "border-t border-papel-200 pt-8"]}>
              <div>
                <p class="dato flex items-center gap-3 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-azul-500">
                  <span class="h-px w-6 shrink-0 bg-azul-500" aria-hidden="true"></span>
                  {fase.momento}
                </p>
                <p class="mt-2 text-sm leading-snug text-grafito-400">{fase.cuando}</p>
              </div>
              <div class="flex flex-wrap gap-3">
                {fase.modulos.map((m) => (
                  <a
                    href={m.href}
                    class="group flex min-w-full flex-1 items-start gap-3.5 rounded-xl border border-papel-200 bg-white p-4 transition hover:border-azul-300 sm:min-w-[15rem]"
                  >
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-papel-100 text-grafito-500 transition group-hover:bg-azul-50 group-hover:text-azul-600">
                      <m.icon size={20} stroke-width={1.7} aria-hidden="true" />
                    </span>
                    <span class="min-w-0">
                      <b class="block font-extrabold tracking-tight text-grafito-900">{m.t}</b>
                      <span class="mt-0.5 block text-sm leading-snug text-grafito-500">{m.d}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Los módulos ya NO se desarrollan aquí: cada uno tiene su página bajo
        /producto/ (hallazgo M7). Esta página se queda como índice del arco y
        como PUENTE de los anclajes viejos — ver el script del final. Dejar el
        contenido también aquí duplicaría cada módulo en dos URLs. */}

    <!-- Transversales: no son módulos del arco, atraviesan todas las pantallas. -->
    <NotificacionesSection />
    <AyudaSection />

    <AccessForm />

  </main>
  <Footer />
</Base>

<script>
  /* PUENTE DE ANCLAJES VIEJOS (31-ago-2026, hallazgo M7).
     /funcionalidades/#competencia y sus hermanos están publicados en correos,
     menús de la app y enlaces externos. NO se pueden redirigir en el servidor:
     el navegador nunca manda el fragmento, así que Cloudflare no lo ve. El
     único sitio donde se puede leer es el cliente.
     `replace` y no `assign`: quien llega por un enlace viejo no debería
     encontrarse esta página en su historial de «atrás». */
  const DESTINOS: Record<string, string> = {
    "#inteligencia": "/producto/estadistica-de-la-licitacion/",
    "#competencia": "/producto/analisis-de-competencia/",
    "#contratantes": "/producto/analisis-de-competencia/#contratantes",
    "#busquedas": "/producto/busquedas/",
    "#score": "/producto/busquedas/#score",
    "#sondeos": "/producto/busquedas/#sondeos",
    "#paa": "/producto/busquedas/#paa",
    "#gestion": "/producto/mis-licitaciones/",
    "#licitaciones": "/producto/mis-licitaciones/",
    "#seguimiento": "/producto/mis-licitaciones/",
    "#contratos": "/producto/mis-contratos/",
    "#ejecucion": "/producto/mis-contratos/",
    "#capacidad": "/producto/mis-contratos/#capacidad",
  };
  const puente = () => {
    const destino = DESTINOS[window.location.hash];
    if (destino) window.location.replace(destino);
  };
  puente();
  window.addEventListener("hashchange", puente);
</script>
