---
// /funcionalidades — donde aterriza el mega menú Producto. Cada módulo tiene
// su ancla (#busquedas, #sondeos, #paa, #competencia, #licitaciones,
// #contratos — mismos slugs que enlaza Nav.astro) y su explicación a fondo.
// La única banda oscura es CompetenciaShowcase.
//
// ORDEN (jul-2026): el mismo del menú de la app — primero lo que hay ahí fuera
// (los tres buscadores y Competencia), después lo mío (licitaciones y
// contratos). Los slugs viejos (#contratantes, #seguimiento, #ejecucion) se
// conservan como anclas puente: hay correos, menús y enlaces externos
// apuntando ahí, y un ancla rota manda al visitante al principio de la página
// sin decirle nada.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import BusquedaInteligente from "../components/BusquedaInteligente.astro";
import ScoreSection from "../components/ScoreSection.astro";
import EntidadesEstado from "../components/EntidadesEstado.astro";
import CompetenciaShowcase from "../components/CompetenciaShowcase.astro";
import CapacidadResidualSection from "../components/CapacidadResidualSection.astro";
import PAASection from "../components/PAASection.astro";
import SondeosSection from "../components/SondeosSection.astro";
import CRMShowcase from "../components/CRMShowcase.astro";
import EjecucionSection from "../components/EjecucionSection.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";

// Índice navegable: los módulos con el nombre que tienen dentro de la app.
const indice = [
  { n: "01", href: "#busquedas", t: "Búsquedas automáticas", d: "SECOP I y II cada día, con puntaje 0–100" },
  { n: "02", href: "#sondeos", t: "Sondeos (RFI)", d: "Cuando la entidad pregunta, antes del pliego" },
  { n: "03", href: "#paa", t: "Plan anual (PAA)", d: "Lo que el Estado planea, meses antes" },
  { n: "04", href: "#competencia", t: "Competencia", d: "Empresas, contratantes y tu mercado" },
  { n: "05", href: "#licitaciones", t: "Mis licitaciones", d: "Tu equipo coordinado hasta la adjudicación" },
  { n: "06", href: "#contratos", t: "Mis contratos", d: "Del acta de inicio a la liquidación" },
];
---

<Base
  title="Funcionalidades — ContRadar"
  description="Búsquedas automáticas con puntaje, sondeos de mercado (RFI), Plan Anual de Adquisiciones, análisis de competencia y contratantes, gestión de tus licitaciones y de tus contratos. Todo lo que necesitas para ganar más contratos públicos en Colombia."
>
  <Nav />
  <main>

    <!-- Page intro — claro -->
    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-5 pb-4 pt-14 text-center sm:px-8 lg:pt-20">
        <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
          Producto
        </p>
        <h1 class="text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl lg:text-5xl">
          Una plataforma completa.
          <span class="text-azul-600">No solo alertas.</span>
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-lg text-grafito-500">
          Desde configurar tus búsquedas hasta cerrar el contrato, todo pasa en ContRadar.
          Sin correos perdidos. Sin hojas de Excel.
        </p>
      </div>
    </section>

    <!-- Índice: el arco de la home, navegable -->
    <section class="bg-white">
      <div class="mx-auto max-w-contenido px-5 pb-14 pt-8 sm:px-8">
        <div class="grid gap-px overflow-hidden rounded-2xl border border-papel-200 bg-papel-200 sm:grid-cols-2 lg:grid-cols-3">
          {indice.map((m) => (
            <a href={m.href} class="group flex items-start gap-4 bg-white p-5 transition hover:bg-papel-50">
              <span class="dato grid h-[34px] w-[34px] shrink-0 place-items-center rounded-full border border-papel-200 text-xs font-semibold text-grafito-400 transition group-hover:border-azul-300 group-hover:text-azul-600">
                {m.n}
              </span>
              <span>
                <b class="block font-extrabold tracking-tight text-grafito-900">{m.t}</b>
                <span class="block text-sm text-grafito-500">{m.d}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 01 · Búsquedas automáticas -->
    <div id="busquedas" class="scroll-mt-16">
      <BusquedaInteligente />
      <ScoreSection />
    </div>

    <!-- 02 · Sondeos (RFI) -->
    <div id="sondeos" class="scroll-mt-16">
      <SondeosSection />
    </div>

    {/* 03 · Plan anual (PAA) — PAASection ya trae su propio id="paa"; envolverlo
        en un div con el mismo id duplicaba el ancla (HTML inválido y el salto
        queda a merced del navegador). Igual con CompetenciaShowcase. */}
    <PAASection />

    <!-- 04 · Competencia — sus tres pestañas, en el orden de la app:
         Empresas (CompetenciaShowcase, que trae el id), Contratantes
         (EntidadesEstado) y Mercado, que se cuenta dentro del showcase. -->
    <CompetenciaShowcase />
    <span id="contratantes" class="block scroll-mt-16" aria-hidden="true"></span>
    <EntidadesEstado />

    <!-- 05 · Mis licitaciones -->
    <div id="licitaciones" class="scroll-mt-16">
      <span id="seguimiento" class="block scroll-mt-16" aria-hidden="true"></span>
      <CRMShowcase />
    </div>

    <!-- 06 · Mis contratos — con la Capacidad Residual, que sale justamente de
         lo que tienes en ejecución. -->
    <div id="contratos" class="scroll-mt-16">
      <span id="ejecucion" class="block scroll-mt-16" aria-hidden="true"></span>
      <EjecucionSection />
      <CapacidadResidualSection />
    </div>

    <AccessForm />

  </main>
  <Footer />
</Base>
