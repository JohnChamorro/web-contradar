---
// /funcionalidades — donde aterriza el mega menú Producto. Cada módulo tiene
// su ancla (#busquedas, #sondeos, #paa, #competencia, #licitaciones,
// #contratos — mismos slugs que enlaza Nav.astro) y su explicación a fondo.
// La única banda oscura es CompetenciaShowcase.
//
// ORDEN (jul-2026): el mismo del menú de la app — primero lo que hay ahí fuera
// (los tres buscadores y Competencia), después lo mío (licitaciones y
// contratos). Los slugs viejos (#contratantes, #seguimiento, #ejecucion) se
// conservan como anclas puente: hay correos, menús y enlaces externos
// apuntando ahí, y un ancla rota manda al visitante al principio de la página
// sin decirle nada.
import { CalendarRange, Megaphone, Search, Sigma, Swords, SquareKanban, FileCheck } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import ExpedienteSection from "../components/ExpedienteSection.astro";
import BusquedaInteligente from "../components/BusquedaInteligente.astro";
import BusquedasComoFunciona from "../components/BusquedasComoFunciona.astro";
import ScoreSection from "../components/ScoreSection.astro";
import EntidadesEstado from "../components/EntidadesEstado.astro";
import CompetenciaShowcase from "../components/CompetenciaShowcase.astro";
import CapacidadResidualSection from "../components/CapacidadResidualSection.astro";
import PAASection from "../components/PAASection.astro";
import SondeosSection from "../components/SondeosSection.astro";
import CRMShowcase from "../components/CRMShowcase.astro";
import EjecucionSection from "../components/EjecucionSection.astro";
import AyudaSection from "../components/AyudaSection.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";

// ÍNDICE — rehecho el 30-ago-2026. Antes era una rejilla de tres columnas con
// los siete módulos numerados 01–07: siete no es múltiplo de tres, así que la
// última fila dejaba DOS celdas grises vacías, y la numeración no codificaba
// nada (ni el orden del menú de la app ni el de la propia página, que empieza
// por Estadística). Un número que no significa nada es decoración.
//
// Ahora el índice cuenta lo único que de verdad los ordena: CUÁNDO entra cada
// módulo en la vida de una licitación. Dos antes de que exista el pliego, tres
// cuando el proceso sale, dos cuando el contrato ya es tuyo. Los huecos
// desaparecen por estructura —cada momento fija su propio reparto— y no por
// rellenar celdas.
const arco = [
  {
    momento: "Antes del pliego",
    cuando: "Meses antes de que el proceso exista",
    modulos: [
      { icon: CalendarRange, href: "#paa", t: "Plan anual (PAA)", d: "Lo que el Estado planea comprar, meses antes de publicarlo" },
      { icon: Megaphone, href: "#sondeos", t: "Sondeos (RFI)", d: "Cuando la entidad sale a preguntarle al mercado" },
    ],
  },
  {
    momento: "Cuando sale",
    cuando: "El proceso se publica y hay que decidir",
    modulos: [
      { icon: Search, href: "#busquedas", t: "Búsquedas automáticas", d: "SECOP I y II cada día, con puntaje 0–100" },
      { icon: Sigma, href: "#inteligencia", t: "Estadística de la licitación", d: "Precio, pagos, rivales y adiciones de esa entidad" },
      { icon: Swords, href: "#competencia", t: "Análisis de competencia", d: "Empresas, contratantes y tu mercado" },
    ],
  },
  {
    momento: "Cuando ya es tuyo",
    cuando: "De la propuesta a la liquidación",
    modulos: [
      { icon: SquareKanban, href: "#licitaciones", t: "Mis licitaciones", d: "Tu equipo coordinado hasta la adjudicación" },
      { icon: FileCheck, href: "#contratos", t: "Mis contratos", d: "Del acta de inicio a la liquidación" },
    ],
  },
];
---

<Base
  title="Funcionalidades — ContRadar"
  description="Búsquedas automáticas con puntaje, sondeos de mercado (RFI), Plan Anual de Adquisiciones, análisis de competencia y contratantes, gestión de tus licitaciones y de tus contratos. Todo lo que necesitas para ganar más contratos públicos en Colombia."
>
  <Nav />
  <main>

    <!-- Page intro — claro -->
    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-5 pb-4 pt-14 text-center sm:px-8 lg:pt-20">
        <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
          Producto
        </p>
        <h1 class="mx-auto max-w-[18ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:max-w-none sm:text-4xl lg:text-5xl">
          Del plan anual del Estado
          <span class="block text-azul-600">a la liquidación de tu contrato</span>
        </h1>
        <p class="mx-auto mt-5 max-w-[54ch] text-lg leading-relaxed text-grafito-500">
          Siete módulos sobre los mismos datos: <span class="dato">658</span> millones de
          registros de SECOP&#160;I y SECOP&#160;II, desde <span class="dato">2012</span>.
          El primero se enciende meses antes de que exista el pliego; el último, cuando el
          contrato ya es tuyo.
        </p>
      </div>
    </section>

    <!-- Índice: el arco por momentos. Cada franja es un momento de la vida de
         una licitación y fija su propio reparto (2 · 3 · 2), así que no hay
         celdas vacías que rellenar. `flex-1 min-w-[15rem]` reparte a partes
         iguales dentro de cada franja y baja solo en móvil. -->
    <section class="bg-papel-50">
      <div class="mx-auto max-w-contenido px-5 pb-14 pt-12 sm:px-8">
        <div class="space-y-8">
          {arco.map((fase, i) => (
            <div class:list={["grid gap-5 lg:grid-cols-[13rem_1fr] lg:gap-8", i > 0 && "border-t border-papel-200 pt-8"]}>
              <div>
                <p class="dato flex items-center gap-3 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-azul-500">
                  <span class="h-px w-6 shrink-0 bg-azul-500" aria-hidden="true"></span>
                  {fase.momento}
                </p>
                <p class="mt-2 text-sm leading-snug text-grafito-400">{fase.cuando}</p>
              </div>
              <div class="flex flex-wrap gap-3">
                {fase.modulos.map((m) => (
                  <a
                    href={m.href}
                    class="group flex min-w-full flex-1 items-start gap-3.5 rounded-xl border border-papel-200 bg-white p-4 transition hover:border-azul-300 sm:min-w-[15rem]"
                  >
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-papel-100 text-grafito-500 transition group-hover:bg-azul-50 group-hover:text-azul-600">
                      <m.icon size={20} stroke-width={1.7} aria-hidden="true" />
                    </span>
                    <span class="min-w-0">
                      <b class="block font-extrabold tracking-tight text-grafito-900">{m.t}</b>
                      <span class="mt-0.5 block text-sm leading-snug text-grafito-500">{m.d}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 01 · Estadística de la licitación — el foso, primero -->
    <ExpedienteSection fondo="white" />

    <!-- 03 · Búsquedas automáticas -->
    <div id="busquedas" class="scroll-mt-16">
      <BusquedaInteligente />
      <BusquedasComoFunciona />
      <ScoreSection />
    </div>

    <!-- 02 · Sondeos (RFI) -->
    <div id="sondeos" class="scroll-mt-16">
      <SondeosSection />
    </div>

    {/* 03 · Plan anual (PAA) — PAASection ya trae su propio id="paa"; envolverlo
        en un div con el mismo id duplicaba el ancla (HTML inválido y el salto
        queda a merced del navegador). Igual con CompetenciaShowcase. */}
    <PAASection />

    <!-- 04 · Competencia — sus tres pestañas, en el orden de la app:
         Empresas (CompetenciaShowcase, que trae el id), Contratantes
         (EntidadesEstado) y Mercado, que se cuenta dentro del showcase. -->
    <CompetenciaShowcase />
    <span id="contratantes" class="block scroll-mt-16" aria-hidden="true"></span>
    <EntidadesEstado />

    <!-- 05 · Mis licitaciones -->
    <!-- Gestión de equipo: el paraguas. Ningún competidor del país coordina al
         equipo dentro de la plataforma ni administra el contrato ganado, así
         que la sección lo dice con esa palabra y lo explica a fondo. -->
    <section id="gestion" class="scroll-mt-16 bg-white">
      <div class="mx-auto max-w-contenido px-5 py-14 sm:px-8 lg:py-20">
        <div class="max-w-[62ch]">
          <p class="dato mb-3.5 flex items-center gap-3 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-azul-500">
            <span class="h-px w-8 bg-azul-500" aria-hidden="true"></span>
            Gestión de equipo
          </p>
          <h2 class="text-3xl font-extrabold leading-tight tracking-tight text-grafito-900 sm:text-4xl">
            Licitar no lo hace una persona.
            <span class="text-azul-600">Aquí trabaja tu equipo.</span>
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-grafito-500">
            Las plataformas de licitaciones terminan donde empieza el trabajo real: decidir a
            cuáles presentarse, repartir quién hace qué y no perderle el rastro a nada. Eso
            pasa dentro de ContRadar, no en WhatsApp y hojas de cálculo paralelas.
          </p>
        </div>

        <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-papel-200 bg-papel-200 sm:grid-cols-2 lg:grid-cols-4">
          {[
            ["Un responsable por proceso", "Cada licitación tiene nombre y apellido. Se asigna, se reasigna y queda registrado quién respondía por ella."],
            ["Comentarios con menciones", "La conversación vive junto al proceso, no en un chat aparte. Mencionas a alguien y le llega."],
            ["Documentos en vivo", "Los pliegos y tus documentos propios, organizados por proceso y abiertos en el visor sin descargar nada."],
            ["Bitácora y checklist", "Qué se hizo, cuándo y quién. Y qué falta para que la propuesta quede lista."],
          ].map(([t, d]) => (
            <div class="bg-white p-5 lg:p-6">
              <h3 class="text-[0.9375rem] font-bold text-grafito-900">{t}</h3>
              <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-grafito-500">{d}</p>
            </div>
          ))}
        </div>

        <p class="mt-6 max-w-[62ch] text-[0.9375rem] leading-relaxed text-grafito-500">
          La gestión tiene <strong class="text-grafito-900">dos mitades</strong>: las
          licitaciones que estás persiguiendo y los contratos que ya ganaste. Las dos con el
          mismo equipo dentro.
        </p>
      </div>
    </section>

    <div id="licitaciones" class="scroll-mt-16">
      <span id="seguimiento" class="block scroll-mt-16" aria-hidden="true"></span>
      <CRMShowcase />
    </div>

    <!-- 06 · Mis contratos — con la Capacidad Residual, que sale justamente de
         lo que tienes en ejecución. -->
    <div id="contratos" class="scroll-mt-16">
      <span id="ejecucion" class="block scroll-mt-16" aria-hidden="true"></span>
      <EjecucionSection />
      <CapacidadResidualSection />
    </div>

    <!-- Transversal: no es un módulo del arco, está en todas las pantallas. -->
    <AyudaSection />

    <AccessForm />

  </main>
  <Footer />
</Base>
