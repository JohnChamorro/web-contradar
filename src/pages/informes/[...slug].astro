---
/* /informes/ (hub) y /informes/<slug>/. Solo existen si hay al menos un
   informe con datos reales en src/data/informes/. */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import AccessForm from "../../components/AccessForm.astro";
import Migas from "../../components/guias/Migas.astro";
import CtaDiagnostico from "../../components/guias/CtaDiagnostico.astro";
import CajaAutor from "../../components/guias/CajaAutor.astro";
import { absoluta, fundador, ID } from "../../lib/esquemas";
import { INFORMES, type Informe } from "../../lib/informes";

export function getStaticPaths() {
  if (!INFORMES.length) return [];
  return [
    { params: { slug: undefined }, props: { informe: null } },
    ...INFORMES.map((i) => ({ params: { slug: i.slug }, props: { informe: i } })),
  ];
}
const { informe } = Astro.props as { informe: Informe | null };
const migas = informe
  ? [{ nombre: "Informes", url: "/informes/" }, { nombre: informe.titulo, url: `/informes/${informe.slug}/` }]
  : [{ nombre: "Informes", url: "/informes/" }];
const esquemas = informe
  ? [{
      "@context": "https://schema.org", "@type": "Report", headline: informe.titulo, description: informe.hallazgo,
      datePublished: informe.publicado, dateModified: informe.corte, inLanguage: "es-CO",
      mainEntityOfPage: absoluta(`/informes/${informe.slug}/`), author: fundador, publisher: { "@id": ID.organizacion },
    }]
  : [];
---

<Base
  title={informe ? `${informe.titulo} · ContRadar`.slice(0, 70) : "Informes de contratación pública en Colombia · ContRadar"}
  description={informe ? informe.hallazgo.slice(0, 160) : "Informes con datos del SECOP sobre cómo compra el Estado colombiano: precios de adjudicación, competencia y plazos. Metodología y muestra en cada cifra."}
  migas={migas}
  esquemas={esquemas}
>
  <Nav />
  <main>
    <section class="bg-white">
      <div class="mx-auto max-w-3xl px-5 pb-10 pt-10 sm:px-8 lg:pt-14">
        <Migas migas={migas} />
        {informe ? (
          <>
            <h1 class="mt-5 text-3xl font-extrabold leading-[1.08] tracking-tight text-grafito-900 sm:text-4xl text-wrap-balance">{informe.titulo}</h1>
            <p class="mt-4 text-lg leading-relaxed text-grafito-700">{informe.hallazgo}</p>
            {informe.secciones.map((s) => (
              <section class="mt-10">
                <h2 class="text-xl font-extrabold tracking-tight text-grafito-900">{s.titulo}</h2>
                <p class="mt-3 text-[0.9375rem] leading-relaxed text-grafito-500">{s.texto}</p>
                {s.tabla && (
                  <div class="mt-4 overflow-x-auto rounded-xl border border-papel-200">
                    <table class="w-full min-w-[420px] border-collapse text-sm">
                      <thead><tr>{s.tabla.columnas.map((c, i) => <th class={`px-4 py-3 text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-grafito-500 ${i ? "text-right" : "text-left"}`}>{c}</th>)}</tr></thead>
                      <tbody>{s.tabla.filas.map((f) => <tr class="border-t border-papel-150">{f.map((v, i) => <td class={`px-4 py-2.5 ${i ? "dato text-right" : ""} text-grafito-700`}>{typeof v === "number" ? v.toLocaleString("es-CO") : v}</td>)}</tr>)}</tbody>
                    </table>
                  </div>
                )}
              </section>
            ))}
            <section class="mt-12 rounded-xl border border-papel-200 bg-papel-50 p-5 text-[0.875rem] leading-relaxed text-grafito-500">
              <h2 class="text-base font-bold text-grafito-900">Metodología</h2>
              <p class="mt-2"><strong class="text-grafito-900">Fuente:</strong> {informe.metodologia.fuente}</p>
              <p><strong class="text-grafito-900">Ventana:</strong> {informe.metodologia.ventana}</p>
              <p><strong class="text-grafito-900">Muestra:</strong> {informe.metodologia.muestra}</p>
              <p><strong class="text-grafito-900">Limpieza:</strong> {informe.metodologia.limpieza}</p>
              <p class="mt-2">Corte de datos: <span class="dato">{informe.corte}</span>. Para prensa: soporte@contradar.com.co.</p>
            </section>
            <CtaDiagnostico medio="informe" campana={informe.slug} />
            <CajaAutor publicada={informe.publicado} revisada={informe.corte} />
          </>
        ) : (
          <>
            <h1 class="mt-5 text-3xl font-extrabold leading-[1.08] tracking-tight text-grafito-900 sm:text-4xl">Informes</h1>
            <ul class="mt-8 space-y-4">
              {INFORMES.map((i) => (
                <li><a href={`/informes/${i.slug}/`} class="block rounded-xl border border-papel-200 p-5 transition hover:border-azul-300"><span class="block text-lg font-bold text-grafito-900">{i.titulo}</span><span class="mt-1 block text-sm text-grafito-500">{i.hallazgo}</span></a></li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
    <AccessForm />
  </main>
  <Footer />
</Base>
