---
// Servicios a medida (fase 4): sale de la home y vive en su propia página,
// enlazada desde el pie.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import CustomDevCTA from "../components/CustomDevCTA.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Servicios a medida — ContRadar"
  description="Integraciones con tu ERP, módulos de análisis personalizados y automatizaciones para tu sector, construidas sobre ContRadar."
>
  <Nav />
  <main>
    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-5 pb-4 pt-14 sm:px-8">
        <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">
          Servicios a medida
        </p>
        <h1 class="max-w-[20ch] text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl">
          Herramientas hechas para tu forma de licitar
        </h1>
      </div>
    </section>
    <CustomDevCTA />
    <AccessForm />
  </main>
  <Footer />
</Base>
