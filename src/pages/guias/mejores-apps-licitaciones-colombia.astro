---
// Comparativa de apps de licitaciones.
//
// 21-nov-2026 (John): la página abre con un CUADRO de checks que se lee en dos
// segundos y después desglosa cada app. El orden pasa de alfabético a «cuántas
// capacidades declara cada una en su web» (src/data/comparativa.ts). Sigue sin
// haber puntaje de calidad: es un conteo de lo declarado, y la página lo dice.
// Antes (revisión post-SEO): sin ranking, orden alfabético.
//
// Ley 256 de 1996: toda afirmación sobre un competidor sale de su propia web,
// con fuente y fecha (docs/seo/mercado-competidores-2026-10.md). Los datos de
// ContRadar se importan de src/data/producto.ts.
//
// RIESGO ANOTADO (30-oct-2026): «mejores» en el <title> y el H1 es un superlativo
// en una página que no rankea. No se cambia por regla previa de John (URL, title y
// H1 fijos, docs/seo/comparativa-checklist-mensual.md); queda a su decisión.
import GuideLayout from "../../layouts/GuideLayout.astro";
import Fuentes from "../../components/guias/Fuentes.astro";
import Figura from "../../components/guias/graficos/Figura.astro";
import Cronograma from "../../components/guias/graficos/Cronograma.astro";
import Comparar from "../../components/guias/graficos/Comparar.astro";
import CuadroResumen from "../../components/comparativa/CuadroResumen.astro";
import Marca from "../../components/comparativa/Marca.astro";
import { GRUPOS, N_CRIT, MARCAS, ORDEN, CAPACIDADES, NUESTRA, valor, totales } from "../../data/comparativa";
import { moneda } from "../../lib/formato";
import { plan, precioMes, PRECIO_DESDE, PRUEBA, DESDE, DESDE_OFERTAS } from "../../data/producto";

const alerta = plan("vigia");
const dominio = plan("enterprise");
const anios = new Date("2026-10-30").getFullYear() - DESDE;
const ventaja = plan("radar");
const pliegos = `${alerta.pliegosMes}, ${ventaja.pliegosMes} o ${dominio.pliegosMes}`;
const propuestas = `${alerta.propuestasMes}, ${ventaja.propuestasMes} o ${dominio.propuestasMes}`;

/* Licitum. Precios leídos en licitum.co el 30-oct-2026. Anual = total ÷ 12. */
const LICITUM = [
  { plan: "Explorador", mes: 890_000, anual: 8_500_000 },
  { plan: "Profesional", mes: 1_890_000, anual: 17_900_000 },
  { plan: "Empresa", mes: 3_500_000, anual: 35_000_000 },
];
const empresa = LICITUM[2];
const menosMes = Math.round((1 - dominio.total.mensual / empresa.mes) * 100);
const menosAnual = Math.round((1 - precioMes(dominio, "anual") / (empresa.anual / 12)) * 100);

const FICHAS: { nombre: string; nuestra?: boolean; mejorPara: string; resumen: string; precio: string }[] = [
  {
    nombre: "ContRadar",
    nuestra: true,
    mejorPara: "Decidir dónde y a qué precio ofertar, y llevar el contrato después de ganarlo",
    resumen: `Lee el pliego con IA (${pliegos} pliegos al mes según el plan) y cruza tu RUP; llena formatos (${propuestas} propuestas al mes) y trae oferta económica con AIU y APU, desde Ventaja. Estadística de cada licitación con los datos abiertos del SECOP: a qué precio se adjudica por sector y territorio desde Ventaja y por entidad en el plan Dominio (con las ofertas desde ${DESDE_OFERTAS}), quién se presenta, en cuántos días paga la entidad y si suele ampliar el contrato. Análisis de competencia con consorcios, búsquedas con puntaje 0-100, sondeos (RFI), PAA, visor de pliegos y gestión de licitaciones y contratos en equipo, con capacidad residual (K).`,
    precio: `Desde ${moneda(PRECIO_DESDE)}/mes en plan anual (${moneda(alerta.total.mensual)} mes a mes), sin IVA adicional. Prueba de ${PRUEBA.dias} días sin tarjeta`,
  },
  {
    nombre: "Licitarus",
    mejorPara: "Equipos que leen muchos pliegos y quieren cada respuesta con su cita",
    resumen: "12 fuentes (SECOP I y II, EPM, Bolsa Mercantil, acueductos…); IA que lee el pliego citando página y norma y lo cruza con el RUP; tablero con tareas; ficha de cada empresa con consorcios y porcentaje; quién se presentó; formatos CCE; análisis de precios.",
    precio: "Encontrar $250.000/mes; Esencial $750.000/mes; Analizar $1.500.000/mes; Ganar a la medida; IVA incluido. Buscar y un primer análisis, gratis (revisado el 21-nov-2026)",
  },
  {
    nombre: "LicitIA",
    mejorPara: "Independientes y pymes con presupuesto ajustado",
    resumen: "SECOP I, II y PAA; evaluador de elegibilidad con tu RUP; generador de propuestas; simulador AIU; «curva de descuento»; kanban; bóveda documental; alertas por Telegram; API en Agencia y Corporativo.",
    precio: "$15.900 (sin IA) a $299.000/mes según plan; evaluación con IA desde $29.900; no aclara IVA",
  },
  {
    nombre: "Licitum",
    mejorPara: "Obra pública, ingeniería y consultoría que quieren anexos con la fuente de cada campo",
    resumen: "Evaluación de requisitos frente a tu empresa, incluido K-residual; análisis de pliegos con IA; anexos con la fuente de cada campo; comparación de adendas; historial de adjudicaciones; roles comercial, técnico, jurídico y aprobador; SLA en el plan Empresa.",
    precio: "Explorador $890.000, Profesional $1.890.000 y Empresa $3.500.000 al mes",
  },
  {
    nombre: "Fromus",
    mejorPara: "Propuesta automática y habilitación financiera, con un plan único",
    resumen: "Filtra procesos según tu empresa; cruza tus indicadores financieros con el pliego; requisitos con su página; análisis de competidores; propuesta automática con APU/AIU. En las páginas revisadas nombra solo SECOP II.",
    precio: "$199.000/mes + IVA, hasta 5 usuarios",
  },
  {
    nombre: "LicitaYa",
    mejorPara: "Recibir las alertas en el celular",
    resumen: "SECOP I y II y entidades descentralizadas; alertas por perfil; IA que analiza tu RUP y cada proceso; subcuentas; alertas por correo, SMS y push; app iOS y Android.",
    precio: "$49.999 a $129.999/mes; no aclara IVA",
  },
  {
    nombre: "Licitaciones.info",
    mejorPara: "Quien vende a Ecopetrol u otros compradores que no publican en el SECOP y quiere pagar por adelantado",
    resumen: "SECOP I y II y, según su web, más de 1.000 portales; perfiles ilimitados; rastreo de adendas y cambios de estado; descarga de documentos; subcuentas y notas; app móvil.",
    precio: "Por periodo: $240.000 (30 días) a $2.000.000 (28 meses); prueba de 30 días; la tarjeta no menciona el IVA",
  },
  {
    // elpaislicita.com redirige (301) a gremia.com desde octubre de 2026: mismo
    // producto con otro nombre (mismos planes y precios). Verificado el 22-oct.
    nombre: "GremIA (antes El País Licita)",
    mejorPara: "Empresas del Valle y afiliados a la Cámara de Comercio de Cali",
    resumen: "Alertas por palabra clave, entidad y UNSPSC; chat con IA sobre el pliego; histórico de más de 1,5 millones de contratos de SECOP II; dashboards de mercado; licitaciones privadas entre afiliados de la Cámara de Comercio de Cali.",
    precio: "Alertas desde $60.800/mes + IVA; Pro desde $160.000/mes + IVA (plan anual); primer mes gratis",
  },
  {
    nombre: "iaLicitaciones",
    mejorPara: "Empresas que licitan también fuera de Colombia",
    resumen: "SECOP I, II, TVEC y PAA; requisitos frente a tu RUP con K residual; formatos de la entidad; propuesta técnica a Word; kanban; competencia y CRM de entidades según plan.",
    precio: "29, 99 y 299 al mes: su tarjeta muestra euros y su FAQ dice que cobra en dólares; cuenta gratis disponible",
  },
  {
    nombre: "Colombia Licita",
    mejorPara: "Buscar por texto exacto y pagar solo los días que necesitas",
    resumen: "Buscador unificado de SECOP I y II con texto exacto y orden por cuantía; alertas por correo con licencia.",
    precio: "Licencia de $25.000 (10 días) a $720.000 (720 días); exenta de IVA",
  },
];
/* Mismo orden del cuadro: por capacidades declaradas (src/data/comparativa.ts). */
const ranking = ORDEN.map((n) => FICHAS.find((f) => f.nombre === n)!);
const soloNosotros = CAPACIDADES.filter((c) => ORDEN.every((n) => (n === NUESTRA ? valor(MARCAS[n], c.id) === 1 : valor(MARCAS[n], c.id) === 0)));
const tn = totales(NUESTRA);
const segunda = ORDEN[1];
const ts = totales(segunda);
/* Precio de entrada para el cuadro: el mismo dato de cada ficha, en corto. */
const DESDE_APP: Record<string, string> = {
  ContRadar: `Desde ${moneda(PRECIO_DESDE)}/mes`,
  Licitarus: "Desde $250.000/mes",
  LicitIA: "Desde $15.900/mes",
  Licitum: "Desde $890.000/mes",
  Fromus: "$199.000/mes + IVA",
  LicitaYa: "Desde $49.999/mes",
  "Licitaciones.info": "$240.000 por 30 días",
  "GremIA (antes El País Licita)": "Desde $60.800/mes + IVA",
  iaLicitaciones: "Desde 29 al mes (€ o USD)",
  "Colombia Licita": "$25.000 por 10 días",
};

/* Listas que salen de la matriz: si una marca cambia, el texto cambia con ella. */
const cortoApp = (n: string) => n.replace(/ \(antes .*\)$/, "");
const lista = (ns: string[]) => ns.length > 1 ? ns.slice(0, -1).join(", ") + " y " + ns[ns.length - 1] : ns[0];
const conIa = lista(ORDEN.filter((n) => valor(MARCAS[n], "ia") === 1).map(cortoApp));

const faq = [
  {
    q: "¿Cuál es la mejor app de licitaciones en Colombia?",
    a: "Depende de lo que necesites. No damos un puntaje de calidad: contamos cuántas de las " + N_CRIT + " capacidades revisadas declara cada app en su web, y ContRadar declara " + tn.si + ". La tabla dice cuáles declara cada una. Para leer pliegos con IA: " + conIa + " lo declaran. Para alertas en el celular: LicitaYa y Licitaciones.info tienen app. Para fuentes además del SECOP: Licitaciones.info y Licitarus. Para el precio de adjudicación por entidad (en el plan Dominio) y la gestión del contrato ganado: ContRadar.",
  },
  {
    q: "¿Cuál es la plataforma oficial para licitar con el Estado en Colombia?",
    a: "SECOP II, de Colombia Compra Eficiente: ahí se publican los procesos y ahí presentas la oferta. SECOP I sigue recibiendo publicaciones de muchas entidades. Ninguna app privada reemplaza esos sistemas: te ayudan a encontrar, decidir y preparar.",
  },
  {
    q: "¿Hay apps gratuitas para buscar licitaciones en Colombia?",
    a: "Sí. La vista pública de SECOP I y II se consulta sin pagar. Entre las privadas, Colombia Licita deja buscar sin licencia, iaLicitaciones tiene cuenta gratuita y Licitarus deja crear la empresa, buscar y hacer un primer análisis de prueba. La mayoría ofrece pruebas de 3 días a 1 mes; la de ContRadar es de 7 días sin tarjeta.",
  },
  {
    q: "¿Cuánto cuesta una app de licitaciones en Colombia?",
    a: "Al 30 de octubre de 2026, según la web de cada una, desde $15.900 al mes (plan Starter de LicitIA, sin IA) hasta $3.500.000 al mes (plan Empresa de Licitum). Revisa si el precio incluye IVA: unas lo suman aparte y otras no lo aclaran.",
  },
];

const fuentes = [
  { titulo: "SECOP II — Colombia Compra Eficiente", url: "https://www.colombiacompra.gov.co/secop/secop-ii" },
  { titulo: "SECOP I — Colombia Compra Eficiente", url: "https://www.colombiacompra.gov.co/secop/secop-i" },
  { titulo: "Tienda Virtual del Estado Colombiano — qué es", url: "https://www.colombiacompra.gov.co/secop/tvec/que-es-la-tienda-virtual" },
  { titulo: "GremIA (antes El País Licita) — inicio, funciones y planes", url: "https://gremia.com/" },
  { titulo: "LicitIA — inicio, funciones, planes y FAQ", url: "https://licitia.com.co/" },
  { titulo: "LicitIA — documentación de la API", url: "https://licitia.com.co/api.html" },
  { titulo: "iaLicitaciones Colombia — inicio y planes", url: "https://ialicitaciones.com/co/" },
  { titulo: "Licitarus — inicio, fuentes y precios", url: "https://www.licitarus.com/" },
  { titulo: "Licitarus — novedades del producto", url: "https://www.licitarus.com/novedades" },
  { titulo: "LicitaYa — inicio y planes", url: "https://www.licitaya.co/" },
  { titulo: "Licitaciones.info — inicio", url: "https://licitaciones.info/colombia" },
  { titulo: "Licitaciones.info — planes", url: "https://licitaciones.info/colombia/planes" },
  { titulo: "Fromus — inicio, funciones y precio", url: "https://www.fromus.tech/" },
  { titulo: "Fromus — resumen estructurado", url: "https://www.fromus.tech/para-ias" },
  { titulo: "Colombia Licita — preguntas frecuentes", url: "https://colombialicita.com/faq" },
  { titulo: "Licitum — inicio y planes", url: "https://licitum.co/" },
];
---

<GuideLayout
  title="Mejores apps de licitaciones en Colombia 2026"
  description={`Comparamos 10 apps de licitaciones en Colombia en ${N_CRIT} capacidades: qué declara cada una, cuánto cuesta y para quién es. Actualizado el 21 de noviembre de 2026.`}
  h1="Las mejores apps de licitaciones en Colombia en 2026"
  slug="mejores-apps-licitaciones-colombia"
  datePublished="2026-10-02"
  dateModified="2026-11-21"
  faq={faq}
  relacionadas={["como-ganar-una-licitacion", "como-buscar-licitaciones-en-secop", "secop-i-vs-secop-ii", "minima-cuantia"]}
  cta={{
    titulo: "Antes de elegir app, mira tu punto de partida",
    texto: "Escribe tu NIT y te mostramos qué contratos has ganado en el SECOP, con qué entidades y contra quién compites. Gratis y sin registro.",
  }}
>
  <p class="lead">
    Encontrar licitaciones ya no es el problema: el SECOP es público y casi todas las apps te avisan. Lo que cambia
    de una a otra es qué hacen después: unas <strong>leen el pliego con IA</strong>, otras te avisan en el celular y
    otras te dicen <strong>a qué precio se adjudica y contra quién compites</strong>. Comparamos 10 apps en
    {N_CRIT} capacidades, de la búsqueda en el SECOP al contrato ganado, y te decimos para quién puede servir cada una.
  </p>

  <h2 id="cuadro">Las 10 apps en un cuadro</h2>
  <p>
    <strong>ContRadar declara <span class="dato">{tn.si}</span> de las <span class="dato">{N_CRIT}</span> capacidades
    que revisamos; la que sigue, {segunda}, <span class="dato">{ts.si}</span>.</strong> El check quiere decir que la
    app lo declara en su web. Están ordenadas por cuántas declara.
  </p>
  <CuadroResumen desde={DESDE_APP} />
  <p class="revision">
    Contamos lo que cada app <strong>declara en sus páginas públicas</strong>, no su calidad: no las probamos por
    dentro, y que una no mencione algo no quiere decir que no lo tenga. La única de las ocho columnas que ContRadar no
    declara son las alertas en el celular. Las {N_CRIT} capacidades, una por una, están en
    <a href="#criterios">qué declara cada una</a>.
  </p>

  <h2 id="una-por-una">Qué hace cada una</h2>
  <ul class="fichas not-prose">
    {ranking.map((a) => (
      <li class="ficha">
        <p class="ficha__nombre">{a.nombre}{a.nuestra && <span class="ficha__nuestra">nuestra</span>}</p>
        <p class="ficha__mejor"><strong>Para quién:</strong> {a.mejorPara}.</p>
        <p class="ficha__txt">{a.resumen}</p>
        <p class="ficha__precio">{a.precio}.</p>
      </li>
    ))}
  </ul>
  <p>
    Otra más, <strong>BuscaSECOP</strong> (buscasecop.com), aparece en buscadores, pero su web no cargó el día de la
    consulta y no publicamos datos que no pudimos ver.
  </p>
  <p class="revision">
    <strong>Revisado el 30 de octubre de 2026.</strong> Verificamos en la web de cada app sus planes, precios y funciones,
    y repetimos la revisión cada mes. En esta: Licitarus nombra sus planes de pago Encontrar y Analizar; Licitaciones.info
    anuncia 30 días gratis; iaLicitaciones declara SECOP I, II y TVEC, y LicitIA ya no nombra HubSpot ni Salesforce.
    El 21 de noviembre volvimos a revisar Licitarus y Colombia Licita: Licitarus cambió sus planes (Encontrar
    $250.000, Esencial $750.000 y Analizar $1.500.000 al mes) y ya no declara alertas por WhatsApp.
  </p>

  <h2 id="criterios">Qué declara cada una</h2>
  <p>
    El check = lo declara · «En parte» = lo declara en parte · la raya = no lo menciona en las páginas revisadas. No probamos las apps por
    dentro: «no lo menciona» no quiere decir que la app no lo tenga. Las {N_CRIT} capacidades siguen el camino de una
    licitación de principio a fin, e incluyen aquellas que ContRadar no declara, como las alertas en el celular.
  </p>
  <Figura
    titulo={`Las ${N_CRIT} capacidades siguen el camino de una licitación, de la búsqueda al contrato ganado`}
    nota="Cómo están agrupados los criterios de la tabla de abajo. Cada etapa dice cuántas capacidades revisamos en ella."
  >
    <Cronograma hitos={GRUPOS.map((g) => ({
      t: g.g,
      d: `${g.c.length} capacidades, como ${/^[A-ZÁÉÍÓÚ][a-záéíóúñ]/.test(g.c[0].t) ? g.c[0].t.charAt(0).toLowerCase() + g.c[0].t.slice(1) : g.c[0].t}`,
    }))} />
  </Figura>
  <div class="tabla-scroll">
  <table class="matriz">
    <thead>
      <tr>
        <th>Criterio</th>
        {ranking.map((a) => <th>{a.nombre}{a.nuestra && <span class="matriz__nuestra"> (nuestra)</span>}</th>)}
      </tr>
    </thead>
    <tbody>
      {GRUPOS.map((g) => (
        <>
          <tr class="matriz__grupo"><td colspan={ranking.length + 1}>{g.g}</td></tr>
          {g.c.map((c) => (
            <tr>
              <td><strong>{c.t}</strong><span class="matriz__d">{c.d}</span></td>
              {ranking.map((a) => (
                <td class="matriz__v"><Marca v={valor(MARCAS[a.nombre], c.id)} quien={`${a.nombre}, ${c.t}`} /></td>
              ))}
            </tr>
          ))}
        </>
      ))}
    </tbody>
  </table>
  </div>

  <h2>Lo que declara ContRadar</h2>
  <p>
    En las páginas que revisamos el 30 de octubre de 2026, <strong>{soloNosotros.length} capacidades de
    <a href="/">ContRadar</a> no aparecen declaradas por las demás</strong>:
    {soloNosotros.map((c, i) => (<>{i > 0 && (i === soloNosotros.length - 1 ? " y " : ", ")}{c.t.charAt(0).toLowerCase() + c.t.slice(1)}</>))}.
    Eso no significa que las demás no las tengan. Lo que ContRadar declara, en la práctica:
  </p>
  <ul>
    <li>
      <strong>Declara su ventana de datos:</strong> contratos de SECOP I y II desde {DESDE}, {anios} años, y ofertas
      desde {DESDE_OFERTAS}.
    </li>
    <li>
      <strong>Lee el pliego y cruza tu RUP:</strong> {pliegos} pliegos con IA al mes según el plan, y cruce con tus
      indicadores en todos. Llena formatos ({propuestas} propuestas al mes) y trae oferta económica con AIU y APU, desde Ventaja.
    </li>
    <li>
      <strong>Muestra a qué precio se adjudica antes de ofertar:</strong> por sector y territorio desde Ventaja y por
      entidad en el plan Dominio, con quién se presenta y en cuántos días paga la entidad, y cada cifra dice sobre cuántos casos está medida.
      Así funciona la <a href="/producto/estadistica-de-la-licitacion/">estadística de la licitación</a>.
    </li>
    <li>
      <strong>Sigue después de ganar:</strong> incluye gestión del contrato ganado
      (hitos, pólizas, actas y liquidación) en <a href="/producto/mis-contratos/">Mis contratos</a> y capacidad
      residual (K) para obra pública. Prueba la
      <a href="/herramientas/calculadora-capacidad-residual/">calculadora de K</a> gratis.
    </li>
    <li>
      <strong>Conoce a la entidad antes de ofertarle:</strong> en cuántos días paga, con qué frecuencia amplía sus
      contratos, de dónde sale la plata (regalías, SGP o presupuesto propio) y en qué municipio se ejecuta de verdad.
    </li>
    <li>
      <strong>Muestra a los rivales:</strong> quién se presenta, quién gana y con quién se asocia cada empresa en
      consorcio y en qué porcentaje, aunque escriban su nombre de otra forma.
    </li>
    <li>
      <strong>Muestra procesos en borrador y, en el plan Dominio, sondeos de mercado (RFI):</strong> en estos, la entidad
      apenas está preguntando precios.
    </li>
    <li>
      <strong>Publica su precio:</strong> el plan más completo, Dominio, cuesta
      <span class="dato">{moneda(precioMes(dominio, "anual"))}</span>/mes en plan anual (comparación con Licitum, abajo).
    </li>
  </ul>
  <p>
    Lo que <strong>no</strong> hace, para que decidas con todo: no tiene app móvil (las
    alertas de búsqueda llegan en un correo diario) y solo lee SECOP I y II, no portales propios como el de Ecopetrol o los de
    algunos acueductos; además, la lectura de pliegos tiene cupo mensual. Si eso es lo que más te pesa, mira LicitaYa,
    Licitaciones.info o Licitarus.
  </p>

  <h2 id="precio-liga-alta">Precios de los planes más completos</h2>
  <p>
    Comparación en el mismo periodo de pago, con los precios públicos revisados el 30 de octubre de 2026:
  </p>
  <div class="tabla-scroll">
  <table>
    <thead><tr><th>Plan</th><th>Mes a mes</th><th>En plan anual (al mes)</th></tr></thead>
    <tbody>
      {LICITUM.map((l) => (
        <tr><td>Licitum {l.plan}</td><td><span class="dato">{moneda(l.mes)}</span></td><td><span class="dato">{moneda(Math.round(l.anual / 12))}</span></td></tr>
      ))}
      <tr><td>ContRadar Dominio</td><td><span class="dato">{moneda(dominio.total.mensual)}</span></td><td><span class="dato">{moneda(precioMes(dominio, "anual"))}</span></td></tr>
    </tbody>
  </table>
  </div>
  <p>
    En precio publicado, Dominio está {menosMes}&nbsp;% por debajo de Licitum Empresa mes a mes y {menosAnual}&nbsp;%
    en plan anual, <strong>pero no incluyen lo mismo:</strong> Licitum Empresa da usuarios ilimitados y SLA de soporte, y
    Dominio {dominio.usuarios} usuarios. Licitum declara análisis de pliegos, borradores de anexos, K-residual e historial de
    adjudicaciones. ContRadar declara precio de adjudicación por entidad en el plan Dominio y gestión del contrato, que
    Licitum no menciona en su inicio. ContRadar no suma IVA al precio publicado; Licitum no menciona el IVA en su inicio.
  </p>

  <h2>Primero, las plataformas oficiales</h2>
  <p>
    Ninguna app privada reemplaza a los sistemas de Colombia Compra Eficiente: todas leen los datos que estos
    publican, y la oferta se presenta en ellos.
  </p>
  <Figura
    titulo="El SECOP publica y recibe la oferta; una app te ayuda a encontrar, decidir y preparar"
    nota="Plataformas de Colombia Compra Eficiente frente a las apps privadas de esta comparativa. Precios publicados al 30 de octubre de 2026."
  >
    <Comparar
      columnas={["Plataformas oficiales", "Apps privadas"]}
      filas={[
        { aspecto: "Qué hacen", valores: ["Las entidades publican sus procesos y, en SECOP II, los gestionan en línea", "Leen los datos que publica el SECOP"] },
        { aspecto: "La oferta", valores: ["En SECOP II la presentas <b>ahí</b>", "No la reciben: te ayudan a <b>prepararla</b>"] },
        { aspecto: "Para qué te sirven", valores: ["Consultar los procesos y ofertar", "Encontrar, decidir y preparar"] },
        { aspecto: "Cuánto cuestan", valores: ["La vista pública de SECOP I y II se consulta <b>sin pagar</b>", "Planes de <b>$15.900</b> a <b>$3.500.000</b> al mes; algunas tienen cuenta o plan gratis"] },
      ]}
    />
  </Figura>
  <ul>
    <li><strong>SECOP II.</strong> La plataforma transaccional: las entidades gestionan ahí sus procesos y tú presentas la oferta.</li>
    <li><strong>SECOP I.</strong> La plataforma donde las entidades publican los documentos del proceso. En los datos que procesa ContRadar, muchas alcaldías y ESE siguen publicando ahí, y una búsqueda solo en SECOP II no las muestra. Lo explicamos en <a href="/guias/secop-i-vs-secop-ii/">SECOP I vs. SECOP II</a>.</li>
    <li><strong>Tienda Virtual del Estado Colombiano.</strong> Donde las entidades compran por acuerdos marco de precios. Si vendes bienes de catálogo, te interesa ser proveedor de un acuerdo marco.</li>
  </ul>

  <h2>Cuál elegir según tu caso</h2>
  <ul>
    <li><strong>Calificas, ofertas y pierdes por precio:</strong> busca una con datos de adjudicación. ContRadar los declara por sector y territorio desde Ventaja y por entidad en el plan Dominio; otras, por sector o por empresa.</li>
    <li><strong>Ya ganas y se te complican las pólizas, las actas o el K:</strong> ContRadar declara gestión del contrato.</li>
    <li><strong>Te descalifican por requisitos que no viste en el pliego:</strong> una app que lea el pliego con IA, como {conIa}.</li>
    <li><strong>Quieres las alertas en el celular:</strong> LicitaYa o Licitaciones.info, que tienen app; LicitIA por Telegram.</li>
    <li><strong>Vendes a Ecopetrol o a empresas que contratan en su propio portal:</strong> revisa Licitaciones.info, LicitaYa (nombra Ecopetrol) o Licitarus (nombra EPM y acueductos). El SENA y EPM también publican en el SECOP, así que aparecen en cualquier app que lo lea.</li>
    <li><strong>Licitas una o dos veces al año:</strong> SECOP y su vista pública te alcanzan; si quieres alertas, una licencia corta de Colombia Licita.</li>
  </ul>
  <p>
    Si quieres el panorama completo antes de elegir, empieza por <a href="/licitaciones-colombia/">licitaciones en
    Colombia</a> y la guía de <a href="/guias/como-ganar-una-licitacion/">cómo ganar una licitación</a>.
  </p>

  <div class="callout">
    <p>
      <strong>Revisado el 30 de octubre de 2026.</strong> Todo lo que decimos de cada plataforma sale de su propia
      web en esa fecha. ContRadar es nuestra; por eso publicamos los criterios y la fuente de
      cada dato. Si eres una de estas plataformas y algo está mal o cambió, escríbenos a
      <a href="mailto:soporte@contradar.com.co">soporte@contradar.com.co</a> con el enlace público donde se vea el dato
      correcto y actualizamos la comparativa.
    </p>
  </div>

