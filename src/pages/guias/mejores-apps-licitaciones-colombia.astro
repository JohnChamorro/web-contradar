---
// Comparativa de apps de licitaciones (reescrita el 2-oct-2026 a pedido de
// John: ranking con criterios públicos, enfocado en GANAR licitaciones).
//
// Ley 256 de 1996: toda afirmación sobre un competidor sale de su propia web,
// con fuente y fecha (docs/seo/mercado-competidores-2026-10.md). El puntaje
// es la suma de criterios declarados y verificables; los criterios los
// elegimos nosotros y lo decimos. La IA sobre el pliego cuenta como criterio
// y ContRadar no lo cumple: eso es lo que hace creíble el resto.
// Los datos de ContRadar se importan de src/data/producto.ts.
import GuideLayout from "../../layouts/GuideLayout.astro";
import Fuentes from "../../components/guias/Fuentes.astro";
import { moneda } from "../../lib/formato";
import { plan, precioMes, PRECIO_DESDE, PRUEBA, DESDE } from "../../data/producto";

const alerta = plan("vigia");
const dominio = plan("enterprise");
const anios = new Date("2026-10-02").getFullYear() - DESDE;

/* Licitum, la liga alta. Precios de licitum.co tal como los muestra el índice
   de búsqueda el 2-oct-2026 (su web responde 403 a consultas automáticas),
   iguales a los del estudio de mercado de agosto. Anual = total ÷ 12. */
const LICITUM = [
  { plan: "Explorador", mes: 890_000, anual: 8_500_000 },
  { plan: "Profesional", mes: 1_890_000, anual: 17_900_000 },
  { plan: "Empresa", mes: 3_500_000, anual: 35_000_000 },
];
const empresa = LICITUM[2];
const menosMes = Math.round((1 - dominio.total.mensual / empresa.mes) * 100);
const menosAnual = Math.round((1 - precioMes(dominio, "anual") / (empresa.anual / 12)) * 100);

/* Criterios. 1 = lo declara su web · ½ = lo declara en parte · 0 = no lo declara. */
const CRITERIOS = [
  { id: "secop", t: "SECOP I y II", d: "Lee las dos plataformas. Muchas alcaldías y ESE siguen publicando en SECOP I." },
  { id: "historico", t: "Histórico declarado", d: "Dice cuántos años de adjudicaciones usa para medir el mercado." },
  { id: "precio", t: "Precio de adjudicación", d: "Muestra a qué precio adjudica cada entidad frente a su presupuesto." },
  { id: "competencia", t: "Análisis de competencia", d: "Ficha de cada rival: qué ganó, con quién y por cuánto." },
  { id: "ia", t: "Lee el pliego con IA", d: "Resume requisitos o cruza el pliego con tu RUP." },
  { id: "equipo", t: "Trabajo en equipo", d: "Tablero, usuarios o roles para llevar las licitaciones entre varios." },
  { id: "contrato", t: "Gestión del contrato ganado", d: "Hitos, pólizas, actas y liquidación después de ganar." },
  { id: "k", t: "Capacidad residual (K)", d: "Calcula el K de obra pública con tus contratos en ejecución." },
] as const;
type C = (typeof CRITERIOS)[number]["id"];
type Puntos = Record<C, 0 | 0.5 | 1>;

const APPS: { nombre: string; nuestra?: boolean; p: Puntos; mejorPara: string; resumen: string; precio: string }[] = [
  {
    nombre: "ContRadar",
    nuestra: true,
    p: { secop: 1, historico: 1, precio: 1, competencia: 1, ia: 0, equipo: 1, contrato: 1, k: 1 },
    mejorPara: "Decidir dónde y a qué precio ofertar, y llevar el contrato después de ganarlo",
    resumen: `Estadística de cada licitación con el histórico del SECOP I y II desde ${DESDE}: a qué precio adjudica esa entidad, quién se le presenta y en cuántos días paga. Análisis de competencia, búsquedas con puntaje 0-100, PAA y gestión de licitaciones y contratos en equipo, con capacidad residual (K). No lee el pliego con IA.`,
    precio: `Desde ${moneda(PRECIO_DESDE)}/mes en plan anual (${moneda(alerta.total.mensual)} mes a mes), sin IVA adicional. Prueba de ${PRUEBA.dias} días sin tarjeta`,
  },
  {
    nombre: "Licitarus",
    p: { secop: 1, historico: 0, precio: 0.5, competencia: 1, ia: 1, equipo: 1, contrato: 0, k: 0 },
    mejorPara: "Equipos que leen muchos pliegos y quieren cada respuesta con su cita",
    resumen: "12 fuentes (SECOP I y II, EPM, Bolsa Mercantil, acueductos…); IA que lee el pliego citando página y norma; tablero con tareas; ficha de cada empresa; herramienta de análisis de precios.",
    precio: "Gratis con 3 análisis; Pro $690.000/mes o $5.900.000/año, IVA incluido",
  },
  {
    nombre: "LicitIA",
    p: { secop: 1, historico: 0, precio: 0.5, competencia: 0, ia: 1, equipo: 1, contrato: 0, k: 0 },
    mejorPara: "Independientes y pymes con presupuesto ajustado",
    resumen: "SECOP I, II y PAA; evaluador de elegibilidad con tu RUP; generador de propuestas; simulador AIU; «curva de descuento»; kanban; alertas por Telegram; API.",
    precio: "$15.900 a $299.000/mes según plan; no aclara IVA",
  },
  {
    nombre: "Fromus",
    p: { secop: 0, historico: 0, precio: 0, competencia: 1, ia: 1, equipo: 1, contrato: 0, k: 0 },
    mejorPara: "Armar la propuesta y verificar la habilitación con poco equipo",
    resumen: "Filtra procesos según tu empresa; cruza tus indicadores financieros con el pliego; requisitos con su página; análisis de competidores; propuesta automática con APU/AIU. Su web nombra solo SECOP II.",
    precio: "$199.000/mes + IVA, hasta 5 usuarios",
  },
  {
    nombre: "LicitaYa",
    p: { secop: 1, historico: 0, precio: 0, competencia: 0, ia: 1, equipo: 0.5, contrato: 0, k: 0 },
    mejorPara: "Recibir las alertas en el celular",
    resumen: "Alertas por perfil; IA que analiza tu RUP y cada proceso; subcuentas; alertas por correo, SMS y push; app iOS y Android.",
    precio: "$49.999 a $129.999/mes; no aclara IVA",
  },
  {
    nombre: "iaLicitaciones",
    p: { secop: 0, historico: 0, precio: 0, competencia: 0.5, ia: 1, equipo: 1, contrato: 0, k: 0 },
    mejorPara: "Empresas que licitan también en España o la Unión Europea",
    resumen: "Alertas; análisis de pliegos con OCR; memoria técnica en DOCX; kanban; inteligencia de mercado. En Colombia nombra solo SECOP II.",
    precio: "€29, €99 y €299 al mes",
  },
  {
    nombre: "Licitum",
    p: { secop: 0, historico: 0, precio: 0, competencia: 0, ia: 1, equipo: 1, contrato: 0, k: 0 },
    mejorPara: "Empresas grandes que quieren IA sobre cláusulas y anexos, con soporte dedicado",
    resumen: "Evaluación de requisitos frente a tu empresa; análisis de cláusulas con IA; borradores de anexos; consorcios; roles comercial, técnico, jurídico y aprobador; SLA en el plan Empresa.",
    precio: "Explorador $890.000, Profesional $1.890.000 y Empresa $3.500.000 al mes",
  },
  {
    nombre: "El País Licita",
    p: { secop: 0, historico: 0.5, precio: 0, competencia: 0, ia: 1, equipo: 0.5, contrato: 0, k: 0 },
    mejorPara: "Empresas del Valle y afiliados a la Cámara de Comercio de Cali",
    resumen: "Alertas por palabra clave, entidad y UNSPSC; chat con IA sobre el pliego; histórico de más de 1,5 millones de contratos de SECOP II; dashboards de mercado.",
    precio: "Alertas desde $60.800/mes + IVA; Pro desde $160.000/mes + IVA (plan anual)",
  },
  {
    nombre: "Licitaciones.info",
    p: { secop: 1, historico: 0, precio: 0, competencia: 0, ia: 0, equipo: 1, contrato: 0, k: 0 },
    mejorPara: "Quien vende a SENA, Ecopetrol, EPM o empresas de servicios públicos y quiere pagar por adelantado",
    resumen: "Muchas fuentes además de SECOP; perfiles ilimitados; rastreo de adendas; descarga de documentos; subcuentas y notas; app móvil.",
    precio: "Por periodo: $240.000 (30 días) a $2.000.000 (28 meses); no aclara IVA",
  },
  {
    nombre: "Colombia Licita",
    p: { secop: 1, historico: 0, precio: 0, competencia: 0, ia: 0, equipo: 0, contrato: 0, k: 0 },
    mejorPara: "Buscar por texto exacto y pagar solo los días que necesitas",
    resumen: "Buscador unificado de SECOP I y II con texto exacto y orden por cuantía; alertas por correo con licencia.",
    precio: "Licencia de $25.000 (10 días) a $720.000 (720 días); exenta de IVA",
  },
];
const total = (p: Puntos) => Object.values(p).reduce((s, v) => s + v, 0);
const ranking = [...APPS].sort((a, b) => total(b.p) - total(a.p) || (a.nuestra ? -1 : 0));
const fmtPts = (n: number) => n.toLocaleString("es-CO", { maximumFractionDigits: 1 });
const marca = (v: 0 | 0.5 | 1) => (v === 1 ? "✓" : v === 0.5 ? "½" : "—");
const etiqueta = (v: 0 | 0.5 | 1) => (v === 1 ? "lo declara" : v === 0.5 ? "en parte" : "no lo declara");
const segundo = ranking[1];

const faq = [
  {
    q: "¿Cuál es la mejor app de licitaciones en Colombia?",
    a: `Depende de lo que necesites. Si quieres ganar más licitaciones —saber a qué precio adjudica cada entidad, contra quién compites y llevar el contrato después—, ContRadar cumple ${fmtPts(total(APPS[0].p))} de los 8 criterios de esta comparativa, la que más. Si lo que más te cuesta es leer pliegos, Licitarus o LicitIA leen el pliego con IA; para alertas en el celular, LicitaYa.`,
  },
  {
    q: "¿Cuál es la plataforma oficial para licitar con el Estado en Colombia?",
    a: "SECOP II, de Colombia Compra Eficiente: ahí se publican los procesos y ahí presentas la oferta. SECOP I sigue recibiendo publicaciones de muchas entidades. Ninguna app privada reemplaza esos sistemas: te ayudan a encontrar, decidir y preparar.",
  },
  {
    q: "¿Hay apps gratuitas para buscar licitaciones en Colombia?",
    a: "Sí. La vista pública de SECOP I y II se consulta sin pagar. Entre las privadas, Colombia Licita deja buscar sin licencia y Licitarus tiene un plan gratis con 3 análisis por única vez. La mayoría ofrece pruebas de 3 días a 1 mes; la de ContRadar es de 7 días sin tarjeta.",
  },
  {
    q: "¿Cuánto cuesta una app de licitaciones en Colombia?",
    a: "A octubre de 2026, según la web de cada una, desde $15.900 al mes (plan Starter de LicitIA) hasta $3.500.000 al mes (plan Empresa de Licitum). Revisa si el precio incluye IVA: unas lo suman aparte y otras no lo aclaran.",
  },
];

const fuentes = [
  { titulo: "SECOP II — Colombia Compra Eficiente", url: "https://www.colombiacompra.gov.co/secop/secop-ii" },
  { titulo: "SECOP I — Colombia Compra Eficiente", url: "https://www.colombiacompra.gov.co/secop/secop-i" },
  { titulo: "Tienda Virtual del Estado Colombiano — qué es", url: "https://www.colombiacompra.gov.co/secop/tvec/que-es-la-tienda-virtual" },
  { titulo: "El País Licita — inicio, funciones y planes", url: "https://elpaislicita.com/" },
  { titulo: "LicitIA — inicio, funciones, planes y FAQ", url: "https://licitia.com.co/" },
  { titulo: "iaLicitaciones Colombia — inicio y planes", url: "https://ialicitaciones.com/co/" },
  { titulo: "Licitarus — inicio, fuentes y precios", url: "https://www.licitarus.com/" },
  { titulo: "LicitaYa — inicio y planes", url: "https://www.licitaya.co/" },
  { titulo: "Licitaciones.info — planes", url: "https://licitaciones.info/colombia/planes" },
  { titulo: "Fromus — inicio, funciones y precio", url: "https://www.fromus.tech/" },
  { titulo: "Colombia Licita — preguntas frecuentes", url: "https://colombialicita.com/faq" },
  { titulo: "Licitum — inicio y planes", url: "https://licitum.co/" },
];
---

<GuideLayout
  title="Mejores apps de licitaciones en Colombia 2026"
  description="Ranking 2026 de 10 apps de licitaciones en Colombia con 8 criterios públicos: SECOP I y II, histórico, precio de adjudicación, competencia, IA y precio."
  h1="Las mejores apps de licitaciones en Colombia en 2026"
  slug="mejores-apps-licitaciones-colombia"
  datePublished="2026-10-02"
  faq={faq}
  relacionadas={["como-ganar-una-licitacion", "como-buscar-licitaciones-en-secop", "secop-i-vs-secop-ii"]}
  cta={{
    titulo: "Antes de elegir app, mira tu punto de partida",
    texto: "Escribe tu NIT y te mostramos qué contratos has ganado en el SECOP, con qué entidades y contra quién compites. Gratis y sin registro.",
  }}
>
  <p class="lead">
    Encontrar licitaciones ya no es el problema: el SECOP es público y casi todas las apps te avisan. Lo que separa
    a quien gana de quien solo se presenta es saber, antes de ofertar, <strong>a qué precio adjudica esa entidad y
    contra quién compites</strong>. Con esa vara comparamos 10 apps con 8 criterios públicos. La que más cumple es
    <strong>ContRadar</strong> ({fmtPts(total(APPS[0].p))} de 8), seguida de <strong>{segundo.nombre}</strong>
    ({fmtPts(total(segundo.p))} de 8). Si lo que te frena es leer pliegos, la mejor elección es otra, y también te la decimos.
  </p>

  <h2>Ranking 2026</h2>
  <ol class="ranking not-prose">
    {ranking.map((a, i) => (
      <li class:list={["ranking__item", a.nuestra && "ranking__item--cr"]}>
        <div class="ranking__cab">
          <span class="ranking__pos">{i + 1}</span>
          <span class="ranking__nombre">{a.nombre}</span>
          <span class="ranking__pts"><span class="dato">{fmtPts(total(a.p))}</span> / 8</span>
        </div>
        <p class="ranking__mejor"><strong>Mejor para:</strong> {a.mejorPara}.</p>
        <p class="ranking__txt">{a.resumen}</p>
        <p class="ranking__precio">{a.precio}.</p>
        {a.nuestra && (
          <a href="#solicitar" class="ranking__cta">Probar {PRUEBA.dias} días gratis</a>
        )}
      </li>
    ))}
  </ol>
  <p>
    Otra más, <strong>BuscaSECOP</strong> (buscasecop.com), aparece en buscadores, pero su web no cargó el día de la
    consulta y no publicamos datos que no pudimos ver.
  </p>

  <h2 id="criterios">Cómo puntuamos</h2>
  <p>
    Cada criterio vale 1 punto si la web de la plataforma lo declara, ½ si lo declara en parte y 0 si no lo menciona.
    No probamos las apps por dentro: «no lo declara» quiere decir que su web no lo dice, no que la app no lo tenga.
    Los criterios los elegimos nosotros y están pensados para <strong>ganar</strong> licitaciones; por eso la lectura
    del pliego con IA es uno de los ocho, y no el más importante.
  </p>
  <div class="tabla-scroll">
  <table class="matriz">
    <thead>
      <tr>
        <th>Criterio</th>
        {ranking.map((a) => <th class:list={[a.nuestra && "col-cr"]}>{a.nombre}</th>)}
      </tr>
    </thead>
    <tbody>
      {CRITERIOS.map((c) => (
        <tr>
          <td><strong>{c.t}</strong><span class="matriz__d">{c.d}</span></td>
          {ranking.map((a) => (
            <td class:list={["matriz__v", a.nuestra && "col-cr"]} aria-label={`${a.nombre}: ${etiqueta(a.p[c.id])}`}>{marca(a.p[c.id])}</td>
          ))}
        </tr>
      ))}
      <tr class="matriz__total">
        <td><strong>Total</strong></td>
        {ranking.map((a) => <td class:list={["matriz__v", a.nuestra && "col-cr"]}><span class="dato">{fmtPts(total(a.p))}</span></td>)}
      </tr>
    </tbody>
  </table>
  </div>

  <h2>Por qué ContRadar sale primero</h2>
  <ul>
    <li>
      <strong>Es la única que declara cuántos años de histórico usa:</strong> SECOP I y II desde {DESDE}, {anios} años de
      adjudicaciones. El precio de un proceso se entiende con el de los anteriores de esa misma entidad, no con un
      promedio nacional.
    </li>
    <li>
      <strong>Te dice a qué precio se gana antes de ofertar:</strong> en cada licitación muestra a qué precio adjudica
      esa entidad, quién se le presenta y en cuántos días paga, y cada cifra dice sobre cuántos casos está medida.
      Así funciona la <a href="/producto/estadistica-de-la-licitacion/">estadística de la licitación</a>.
    </li>
    <li>
      <strong>Sigue después de ganar:</strong> es la única de la tabla que declara gestión del contrato ganado
      (hitos, pólizas, actas y liquidación) y capacidad residual (K) para obra pública. Prueba la
      <a href="/herramientas/calculadora-capacidad-residual/">calculadora de K</a> gratis.
    </li>
    <li>
      <strong>Cuesta menos que la liga empresarial:</strong> el plan más completo, Dominio, cuesta
      <span class="dato">{moneda(precioMes(dominio, "anual"))}</span>/mes en plan anual,
      {menosAnual}&nbsp;% menos que el plan Empresa de Licitum (detalle abajo).
    </li>
  </ul>
  <p>
    Lo que <strong>no</strong> hace, para que decidas con todo: no lee el pliego con IA ni arma la propuesta, no tiene
    app móvil (la alerta llega por correo una vez al día) y solo lee SECOP I y II, no portales propios como los de EPM
    o los acueductos. Si eso es lo que más te pesa, mira Licitarus, LicitIA o Licitaciones.info.
  </p>

  <h2 id="precio-liga-alta">El precio frente a la liga empresarial</h2>
  <p>
    Las plataformas que se venden a grandes empresas cobran bastante más que el resto. Esta es la comparación en el
    mismo periodo de pago, con los precios públicos a octubre de 2026:
  </p>
  <div class="tabla-scroll">
  <table>
    <thead><tr><th>Plan</th><th>Mes a mes</th><th>En plan anual (al mes)</th></tr></thead>
    <tbody>
      {LICITUM.map((l) => (
        <tr><td>Licitum {l.plan}</td><td><span class="dato">{moneda(l.mes)}</span></td><td><span class="dato">{moneda(Math.round(l.anual / 12))}</span></td></tr>
      ))}
      <tr class="fila-cr"><td><strong>ContRadar Dominio</strong></td><td><span class="dato">{moneda(dominio.total.mensual)}</span></td><td><span class="dato">{moneda(precioMes(dominio, "anual"))}</span></td></tr>
    </tbody>
  </table>
  </div>
  <p>
    <strong>Dominio cuesta {menosMes}&nbsp;% menos que Licitum Empresa mes a mes y {menosAnual}&nbsp;% menos en plan
    anual.</strong> Licitum declara análisis de cláusulas con IA, borradores de anexos y soporte con SLA, que ContRadar
    no tiene; ContRadar trae el precio de adjudicación de cada entidad, el análisis de competencia sin tope, la gestión
    del contrato y el K, que Licitum no declara. ContRadar no suma IVA al precio publicado; en Licitum no pudimos
    confirmar si lo incluye.
  </p>

  <h2>Primero, las plataformas oficiales</h2>
  <p>
    Ninguna app privada reemplaza a los sistemas de Colombia Compra Eficiente: todas leen los datos que estos
    publican, y la oferta se presenta en ellos.
  </p>
  <ul>
    <li><strong>SECOP II.</strong> La plataforma transaccional: las entidades gestionan ahí sus procesos y tú presentas la oferta.</li>
    <li><strong>SECOP I.</strong> La plataforma de publicidad. Muchas alcaldías y ESE siguen publicando ahí, así que una búsqueda solo en SECOP II se las pierde. Lo explicamos en <a href="/guias/secop-i-vs-secop-ii/">SECOP I vs. SECOP II</a>.</li>
    <li><strong>Tienda Virtual del Estado Colombiano.</strong> Donde las entidades compran por acuerdos marco de precios. Si vendes bienes de catálogo, te interesa ser proveedor de un acuerdo marco.</li>
  </ul>

  <h2>Cuál elegir según tu caso</h2>
  <ul>
    <li><strong>Calificas, ofertas y pierdes por precio:</strong> necesitas el histórico de adjudicaciones de esa entidad. ContRadar.</li>
    <li><strong>Ya ganas y se te complican las pólizas, las actas o el K:</strong> ContRadar, por la gestión del contrato.</li>
    <li><strong>Te descalifican por requisitos que no viste en el pliego:</strong> una app que lea el pliego con IA, como Licitarus o LicitIA.</li>
    <li><strong>Quieres las alertas en el celular:</strong> LicitaYa.</li>
    <li><strong>Vendes a Ecopetrol, EPM o empresas de servicios públicos:</strong> Licitaciones.info o Licitarus, que declaran esas fuentes.</li>
    <li><strong>Licitas una o dos veces al año:</strong> SECOP y su vista pública te alcanzan; si quieres alertas, una licencia corta de Colombia Licita.</li>
  </ul>
  <p>
    Si quieres el panorama completo antes de elegir, empieza por <a href="/licitaciones-colombia/">licitaciones en
    Colombia</a> y la guía de <a href="/guias/como-ganar-una-licitacion/">cómo ganar una licitación</a>.
  </p>

  <div class="callout">
    <p>
      <strong>Información pública a octubre de 2026.</strong> Todo lo que decimos de cada plataforma sale de su propia
      web, consultada el 2 de octubre de 2026. ContRadar es nuestra; por eso publicamos los criterios y la fuente de
      cada dato. Si eres una de estas plataformas y algo está mal o cambió, escríbenos a
      <a href="mailto:soporte@contradar.com.co">soporte@contradar.com.co</a> con el enlace público donde se vea el dato
      correcto y actualizamos la comparativa.
    </p>
  </div>

  <Fuentes fuentes={fuentes} consultadas="2026-10-02" />
</GuideLayout>

<style>
  .ranking { margin: 1.5rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.75rem; }
  .ranking__item { border: 1px solid var(--papel-200); border-radius: 12px; background: var(--papel-000); padding: 1rem 1.25rem; }
  .ranking__item--cr { border: 2px solid var(--azul-500); }
  .ranking__cab { display: flex; align-items: baseline; gap: 0.75rem; }
  .ranking__pos { font-family: 'IBM Plex Mono', monospace; font-size: 0.875rem; font-weight: 600; color: var(--grafito-500); min-width: 1.5rem; }
  .ranking__item--cr .ranking__pos { color: var(--azul-600); }
  .ranking__nombre { flex: 1; font-size: 1.0625rem; font-weight: 800; color: var(--grafito-900); }
  .ranking__pts { font-size: 0.8125rem; color: var(--grafito-500); white-space: nowrap; }
  .ranking__pts .dato { font-size: 1rem; font-weight: 700; color: var(--grafito-900); }
  .ranking__mejor { margin: 0.4rem 0 0; font-size: 0.875rem; color: var(--grafito-700); }
