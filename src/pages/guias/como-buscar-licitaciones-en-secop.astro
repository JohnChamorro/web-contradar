const faq = [
  {
    q: "¿Buscar licitaciones en SECOP es gratis?",
    a: "Sí. La consulta de SECOP I y SECOP II es pública y gratuita, y no necesitas registrarte. Solo necesitas una cuenta de proveedor en SECOP II si vas a presentar ofertas en esa plataforma.",
  },
  {
    q: "¿Dónde se buscan los procesos de SECOP II?",
    a: "En la búsqueda de procesos de la plataforma, que Colombia Compra Eficiente enlaza desde su página de SECOP II. SECOP I tiene su propia consulta, enlazada desde la página de SECOP I. Son dos búsquedas distintas.",
  },
  {
    q: "¿Cuál es la diferencia entre SECOP I y SECOP II?",
    a: "SECOP I es una plataforma de publicidad: la entidad sube los documentos del proceso. SECOP II es transaccional: el proceso ocurre en línea y desde ahí se presentan las ofertas. Las dos conviven, así que para no perder procesos hay que revisar ambas.",
  },
  {
    q: "¿Cada cuánto debo revisar el SECOP?",
    a: "Todos los días hábiles si buscas a mano. En mínima cuantía la invitación puede durar 1 día hábil y el plazo para ofertar es igual de corto, así que una revisión semanal deja procesos enteros por fuera.",
  },
  {
    q: "¿Qué busco primero: palabras o códigos UNSPSC?",
    a: "Las dos cosas. Las palabras encuentran lo que la entidad redactó como tú; los códigos UNSPSC encuentran lo que redactó distinto. Usa los mismos códigos de tu RUP y varias formas de nombrar lo que vendes.",
  },
];

const fuentes = [
  {
    titulo: "Colombia Compra Eficiente — SECOP II",
    url: "https://www.colombiacompra.gov.co/secop/secop-ii",
    nota: "plataforma transaccional, vista pública y enlace a la búsqueda de procesos",
