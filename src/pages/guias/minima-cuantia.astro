---
import GuideLayout from "../../layouts/GuideLayout.astro";
import Figura from "../../components/guias/graficos/Figura.astro";
import Barras from "../../components/guias/graficos/Barras.astro";
import Cronograma from "../../components/guias/graficos/Cronograma.astro";
import DatoContRadar from "../../components/guias/DatoContRadar.astro";
import PorQueContRadar from "../../components/guias/PorQueContRadar.astro";
import { ANIO_CUANTIAS, SMMLV, tramosCuantia, cuantiasCgp, CGP } from "../../data/cuantias";
import { moneda } from "../../lib/formato";

/* Las cifras salen de src/data/cuantias.ts: cuando se decrete el salario del
   año siguiente se cambia allá y esta guía, la tabla y la herramienta del
   tope quedan al día juntas (docs/seo/runbook-smmlv.md). Lo que NO se
   actualiza solo son los textos sobre el decreto y sus fuentes. */
const A = ANIO_CUANTIAS;
const S = moneda(SMMLV[A]);
const T = tramosCuantia(A);
const cgp = cuantiasCgp(A);
const bajo = moneda(T[0].minimaPesos);
const alto = moneda(T[4].minimaPesos);
const M = (v: number) => moneda(v, "abreviado");
/* Título y descripción llevan LA CIFRA (28-nov-2026). Search Console, 3 meses:
   12.659 impresiones en posición 5,3 con 0,83 % de clics; «minima cuantia 2026»
   y «valor minima cuantia 2026» suman 2.007 impresiones y 1 clic. Quien busca
   el valor quiere verlo en el resultado, y sale de las mismas constantes que la
   tabla, así que cambia solo cada enero. */

const faq = [
  {
    q: `¿Cuánto es la mínima cuantía en ${A}?`,
    a: `Depende de la entidad: es hasta el 10 % de su menor cuantía, y esa menor cuantía va de 280 a 1.000 SMMLV según su presupuesto anual. Con el salario mínimo de ${A} (${S}), el tope va de ${bajo} en las entidades con presupuesto inferior a 120.000 SMMLV a ${alto} en las de 1.200.000 SMMLV o más.`,
  },
  {
    q: `¿Cuál es el valor de la mínima cuantía ${A} en municipios de sexta categoría?`,
    a: `La ley no fija el tope por categoría sino por presupuesto anual. Si el presupuesto del municipio es inferior a 120.000 SMMLV (${moneda(T[1].desdePesos)} en ${A}), su mínima cuantía llega hasta ${bajo}, que es el tramo donde suele quedar un municipio de sexta categoría. Si su presupuesto es mayor, aplica el tramo siguiente.`,
  },
  {
    q: "¿Cómo sé cuál es el tope de mínima cuantía de una entidad en particular?",
    a: `Cada entidad lo declara en su Plan Anual de Adquisiciones. En la herramienta gratis de ContRadar escribes la alcaldía, gobernación u hospital y ves el tope que declaró para ${A}, con la fecha de su plan.`,
  },
  {
    q: `¿La mínima cuantía de la contratación estatal es la misma del Código General del Proceso?`,
    a: `No. La del Código General del Proceso (Ley 1564 de 2012, art. 25) clasifica demandas: son de mínima cuantía las pretensiones de hasta ${CGP.minimaHastaSmmlv} SMMLV, ${moneda(cgp.minimaHasta)} en ${A}. La de contratación estatal depende del presupuesto de la entidad y va de ${bajo} a ${alto}.`,
  },
  {
    q: "¿Cuántos SMMLV es la mínima cuantía?",
    a: "Entre 28 y 100 SMMLV: 28 en las entidades con presupuesto inferior a 120.000 SMMLV, 45 desde 120.000, 65 desde 400.000, 85 desde 850.000 y 100 desde 1.200.000.",
  },
  {
    q: "¿Necesito RUP para participar en una mínima cuantía?",
    a: "No. El artículo 6 de la Ley 1150 de 2007 exceptúa del Registro Único de Proponentes a los contratos de mínima cuantía. En ese caso es la entidad la que verifica las condiciones del proponente con los documentos que pida en la invitación.",
  },
  {
    q: "¿Cuánto tiempo hay para presentar la oferta en mínima cuantía?",
    a: "La invitación se publica por lo menos 1 día hábil para observaciones, y después del aviso que dice si el proceso se limita a Mipyme queda por lo menos 1 día hábil más para ofertar. Son mínimos: la entidad puede dar más, pero en la práctica los plazos son cortos y conviene enterarse el mismo día de la publicación.",
  },
  {
    q: "¿Puedo subsanar documentos en una mínima cuantía?",
    a: "Sí. El Decreto 1082 de 2015 obliga a la entidad a dar la oportunidad de subsanar dentro de un término preclusivo que fija en la invitación. Si no lo fija, puedes subsanar hasta antes de que termine el traslado del informe de evaluación. Lo que no se subsana es el precio: es el factor de selección.",
  },
  {
    q: "¿En mínima cuantía piden póliza?",
    a: "Depende de la invitación. El Decreto 1082 de 2015 deja a la entidad libre de exigir o no garantías en mínima cuantía. Lee la invitación completa: si la pide, debes cumplirla en los términos que fije.",
  },
];

const fuentes = [
  {
    titulo: "Ley 1150 de 2007",
    url: "http://www.secretariasenado.gov.co/senado/basedoc/ley_1150_2007.html",
    nota: "art. 2 num. 2 lit. b (menor cuantía según presupuesto) y num. 5 (mínima cuantía, modificado por el art. 30 de la Ley 2069 de 2020); art. 6 (excepción del RUP); art. 7 (garantías)",
  },
  {
    titulo: "Ley 1474 de 2011",
    url: "http://www.secretariasenado.gov.co/senado/basedoc/ley_1474_2011_pr002.html",
    nota: "art. 94 (adicionó la mínima cuantía al art. 2 de la Ley 1150)",
  },
  {
    titulo: "Decreto 1082 de 2015",
    url: "https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=77653",
    nota: "arts. 2.2.1.2.1.5.1 (estudios previos), 2.2.1.2.1.5.2 (procedimiento), 2.2.1.2.1.5.3 (grandes almacenes) y 2.2.1.2.1.5.5 (garantías)",
  },
  {
    titulo: "Decreto 1469 de 2025",
    url: "https://normograma.mintic.gov.co/mintic/compilacion/docs/decreto_1469_2025.htm",
    nota: "art. 1: salario mínimo de 2026, $1.750.905",
  },
  {
    titulo: "Decreto 159 de 2026",
    url: "https://normograma.mintic.gov.co/mintic/compilacion/docs/decreto_0159_2026.htm",
    nota: "transitorio, mismo valor; su nota de vigencia dice que cumplió su objeto al levantarse la suspensión del Decreto 1469",
  },
  {
    titulo: "Ley 1564 de 2012 (Código General del Proceso)",
    url: "http://www.secretariasenado.gov.co/senado/basedoc/ley_1564_2012.html",
    nota: "art. 25: cuantías de los procesos judiciales (mínima hasta 40 SMMLV, menor hasta 150). No aplica a la contratación estatal",
  },
  {
    titulo: "Ley 136 de 1994, art. 2, modificado por la Ley 1551 de 2012, art. 7",
    url: "http://www.secretariasenado.gov.co/senado/basedoc/ley_1551_2012.html",
    nota: "categorías de municipios: sexta categoría, hasta 10.000 habitantes e ingresos corrientes de libre destinación de hasta 15.000 SMMLV",
  },
  {
    titulo: "Portafolio, 17-jul-2026: el Consejo de Estado revoca la suspensión del Decreto 1469",
    url: "https://www.portafolio.co/economia/gobierno/consejo-de-estado-reactiva-el-aumento-del-23-del-salario-minimo-de-2026-esto-determino-498416",
    nota: "el valor no cambia y el proceso de nulidad sigue sin sentencia de fondo",
  },
];
---

<GuideLayout
  title={`Mínima cuantía ${A}: de ${M(T[0].minimaPesos)} a ${M(T[4].minimaPesos)} según la entidad`}
  description={`En ${A} la mínima cuantía va de ${bajo} (28 SMMLV) a ${alto} (100 SMMLV) según el presupuesto de la entidad. Tabla por tramos y cómo se gana.`}
  h1={`Mínima cuantía ${A}: cuánto es y cómo se gana`}
  slug="minima-cuantia"
  datePublished="2026-10-02"
  dateModified="2026-11-21"
  faq={faq}
  fuentes={fuentes}
  consultadas="2026-11-21"
  relacionadas={["como-calcular-la-oferta-economica", "seleccion-abreviada", "poliza-de-seriedad-de-la-oferta"]}
  sinCta
  masEnlaces={[
    { titulo: "Licitaciones de construcción y obra civil", resumen: "Cómo se licita la obra pública, qué requisitos piden y con qué códigos buscar.", href: "/sectores/construccion/" },
    { titulo: "Estadística de la licitación", resumen: "A qué precio se adjudica en tu sector y tu zona, con el número de casos detrás de cada cifra.", href: "/producto/estadistica-de-la-licitacion/" },
  ]}
>
  <p class="lead">
    En {A} la mínima cuantía va de <strong><span class="dato">{bajo}</span> a
    <span class="dato">{alto}</span></strong>. No hay un valor único: es el <strong>10 % de la menor cuantía de
    cada entidad</strong>, que depende de su presupuesto anual en salarios mínimos. El SMMLV de {A} es
    <span class="dato">{S}</span>.
  </p>
  <p>
    ¿Necesitas el de una entidad en particular? Escribe la alcaldía, gobernación u hospital en
    <a href="/herramientas/tope-minima-cuantia/">tope de mínima cuantía por entidad</a> y mira el que declaró para {A}.
  </p>

  <Figura
    titulo="El tope de la mínima cuantía sube con el presupuesto de la entidad"
    nota={`Tope de mínima cuantía en ${A} según el presupuesto anual de la entidad. Cálculo de ContRadar con el SMMLV de ${S} y los tramos del artículo 2 de la Ley 1150 de 2007.`}
  >
    <Barras filas={T.map((t) => ({ etiqueta: t.etiqueta, valor: t.minimaPesos, texto: moneda(t.minimaPesos) }))} />
  </Figura>

  <div class="tabla-scroll">
    <table>
      <thead>
        <tr>
          <th>Presupuesto anual de la entidad</th>
          <th>En pesos de {A}</th>
          <th>Menor cuantía</th>
          <th>Mínima cuantía en SMMLV</th>
          <th>Mínima cuantía {A}</th>
        </tr>
      </thead>
      <tbody>
        {T.map((t, i) => (
          <tr>
            <td>{t.etiqueta}</td>
            <td>{i === 0 ? "Menos de " : "Desde "}<span class="dato">{moneda(i === 0 ? t.hastaPesos! : t.desdePesos)}</span></td>
            <td><span class="dato">{t.menorSmmlv.toLocaleString("es-CO")}</span> SMMLV</td>
            <td><span class="dato">{t.minimaSmmlv}</span></td>
            <td><strong><span class="dato">{moneda(t.minimaPesos)}</span></strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>
    La tabla sale del literal b del numeral 2 del artículo 2 de la Ley 1150 de 2007 (los tramos de menor cuantía) y
    del numeral 5 del mismo artículo (el 10 %). Es el «hasta»: una entidad puede contratar por esta modalidad
    cualquier cosa que no pase de esa cifra.
  </p>

  <DatoContRadar id="mc-tope-paa-2026" />
  <DatoContRadar id="mc-participacion" />

  <h2>Municipios: la categoría no fija el tope</h2>
  <p>
    Mucha gente busca el valor «para municipios de sexta categoría», y hay que aclarar algo: <strong>la ley de
    contratación no mira la categoría, mira el presupuesto anual</strong>. La categoría se define con otra medida:
    población e ingresos corrientes de libre destinación. Una de sexta tiene hasta <span class="dato">10.000</span>
    habitantes e ingresos de libre destinación de hasta <span class="dato">15.000</span> SMMLV
    (<span class="dato">{moneda(15_000 * SMMLV[A])}</span> en {A}).
  </p>
  <p>
    En la práctica, un municipio de sexta suele estar en el primer tramo: si su presupuesto total es inferior a
    <span class="dato">{moneda(T[1].desdePesos)}</span>, su menor cuantía es 280 SMMLV y su mínima cuantía llega hasta
    <strong><span class="dato">{bajo}</span></strong>. La cuenta es 280 × {S} = {moneda(T[0].menorPesos)}, y el 10 % de
    eso. Si el presupuesto supera ese valor, aplica el tramo siguiente, sea cual sea su categoría.
  </p>
  <DatoContRadar id="mc-municipios-tope" />
  <div class="callout">
    <p>
      <strong>Ojo con el año y con el salario.</strong> La tabla cambia cada enero. Además, el salario de 2026 está
      demandado: el Consejo de Estado suspendió el Decreto 1469 de 2025 en febrero, el Gobierno mantuvo el mismo
      valor con el Decreto 159 de 2026 y la suspensión se revocó en julio. El valor sigue en $1.750.905, pero el
      proceso de nulidad no tiene sentencia de fondo. Si esa sentencia cambia el salario, estas cifras cambian.
    </p>
  </div>

  <h2>No la confundas con la mínima cuantía del Código General del Proceso</h2>
  <p>
    Si llegaste buscando la mínima cuantía «del CGP», es otra cosa. El Código General del Proceso (Ley 1564 de 2012,
    artículo 25) clasifica las <strong>demandas</strong> ante los jueces por el valor de lo que se pide, y no tiene
    que ver con el presupuesto de ninguna entidad:
  </p>
  <div class="tabla-scroll">
    <table>
      <thead>
        <tr><th>Cuantía del proceso judicial</th><th>En SMMLV</th><th>En pesos de {A}</th></tr>
      </thead>
      <tbody>
        <tr><td>Mínima</td><td>Hasta <span class="dato">{CGP.minimaHastaSmmlv}</span></td><td>Hasta <span class="dato">{moneda(cgp.minimaHasta)}</span></td></tr>
        <tr><td>Menor</td><td>Más de <span class="dato">{CGP.minimaHastaSmmlv}</span> y hasta <span class="dato">{CGP.menorHastaSmmlv}</span></td><td>Hasta <span class="dato">{moneda(cgp.menorHasta)}</span></td></tr>
        <tr><td>Mayor</td><td>Más de <span class="dato">{CGP.menorHastaSmmlv}</span></td><td>Más de <span class="dato">{moneda(cgp.menorHasta)}</span></td></tr>
      </tbody>
    </table>
  </div>
  <p>
    El resto de esta guía trata de la mínima cuantía de la <strong>contratación estatal</strong>: la modalidad con la
    que una entidad compra por debajo de su tope.
  </p>

  <h2>Qué dice la norma</h2>
  <p>
    La mínima cuantía la añadió el artículo 94 de la Ley 1474 de 2011 y hoy rige con el texto del artículo 30 de la
    Ley 2069 de 2020. La ley fija cuatro reglas:
  </p>
  <ul>
    <li>La entidad publica una <strong>invitación</strong> por un término no inferior a <span class="dato">1</span> día hábil, con el objeto, el presupuesto y las condiciones técnicas.</li>
    <li>El plazo para presentar la oferta tampoco puede ser inferior a <span class="dato">1</span> día hábil.</li>
    <li>La entidad escoge, mediante comunicación de aceptación, la <strong>propuesta con el menor precio</strong> siempre que cumpla las condiciones exigidas.</li>
    <li>La <strong>oferta más la aceptación son el contrato</strong>: no hay una minuta aparte que firmar.</li>
  </ul>
  <p>
    El procedimiento detallado está en el Decreto 1082 de 2015, artículos 2.2.1.2.1.5.1 y siguientes.
  </p>

  <h2>El procedimiento, paso a paso</h2>
  <Figura
    titulo="Una mínima cuantía se resuelve en días, no en semanas"
    nota="Plazos mínimos del Decreto 1082 de 2015: la entidad puede dar más tiempo, nunca menos."
  >
    <Cronograma hitos={[
      { t: "Estudios previos" },
      { t: "Invitación en el SECOP", plazo: "1 día hábil", d: "para observaciones" },
      { t: "Respuestas y adendas", d: "Adendas hasta 1 día hábil antes del cierre" },
      { t: "Aviso Mipyme", plazo: "1 día hábil", d: "para ofertar" },
      { t: "Menor precio", d: "Se verifica la oferta más barata" },
      { t: "Informe de evaluación", plazo: "1 día hábil", d: "para observaciones" },
      { t: "Aceptación", d: "Oferta y aceptación forman el contrato" },
    ]} />
  </Figura>
  <ol>
    <li>
      <strong>Estudios previos.</strong> La entidad describe la necesidad, el objeto con su código del
      Clasificador de Bienes y Servicios, las condiciones técnicas, el valor estimado, el plazo y el
      certificado de disponibilidad presupuestal.
    </li>
    <li>
      <strong>Invitación en el SECOP.</strong> Dice cómo acreditar la capacidad jurídica, la experiencia
      mínima (si la exige) y el cumplimiento técnico. Queda publicada por lo menos 1 día hábil para que
      hagas observaciones; en ese mismo término se puede pedir que el proceso se limite a Mipyme.
    </li>
    <li>
      <strong>Respuesta a observaciones y adendas.</strong> La entidad responde antes de abrir el plazo de
      ofertas. Puede modificar la invitación con adendas hasta 1 día hábil antes del cierre.
    </li>
    <li>
      <strong>Aviso de limitación a Mipyme.</strong> La entidad publica si el proceso quedó limitado a
      Mipyme o si puede participar cualquiera. Desde ese aviso corre un plazo de por lo menos 1 día hábil
      para presentar ofertas.
    </li>
    <li>
      <strong>Verificación del menor precio.</strong> La entidad revisa las ofertas económicas y verifica
      que la más barata cumpla. Si no cumple, pasa a la segunda más barata, y así sucesivamente.
    </li>
    <li>
      <strong>Informe de evaluación.</strong> Se publica por lo menos 1 día hábil para que los oferentes
      hagan observaciones, que la entidad responde antes de aceptar.
    </li>
    <li>
      <strong>Aceptación de la oferta.</strong> La entidad acepta la oferta de menor precio que cumple e
      informa quién será el supervisor. Oferta y aceptación forman el contrato.
    </li>
  </ol>
  <p>
    Si hay empate, la entidad aplica los criterios de desempate del artículo 35 de la Ley 2069 de 2020.
  </p>

  <h3>Qué te pueden pedir y qué no</h3>
  <ul>
    <li><strong>RUP:</strong> no. La Ley 1150 (art. 6) exceptúa del registro a los contratos de mínima cuantía; la entidad verifica tus condiciones directamente.</li>
    <li><strong>Capacidad financiera:</strong> solo si la entidad no paga contra entrega a satisfacción, y debe decir en la invitación cómo la verifica.</li>
    <li><strong>Experiencia:</strong> solo si la invitación la exige.</li>
    <li><strong>Garantías:</strong> la entidad es libre de pedirlas o no. Si las pide, aplican las reglas de la <a href="/guias/poliza-de-seriedad-de-la-oferta/">garantía de seriedad</a> y de cumplimiento.</li>
  </ul>

  <h3>La variante de grandes almacenes</h3>
  <p>
    Para comprar bienes hasta el monto de su mínima cuantía, la entidad también puede invitar solo a
    establecimientos que la Superintendencia de Industria y Comercio define como «gran almacén». En ese caso
    la invitación va dirigida a ellos, el plazo para cotizar es de por lo menos 1 día hábil y gana la
    cotización de menor precio que cumpla.
  </p>

  <h2>Cómo se gana una mínima cuantía</h2>
  <p>
    Aquí no hay puntaje por calidad ni por experiencia adicional: gana el <strong>menor precio que cumple</strong>.
    Por eso la pregunta que importa no es «cuánto puedo cobrar» sino «a cuánto se gana en esta entidad».
  </p>
  <ul>
    <li><strong>El precio decide.</strong> Si tu oferta es la más baja y cumple, ganas. Si es la segunda, solo ganas si la primera falla en algo.</li>
    <li><strong>Cumplir es la otra mitad.</strong> Una oferta barata que no cumple no sirve. Revisa la invitación línea por línea y responde cada condición técnica de forma explícita.</li>
    <li><strong>No regales margen.</strong> Bajar mucho sin saber a cuánto se suele adjudicar es dejar plata en la mesa o arriesgarte a una oferta que no puedes cumplir.</li>
  </ul>
  <DatoContRadar id="mc-al-presupuesto-2026" />
  <DatoContRadar id="mc-baja-2026" />
  <p>
    Esa respuesta se puede reconstruir a mano, contrato por contrato, en el SECOP. Hay que repetirlo
    para cada entidad, y por eso construí ContRadar: para ver <a href="/producto/estadistica-de-la-licitacion/">a qué precio adjudica esa
    entidad</a> antes de ofertar, con el número de casos detrás de cada cifra. Para armar tu número, sigue con
    <a href="/guias/como-calcular-la-oferta-economica/">cómo calcular la oferta económica</a>.
  </p>

  <h2>Errores que cuestan una mínima cuantía</h2>
  <ul>
    <li><strong>Enterarte tarde.</strong> Con plazos de 1 día hábil, si revisas el SECOP una vez a la semana pierdes procesos enteros.</li>
    <li><strong>Calcular mal el tope.</strong> Un proceso de $120 M puede ser mínima cuantía en una entidad de presupuesto grande (tope de hasta {M(T[4].minimaPesos)} en {A}) y menor cuantía en un municipio pequeño (tope de {M(T[0].minimaPesos)}). Revisa la modalidad que publicó la entidad y, si dudas, <a href="/herramientas/tope-minima-cuantia/">el tope que declaró</a>.</li>
    <li><strong>No subsanar a tiempo.</strong> Si la invitación fija un término para subsanar, es preclusivo: después de esa fecha la oferta se rechaza.</li>
    <li><strong>Ignorar la limitación a Mipyme.</strong> Si el proceso se limita, solo pueden ofertar Mipyme; si eres Mipyme y quieres que se limite, la solicitud va dentro del término de observaciones.</li>
  </ul>

  <h2>Dónde encontrar procesos de mínima cuantía</h2>
  <p>
    Se publican en SECOP I o SECOP II según la entidad, y en la búsqueda puedes filtrar por la modalidad
    «mínima cuantía». Si nunca has buscado, empieza por
    <a href="/guias/como-buscar-licitaciones-en-secop/">cómo buscar licitaciones en SECOP</a> y revisa
    <a href="/guias/secop-i-vs-secop-ii/">en qué plataforma publica cada entidad</a>.
  </p>
  <p>
    Si el valor supera el tope de la entidad, el proceso pasa a otra modalidad, normalmente la
    <a href="/guias/seleccion-abreviada/">selección abreviada de menor cuantía</a>. El panorama completo está en
    <a href="/licitaciones-colombia/">licitaciones en Colombia</a>.
  </p>

  <PorQueContRadar
    campana="minima-cuantia"
    filas={[
      { tarea: "Enterarte a tiempo de una invitación de 1 día hábil", aMano: "Revisar SECOP I y SECOP II cada día, por separado", conContRadar: "Te llegan al correo cada mañana los procesos que encajan con tu empresa" },
      { tarea: "Saber a qué precio adjudica esa entidad", aMano: "Abrir sus contratos uno por uno y sacar la cuenta", conContRadar: "La mediana de tu sector y tu zona junto al proceso, con cuántos casos la sostienen; la de cada entidad, en el plan Dominio" },
