---
import Flecha from "../../components/Flecha.astro";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import AccessForm from "../../components/AccessForm.astro";
import Footer from "../../components/Footer.astro";

const guias = [
  {
    slug: "como-buscar-licitaciones-en-secop",
    title: "Cómo buscar licitaciones en SECOP",
    desc: "Paso a paso para encontrar procesos en SECOP I y II: filtros, UNSPSC y los errores que cuestan contratos.",
    tag: "Empezar",
  },
  {
    slug: "que-es-el-paa",
    title: "Qué es el PAA y cómo aprovecharlo",
    desc: "El Plan Anual de Adquisiciones te dice qué planea comprar el Estado — meses antes de que abra la licitación.",
    tag: "Anticiparse",
  },
  {
    slug: "apps-para-licitaciones-colombia",
    title: "Apps para buscar licitaciones en Colombia",
    desc: "SECOP, OportunidadesCCE, buscadores y plataformas de monitoreo: comparativa honesta para elegir según tu volumen.",
    tag: "Herramientas",
  },
];
---

<Base
  title="Guías de licitaciones públicas en Colombia — ContRadar"
  description="Guías prácticas y gratuitas sobre contratación pública: cómo buscar en SECOP, qué es el PAA, qué herramientas usar y cómo ganar más licitaciones en Colombia."
>
  <Nav />
  <main>

    <!-- Page intro — claro (v2) -->
    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-5 py-14 text-center sm:px-8">
        <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">Guías</p>
        <h1 class="text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl lg:text-5xl">Guías de licitaciones</h1>
        <p class="mx-auto mt-4 max-w-xl text-lg text-grafito-500">Contratación pública en Colombia, explicada en claro. Gratis, sin registro.</p>
      </div>
    </section>

    <section class="bg-slate-50">
      <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
        <div class="grid gap-4 sm:grid-cols-3">
          {guias.map((g) => (
            <a href={`/guias/${g.slug}/`} class="group rounded-xl border border-papel-200 bg-white p-6 transition hover:border-azul-300">
              <span class="dato rounded-full bg-papel-100 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-grafito-500">{g.tag}</span>
              <h2 class="mt-3 text-lg font-bold text-grafito-900 group-hover:text-azul-600 transition">{g.title}</h2>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{g.desc}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-azul-600">Leer guía <Flecha /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <AccessForm />

  </main>
  <Footer />
</Base>
