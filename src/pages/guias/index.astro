---
import Flecha from "../../components/Flecha.astro";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import AccessForm from "../../components/AccessForm.astro";
import Footer from "../../components/Footer.astro";

import { GUIAS, ETAPAS, type Etapa } from "../../data/guias";
/* Desde el registro único (src/data/guias.ts), agrupadas por etapa. */
const grupos = (Object.keys(ETAPAS) as Etapa[]).map((e) => ({ titulo: ETAPAS[e], guias: GUIAS.filter((g) => g.etapa === e) }));
---

<Base
  title="Guías de licitaciones públicas en Colombia · ContRadar"
  description="Guías gratis de contratación pública en Colombia: SECOP, RUP, requisitos habilitantes, capacidad residual, mínima cuantía, oferta económica y cómo ganar licitaciones."
  migas={[{ nombre: "Guías", url: "/guias/" }]}
>
  <Nav />
  <main>

    <!-- Page intro — claro (v2) -->
    <section class="bg-white">
      <div class="mx-auto max-w-4xl px-5 py-14 text-center sm:px-8">
        <p class="dato mb-3.5 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-grafito-400">Guías</p>
        <h1 class="text-3xl font-extrabold leading-[1.05] tracking-tight text-grafito-900 sm:text-4xl lg:text-5xl">Guías de licitaciones</h1>
        <p class="mx-auto mt-4 max-w-xl text-lg text-grafito-500">Contratación pública en Colombia, explicada en claro. Gratis, sin registro.</p>
      </div>
    </section>

    <!-- Blanca (24-sep): la banda clara de la prueba va justo debajo y dos
         papel-100 seguidos se funden. -->
    <section class="bg-white">
      <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
        <p class="max-w-[65ch] text-[0.9375rem] leading-relaxed text-grafito-500">
          ¿Empiezas de cero? Lee primero <a href="/licitaciones-colombia/" class="font-semibold text-azul-600 hover:underline">licitaciones en Colombia</a>, el mapa completo. Y si necesitas tu K, usa la <a href="/herramientas/calculadora-capacidad-residual/" class="font-semibold text-azul-600 hover:underline">calculadora de capacidad residual</a>.
        </p>
        {grupos.map((gr) => (
          <div class="mt-10">
            <h2 class="text-xl font-extrabold tracking-tight text-grafito-900">{gr.titulo}</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {gr.guias.map((g) => (
                <a href={`/guias/${g.slug}/`} class="group rounded-xl border border-papel-200 bg-white p-6 transition hover:border-azul-300">
                  <h3 class="text-lg font-bold text-grafito-900 transition group-hover:text-azul-600">{g.titulo}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-grafito-500">{g.resumen}</p>
                  <span class="mt-4 inline-block text-sm font-semibold text-azul-600">Leer guía <Flecha /></span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <AccessForm />

  </main>
  <Footer />
</Base>
