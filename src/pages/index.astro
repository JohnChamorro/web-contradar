---
// Home fase 4 (replica landing-v4.html):
// hero → VS → arco → sector → precio → full-bleed → precios resumidos →
// FAQ corto → formulario de prueba → footer.
// Fuera: roadmap, servicios a medida (página propia enlazada del pie) y
// las secciones duplicadas del sistema viejo.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AccesosBar from "../components/AccesosBar.astro";
import VSBand from "../components/VSBand.astro";
import ExpedienteSection from "../components/ExpedienteSection.astro";
import ArcoCinco from "../components/ArcoCinco.astro";
import SectorFoto from "../components/SectorFoto.astro";
import PrecioFoto from "../components/PrecioFoto.astro";
import FullBleedCTA from "../components/FullBleedCTA.astro";
import PreciosResumen from "../components/PreciosResumen.astro";
import Faq from "../components/Faq.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <AccesosBar />
    <ExpedienteSection />
    <VSBand />
    <ArcoCinco />
    <SectorFoto />
    <PrecioFoto />
    <FullBleedCTA />
    <PreciosResumen />
    <Faq limit={5} />
    {/* El destino de "Prueba gratis" (#solicitar): se queda al final. */}
    <AccessForm />
  </main>
  <Footer />
</Base>
