---
// Home fase 4 (replica landing-v4.html):
// hero → VS → arco → sector → precio → full-bleed → precios resumidos →
// FAQ corto → formulario de prueba → footer.
// Fuera: roadmap, servicios a medida (página propia enlazada del pie) y
// las secciones duplicadas del sistema viejo.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import VSBand from "../components/VSBand.astro";
import CompetenciaShowcase from "../components/CompetenciaShowcase.astro";
import GestionEquipoSection from "../components/GestionEquipoSection.astro";
import ExpedienteSection from "../components/ExpedienteSection.astro";
import DashboardPortada from "../components/DashboardPortada.astro";
import ArcoCinco from "../components/ArcoCinco.astro";
import SectorFoto from "../components/SectorFoto.astro";
import PrecioFoto from "../components/PrecioFoto.astro";
import FullBleedCTA from "../components/FullBleedCTA.astro";
import FranjaEquipo from "../components/FranjaEquipo.astro";
import PreciosResumen from "../components/PreciosResumen.astro";
import Faq from "../components/Faq.astro";
import AccessForm from "../components/AccessForm.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <main>
    <Hero />
    {/* Los accesos de módulo que vivían aquí quedaron duplicados con el
        arco de módulos de abajo; John pidió en su lugar la banda del SECOP
        (1-sep-2026). Movida, no copiada: antes vivía junto a los precios. */}
    {/* Las cifras vivas van DENTRO de la banda (1-sep): un solo argumento,
        una sola superficie. */}
    <FullBleedCTA />
    {/* Los tres módulos que más venden, cada uno con su pantalla del producto:
        la estadística de la licitación, el análisis de competencia y la gestión
        de equipo. La comparación de búsqueda («alcantarilla») estuvo aquí unas
        horas el 31-ago y John la sacó: su sitio es /producto/busquedas/, donde
        se cuenta entera. */}
    {/* Fondo claro (John, 1-sep). Iba en tinta-900 y caía JUSTO detrás de la
        banda del SECOP, que también es oscura: dos bandas oscuras seguidas,
        cuando el sistema manda una sola por página. Blanco, además, da
        respiro tras la banda y encadena bien con el papel-100 de competencia. */}
    <ExpedienteSection fondo="white" />
    <CompetenciaShowcase />
    {/* La franja del equipo NUESTRO abre la sección del equipo DEL CLIENTE
        (John, 2-sep): «detrás de cada cifra hay un equipo que responde» hace
        de puente natural hacia «licitar no lo hace una persona». */}
    <FranjaEquipo />
    <GestionEquipoSection />
    {/* El tablero CIERRA los módulos, no los abre (John, 1-sep): aporta,
        pero vende menos que estadística/competencia/gestión — al final lee
        como «todo lo anterior te recibe resumido cada mañana». */}
    <DashboardPortada />
    <PrecioFoto />
    <VSBand />
    <SectorFoto />
    <ArcoCinco />
    <PreciosResumen />
    <Faq limit={5} />
    {/* El destino de "Prueba gratis" (#solicitar): se queda al final. */}
    <AccessForm />
  </main>
  <Footer />
</Base>
